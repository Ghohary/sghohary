        #custom-orders .custom-order-actions {
            margin-top: 10px;
            gap: 8px;
        }

        #custom-orders .custom-order-actions .btn,
        #custom-orders .custom-order-actions .btn-small,
        #custom-orders .custom-order-list-actions .btn-small {
