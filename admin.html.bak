        body::before {
            opacity: 0.24 !important;
            background-size: 30px 30px !important;
            background-image:
                linear-gradient(rgba(132, 166, 219, 0.14) 1px, transparent 1px),
                linear-gradient(90deg, rgba(132, 166, 219, 0.14) 1px, transparent 1px) !important;
            animation: none !important;
        }

        body::after {
            background:
                radial-gradient(66% 34% at 50% -12%, rgba(131, 176, 243, 0.24) 0%, rgba(131, 176, 243, 0) 100%),
                linear-gradient(180deg, rgba(151, 192, 252, 0.16) 0%, rgba(151, 192, 252, 0) 34%) !important;
            animation: none !important;
        }

        .admin-header {
            border-bottom: 1px solid rgba(116, 152, 206, 0.34) !important;
