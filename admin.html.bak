        <!-- BULK PRICES TAB -->
        <div id="prices" class="tab-content">
            <h2>Bulk Price Update</h2>
            
            <form id="bulkPriceForm" onsubmit="handleBulkPriceUpdate(event)">
                <textarea id="bulkPriceData" placeholder="Enter product updates in format: SKU,NEW_PRICE&#10;Example:&#10;EL-001,25000&#10;MV-002,19500&#10;RST-003,32000" style="min-height: 200px;"></textarea>
                <button type="submit" style="margin-top: 15px;">Update Prices</button>
            </form>

            <div id="bulkUpdateResults"></div>
        </div>

        <!-- SETTINGS TAB -->
        <div id="settings" class="tab-content">
            <div class="settings-grid">
                <div class="settings-card shipping-settings">
                    <div class="shipping-panel-head">
                        <div>
                            <h3 class="shipping-panel-title">Shipping Network</h3>
                            <p class="shipping-panel-subtitle">Continent-based rates synced directly to checkout</p>
                        </div>
                        <div class="shipping-panel-chip" id="shippingRegionCountChip">0 countries</div>
                    </div>
                    <div id="shippingRegionsTable" class="shipping-box-layout"></div>
                    <div class="shipping-actions">
                        <select id="shippingCountryPicker" class="shipping-country-picker">
                            <option value="">Select country to add</option>
                        </select>
                        <button class="btn-small shipping-action-add" id="addShippingRegionBtn" type="button">Add Country</button>
                        <button class="btn shipping-action-save" id="saveShippingRegionsBtn" type="button">Save</button>
                    </div>
                    <div class="shipping-note">
                        Changes update checkout delivery countries for all customers.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = window.location.origin === 'null' ? 'https://mohsenghohary.net' : '';
        const MEDIA_UPLOAD_URL = `${API_BASE || window.location.origin}/api/upload`;
        const SHIPPING_REGIONS_API = `${API_BASE}/api/shipping-regions`;
        const CUSTOM_ORDERS_API = `${API_BASE}/api/custom-orders`;
        const INVOICE_API = `${API_BASE}/api/invoices`;
        const ADMIN_ANALYTICS_API = `${API_BASE}/api/admin/analytics`;
        const safeStorageGet = (storage, key, fallback = '') => {
            try {
                const value = storage.getItem(key);
                return value == null ? fallback : value;
            } catch (error) {
                return fallback;
            }
        };
        const safeStorageSet = (storage, key, value) => {
            try {
                storage.setItem(key, value);
                return true;
            } catch (error) {
                return false;
            }
        };
        const safeStorageRemove = (storage, key) => {
            try {
                storage.removeItem(key);
                return true;
            } catch (error) {
                return false;
            }
        };
        let authToken = safeStorageGet(localStorage, 'adminToken', '');
        let authFailureHandled = false;
        const refreshAdminToken = () => {
            authToken = safeStorageGet(localStorage, 'adminToken', '') || safeStorageGet(sessionStorage, 'adminToken', '') || '';
            return authToken;
        };
        const buildAdminHeaders = (headers = {}) => {
            const merged = { ...headers };
            const token = refreshAdminToken();
            if (token) {
                merged.Authorization = `Bearer ${token}`;
            }
            return merged;
        };
        const adminFetch = async (url, options = {}) => {
            const headers = buildAdminHeaders(options.headers || {});
            const response = await fetch(url, { ...options, headers });
            if ((response.status === 401 || response.status === 403) && !authFailureHandled) {
                authFailureHandled = true;
                showAlert('Admin session expired. Please sign in again.', 'error');
                setTimeout(() => {
                    if (window.ghoharyAuth && typeof window.ghoharyAuth.logout === 'function') {
                        window.ghoharyAuth.logout();
                    }
                }, 700);
            }
            return response;
        };
        const debounce = (fn, delay = 120) => {
            let timer = null;
            return (...args) => {
                if (timer) clearTimeout(timer);
                timer = setTimeout(() => {
                    timer = null;
                    fn(...args);
                }, delay);
            };
        };
        let products = [];
        let orders = [];
        let orderSearchTerm = '';
        let productSearchTerm = '';
        const ORDER_FILTER_STORAGE_KEY = 'ghoharyAdminOrderFilter';
        const ORDER_SORT_STORAGE_KEY = 'ghoharyAdminOrderSort';
        const ORDER_FILTER_OPTIONS = new Set(['all', 'unfulfilled', 'in-transit', 'delivered', 'refunded']);
        const ORDER_SORT_OPTIONS = new Set(['newest', 'oldest', 'total-high', 'total-low', 'customer-asc', 'customer-desc']);
        let orderQuickFilter = safeStorageGet(localStorage, ORDER_FILTER_STORAGE_KEY, 'all') || 'all';
        let orderSortMode = safeStorageGet(localStorage, ORDER_SORT_STORAGE_KEY, 'newest') || 'newest';
        const PRODUCT_FILTER_STORAGE_KEY = 'ghoharyAdminProductFilter';
        const PRODUCT_SORT_STORAGE_KEY = 'ghoharyAdminProductSort';
        const PRODUCT_DRAFT_STORAGE_KEY = 'ghoharyAdminProductDraftV2';
        const PRODUCT_FILTER_OPTIONS = new Set(['all', 'in-stock', 'low-stock', 'out-of-stock', 'price-request']);
        const PRODUCT_SORT_OPTIONS = new Set([
            'newest',
            'oldest',
            'name-asc',
            'name-desc',
            'price-high',
            'price-low',
            'inventory-high',
            'inventory-low'
        ]);
        let productInventoryFilter = safeStorageGet(localStorage, PRODUCT_FILTER_STORAGE_KEY, 'all') || 'all';
        let productSortMode = safeStorageGet(localStorage, PRODUCT_SORT_STORAGE_KEY, 'newest') || 'newest';
        const INVOICE_QUICK_FILTER_STORAGE_KEY = 'ghoharyAdminInvoiceQuickFilter';
        const INVOICE_SORT_STORAGE_KEY = 'ghoharyAdminInvoiceSort';
        const INVOICE_QUICK_FILTER_OPTIONS = new Set(['all', 'open', 'paid', 'draft', 'overdue']);
        const INVOICE_SORT_OPTIONS = new Set(['newest', 'oldest', 'amount-high', 'amount-low', 'client-asc', 'client-desc', 'due-soon', 'status']);
        let invoiceQuickFilter = safeStorageGet(localStorage, INVOICE_QUICK_FILTER_STORAGE_KEY, 'all') || 'all';
        let invoiceSortMode = safeStorageGet(localStorage, INVOICE_SORT_STORAGE_KEY, 'newest') || 'newest';
        let shippingRegions = [];
        let shippingCountryCatalog = [];
        let invoices = [];
        let invoiceEditingId = null;
        let customOrders = [];
        let customOrderEditingId = null;
        let analyticsSnapshot = null;
        let analyticsRefreshTimer = null;
        let analyticsGlobeFrameId = null;
        let analyticsGlobeRotation = 0;
        let analyticsGlobeResizeBound = false;
        let analyticsGlobeBaseDots = null;
        let analyticsGlobeStars = null;
        let analyticsGlobeStarFieldKey = '';
        let customStatusLocked = false;
        let pendingOrderOpen = null;
        let pendingEditProductId = null;
        let isAddProductView = false;
        let isProductSubmitInFlight = false;
        // Product media state must be initialized before any readiness/size routines run.
        let imageFiles = [];
        let imageAltTexts = [];
        let selectedImageIndex = -1;
        let activeUploads = 0;
        let videoFiles = [];
        let activeVideoUploads = 0;
        let invoiceControlsBound = false;
        let productsTableEventsBound = false;
        let productsRenderToken = 0;
        let addProductWorkspaceBound = false;
        let productCategorySelectBound = false;
        let productSortSelectBound = false;
        let orderSortSelectBound = false;
        let productDraftSaveTimer = null;
        const ADMIN_PRODUCTS_CACHE_KEY = 'ghoharyAdminProductsSummaryCache';
        const ADMIN_PRODUCTS_CACHE_TTL_MS = 10 * 60 * 1000;
        const shippingGroupCollapsedState = {};
        const SHIPPING_REGION_GROUPS = [
            { key: 'europe', label: 'Europe' },
            { key: 'america', label: 'America' },
            { key: 'gcc', label: 'GCC' },
            { key: 'asia', label: 'Asia' },
            { key: 'australia', label: 'Australia' }
        ];
        const getShippingRegionGroupKey = (region) => {
            const explicitRegionKey = String(region?.continent || region?.region || '')
                .trim()
                .toLowerCase();
            if (SHIPPING_REGION_GROUPS.some((group) => group.key === explicitRegionKey)) {
                return explicitRegionKey;
            }
            const value = `${String(region?.id || '').toLowerCase()} ${String(region?.name || '').toLowerCase()}`;
            if (/(united kingdom|uk|france|italy|germany|ireland|switzerland|belgium|czech|europe|spain|portugal|netherlands|austria|sweden|norway|denmark|finland|poland|greece)/.test(value)) return 'europe';
            if (/(united states|usa|canada|mexico|brazil|argentina|america)/.test(value)) return 'america';
            if (/(uae|united arab emirates|saudi|qatar|kuwait|bahrain|oman|gcc)/.test(value)) return 'gcc';
            if (/(australia|new zealand|oceania)/.test(value)) return 'australia';
            return 'asia';
        };
        const GCC_COUNTRY_CODES = new Set(['AE', 'SA', 'QA', 'KW', 'BH', 'OM']);
        const FALLBACK_SHIPPING_COUNTRIES = [
            { name: 'United Arab Emirates', code: 'AE', continent: 'gcc' },
            { name: 'Saudi Arabia', code: 'SA', continent: 'gcc' },
            { name: 'Qatar', code: 'QA', continent: 'gcc' },
            { name: 'Kuwait', code: 'KW', continent: 'gcc' },
            { name: 'Bahrain', code: 'BH', continent: 'gcc' },
            { name: 'Oman', code: 'OM', continent: 'gcc' },
            { name: 'United Kingdom', code: 'GB', continent: 'europe' },
            { name: 'France', code: 'FR', continent: 'europe' },
            { name: 'Italy', code: 'IT', continent: 'europe' },
            { name: 'Germany', code: 'DE', continent: 'europe' },
            { name: 'Ireland', code: 'IE', continent: 'europe' },
            { name: 'Switzerland', code: 'CH', continent: 'europe' },
            { name: 'Belgium', code: 'BE', continent: 'europe' },
            { name: 'Czech Republic', code: 'CZ', continent: 'europe' },
            { name: 'United States', code: 'US', continent: 'america' },
            { name: 'Canada', code: 'CA', continent: 'america' },
            { name: 'Australia', code: 'AU', continent: 'australia' },
            { name: 'New Zealand', code: 'NZ', continent: 'australia' },
            { name: 'India', code: 'IN', continent: 'asia' },
            { name: 'China', code: 'CN', continent: 'asia' },
            { name: 'Japan', code: 'JP', continent: 'asia' },
            { name: 'Singapore', code: 'SG', continent: 'asia' }
        ];
        const slugifyShippingRegion = (value) => String(value || '')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        const escapeHtml = (value) => String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        const BLOBSOURCE_URL_PATTERN = /(?:^|[./-])(vercel-storage\.com|public\.blob\.vercel-storage\.com|blob\.vercel-storage)(?:[/?#]|$)/i;
        const sanitizeMediaUrl = (value) => {
            const url = String(value || '').trim();
            if (!url) return '';
            if (/^(https?:\/\/|\/|data:image\/|data:video\/)/i.test(url)) {
                if (BLOBSOURCE_URL_PATTERN.test(url)) return '';
                return url;
            }
            return '';
        };
        const optimizeProductThumbnailUrl = (value) => {
            const source = sanitizeMediaUrl(value);
            if (!source || /^data:/i.test(source)) return source;
            if (!/res\.cloudinary\.com\/.+\/image\/upload\//i.test(source)) return source;
            // Keep existing explicit Cloudinary transforms intact.
            if (/\/upload\/(?:[^/]*,)?(?:c_|w_|h_|q_|f_)/i.test(source)) return source;
            return source.replace('/upload/', '/upload/f_auto,q_auto,c_fill,w_192,h_252/');
        };
        const normalizeShippingRegionRecord = (region) => {
            const name = String(region?.name || '').trim();
            if (!name) return null;
            const id = slugifyShippingRegion(region?.id || name);
            if (!id) return null;
            const regionKey = getShippingRegionGroupKey({ ...region, id, name });
            const price = Number(region?.price || 0);
            return {
                id,
                name,
                enabled: region?.enabled !== false,
                eta: String(region?.eta || '').trim(),
                price: Number.isFinite(price) ? Math.max(0, price) : 0,
                continent: regionKey
            };
        };
        const clearProductViewParamsFromUrl = () => {
            const url = new URL(window.location.href);
            let changed = false;
            ['view', 'edit'].forEach((key) => {
                if (url.searchParams.has(key)) {
                    url.searchParams.delete(key);
                    changed = true;
                }
            });
            if (!changed) return;
            const query = url.searchParams.toString();
            const nextUrl = `${url.pathname}${query ? `?${query}` : ''}${url.hash || ''}`;
            window.history.replaceState({}, '', nextUrl);
        };
        const continentKeyFromCountryMeta = ({ code, region }) => {
            const upperCode = String(code || '').toUpperCase();
            if (GCC_COUNTRY_CODES.has(upperCode)) return 'gcc';
            const normalizedRegion = String(region || '').toLowerCase();
            if (normalizedRegion === 'europe') return 'europe';
            if (normalizedRegion === 'americas') return 'america';
            if (normalizedRegion === 'oceania') return 'australia';
            return 'asia';
        };
        const getProductSubmitButton = () => (
            document.getElementById('addProductSubmit') ||
            document.querySelector('#productForm button[type="submit"]')
        );
        const EDITING_PRODUCT_KEY = 'ghoharyEditingProductId';
        const LEGACY_ALT_NOTICE_TEXT = 'Add descriptive alt text for each image below to improve SEO.';

        function removeLegacyAltSeoNotice(scope = document) {
            const candidates = scope.querySelectorAll('p, div, span, label, small');
            candidates.forEach((el) => {
                if (String(el?.textContent || '').trim() === LEGACY_ALT_NOTICE_TEXT) {
                    el.remove();
                }
            });
        }

        function resolveEditingProductId() {
            const form = document.getElementById('productForm');
            const formId = form?.dataset.editingProductId || '';
            const urlId = new URL(window.location.href).searchParams.get('edit') || '';
            const storedId = sessionStorage.getItem(EDITING_PRODUCT_KEY) || '';
            const resolved = formId || urlId || storedId || '';
            if (!resolved || ['undefined', 'null', 'NaN'].includes(String(resolved))) {
                return '';
            }
            if (resolved && form && formId !== resolved) {
                form.dataset.editingProductId = resolved;
            }
            if (resolved && storedId !== resolved) {
                sessionStorage.setItem(EDITING_PRODUCT_KEY, resolved);
            }
            return resolved;
        }

        function syncProductCategorySelectUi() {
            const select = document.getElementById('productCategory');
            const labelEl = document.getElementById('productCategoryTriggerLabel');
            const shell = document.getElementById('productCategorySelectShell');
            const menu = document.getElementById('productCategoryMenu');
            if (!select || !labelEl) return;
            const selectedOption = Array.from(select.options || []).find((option) => option.value === select.value) || select.options[0];
            const selectedLabel = String(selectedOption?.textContent || 'Select Category').trim() || 'Select Category';
            labelEl.textContent = selectedLabel;
            if (shell) {
                shell.classList.toggle('has-value', Boolean(select.value));
            }
            if (menu) {
                menu.querySelectorAll('.futuristic-select-option').forEach((optionEl) => {
                    const isActive = String(optionEl.dataset.value || '') === String(select.value || '');
                    optionEl.classList.toggle('active', isActive);
                    optionEl.setAttribute('aria-selected', isActive ? 'true' : 'false');
                });
            }
        }

        function initProductCategorySelectUi() {
            const shell = document.getElementById('productCategorySelectShell');
            const select = document.getElementById('productCategory');
            const trigger = document.getElementById('productCategoryTrigger');
            const menu = document.getElementById('productCategoryMenu');
            if (!shell || !select || !trigger || !menu) return;

            const closeMenu = () => {
                shell.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
            };
            const openMenu = () => {
                shell.classList.add('open');
                trigger.setAttribute('aria-expanded', 'true');
                const activeOption = menu.querySelector('.futuristic-select-option.active') || menu.querySelector('.futuristic-select-option');
                if (activeOption && typeof activeOption.focus === 'function') {
                    activeOption.focus({ preventScroll: true });
                }
            };
            const toggleMenu = () => {
                if (shell.classList.contains('open')) {
                    closeMenu();
                } else {
                    openMenu();
                }
            };

            const buildMenu = () => {
                menu.innerHTML = '';
                Array.from(select.options || []).forEach((option, index) => {
                    if (index === 0 && !option.value) return;
                    const optionBtn = document.createElement('button');
                    optionBtn.type = 'button';
                    optionBtn.className = 'futuristic-select-option';
                    optionBtn.setAttribute('role', 'option');
                    optionBtn.dataset.value = option.value;
                    optionBtn.textContent = String(option.textContent || '').trim();
                    optionBtn.addEventListener('click', () => {
                        const nextValue = String(option.value || '');
                        if (String(select.value || '') !== nextValue) {
                            select.value = nextValue;
                            select.dispatchEvent(new Event('input', { bubbles: true }));
                            select.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                        syncProductCategorySelectUi();
                        closeMenu();
                        trigger.focus({ preventScroll: true });
                    });
                    menu.appendChild(optionBtn);
                });
                syncProductCategorySelectUi();
            };

            if (!productCategorySelectBound) {
                productCategorySelectBound = true;
                buildMenu();

                trigger.addEventListener('click', (event) => {
                    event.preventDefault();
                    toggleMenu();
                });

                trigger.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        toggleMenu();
                    } else if (event.key === 'ArrowDown') {
                        event.preventDefault();
                        openMenu();
                    } else if (event.key === 'Escape') {
                        event.preventDefault();
                        closeMenu();
                    }
                });

                menu.addEventListener('keydown', (event) => {
                    const optionNodes = Array.from(menu.querySelectorAll('.futuristic-select-option'));
                    if (!optionNodes.length) return;
                    const activeIndex = optionNodes.indexOf(document.activeElement);
                    if (event.key === 'ArrowDown') {
                        event.preventDefault();
                        const nextIndex = activeIndex < 0 ? 0 : Math.min(optionNodes.length - 1, activeIndex + 1);
                        optionNodes[nextIndex].focus();
                    } else if (event.key === 'ArrowUp') {
                        event.preventDefault();
                        const prevIndex = activeIndex <= 0 ? 0 : activeIndex - 1;
                        optionNodes[prevIndex].focus();
                    } else if (event.key === 'Home') {
                        event.preventDefault();
                        optionNodes[0].focus();
                    } else if (event.key === 'End') {
                        event.preventDefault();
                        optionNodes[optionNodes.length - 1].focus();
                    } else if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        if (document.activeElement && document.activeElement.classList.contains('futuristic-select-option')) {
                            document.activeElement.click();
                        }
                    } else if (event.key === 'Escape') {
                        event.preventDefault();
                        closeMenu();
                        trigger.focus({ preventScroll: true });
                    }
                });

                document.addEventListener('click', (event) => {
                    if (!shell.contains(event.target)) {
                        closeMenu();
                    }
                });

                window.addEventListener('resize', closeMenu);
                select.addEventListener('change', syncProductCategorySelectUi);
            } else {
                syncProductCategorySelectUi();
            }
        }

