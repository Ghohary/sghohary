        function updateProductComposerIndicators() {
            syncProductCategorySelectUi();
            const readinessValue = document.getElementById('productReadinessValue');
            const readinessBar = document.getElementById('productReadinessBar');
            const readinessTrack = document.getElementById('productReadinessTrack');
            const imagesChip = document.getElementById('composerImagesChip');
            const sizesChip = document.getElementById('composerSizesChip');
            const priceChip = document.getElementById('composerPriceChip');
            const hasReadinessUi = Boolean(readinessValue && readinessBar && readinessTrack);

            const nameValue = String(document.getElementById('productName')?.value || '').trim();
            const categoryValue = String(document.getElementById('productCategory')?.value || '').trim();
            const descriptionValue = String(document.getElementById('productDescription')?.value || '').trim();
            const priceRaw = String(document.getElementById('productPrice')?.value || '').trim();
            const selectedSizesCount = document.querySelectorAll('.size-btn.active').length;
            const totalInventory = Array.from(document.querySelectorAll('.size-btn.active')).reduce((sum, btn) => {
                return sum + normalizeSizeInventory(btn.dataset.inventory, 1);
            }, 0);
            const imageCount = Array.isArray(imageFiles) ? imageFiles.length : 0;

            let score = 0;
            if (nameValue) score += 25;
            if (categoryValue) score += 25;
            if (selectedSizesCount > 0) score += 25;
            if (imageCount > 0) score += 15;
            if (descriptionValue.length >= 20) score += 10;

            const normalizedScore = Math.max(0, Math.min(100, score));
            if (hasReadinessUi) {
                readinessValue.textContent = `${normalizedScore}%`;
                readinessBar.style.width = `${normalizedScore}%`;
                readinessTrack.setAttribute('aria-valuenow', String(normalizedScore));
            }

            if (imagesChip) {
                imagesChip.textContent = `Images: ${imageCount}`;
            }
            if (sizesChip) {
                sizesChip.textContent = `Sizes: ${selectedSizesCount} / Stock: ${totalInventory}`;
            }
            if (priceChip) {
                priceChip.textContent = priceRaw ? `Price: AED ${priceRaw}` : 'Price: Request';
            }
        }

        function updateProductDraftStatus(text) {
            const statusEl = document.getElementById('productDraftStatus');
            if (!statusEl) return;
            statusEl.textContent = String(text || 'Draft autosave ready');
        }

        function getProductDraftPayload() {
            const selectedBtns = Array.from(document.querySelectorAll('.size-btn.active'));
            const sizes = selectedBtns.map((btn) => ({
                size: String(btn.getAttribute('data-size') || '').trim(),
                custom: btn.dataset.custom === 'true',
                inventory: Number.isFinite(Number(btn.dataset.inventory)) ? Math.max(0, Number(btn.dataset.inventory)) : 1,
                price: btn.dataset.price !== undefined && btn.dataset.price !== '' ? Number(btn.dataset.price) : null
            })).filter((row) => row.size);

            return {
                name: String(document.getElementById('productName')?.value || ''),
                category: String(document.getElementById('productCategory')?.value || ''),
                price: String(document.getElementById('productPrice')?.value || ''),
                description: String(document.getElementById('productDescription')?.value || ''),
                sizes,
                images: Array.isArray(imageFiles) ? imageFiles.slice() : [],
                imageAlts: Array.isArray(imageAltTexts) ? imageAltTexts.slice() : [],
                videos: Array.isArray(videoFiles) ? videoFiles.slice() : [],
                savedAt: Date.now()
            };
        }

        function persistProductDraft(notify = false) {
            if (!isAddProductView || resolveEditingProductId()) return;
            try {
                const payload = getProductDraftPayload();
                localStorage.setItem(PRODUCT_DRAFT_STORAGE_KEY, JSON.stringify(payload));
                const stamp = new Date(payload.savedAt).toLocaleTimeString('en-GB', {
                    hour: '2-digit',
                    minute: '2-digit'
                });
                updateProductDraftStatus(`Draft saved at ${stamp}`);
                if (notify) showAlert('Draft saved.', 'success');
            } catch (error) {
                if (notify) showAlert('Unable to save draft.', 'error');
            }
        }

        function readProductDraft() {
            try {
                const raw = localStorage.getItem(PRODUCT_DRAFT_STORAGE_KEY);
                if (!raw) return null;
                const parsed = JSON.parse(raw);
                if (!parsed || typeof parsed !== 'object') return null;
                return parsed;
            } catch (error) {
                return null;
            }
        }

        function queueProductDraftSave() {
            if (!isAddProductView || resolveEditingProductId()) return;
            if (productDraftSaveTimer) window.clearTimeout(productDraftSaveTimer);
            productDraftSaveTimer = window.setTimeout(() => {
                productDraftSaveTimer = null;
                persistProductDraft(false);
            }, 700);
        }

        function restoreProductDraft(notify = false) {
            const draft = readProductDraft();
            if (!draft) {
                if (notify) showAlert('No saved draft found.', 'error');
                return false;
            }

            const nameInput = document.getElementById('productName');
            const categoryInput = document.getElementById('productCategory');
            const priceInput = document.getElementById('productPrice');
            const descriptionInput = document.getElementById('productDescription');
            if (nameInput) nameInput.value = String(draft.name || '');
            if (categoryInput) categoryInput.value = String(draft.category || '');
            if (priceInput) priceInput.value = String(draft.price || '');
            if (descriptionInput) descriptionInput.value = String(draft.description || '');

            resetBaseSizeButtons();
            const sizeSelectorEl = document.getElementById('sizeSelector');
            (Array.isArray(draft.sizes) ? draft.sizes : []).forEach((sizeEntry) => {
                const sizeValue = String(sizeEntry?.size || '').trim();
                if (!sizeValue) return;
                let btn = findSizeButton(sizeValue);
                if (!btn && sizeSelectorEl) {
                    btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'size-btn';
                    btn.dataset.size = sizeValue;
                    btn.dataset.custom = 'true';
                    btn.textContent = sizeValue;
                    attachSizeButtonHandler(btn);
                    sizeSelectorEl.appendChild(btn);
                }
                if (btn) {
                    btn.classList.add('active');
                    btn.dataset.inventory = String(normalizeSizeInventory(sizeEntry?.inventory, 1));
                    if (sizeEntry?.price !== undefined && sizeEntry?.price !== null && sizeEntry?.price !== '') {
                        btn.dataset.price = String(sizeEntry.price);
                    } else {
                        delete btn.dataset.price;
                    }
                }
            });

            imageFiles = Array.isArray(draft.images) ? draft.images.filter(Boolean) : [];
            imageAltTexts = Array.isArray(draft.imageAlts) ? draft.imageAlts.slice(0, imageFiles.length) : [];
            if (imageAltTexts.length < imageFiles.length) {
                imageAltTexts = imageAltTexts.concat(new Array(imageFiles.length - imageAltTexts.length).fill(''));
            }
            videoFiles = Array.isArray(draft.videos) ? draft.videos.filter(Boolean) : [];
            selectedImageIndex = -1;

            updateSelectedSizesDisplay();
            renderImagePreview();
            renderVideoPreview();
            updateProductComposerIndicators();

            const savedAt = Number(draft.savedAt || 0);
            if (Number.isFinite(savedAt) && savedAt > 0) {
                const stamp = new Date(savedAt).toLocaleTimeString('en-GB', {
                    hour: '2-digit',
                    minute: '2-digit'
                });
                updateProductDraftStatus(`Draft restored from ${stamp}`);
            } else {
                updateProductDraftStatus('Draft restored');
            }
            if (notify) showAlert('Draft restored.', 'success');
            return true;
        }

        function clearAddProductFormState(removeDraft = false) {
            const form = document.getElementById('productForm');
            if (form) {
                form.reset();
                form.dataset.editingProductId = '';
            }
            resetBaseSizeButtons();
            imageFiles = [];
            imageAltTexts = [];
            videoFiles = [];
            selectedImageIndex = -1;
            const imagePreviewEl = document.getElementById('imagePreview');
            const videoPreviewEl = document.getElementById('videoPreview');
            if (imagePreviewEl) imagePreviewEl.innerHTML = '';
            if (videoPreviewEl) videoPreviewEl.innerHTML = '';
            updateSelectedSizesDisplay();
            renderImagePreview();
            renderVideoPreview();
            updateProductComposerIndicators();
            if (removeDraft) {
                localStorage.removeItem(PRODUCT_DRAFT_STORAGE_KEY);
                updateProductDraftStatus('Draft cleared');
            }
        }

        function initAddProductWorkspace() {
            initProductCategorySelectUi();
            if (addProductWorkspaceBound) return;
            addProductWorkspaceBound = true;

            const saveBtn = document.getElementById('saveDraftBtn');
            const restoreBtn = document.getElementById('restoreDraftBtn');
            const clearBtn = document.getElementById('clearProductFormBtn');

            if (saveBtn) {
                saveBtn.addEventListener('click', () => persistProductDraft(true));
            }
            if (restoreBtn) {
                restoreBtn.addEventListener('click', () => restoreProductDraft(true));
            }
            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    clearAddProductFormState(true);
                    showAlert('Product form cleared.', 'success');
                });
            }

            ['productName', 'productCategory', 'productPrice', 'productDescription'].forEach((id) => {
                const field = document.getElementById(id);
                if (!field) return;
                field.addEventListener('input', queueProductDraftSave);
                field.addEventListener('change', queueProductDraftSave);
            });

            const sizeSelectorEl = document.getElementById('sizeSelector');
            if (sizeSelectorEl) {
                sizeSelectorEl.addEventListener('click', () => {
                    window.setTimeout(queueProductDraftSave, 0);
                });
            }

            const sizeInventoryEl = document.getElementById('sizeInventoryMatrix');
            if (sizeInventoryEl) {
                sizeInventoryEl.addEventListener('input', queueProductDraftSave);
                sizeInventoryEl.addEventListener('change', queueProductDraftSave);
                sizeInventoryEl.addEventListener('click', () => {
                    window.setTimeout(queueProductDraftSave, 0);
                });
            }

            const hasDraft = Boolean(readProductDraft());
            updateProductDraftStatus(hasDraft ? 'Draft available to restore' : 'Draft autosave ready');
        }

        function normalizeOrderIdentifier(value) {
            const normalized = String(value || '').trim();
            return normalized || '';
        }

        function isSameOrderRecord(a, b) {
            if (!a || !b) return false;

            const aPaymentIntentId = normalizeOrderIdentifier(a.paymentIntentId);
            const bPaymentIntentId = normalizeOrderIdentifier(b.paymentIntentId);
            if (aPaymentIntentId && bPaymentIntentId) {
                return aPaymentIntentId === bPaymentIntentId;
            }

            const aOrderNumber = normalizeOrderIdentifier(a.orderNumber);
            const bOrderNumber = normalizeOrderIdentifier(b.orderNumber);
            if (aOrderNumber && bOrderNumber) {
                return aOrderNumber === bOrderNumber;
            }

            const aInternalId = normalizeOrderIdentifier(a._id || a.id);
            const bInternalId = normalizeOrderIdentifier(b._id || b.id);
            if (aInternalId && bInternalId) {
                return aInternalId === bInternalId;
            }

            return false;
        }

        const ORDER_SKU_LOOKUP_TTL_MS = 10 * 60 * 1000;
        let orderSkuLookupCache = null;
        let orderSkuLookupFetchedAt = 0;
        let orderSkuLookupPromise = null;
        const normalizeOrderSkuLookupName = (value) => String(value || '').trim().toLowerCase();

        async function loadOrderSkuLookup() {
            const now = Date.now();
            if (orderSkuLookupCache && (now - orderSkuLookupFetchedAt) < ORDER_SKU_LOOKUP_TTL_MS) {
                return orderSkuLookupCache;
            }
            if (orderSkuLookupPromise) {
                return orderSkuLookupPromise;
            }

            orderSkuLookupPromise = (async () => {
                const byId = new Map();
                const byName = new Map();
                let productList = Array.isArray(products) && products.length ? products : [];

                if (!productList.length) {
                    try {
                        const response = await fetch(`${API_BASE}/api/products?summary=1`, { cache: 'no-store' });
                        if (response.ok) {
                            const payload = await response.json();
                            if (Array.isArray(payload)) {
                                productList = payload;
                            }
                        }
                    } catch (error) {
                        // SKU lookup fallback only.
                    }
                }

                productList.forEach((product) => {
                    const id = String(product?.id || '').trim();
                    const sku = String(product?.sku || '').trim();
                    const name = String(product?.name || '').trim();
                    const nameKey = normalizeOrderSkuLookupName(name);
                    const record = {
                        id,
                        sku,
                        name,
                        price: Number(product?.price)
                    };
                    if (id) {
                        byId.set(id, record);
                    }
                    if (nameKey) {
                        if (!byName.has(nameKey)) byName.set(nameKey, []);
                        byName.get(nameKey).push(record);
                    }
                });

                orderSkuLookupCache = { byId, byName };
                orderSkuLookupFetchedAt = Date.now();
                return orderSkuLookupCache;
            })().finally(() => {
                orderSkuLookupPromise = null;
            });

            return orderSkuLookupPromise;
        }

        async function enrichOrderItemsWithSku(items, pickNumber) {
            const safeItems = Array.isArray(items) ? items : [];
            const missingSku = safeItems.some((item) => !String(item?.sku || item?.productSku || item?.variantSku || '').trim());
            if (!missingSku) return safeItems;

            const lookup = await loadOrderSkuLookup();
            const byId = lookup?.byId || new Map();
            const byName = lookup?.byName || new Map();

            return safeItems.map((item) => {
                const directSku = String(item?.sku || item?.productSku || item?.variantSku || '').trim();
                if (directSku) return item;

                const directProductId = String(item?.productId || item?.id || '').trim();
                let match = directProductId ? byId.get(directProductId) : null;
                if (!match) {
                    const nameKey = normalizeOrderSkuLookupName(item?.name || '');
                    const nameMatches = nameKey ? (byName.get(nameKey) || []) : [];
                    if (nameMatches.length === 1) {
                        match = nameMatches[0];
                    } else if (nameMatches.length > 1) {
                        const itemPrice = pickNumber(item?.unitPrice, item?.price, item?.amount, item?.total, item?.lineTotal, item?.subtotal);
                        if (Number.isFinite(itemPrice)) {
                            match = nameMatches.find((candidate) => Number.isFinite(candidate?.price) && Math.abs(candidate.price - itemPrice) < 0.01) || null;
                        }
                    }
                }

                if (!match) return item;
                const nextSku = String(match?.sku || '').trim();
                const nextProductId = String(match?.id || directProductId || '').trim();
                return {
                    ...item,
                    sku: nextSku || item.sku || '',
                    productId: nextProductId || item.productId || ''
                };
            });
        }

        function showOrderLoadingOverlay() {
            const detailPage = document.getElementById('orderDetailPage');
            if (!detailPage) return;
            detailPage.innerHTML = `
                <div class="order-detail-shell">
                    <div class="order-detail-top">
                        <button type="button" class="order-detail-back" disabled>Back to orders</button>
                        <span class="order-detail-status">Loading</span>
                    </div>
                    <div class="order-detail-header">
                        <div>
                            <div class="order-detail-eyebrow">Order</div>
                            <div class="order-detail-title">Loading...</div>
                        </div>
                    </div>
                </div>
            `;
            detailPage.classList.add('active');
            detailPage.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        let fxClockIntervalId = null;
        const FX_TAB_MODE_LABELS = {
            orders: 'Orders Console',
            analytics: 'Analytics Console',
            products: 'Products Console',
            'custom-orders': 'Custom Orders Console',
            invoices: 'Invoices Console',
            settings: 'Shipping Console'
        };

        function updateFxClock() {
            const clockEl = document.getElementById('fxAdminClock');
            if (!clockEl) return;
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const ss = String(now.getSeconds()).padStart(2, '0');
            clockEl.textContent = `${hh}:${mm}:${ss}`;
        }

        function startFxClock() {
            if (fxClockIntervalId) return;
            updateFxClock();
            fxClockIntervalId = window.setInterval(updateFxClock, 1000);
        }

        function syncFxAdminMode(tabName) {
            const modeEl = document.getElementById('fxAdminMode');
            if (!modeEl) return;
            modeEl.textContent = FX_TAB_MODE_LABELS[tabName] || 'Admin Console';
        }

        const ADMIN_TAB_BADGE_IDS = {
            orders: 'badgeOrders',
            products: 'badgeProducts',
            'custom-orders': 'badgeCustomOrders',
            invoices: 'badgeInvoices',
            settings: 'badgeShipping'
        };

        function formatAdminBadgeCount(value) {
            const safe = Number.isFinite(Number(value)) ? Math.max(0, Math.round(Number(value))) : 0;
            return safe > 99 ? '99+' : String(safe);
        }

        function setAdminTabBadge(tabName, count) {
            const badgeId = ADMIN_TAB_BADGE_IDS[tabName];
            if (!badgeId) return;
            const badge = document.getElementById(badgeId);
            if (!badge) return;
            const safeCount = Number.isFinite(Number(count)) ? Math.max(0, Math.round(Number(count))) : 0;
            badge.textContent = formatAdminBadgeCount(safeCount);
            badge.dataset.count = String(safeCount);
            badge.classList.toggle('is-empty', safeCount === 0);
        }

        function updateAdminTabBadges() {
            setAdminTabBadge('orders', Array.isArray(orders) ? orders.length : 0);
            setAdminTabBadge('products', Array.isArray(products) ? products.length : 0);
            setAdminTabBadge('custom-orders', Array.isArray(customOrders) ? customOrders.length : 0);
            setAdminTabBadge('invoices', Array.isArray(invoices) ? invoices.length : 0);
            setAdminTabBadge('settings', Array.isArray(shippingRegions) ? shippingRegions.length : 0);
            setAdminTabBadge('analytics', Number(analyticsSnapshot?.summary?.liveCount || 0));
        }

        function formatAnalyticsCount(value) {
            const safe = Number.isFinite(Number(value)) ? Math.max(0, Math.round(Number(value))) : 0;
            return safe.toLocaleString('en-US');
        }

        function formatAnalyticsAgo(value) {
            const timestamp = Date.parse(String(value || ''));
            if (!Number.isFinite(timestamp)) return 'just now';
            const diffMs = Math.max(0, Date.now() - timestamp);
            const diffSec = Math.floor(diffMs / 1000);
            if (diffSec < 60) return 'just now';
            const diffMin = Math.floor(diffSec / 60);
            if (diffMin < 60) return `${diffMin}m ago`;
            const diffHour = Math.floor(diffMin / 60);
            if (diffHour < 24) return `${diffHour}h ago`;
            const diffDay = Math.floor(diffHour / 24);
            return `${diffDay}d ago`;
        }

        function formatAnalyticsDateTime(value) {
            const timestamp = Date.parse(String(value || ''));
            if (!Number.isFinite(timestamp)) return '';
            return new Date(timestamp).toLocaleString('en-GB', {
                day: '2-digit',
                month: 'short',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function normalizeAnalyticsText(value) {
            const raw = String(value || '').trim();
            if (!raw) return '';
            let normalized = raw.replace(/\+/g, '%20');
            for (let i = 0; i < 3; i += 1) {
                try {
                    const decoded = decodeURIComponent(normalized);
                    if (decoded === normalized) break;
                    normalized = decoded;
                } catch (error) {
                    break;
                }
            }
            return normalized;
        }

        function formatAnalyticsLocation(visitor) {
            const country = normalizeAnalyticsText(visitor?.country || visitor?.countryCode || 'Unknown');
            const city = normalizeAnalyticsText(visitor?.city || visitor?.region || '');
            return city ? `${city}, ${country}` : country;
        }

        function buildAnalyticsProductNameIndex() {
            const index = new Map();
            const assign = (idValue, nameValue) => {
                const id = String(idValue || '').trim();
                const name = String(nameValue || '').trim();
                if (!id || !name) return;
                if (!index.has(id)) index.set(id, name);
            };

            if (Array.isArray(products) && products.length) {
                products.forEach((product) => {
                    assign(product?.id, product?.name);
                });
            }

            const cachedById = orderSkuLookupCache?.byId;
            if (cachedById instanceof Map) {
                cachedById.forEach((record, id) => {
                    assign(id, record?.name);
                    assign(record?.id, record?.name);
                });
            }

            return index;
        }

        function describeAnalyticsPage(pageValue, productIndex) {
            const raw = normalizeAnalyticsText(String(pageValue || '/').trim() || '/');
            let path = raw;
            let query = '';

            try {
                const parsed = raw.startsWith('http://') || raw.startsWith('https://')
                    ? new URL(raw)
                    : new URL(raw, window.location.origin);
                path = normalizeAnalyticsText(parsed.pathname || '/');
                query = parsed.search || '';
            } catch (error) {
                const splitIndex = raw.indexOf('?');
                if (splitIndex >= 0) {
                    path = normalizeAnalyticsText(raw.slice(0, splitIndex));
                    query = raw.slice(splitIndex);
                }
            }

            let productId = '';
            const routeMatch = path.match(/\/product\/([^/?#]+)/i);
            if (routeMatch && routeMatch[1]) {
                productId = normalizeAnalyticsText(routeMatch[1]);
            }
            if (!productId) {
                const isProductLanding = /^\/product(?:\.html)?\/?$/i.test(path);
                if (isProductLanding && query) {
                    const params = new URLSearchParams(query.startsWith('?') ? query.slice(1) : query);
                    productId = normalizeAnalyticsText(params.get('id') || '');
                }
            }

            if (productId) {
                let decodedProductId = productId;
                try {
                    decodedProductId = decodeURIComponent(productId);
                } catch (error) {
                    decodedProductId = productId;
                }
                const productName = productIndex.get(productId)
                    || productIndex.get(decodedProductId)
                    || productIndex.get(encodeURIComponent(productId));
                if (productName) {
                    return `Product: ${productName}`;
                }
                return `Product: ${productId}`;
            }

            if (path === '/' || path === '/index.html') {
                return 'Page: Home';
            }

            const cleanPath = path.replace(/\/index\.html$/i, '/').replace(/\/+/g, '/');
            return `Page: ${cleanPath || '/'}`;
        }

        function renderAnalyticsList(containerId, rows, emptyText) {
            const container = document.getElementById(containerId);
            if (!container) return;
            if (!Array.isArray(rows) || !rows.length) {
                container.innerHTML = `<div class="analytics-empty">${escapeHtml(emptyText)}</div>`;
                return;
            }
            container.innerHTML = rows.join('');
        }

        function projectAnalyticsPoint(latDeg, lonDeg, rotationDeg, radius, cx, cy) {
            const latRad = Number(latDeg) * Math.PI / 180;
            const lonRad = (Number(lonDeg) + Number(rotationDeg)) * Math.PI / 180;
            if (!Number.isFinite(latRad) || !Number.isFinite(lonRad)) return null;
            const x = Math.cos(latRad) * Math.sin(lonRad);
            const y = Math.sin(latRad);
            const z = Math.cos(latRad) * Math.cos(lonRad);
            return {
                x: cx + radius * x,
                y: cy - radius * y,
                z
            };
        }

        function analyticsNoise(seed) {
            const value = Math.sin((seed * 12.9898) + 78.233) * 43758.5453;
            return value - Math.floor(value);
        }

        function getAnalyticsGlobeStarField(width, height) {
            const key = `${Math.max(1, width)}x${Math.max(1, height)}`;
            if (analyticsGlobeStarFieldKey === key && Array.isArray(analyticsGlobeStars) && analyticsGlobeStars.length) {
                return analyticsGlobeStars;
            }

            const starCount = Math.max(90, Math.min(220, Math.round((width * height) / 3300)));
            const stars = [];
            for (let i = 0; i < starCount; i += 1) {
                const x = analyticsNoise((i + 1) * 1.173) * width;
                const y = analyticsNoise((i + 1) * 2.913) * height;
                const twinkleSeed = analyticsNoise((i + 1) * 4.667);
                stars.push({
                    x,
                    y,
                    size: 0.45 + (analyticsNoise((i + 1) * 5.127) * 1.05),
                    alpha: 0.16 + (twinkleSeed * 0.34),
                    twinkle: 0.5 + (analyticsNoise((i + 1) * 6.751) * 1.8),
                    phase: analyticsNoise((i + 1) * 7.321) * Math.PI * 2
                });
            }
            analyticsGlobeStars = stars;
            analyticsGlobeStarFieldKey = key;
            return stars;
        }

        const ANALYTICS_LAND_POLYGONS = [
            [
                [-168, 72], [-160, 68], [-152, 64], [-144, 61], [-134, 57], [-126, 51], [-123, 44], [-120, 36],
                [-116, 28], [-108, 22], [-98, 19], [-88, 20], [-82, 24], [-79, 30], [-76, 36], [-70, 44],
                [-64, 52], [-58, 60], [-62, 68], [-74, 73], [-92, 78], [-112, 79], [-132, 78], [-150, 76], [-168, 72]
            ],
            [
                [-73, 60], [-64, 58], [-54, 59], [-44, 63], [-36, 70], [-32, 77], [-40, 82], [-52, 84],
                [-64, 82], [-72, 74], [-73, 60]
            ],
            [
                [-81, 12], [-77, 6], [-75, -2], [-78, -10], [-76, -18], [-72, -28], [-68, -38], [-63, -49],
                [-56, -55], [-48, -53], [-42, -43], [-39, -30], [-39, -17], [-43, -6], [-50, 2], [-60, 8],
                [-70, 11], [-81, 12]
            ],
            [
                [-10, 35], [-8, 42], [-4, 49], [4, 55], [16, 60], [30, 63], [46, 65], [62, 66], [80, 66], [98, 65],
                [114, 61], [128, 57], [142, 53], [156, 54], [170, 60], [176, 67], [170, 73], [154, 75], [134, 74],
                [114, 72], [94, 70], [76, 67], [60, 64], [46, 60], [34, 56], [24, 52], [16, 48], [10, 44], [2, 39], [-6, 36], [-10, 35]
            ],
            [
                [-18, 36], [-9, 34], [3, 33], [14, 31], [24, 26], [31, 19], [36, 10], [39, -2], [37, -14],
                [33, -24], [26, -32], [16, -35], [5, -35], [-5, -31], [-12, -22], [-16, -10], [-17, 3], [-16, 16], [-15, 26], [-18, 36]
            ],
            [
                [34, 32], [45, 31], [56, 28], [66, 24], [74, 18], [80, 10], [85, 16], [84, 24], [77, 30],
                [67, 31], [56, 30], [45, 31], [34, 32]
            ],
            [
                [92, 22], [102, 20], [112, 16], [120, 10], [123, 2], [118, -4], [109, -7], [101, -3], [95, 5], [92, 13], [92, 22]
            ],
            [
                [126, 46], [133, 43], [140, 38], [143, 33], [141, 29], [136, 31], [130, 35], [126, 41], [126, 46]
            ],
            [
                [112, -10], [122, -12], [134, -16], [145, -22], [152, -30], [150, -38], [142, -43], [132, -41],
                [123, -35], [116, -27], [112, -18], [112, -10]
            ],
            [
                [166, -35], [174, -37], [178, -42], [174, -46], [168, -45], [166, -40], [166, -35]
            ],
            [
                [43, -13], [50, -16], [51, -23], [48, -29], [44, -24], [43, -13]
            ]
        ];

        const ANALYTICS_OCEAN_CUTS = [
            [[-88, 18], [-84, 18], [-83, 22], [-86, 24], [-89, 22], [-88, 18]],
            [[-12, 35], [0, 36], [12, 36], [20, 40], [12, 44], [0, 44], [-8, 42], [-12, 35]]
        ];

        function analyticsNormalizeLon(lon) {
            let value = Number(lon);
            while (value > 180) value -= 360;
            while (value < -180) value += 360;
            return value;
        }

        function analyticsPointInPolygon(lat, lon, polygon) {
            const testLat = Number(lat);
            const testLon = analyticsNormalizeLon(lon);
            if (!Number.isFinite(testLat) || !Number.isFinite(testLon) || !Array.isArray(polygon) || polygon.length < 3) {
                return false;
            }
            let inside = false;
            for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i, i += 1) {
                const lonI = analyticsNormalizeLon(polygon[i][0]);
                const latI = Number(polygon[i][1]);
                const lonJ = analyticsNormalizeLon(polygon[j][0]);
                const latJ = Number(polygon[j][1]);
                const intersects = ((latI > testLat) !== (latJ > testLat))
                    && (testLon < ((lonJ - lonI) * (testLat - latI)) / ((latJ - latI) || 1e-9) + lonI);
                if (intersects) inside = !inside;
            }
            return inside;
        }

        function analyticsLandMask(lat, lon) {
            const isLand = ANALYTICS_LAND_POLYGONS.some((polygon) => analyticsPointInPolygon(lat, lon, polygon));
            if (!isLand) return false;
            return !ANALYTICS_OCEAN_CUTS.some((polygon) => analyticsPointInPolygon(lat, lon, polygon));
        }

        function analyticsSeededOffset(lat, lon) {
            const seed = Math.sin(((lat + 90.312) * 12.9898) + ((lon + 180.5) * 78.233)) * 43758.5453;
            const fract = seed - Math.floor(seed);
            const latOffset = (fract - 0.5) * 0.28;
            const lonOffset = (((fract * 1.6180339) % 1) - 0.5) * 0.34;
            return { latOffset, lonOffset };
        }

        function getAnalyticsGlobeBaseDots() {
            if (Array.isArray(analyticsGlobeBaseDots) && analyticsGlobeBaseDots.length) {
                return analyticsGlobeBaseDots;
            }
            const dots = [];
            for (let lat = -80; lat <= 82; lat += 1.85) {
                const lonStep = Math.max(1.9, 2.35 + (Math.abs(lat) * 0.018));
                for (let lon = -180; lon <= 180; lon += lonStep) {
                    if (!analyticsLandMask(lat, lon)) continue;
                    const jitter = analyticsSeededOffset(lat, lon);
                    dots.push({
                        latitude: Math.max(-84, Math.min(84, lat + jitter.latOffset)),
                        longitude: lon + jitter.lonOffset
                    });
                }
            }
            analyticsGlobeBaseDots = dots;
            return dots;
        }

        function renderAnalyticsGlobeFrame() {
            const canvas = document.getElementById('analyticsGlobeCanvas');
            if (!canvas) return;
            const rect = canvas.getBoundingClientRect();
            const width = Math.max(1, Math.floor(rect.width));
            const height = Math.max(1, Math.floor(rect.height));
            if (width < 40 || height < 40) return;

            const dpr = Math.max(1, window.devicePixelRatio || 1);
            const targetWidth = Math.floor(width * dpr);
            const targetHeight = Math.floor(height * dpr);
            if (canvas.width !== targetWidth || canvas.height !== targetHeight) {
                canvas.width = targetWidth;
                canvas.height = targetHeight;
            }

            const ctx = canvas.getContext('2d');
            if (!ctx) return;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            const cx = width / 2;
            const cy = height / 2;
            const radius = Math.max(30, Math.min(width, height) * 0.42);
            const snapshot = analyticsSnapshot && typeof analyticsSnapshot === 'object' ? analyticsSnapshot : {};
            const livePoints = Array.isArray(snapshot?.points?.live) ? snapshot.points.live : [];
            const recentPoints = Array.isArray(snapshot?.points?.recent) ? snapshot.points.recent : [];
            const countryPoints = Array.isArray(snapshot?.points?.countries) ? snapshot.points.countries : [];

            const nowMs = Date.now();
            const stars = getAnalyticsGlobeStarField(width, height);
            ctx.fillStyle = '#04070d';
            ctx.fillRect(0, 0, width, height);
            stars.forEach((star) => {
                const twinkle = 0.72 + (0.28 * Math.sin((nowMs / 700) * star.twinkle + star.phase));
                ctx.globalAlpha = Math.max(0.06, Math.min(0.72, star.alpha * twinkle));
                ctx.fillStyle = '#d9e2f2';
                ctx.beginPath();
                ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                ctx.fill();
            });
            ctx.globalAlpha = 1;

            const haloGradient = ctx.createRadialGradient(
                cx,
                cy,
                radius * 0.42,
                cx,
                cy,
                radius * 1.38
            );
            haloGradient.addColorStop(0, 'rgba(81, 120, 185, 0.24)');
            haloGradient.addColorStop(0.55, 'rgba(63, 89, 130, 0.12)');
            haloGradient.addColorStop(1, 'rgba(35, 46, 68, 0)');
            ctx.fillStyle = haloGradient;
            ctx.beginPath();
            ctx.arc(cx, cy, radius * 1.34, 0, Math.PI * 2);
            ctx.fill();

            const sphereGradient = ctx.createRadialGradient(
                cx - radius * 0.34,
                cy - radius * 0.4,
                radius * 0.08,
                cx,
                cy,
                radius * 1.04
            );
            sphereGradient.addColorStop(0, '#2a3a53');
            sphereGradient.addColorStop(0.48, '#141d2c');
            sphereGradient.addColorStop(1, '#060a12');
            ctx.fillStyle = sphereGradient;
            ctx.beginPath();
            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
            ctx.fill();

            const sphereSheen = ctx.createRadialGradient(
                cx - radius * 0.45,
                cy - radius * 0.5,
                1,
                cx - radius * 0.45,
                cy - radius * 0.5,
                radius * 0.95
            );
            sphereSheen.addColorStop(0, 'rgba(210, 230, 255, 0.28)');
            sphereSheen.addColorStop(0.4, 'rgba(130, 170, 235, 0.12)');
            sphereSheen.addColorStop(1, 'rgba(74, 96, 138, 0)');
            ctx.fillStyle = sphereSheen;
            ctx.beginPath();
            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
            ctx.fill();

            ctx.lineWidth = 1.25;
            ctx.strokeStyle = '#5f769f';
            ctx.beginPath();
            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
            ctx.stroke();

            const strokeProjectedCurve = (samples, strokeStyle, lineWidth = 1, dash = []) => {
                ctx.save();
                ctx.strokeStyle = strokeStyle;
                ctx.lineWidth = lineWidth;
                ctx.setLineDash(dash);
                let drawing = false;
                ctx.beginPath();
                for (let i = 0; i < samples.length; i += 1) {
                    const p = samples[i];
                    if (!p || p.z < -0.02) {
                        if (drawing) {
                            ctx.stroke();
                            ctx.beginPath();
                            drawing = false;
                        }
                        continue;
                    }
                    if (!drawing) {
                        ctx.moveTo(p.x, p.y);
                        drawing = true;
                    } else {
                        ctx.lineTo(p.x, p.y);
                    }
                }
                if (drawing) ctx.stroke();
                ctx.restore();
            };

            for (let lon = -150; lon <= 180; lon += 30) {
                const curve = [];
                for (let lat = -90; lat <= 90; lat += 3) {
                    curve.push(projectAnalyticsPoint(lat, lon, analyticsGlobeRotation, radius, cx, cy));
                }
                strokeProjectedCurve(curve, 'rgba(120, 153, 208, 0.2)', 0.7);
            }
            for (let lat = -60; lat <= 60; lat += 20) {
                const curve = [];
                for (let lon = -180; lon <= 180; lon += 3) {
                    curve.push(projectAnalyticsPoint(lat, lon, analyticsGlobeRotation, radius, cx, cy));
                }
                strokeProjectedCurve(curve, 'rgba(104, 136, 186, 0.16)', 0.65, [2, 3]);
            }

            const scanYProgress = ((analyticsGlobeRotation * 2.05 + 96) % 360) / 360;
            const scanY = (cy - radius) + (scanYProgress * radius * 2);
            ctx.save();
            ctx.beginPath();
            ctx.arc(cx, cy, radius * 0.995, 0, Math.PI * 2);
            ctx.clip();

            const horizontalScan = ctx.createLinearGradient(cx, scanY - 32, cx, scanY + 32);
            horizontalScan.addColorStop(0, 'rgba(74, 138, 255, 0)');
            horizontalScan.addColorStop(0.45, 'rgba(120, 193, 255, 0.16)');
            horizontalScan.addColorStop(0.52, 'rgba(183, 226, 255, 0.28)');
            horizontalScan.addColorStop(0.6, 'rgba(120, 193, 255, 0.16)');
            horizontalScan.addColorStop(1, 'rgba(74, 138, 255, 0)');
            ctx.fillStyle = horizontalScan;
            ctx.fillRect(cx - radius, cy - radius, radius * 2, radius * 2);

            ctx.restore();

            const drawPoint = (point, fillStyle, size, alphaBase, outline = false, glow = false) => {
                const lat = Number(point?.latitude);
                const lon = Number(point?.longitude);
                if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;
                const p = projectAnalyticsPoint(lat, lon, analyticsGlobeRotation, radius, cx, cy);
                if (!p || p.z < -0.02) return;
                const alpha = Math.max(0.15, Math.min(1, alphaBase * (p.z + 0.32)));
                ctx.globalAlpha = alpha;
                ctx.fillStyle = fillStyle;
                if (glow) {
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = fillStyle;
                } else {
                    ctx.shadowBlur = 0;
                }
                ctx.beginPath();
                ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
                ctx.fill();
                if (outline) {
                    ctx.lineWidth = 0.9;
                    ctx.strokeStyle = '#ffffff';
                    ctx.stroke();
                }
                ctx.shadowBlur = 0;
                ctx.globalAlpha = 1;
            };

            const baseDots = getAnalyticsGlobeBaseDots();
            baseDots.forEach((point) => drawPoint(point, '#93a7c7', 0.56, 0.6, false));
            countryPoints.forEach((point) => {
                const count = Number(point?.count || 0);
                const size = Math.max(0.8, Math.min(2.05, 0.92 + (Math.log10(Math.max(1, count + 1)) * 0.54)));
                drawPoint(point, '#b7c7e1', size, 0.86, false);
            });
            recentPoints.forEach((point) => drawPoint(point, '#8ea6cc', 0.96, 0.9, false));
            livePoints.forEach((point, index) => {
                const pulse = 0.7 + (0.3 * Math.sin((nowMs / 320) + (index * 0.75)));
                drawPoint(point, '#31e57f', 1.35 + (pulse * 0.9), 1, true, true);
            });
        }

        function runAnalyticsGlobeLoop() {
            const analyticsTab = document.getElementById('analytics');
            if (!analyticsTab || !analyticsTab.classList.contains('active') || !document.body.classList.contains('admin-analytics-view')) {
                analyticsGlobeFrameId = null;
                return;
            }
            analyticsGlobeRotation = (analyticsGlobeRotation + 0.095) % 360;
            renderAnalyticsGlobeFrame();
            analyticsGlobeFrameId = window.requestAnimationFrame(runAnalyticsGlobeLoop);
        }

        function startAnalyticsGlobe() {
            if (analyticsGlobeFrameId) return;
            if (!analyticsGlobeResizeBound) {
                analyticsGlobeResizeBound = true;
                window.addEventListener('resize', () => {
                    if (document.body.classList.contains('admin-analytics-view')) {
                        renderAnalyticsGlobeFrame();
                    }
                }, { passive: true });
            }
            analyticsGlobeFrameId = window.requestAnimationFrame(runAnalyticsGlobeLoop);
        }

        function stopAnalyticsGlobe() {
            if (!analyticsGlobeFrameId) return;
            window.cancelAnimationFrame(analyticsGlobeFrameId);
            analyticsGlobeFrameId = null;
        }

        function startAnalyticsAutoRefresh() {
            if (analyticsRefreshTimer) return;
            analyticsRefreshTimer = window.setInterval(() => {
                if (!document.body.classList.contains('admin-analytics-view')) return;
                loadAnalyticsDashboard({ silent: true });
            }, 30000);
        }

        function stopAnalyticsAutoRefresh() {
            if (analyticsRefreshTimer) {
                window.clearInterval(analyticsRefreshTimer);
                analyticsRefreshTimer = null;
            }
            stopAnalyticsGlobe();
        }

        function renderAnalyticsDashboard(snapshot) {
            const safeSnapshot = snapshot && typeof snapshot === 'object' ? snapshot : {};
            const summary = safeSnapshot.summary && typeof safeSnapshot.summary === 'object' ? safeSnapshot.summary : {};
            const liveVisitors = Array.isArray(safeSnapshot.liveVisitors) ? safeSnapshot.liveVisitors : [];
            const recentVisitors = Array.isArray(safeSnapshot.recentVisitors) ? safeSnapshot.recentVisitors : [];

            if (!orderSkuLookupCache) {
                loadOrderSkuLookup()
                    .then(() => {
                        if (analyticsSnapshot && document.body.classList.contains('admin-analytics-view')) {
                            renderAnalyticsDashboard(analyticsSnapshot);
                        }
                    })
                    .catch(() => {
                        // Optional enrichment only.
                    });
            }

            const analyticsProductIndex = buildAnalyticsProductNameIndex();

            const liveCountEl = document.getElementById('analyticsLiveCount');
            const recentCountEl = document.getElementById('analyticsRecentCount');
            const cityCountEl = document.getElementById('analyticsCityCount');
            const updatedEl = document.getElementById('analyticsUpdatedAt');

            if (liveCountEl) liveCountEl.textContent = formatAnalyticsCount(summary.liveCount);
            if (recentCountEl) recentCountEl.textContent = formatAnalyticsCount(summary.recent24hCount);
            if (cityCountEl) cityCountEl.textContent = formatAnalyticsCount(summary.citiesCount);
            if (updatedEl) {
                const updatedLabel = safeSnapshot.generatedAt ? formatAnalyticsAgo(safeSnapshot.generatedAt) : 'just now';
                updatedEl.textContent = `Updated ${updatedLabel}`;
            }

            const normalizedLiveVisitors = liveVisitors
                .slice(0, 200)
                .map((visitor, index) => {
                    const backendNumber = Number(visitor?.visitorNumber);
                    const visitorNumber = Number.isFinite(backendNumber) && backendNumber > 0
                        ? Math.round(backendNumber)
                        : index + 1;
                    return {
                        ...visitor,
                        __visitorNumber: visitorNumber
                    };
                })
                .sort((a, b) => {
                    const numberDiff = Number(a.__visitorNumber || 0) - Number(b.__visitorNumber || 0);
                    if (numberDiff !== 0) return numberDiff;
                    return Date.parse(String(b?.lastSeenAt || '')) - Date.parse(String(a?.lastSeenAt || ''));
                });

            const liveRows = normalizedLiveVisitors.slice(0, 40).map((visitor) => {
                const visitorLabel = `Visitor ${visitor.__visitorNumber}`;
                const location = formatAnalyticsLocation(visitor);
                const page = normalizeAnalyticsText(String(visitor?.page || '/').trim() || '/');
                const pageLabel = describeAnalyticsPage(page, analyticsProductIndex);
                return `
                    <div class="analytics-live-row">
                        <div class="analytics-live-main">
                            <div class="analytics-live-head">
                                <span class="analytics-live-dot" aria-hidden="true"></span>
                                <div class="analytics-visitor-number">${escapeHtml(visitorLabel)}</div>
                                <div class="analytics-visitor-location">${escapeHtml(location)}</div>
                            </div>
                            <div class="analytics-visitor-page">${escapeHtml(pageLabel)}</div>
                        </div>
                    </div>
                `;
            });
            renderAnalyticsList('analyticsLiveList', liveRows, 'No live visitors right now.');

            const recentRows = recentVisitors.slice(0, 60).map((visitor) => {
                const location = formatAnalyticsLocation(visitor);
                const timestamp = formatAnalyticsDateTime(visitor?.lastSeenAt);
                const page = normalizeAnalyticsText(String(visitor?.page || '/').trim() || '/');
                const pageLabel = describeAnalyticsPage(page, analyticsProductIndex);
                return `
                    <div class="analytics-list-row">
                        <div class="analytics-list-main">
                            <div class="analytics-list-title">${escapeHtml(location)}</div>
                            <div class="analytics-list-subtitle">${escapeHtml(pageLabel)}</div>
                        </div>
                        <div class="analytics-list-meta">${escapeHtml(timestamp || formatAnalyticsAgo(visitor?.lastSeenAt))}</div>
                    </div>
                `;
            });
            renderAnalyticsList('analyticsRecentList', recentRows, 'No visitor activity in the last 24 hours.');

            startAnalyticsGlobe();
        }

        async function loadAnalyticsDashboard(options = {}) {
            const silent = Boolean(options?.silent);
            try {
                const response = await adminFetch(`${ADMIN_ANALYTICS_API}?t=${Date.now()}`, { cache: 'no-store' });
                if (!response.ok) {
                    throw new Error(`analytics_${response.status}`);
                }
                const payload = await response.json();
                analyticsSnapshot = payload && typeof payload === 'object' ? payload : {};
                renderAnalyticsDashboard(analyticsSnapshot);
                startAnalyticsAutoRefresh();
                updateAdminTabBadges();
            } catch (error) {
                if (!silent) {
                    showAlert('Unable to load analytics right now. Please refresh and try again.', 'error');
                }
                if (!analyticsSnapshot) {
                    renderAnalyticsDashboard({});
                }
            }
        }

        function resolveEventTargetElement(event) {
            const rawTarget = event?.target;
            if (rawTarget instanceof Element) return rawTarget;
            if (rawTarget && rawTarget.parentElement instanceof Element) return rawTarget.parentElement;
            return null;
        }

        function releaseOrderDetailLock() {
            document.body.style.overflow = '';
            document.documentElement.classList.remove('order-deeplink');
            const detailPage = document.getElementById('orderDetailPage');
            if (detailPage) {
                detailPage.classList.remove('active');
                detailPage.classList.remove('editing');
                detailPage.setAttribute('aria-hidden', 'true');
                if (detailPage.__closeCleanupTimer) {
                    window.clearTimeout(detailPage.__closeCleanupTimer);
                    detailPage.__closeCleanupTimer = null;
                }
                detailPage.innerHTML = '';
            }
            const url = new URL(window.location.href);
            if (url.searchParams.has('order')) {
                url.searchParams.delete('order');
                history.replaceState({}, '', url);
            }
        }

        // Tab switching
        function switchTab(tabName, evt) {
            if (tabName !== 'orders') {
                releaseOrderDetailLock();
            }
            if (tabName !== 'analytics') {
                stopAnalyticsAutoRefresh();
            }
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.body.classList.toggle('admin-orders-view', tabName === 'orders');
            document.body.classList.toggle('admin-analytics-view', tabName === 'analytics');
            document.body.classList.toggle('admin-invoices-view', tabName === 'invoices');
            document.body.classList.toggle('admin-custom-orders-view', tabName === 'custom-orders');
            document.body.classList.toggle('admin-products-view', tabName === 'products');
            document.body.classList.toggle('admin-settings-view', tabName === 'settings');
            
            document.getElementById(tabName).classList.add('active');
            let activeBtn = null;
            if (evt && evt.target) {
                activeBtn = evt.currentTarget || (evt.target.closest ? evt.target.closest('.tab-btn') : null);
                if (activeBtn) activeBtn.classList.add('active');
            } else {
                const btn = document.querySelector(`.tab-btn[data-tab="${tabName}"]`);
                if (btn) {
                    btn.classList.add('active');
                    activeBtn = btn;
                }
            }
            const menuHintEl = document.getElementById('adminMenuHint');
            if (menuHintEl && activeBtn && activeBtn.dataset.tabHint) {
                menuHintEl.textContent = activeBtn.dataset.tabHint;
            }
            syncFxAdminMode(tabName);
            if (tabName !== 'products') {
                clearProductViewParamsFromUrl();
            }
            safeStorageSet(localStorage, 'adminActiveTab', tabName);
            updateAdminTabBadges();

            if (tabName === 'products') {
                const renderSurfaces = !(isAddProductView && document.body.classList.contains('admin-add-product-view'));
                loadProducts({ silent: isAddProductView, renderSurfaces });
            }
            if (tabName === 'orders') {
                bindOrdersToolbarControls();
                loadOrders();
                window.requestAnimationFrame(enforceOrdersTextBlack);
            }
            if (tabName === 'analytics') loadAnalyticsDashboard();
            if (tabName === 'invoices') loadInvoices();
            if (tabName === 'custom-orders') loadCustomOrders();
            if (tabName === 'settings') loadShippingRegionsSettings();
            clearAdminPanelInlineColorLocks();
            window.requestAnimationFrame(enforceAdminPanelTextBlack);
        }

        document.addEventListener('DOMContentLoaded', () => {
            try {
            const tabsContainer = document.querySelector('.admin-guided-tabs');
            if (tabsContainer && !tabsContainer.dataset.bound) {
                tabsContainer.dataset.bound = 'true';
                let adminTabPointerHandled = false;
                tabsContainer.querySelectorAll('.tab-btn[data-tab]').forEach((tabBtn) => {
                    tabBtn.setAttribute('type', 'button');
                });
                tabsContainer.addEventListener('pointerdown', (event) => {
                    if (event.button !== 0) return;
                    if (event.pointerType && event.pointerType !== 'mouse') return;
                    const targetEl = resolveEventTargetElement(event);
                    const tabBtn = targetEl?.closest('.tab-btn[data-tab]');
                    if (!tabBtn) return;
                    adminTabPointerHandled = true;
                    event.preventDefault();
                    switchTab(tabBtn.dataset.tab, { currentTarget: tabBtn, target: targetEl });
                });
                tabsContainer.addEventListener('click', (event) => {
                    const targetEl = resolveEventTargetElement(event);
                    const tabBtn = targetEl?.closest('.tab-btn[data-tab]');
                    if (!tabBtn) return;
                    if (adminTabPointerHandled) {
                        adminTabPointerHandled = false;
                        return;
                    }
                    event.preventDefault();
                    switchTab(tabBtn.dataset.tab, { currentTarget: tabBtn, target: targetEl });
                });
                tabsContainer.addEventListener('keydown', (event) => {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    const targetEl = resolveEventTargetElement(event);
                    const tabBtn = targetEl?.closest('.tab-btn[data-tab]');
                    if (!tabBtn) return;
                    event.preventDefault();
                    switchTab(tabBtn.dataset.tab, { currentTarget: tabBtn, target: targetEl });
                });
            }
            const quickActions = document.getElementById('adminQuickActions');
            if (quickActions && !quickActions.dataset.bound) {
                quickActions.dataset.bound = 'true';
                quickActions.addEventListener('click', (event) => {
                    const targetEl = resolveEventTargetElement(event);
                    const actionBtn = targetEl?.closest('.admin-quick-btn[data-admin-action]');
                    if (!actionBtn) return;
                    event.preventDefault();
                    const action = String(actionBtn.dataset.adminAction || '').trim();
                    if (action === 'refresh-orders') {
                        if (document.getElementById('orders')?.classList.contains('active')) {
                            loadOrders();
                        } else {
                            switchTab('orders');
                        }
                        return;
                    }
                    if (action === 'new-product') {
                        safeStorageSet(localStorage, 'adminActiveTab', 'products');
                        window.location.href = 'admin.html?view=add-product';
                        return;
                    }
                    if (action === 'new-invoice') {
                        switchTab('invoices');
                        window.setTimeout(() => {
                            if (typeof resetInvoiceForm === 'function') {
                                resetInvoiceForm();
                            }
                            document.getElementById('invoiceClientName')?.focus();
                        }, 90);
                    }
                });
            }
            updateAdminTabBadges();

            const shippingActions = [
                ['addShippingRegionBtn', addShippingRegionRow],
                ['saveShippingRegionsBtn', saveShippingRegions]
            ];
            shippingActions.forEach(([id, handler]) => {
                const element = document.getElementById(id);
                if (!element || element.dataset.bound) return;
                element.dataset.bound = 'true';
                element.addEventListener('click', handler);
            });

            const shippingTable = document.getElementById('shippingRegionsTable');
            if (shippingTable && !shippingTable.dataset.bound) {
                shippingTable.dataset.bound = 'true';
                shippingTable.addEventListener('click', (event) => {
                    const removeBtn = event.target.closest('.shipping-remove-btn[data-region-index]');
                    if (removeBtn) {
                        const index = Number(removeBtn.getAttribute('data-region-index'));
                        if (Number.isFinite(index)) removeShippingRegion(index);
                        return;
                    }
                    const toggleBtn = event.target.closest('.shipping-group-toggle[data-group-key]');
                    if (toggleBtn) {
                        const groupKey = String(toggleBtn.getAttribute('data-group-key') || '').trim();
                        if (groupKey) toggleShippingGroup(groupKey);
                    }
                });
            }

            const ordersTableEl = document.getElementById('ordersTable');
            if (ordersTableEl && !ordersTableEl.dataset.bound) {
                ordersTableEl.dataset.bound = 'true';
                ordersTableEl.addEventListener('click', (event) => {
                    const row = event.target.closest('tr.order-row[data-order-id]');
                    if (!row) return;
                    const orderId = String(row.getAttribute('data-order-id') || '').trim();
                    if (!orderId) return;
                    viewOrder(orderId);
                });
                ordersTableEl.addEventListener('keydown', (event) => {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    const row = event.target.closest('tr.order-row[data-order-id]');
                    if (!row) return;
                    event.preventDefault();
                    const orderId = String(row.getAttribute('data-order-id') || '').trim();
                    if (!orderId) return;
                    viewOrder(orderId);
                });
            }

            const authReady = !(window.ghoharyAuth && typeof window.ghoharyAuth.isAuthenticated === 'function')
                || window.ghoharyAuth.isAuthenticated();
            if (!authReady) {
                return;
            }
            startFxClock();
            bindOrdersColorObserver();

            const productSubnavTitle = document.getElementById('productSubnavTitle');
            const url = new URL(window.location.href);
            const viewMode = url.searchParams.get('view');
            const editParam = url.searchParams.get('edit');
            const orderParam = url.searchParams.get('order');
            if (!orderParam) {
                document.body.style.overflow = '';
                document.documentElement.classList.remove('order-deeplink');
            }
            const allowedAdminTabs = new Set(['orders', 'analytics', 'invoices', 'custom-orders', 'products', 'settings']);
            const storedTab = safeStorageGet(localStorage, 'adminActiveTab', '');
            const savedTab = allowedAdminTabs.has(storedTab) ? storedTab : 'orders';
            const orderSearchInput = document.getElementById('orderSearchInput');
            const productSearchInput = document.getElementById('productSearchInput');
            const runOrderSearch = debounce(() => {
                renderOrdersTable();
            }, 120);
            if (orderSearchInput) {
                orderSearchInput.value = orderSearchTerm;
                orderSearchInput.addEventListener('input', () => {
                    orderSearchTerm = orderSearchInput.value.trim().toLowerCase();
                    runOrderSearch();
                });
            }

            const applyProductSearch = debounce(() => {
                productSearchTerm = String(productSearchInput?.value || '').trim().toLowerCase();
                renderProductsTable();
            }, 100);

            if (productSearchInput) {
                productSearchInput.value = productSearchTerm;
                productSearchInput.addEventListener('input', applyProductSearch);
                productSearchInput.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        applyProductSearch();
                    }
                });
            }
            bindOrdersToolbarControls();
            bindProductsToolbarControls();
            window.requestAnimationFrame(() => {
                clearAdminPanelInlineColorLocks();
                enforceAdminPanelTextBlack();
                if (savedTab === 'orders' || orderParam) {
                    enforceOrdersTextBlack();
                }
            });
            const shouldOpenAddProductView = viewMode === 'add-product';
            if (shouldOpenAddProductView) {
                isAddProductView = true;
                document.body.classList.add('admin-add-product-view');
                safeStorageSet(localStorage, 'adminActiveTab', 'products');
                pendingEditProductId = editParam ? String(editParam) : null;
                if (pendingEditProductId) {
                    sessionStorage.setItem(EDITING_PRODUCT_KEY, pendingEditProductId);
                } else {
                    sessionStorage.removeItem(EDITING_PRODUCT_KEY);
                }
                if (productSubnavTitle) {
                    productSubnavTitle.textContent = pendingEditProductId ? 'Edit Product' : 'Add New Product';
                }
                switchTab('products');
                if (!pendingEditProductId) {
                    const form = document.getElementById('productForm');
                    if (form) {
                        form.reset();
                        form.dataset.editingProductId = '';
                        sessionStorage.removeItem(EDITING_PRODUCT_KEY);
                        resetBaseSizeButtons();
                        imageFiles = [];
                        imageAltTexts = [];
                        videoFiles = [];
                        if (imagePreviewContainer) {
                            imagePreviewContainer.innerHTML = '';
                        }
                        if (videoPreviewContainer) {
                            videoPreviewContainer.innerHTML = '';
                        }
                        const submitBtn = getProductSubmitButton();
                        if (submitBtn && submitBtn.dataset.originalText) {
                            submitBtn.textContent = submitBtn.dataset.originalText;
                        } else if (submitBtn) {
                            submitBtn.textContent = 'Add Product';
                        }
                        updateSelectedSizesDisplay();
                    }
                }
                initAddProductWorkspace();
                if (!pendingEditProductId) {
                    restoreProductDraft(false);
                }
                updateProductComposerIndicators();
                return;
            }

            if (productSubnavTitle) {
                productSubnavTitle.textContent = 'All Products';
            }

            if (orderParam) {
                pendingOrderOpen = orderParam;
                showOrderLoadingOverlay();
            }
            switchTab(orderParam ? 'orders' : savedTab);
            updateProductComposerIndicators();
            } catch (bootError) {
                console.error('[Admin] Boot error:', bootError);
                const fallbackMessage = document.getElementById('alertContainer');
                if (fallbackMessage) {
                    fallbackMessage.innerHTML = '<div class="alert error" role="alert">Admin failed to initialize. Please refresh this page.</div>';
                }
            }
        });

        // Alert helper
        function showAlert(message, type = 'success') {
            const container = document.getElementById('alertContainer');
            if (!container) return;

            container.innerHTML = '';
            const overlay = document.createElement('div');
            overlay.className = 'alert-overlay';

            const alert = document.createElement('div');
            alert.className = `alert ${type}`;
            alert.setAttribute('role', 'alert');
            const closeBtn = document.createElement('button');
            closeBtn.className = 'alert-close';
            closeBtn.type = 'button';
            closeBtn.setAttribute('aria-label', 'Close alert');
            closeBtn.textContent = '';

            const headerEl = document.createElement('div');
            headerEl.className = 'alert-header';

            const iconEl = document.createElement('span');
            iconEl.className = 'alert-icon';
            iconEl.innerHTML = type === 'success'
                ? '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10.4l3.5 3.6 7.5-7.8" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                : '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4.2v6.7" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><circle cx="10" cy="14.7" r="1.1" fill="currentColor"/></svg>';

            const titleEl = document.createElement('span');
            titleEl.className = 'alert-title';
            titleEl.textContent = type === 'success' ? 'Success' : 'Notice';

            const messageEl = document.createElement('span');
            messageEl.className = 'alert-message';
            messageEl.textContent = String(message || '');

            alert.appendChild(closeBtn);
            headerEl.appendChild(iconEl);
            headerEl.appendChild(titleEl);
            alert.appendChild(headerEl);
            alert.appendChild(messageEl);

            const dismiss = () => {
                overlay.remove();
            };

            overlay.addEventListener('click', (event) => {
                if (event.target === overlay) dismiss();
            });

            closeBtn.addEventListener('click', dismiss);

            overlay.appendChild(alert);
            container.appendChild(overlay);
            setTimeout(dismiss, 3800);
        }

        // ===== INVOICES =====
        const INVOICE_KEY = 'ghoharyInvoices';

        const INVOICE_STATUS_LABELS = {
            draft: 'Draft',
            unpaid: 'Unpaid',
            partially_paid: 'Partially Paid',
            paid: 'Paid',
            overdue: 'Overdue'
        };

        const INVOICE_STATUS_SORT_ORDER = {
            overdue: 0,
            unpaid: 1,
            partially_paid: 2,
            draft: 3,
            paid: 4
        };

        const normalizeInvoiceControlsState = () => {
            if (!INVOICE_QUICK_FILTER_OPTIONS.has(invoiceQuickFilter)) {
                invoiceQuickFilter = 'all';
            }
            if (!INVOICE_SORT_OPTIONS.has(invoiceSortMode)) {
                invoiceSortMode = 'newest';
            }
        };

        const persistInvoiceControlsState = () => {
            localStorage.setItem(INVOICE_QUICK_FILTER_STORAGE_KEY, invoiceQuickFilter);
            localStorage.setItem(INVOICE_SORT_STORAGE_KEY, invoiceSortMode);
        };

        const formatInvoiceStatusLabel = (status) => (
            INVOICE_STATUS_LABELS[String(status || '').toLowerCase()] || 'Draft'
        );

        const isInvoiceOverdue = (invoice) => {
            const status = String(invoice?.status || '').toLowerCase();
            if (status === 'paid') return false;
            const dueDate = String(invoice?.dueDate || '').trim();
            if (!dueDate) return false;
            const due = Date.parse(`${dueDate}T23:59:59`);
            if (!Number.isFinite(due)) return false;
            return Date.now() > due;
        };

        const normalizeInvoiceStatusForUi = (invoice) => {
            const status = String(invoice?.status || 'draft').toLowerCase();
            if (isInvoiceOverdue(invoice) && status !== 'paid') return 'overdue';
            return status || 'draft';
        };

        const formatInvoiceDate = (value) => {
            const time = Date.parse(String(value || ''));
            if (!Number.isFinite(time)) return '--';
            return new Date(time).toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        };

        const invoiceSortTimestamp = (invoice) => {
            const updated = Date.parse(String(invoice?.updatedAt || ''));
            if (Number.isFinite(updated)) return updated;
            const created = Date.parse(String(invoice?.createdAt || ''));
            if (Number.isFinite(created)) return created;
            return 0;
        };

        const invoiceDueTimestamp = (invoice) => {
            const due = Date.parse(String(invoice?.dueDate || ''));
            if (Number.isFinite(due)) return due;
            return Number.POSITIVE_INFINITY;
        };

        const formatInvoiceMoney = (value, currency = 'AED') => {
            const safeValue = Number.isFinite(Number(value)) ? Number(value) : 0;
            const safeCurrency = String(currency || 'AED').toUpperCase();
            return `${safeCurrency} ${safeValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        };

        const setInvoiceEditorMode = (mode = 'new', invoiceNumber = '') => {
            const modeEl = document.getElementById('invoiceEditorMode');
            if (!modeEl) return;
            if (mode === 'edit' && invoiceNumber) {
                modeEl.textContent = `Editing ${invoiceNumber}`;
                return;
            }
            modeEl.textContent = 'New invoice';
        };

        const updateInvoiceItemLineTotals = (currency = 'AED') => {
            document.querySelectorAll('#invoiceItems .invoice-item').forEach((row) => {
                const qty = parseFloat(row.querySelector('.invoice-item-qty')?.value || '0');
                const unitPrice = parseFloat(row.querySelector('.invoice-item-price')?.value || '0');
                const total = (Number.isFinite(qty) ? qty : 0) * (Number.isFinite(unitPrice) ? unitPrice : 0);
                const totalEl = row.querySelector('.invoice-item-line-total');
                if (totalEl) {
                    totalEl.textContent = formatInvoiceMoney(total, currency);
                }
            });
        };

        const updateInvoiceDashboardStats = () => {
            const stats = {
                total: invoices.length,
                open: 0,
                paid: 0,
                overdue: 0,
                dueAmount: 0
            };

            invoices.forEach((invoice) => {
                const status = normalizeInvoiceStatusForUi(invoice);
                const total = Number(invoice?.total || 0);
                if (status === 'paid') {
                    stats.paid += 1;
                } else {
                    stats.open += 1;
                    stats.dueAmount += Number.isFinite(total) ? total : 0;
                }
                if (status === 'overdue') {
                    stats.overdue += 1;
                }
            });

            const totalEl = document.getElementById('invoiceStatTotal');
            const openEl = document.getElementById('invoiceStatOpen');
            const paidEl = document.getElementById('invoiceStatPaid');
            const overdueEl = document.getElementById('invoiceStatOverdue');
            const dueAmountEl = document.getElementById('invoiceStatDueAmount');
            if (totalEl) totalEl.textContent = String(stats.total);
            if (openEl) openEl.textContent = String(stats.open);
            if (paidEl) paidEl.textContent = String(stats.paid);
            if (overdueEl) overdueEl.textContent = String(stats.overdue);
            if (dueAmountEl) dueAmountEl.textContent = formatInvoiceMoney(stats.dueAmount, 'AED');
        };

        const updateInvoiceResultsMeta = (filteredCount = 0) => {
            const metaEl = document.getElementById('invoiceResultsMeta');
            if (!metaEl) return;
            if (!invoices.length) {
                metaEl.textContent = 'No invoices in library';
                return;
            }
            metaEl.textContent = `Showing ${filteredCount} of ${invoices.length} invoices`;
        };

        const syncInvoiceDashboardControlState = () => {
            normalizeInvoiceControlsState();
            document.querySelectorAll('#invoices .invoice-quick-filter[data-invoice-quick-filter]').forEach((button) => {
                const filter = String(button.getAttribute('data-invoice-quick-filter') || '').trim();
                const isActive = filter === invoiceQuickFilter;
                button.classList.toggle('active', isActive);
                button.setAttribute('aria-selected', isActive ? 'true' : 'false');
                button.setAttribute('role', 'tab');
                button.setAttribute('tabindex', isActive ? '0' : '-1');
            });
            const sortSelect = document.getElementById('invoiceSortMode');
            if (sortSelect) {
                sortSelect.value = INVOICE_SORT_OPTIONS.has(invoiceSortMode) ? invoiceSortMode : 'newest';
            }
        };

        const filterInvoicesForList = (collection) => {
            const term = (document.getElementById('invoiceSearch')?.value || '').toLowerCase();
            const statusFilter = document.getElementById('invoiceStatusFilter')?.value || '';
            const currencyFilter = (document.getElementById('invoiceCurrencyFilter')?.value || '').toUpperCase();

            const filtered = (Array.isArray(collection) ? collection : []).filter((invoice) => {
                const normalizedStatus = normalizeInvoiceStatusForUi(invoice);
                const rawStatus = String(invoice?.status || '').toLowerCase();
                const invoiceCurrency = String(invoice?.currency || '').toUpperCase();
                const matchesTerm = !term || `${invoice?.number || ''} ${invoice?.client?.name || ''} ${invoice?.client?.email || ''}`.toLowerCase().includes(term);
                const matchesStatus = !statusFilter || (statusFilter === 'overdue'
                    ? normalizedStatus === 'overdue'
                    : rawStatus === statusFilter);
                const matchesCurrency = !currencyFilter || invoiceCurrency === currencyFilter;
                let matchesQuickFilter = true;
                if (invoiceQuickFilter === 'open') {
                    matchesQuickFilter = normalizedStatus !== 'paid';
                } else if (invoiceQuickFilter === 'paid') {
                    matchesQuickFilter = normalizedStatus === 'paid';
                } else if (invoiceQuickFilter === 'draft') {
                    matchesQuickFilter = normalizedStatus === 'draft';
                } else if (invoiceQuickFilter === 'overdue') {
                    matchesQuickFilter = normalizedStatus === 'overdue';
                }
                return matchesTerm && matchesStatus && matchesCurrency && matchesQuickFilter;
            });

            return filtered.sort((a, b) => {
                if (invoiceSortMode === 'oldest') {
                    return invoiceSortTimestamp(a) - invoiceSortTimestamp(b);
                }
                if (invoiceSortMode === 'amount-high') {
                    return Number(b?.total || 0) - Number(a?.total || 0);
                }
                if (invoiceSortMode === 'amount-low') {
                    return Number(a?.total || 0) - Number(b?.total || 0);
                }
                if (invoiceSortMode === 'client-asc') {
                    return String(a?.client?.name || '').toLowerCase().localeCompare(String(b?.client?.name || '').toLowerCase());
                }
                if (invoiceSortMode === 'client-desc') {
                    return String(b?.client?.name || '').toLowerCase().localeCompare(String(a?.client?.name || '').toLowerCase());
                }
                if (invoiceSortMode === 'due-soon') {
                    return invoiceDueTimestamp(a) - invoiceDueTimestamp(b);
                }
                if (invoiceSortMode === 'status') {
                    const aStatus = normalizeInvoiceStatusForUi(a);
                    const bStatus = normalizeInvoiceStatusForUi(b);
                    const aRank = Number.isFinite(INVOICE_STATUS_SORT_ORDER[aStatus]) ? INVOICE_STATUS_SORT_ORDER[aStatus] : 99;
                    const bRank = Number.isFinite(INVOICE_STATUS_SORT_ORDER[bStatus]) ? INVOICE_STATUS_SORT_ORDER[bStatus] : 99;
                    if (aRank !== bRank) return aRank - bRank;
                }
                return invoiceSortTimestamp(b) - invoiceSortTimestamp(a);
            });
        };

        const bindInvoiceDashboardControls = () => {
            if (invoiceControlsBound) {
                syncInvoiceDashboardControlState();
                return;
            }
            invoiceControlsBound = true;
            syncInvoiceDashboardControlState();

            const commandSurface = document.getElementById('invoiceCommandSurface');
            if (commandSurface) {
                commandSurface.addEventListener('click', (event) => {
                    const filterBtn = event.target.closest('.invoice-quick-filter[data-invoice-quick-filter]');
                    if (!filterBtn) return;
                    const nextFilter = String(filterBtn.getAttribute('data-invoice-quick-filter') || '').trim();
                    if (!INVOICE_QUICK_FILTER_OPTIONS.has(nextFilter) || nextFilter === invoiceQuickFilter) return;
                    invoiceQuickFilter = nextFilter;
                    persistInvoiceControlsState();
                    syncInvoiceDashboardControlState();
                    renderInvoiceList();
                });
            }

            const sortSelect = document.getElementById('invoiceSortMode');
            if (sortSelect) {
                sortSelect.addEventListener('change', () => {
                    const nextSort = String(sortSelect.value || '').trim();
                    invoiceSortMode = INVOICE_SORT_OPTIONS.has(nextSort) ? nextSort : 'newest';
                    persistInvoiceControlsState();
                    syncInvoiceDashboardControlState();
                    renderInvoiceList();
                });
            }

            document.getElementById('invoiceCreateNewBtn')?.addEventListener('click', () => {
                resetInvoiceForm();
                const numberField = document.getElementById('invoiceNumber');
                if (numberField && !numberField.value.trim()) {
                    numberField.value = generateInvoiceNumber();
                }
                document.getElementById('invoiceClientName')?.focus();
            });

            document.getElementById('invoiceGenerateNumberBtn')?.addEventListener('click', () => {
                const numberField = document.getElementById('invoiceNumber');
                if (!numberField) return;
                numberField.value = generateInvoiceNumber();
                numberField.focus();
                numberField.select();
            });

            document.addEventListener('keydown', (event) => {
                if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
                const activeTab = document.querySelector('.tab-content.active');
                if (!activeTab || activeTab.id !== 'invoices') return;
                const target = event.target;
                const tagName = target && target.tagName ? String(target.tagName).toLowerCase() : '';
                if (tagName === 'input' || tagName === 'textarea' || tagName === 'select' || target?.isContentEditable) {
                    return;
                }
                const searchInput = document.getElementById('invoiceSearch');
                if (!searchInput) return;
                event.preventDefault();
                searchInput.focus();
                searchInput.select();
            }, { passive: false });
        };

        const invoiceItemTemplate = (item = {}) => `
            <div class="invoice-item">
                <input type="text" class="invoice-item-name" placeholder="Item name" value="${escapeHtml(item.name || '')}">
                <input type="number" class="invoice-item-qty" min="1" step="1" placeholder="Qty" value="${escapeHtml(item.quantity || 1)}">
                <input type="number" class="invoice-item-price" min="0" step="0.01" placeholder="Unit price" value="${escapeHtml(item.unitPrice || '')}">
                <div class="invoice-item-line-total">AED 0.00</div>
                <button type="button" class="btn-small invoice-item-remove">Remove</button>
            </div>
        `;

        const getInvoiceItems = () => {
            return Array.from(document.querySelectorAll('#invoiceItems .invoice-item')).map(row => {
                return {
                    name: row.querySelector('.invoice-item-name')?.value.trim() || '',
                    quantity: parseInt(row.querySelector('.invoice-item-qty')?.value || '1', 10),
                    unitPrice: parseFloat(row.querySelector('.invoice-item-price')?.value || '0')
                };
            }).filter(item => item.name);
        };

        const computeInvoiceTotals = () => {
            const items = getInvoiceItems();
            const subtotal = items.reduce((sum, item) => sum + (item.quantity * item.unitPrice), 0);
            const tax = parseFloat(document.getElementById('invoiceTax')?.value || '0');
            const shipping = parseFloat(document.getElementById('invoiceShipping')?.value || '0');
            const discount = parseFloat(document.getElementById('invoiceDiscount')?.value || '0');
            const total = subtotal + tax + shipping - discount;
            return { subtotal, tax, shipping, discount, total };
        };

        const updateInvoiceTotals = () => {
            const totals = computeInvoiceTotals();
            const currency = (document.getElementById('invoiceCurrency')?.value || 'AED').toUpperCase();
            const totalsEl = document.getElementById('invoiceTotals');
            if (!totalsEl) return;
            totalsEl.innerHTML = `
                <div class="invoice-total-row"><span>Subtotal</span><span>${currency} ${totals.subtotal.toFixed(2)}</span></div>
                <div class="invoice-total-row"><span>Tax</span><span>${currency} ${totals.tax.toFixed(2)}</span></div>
                <div class="invoice-total-row"><span>Shipping</span><span>${currency} ${totals.shipping.toFixed(2)}</span></div>
                <div class="invoice-total-row"><span>Discount</span><span>${currency} ${totals.discount.toFixed(2)}</span></div>
                <div class="invoice-total-row"><strong>Total</strong><strong>${currency} ${totals.total.toFixed(2)}</strong></div>
            `;
            updateInvoiceItemLineTotals(currency);
        };

        const generateInvoiceNumber = () => {
            const now = new Date();
            const year = now.getFullYear();
            let maxSerial = 0;
            invoices.forEach((invoice) => {
                const match = String(invoice?.number || '').match(new RegExp(`^INV-${year}-(\\d+)$`));
                if (!match) return;
                const serial = Number.parseInt(match[1], 10);
                if (Number.isFinite(serial)) {
                    maxSerial = Math.max(maxSerial, serial);
                }
            });
            const nextSerial = String(maxSerial + 1).padStart(4, '0');
            return `INV-${year}-${nextSerial}`;
        };

        const resetInvoiceForm = () => {
            invoiceEditingId = null;
            document.getElementById('invoiceNumber').value = '';
            const today = new Date();
            const due = new Date(today);
            due.setDate(due.getDate() + 7);
            document.getElementById('invoiceIssueDate').value = today.toISOString().slice(0, 10);
            document.getElementById('invoiceDueDate').value = due.toISOString().slice(0, 10);
            document.getElementById('invoiceStatus').value = 'draft';
            document.getElementById('invoiceCountry').value = '';
            document.getElementById('invoiceCurrency').value = 'AED';
            document.getElementById('invoiceClientName').value = '';
            document.getElementById('invoiceClientEmail').value = '';
            document.getElementById('invoiceClientPhone').value = '';
            document.getElementById('invoiceBillingAddress').value = '';
            document.getElementById('invoiceShippingAddress').value = '';
            document.getElementById('invoiceTax').value = '';
            document.getElementById('invoiceShipping').value = '';
            document.getElementById('invoiceDiscount').value = '';
            document.getElementById('invoiceNotes').value = '';
            document.getElementById('invoiceItems').innerHTML = invoiceItemTemplate();
            setInvoiceEditorMode('new');
            updateInvoiceTotals();
        };

        const parseLocalInvoices = () => {
            try {
                const parsed = JSON.parse(localStorage.getItem(INVOICE_KEY) || '[]');
                return Array.isArray(parsed) ? parsed : [];
            } catch (error) {
                return [];
            }
        };

        const mergeInvoices = (...collections) => {
            const mergedMap = new Map();
            collections
                .flat()
                .forEach((invoice) => {
                    if (!invoice || typeof invoice !== 'object') return;
                    const id = String(invoice.id || '').trim();
                    if (!id) return;
                    const existing = mergedMap.get(id);
                    if (!existing) {
                        mergedMap.set(id, invoice);
                        return;
                    }
                    const currentTime = new Date(invoice.updatedAt || invoice.createdAt || 0).getTime();
                    const existingTime = new Date(existing.updatedAt || existing.createdAt || 0).getTime();
                    if (currentTime >= existingTime) {
                        mergedMap.set(id, invoice);
                    }
                });
            return Array.from(mergedMap.values()).sort((a, b) => {
                const aTime = new Date(a.updatedAt || a.createdAt || 0).getTime();
                const bTime = new Date(b.updatedAt || b.createdAt || 0).getTime();
                return bTime - aTime;
            });
        };

        const persistInvoices = async ({ silent = true } = {}) => {
            localStorage.setItem(INVOICE_KEY, JSON.stringify(invoices));
            try {
                const response = await adminFetch(INVOICE_API, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ invoices })
                });
                if (!response.ok) {
                    throw new Error(`Sync failed (${response.status})`);
                }
                const payload = await response.json().catch(() => ({}));
                if (Array.isArray(payload?.invoices)) {
                    invoices = payload.invoices;
                    localStorage.setItem(INVOICE_KEY, JSON.stringify(invoices));
                }
                return true;
            } catch (error) {
                if (!silent) {
                    showAlert('Invoices saved locally, but cloud sync failed.', 'error');
                }
                return false;
            }
        };

        const renderInvoiceList = () => {
            const listEl = document.getElementById('invoiceList');
            updateAdminTabBadges();
            if (!listEl) return;
            normalizeInvoiceControlsState();
            syncInvoiceDashboardControlState();
            updateInvoiceDashboardStats();
            const filtered = filterInvoicesForList(invoices);
            updateInvoiceResultsMeta(filtered.length);
            if (!filtered.length) {
                listEl.innerHTML = `<p class="invoice-list-empty">${invoices.length ? 'No invoices match current filters.' : 'No invoices yet.'}</p>`;
                return;
            }
            listEl.innerHTML = filtered.map((invoice) => {
                const normalizedStatus = normalizeInvoiceStatusForUi(invoice);
                const statusLabel = formatInvoiceStatusLabel(normalizedStatus);
                const clientName = invoice?.client?.name || 'Client';
                const currency = String(invoice?.currency || 'AED').toUpperCase();
                const total = Number(invoice?.total || 0);
                const issueDateLabel = formatInvoiceDate(invoice?.issueDate);
                const dueDateLabel = formatInvoiceDate(invoice?.dueDate);
                const actionPaymentButton = normalizedStatus === 'paid'
                    ? '<button type="button" class="btn-small invoice-mark-unpaid">Mark unpaid</button>'
                    : '<button type="button" class="btn-small invoice-mark-paid">Mark paid</button>';
                return `
                    <div class="invoice-list-item" data-id="${escapeHtml(invoice?.id)}" tabindex="0" role="button" aria-label="${escapeHtml(`Open invoice ${invoice?.number || ''}`)}">
                        <div class="invoice-list-item-main">
                            <div class="invoice-list-item-top">
                                <span class="invoice-list-number">${escapeHtml(invoice?.number || 'Invoice')}</span>
                                <span class="invoice-status-pill status-${escapeHtml(normalizedStatus)}">${escapeHtml(statusLabel)}</span>
                            </div>
                            <div class="invoice-list-client">${escapeHtml(clientName)}</div>
                            <div class="invoice-list-meta">Issued ${escapeHtml(issueDateLabel)} • Due ${escapeHtml(dueDateLabel)}</div>
                        </div>
                        <div class="invoice-list-amount">
                            <span class="invoice-list-total">${escapeHtml(Number.isFinite(total) ? total.toFixed(2) : '0.00')}</span>
                            <span class="invoice-list-currency">${escapeHtml(currency)}</span>
                        </div>
                        <div class="invoice-list-actions">
                            <button type="button" class="btn-small invoice-edit">Edit</button>
                            <button type="button" class="btn-small invoice-duplicate">Duplicate</button>
                            ${actionPaymentButton}
                            <button type="button" class="btn-small invoice-print">PDF / Print</button>
                            <button type="button" class="btn-small invoice-email">Email</button>
                            <button type="button" class="btn-small invoice-delete">Delete</button>
                        </div>
                    </div>
                `;
            }).join('');
        };

        const loadInvoices = async () => {
            if (authFailureHandled) {
                invoices = [];
                renderInvoiceList();
                return;
            }
            const localInvoices = parseLocalInvoices();
            let remoteInvoices = null;
            try {
                const response = await adminFetch(INVOICE_API, { cache: 'no-store' });
                if (response.ok) {
                    const payload = await response.json().catch(() => ({}));
                    if (Array.isArray(payload?.invoices)) {
                        remoteInvoices = payload.invoices;
                    } else if (Array.isArray(payload)) {
                        remoteInvoices = payload;
                    }
                }
            } catch (error) {
                remoteInvoices = null;
            }

            if (Array.isArray(remoteInvoices)) {
                invoices = mergeInvoices(remoteInvoices, localInvoices);
                if (invoices.length > remoteInvoices.length) {
                    persistInvoices({ silent: true });
                }
            } else {
                invoices = localInvoices;
            }
            localStorage.setItem(INVOICE_KEY, JSON.stringify(invoices));
            renderInvoiceList();
        };

        const saveInvoice = (asDraft = false) => {
            const numberField = document.getElementById('invoiceNumber');
            if (!numberField.value.trim()) {
                numberField.value = generateInvoiceNumber();
            }
            const issueDateField = document.getElementById('invoiceIssueDate');
            const dueDateField = document.getElementById('invoiceDueDate');
            if (!issueDateField.value) {
                issueDateField.value = new Date().toISOString().slice(0, 10);
            }
            if (!dueDateField.value) {
                const fallbackDue = new Date(issueDateField.value || Date.now());
                fallbackDue.setDate(fallbackDue.getDate() + 7);
                dueDateField.value = fallbackDue.toISOString().slice(0, 10);
            }
            const totals = computeInvoiceTotals();
            const invoice = {
                id: invoiceEditingId || `inv_${Date.now()}`,
                number: numberField.value.trim(),
                issueDate: issueDateField.value,
                dueDate: dueDateField.value,
                status: asDraft ? 'draft' : document.getElementById('invoiceStatus').value,
                country: document.getElementById('invoiceCountry').value.trim(),
                currency: (document.getElementById('invoiceCurrency').value || 'AED').toUpperCase(),
                client: {
                    name: document.getElementById('invoiceClientName').value.trim(),
                    email: document.getElementById('invoiceClientEmail').value.trim(),
                    phone: document.getElementById('invoiceClientPhone').value.trim()
                },
                billingAddress: document.getElementById('invoiceBillingAddress').value.trim(),
                shippingAddress: document.getElementById('invoiceShippingAddress').value.trim(),
                items: getInvoiceItems(),
                subtotal: totals.subtotal,
                tax: totals.tax,
                shipping: totals.shipping,
                discount: totals.discount,
                total: totals.total,
                notes: document.getElementById('invoiceNotes').value.trim(),
                createdAt: invoiceEditingId ? undefined : new Date().toISOString(),
                updatedAt: new Date().toISOString()
            };

            if (!invoice.items.length) {
                showAlert('Add at least one item.', 'error');
                return;
            }

            if (!invoice.client.name) {
                showAlert('Client name is required.', 'error');
                return;
            }

            const existingIndex = invoices.findIndex(item => item.id === invoice.id);
            if (existingIndex >= 0) {
                invoices[existingIndex] = { ...invoices[existingIndex], ...invoice };
            } else {
                invoices.unshift(invoice);
            }

            invoiceEditingId = invoice.id;
            setInvoiceEditorMode('edit', invoice.number);
            persistInvoices({ silent: false });
            renderInvoiceList();
            showAlert(asDraft ? 'Draft saved.' : 'Invoice saved.', 'success');
        };

        const loadInvoiceIntoForm = (invoice) => {
            invoiceEditingId = invoice.id;
            document.getElementById('invoiceNumber').value = invoice.number || '';
            document.getElementById('invoiceIssueDate').value = invoice.issueDate || '';
            document.getElementById('invoiceDueDate').value = invoice.dueDate || '';
            document.getElementById('invoiceStatus').value = invoice.status || 'draft';
            document.getElementById('invoiceCountry').value = invoice.country || '';
            document.getElementById('invoiceCurrency').value = invoice.currency || 'AED';
            document.getElementById('invoiceClientName').value = invoice.client?.name || '';
            document.getElementById('invoiceClientEmail').value = invoice.client?.email || '';
            document.getElementById('invoiceClientPhone').value = invoice.client?.phone || '';
            document.getElementById('invoiceBillingAddress').value = invoice.billingAddress || '';
            document.getElementById('invoiceShippingAddress').value = invoice.shippingAddress || '';
            document.getElementById('invoiceTax').value = invoice.tax ?? '';
            document.getElementById('invoiceShipping').value = invoice.shipping ?? '';
            document.getElementById('invoiceDiscount').value = invoice.discount ?? '';
            document.getElementById('invoiceNotes').value = invoice.notes || '';
            document.getElementById('invoiceItems').innerHTML = invoice.items.map(item => invoiceItemTemplate(item)).join('') || invoiceItemTemplate();
            setInvoiceEditorMode('edit', invoice.number || '');
            updateInvoiceTotals();
        };

        const duplicateInvoice = (invoice) => {
            if (!invoice || typeof invoice !== 'object') return;
            const duplicatedInvoice = {
                ...invoice,
                id: `inv_${Date.now()}`,
                number: generateInvoiceNumber(),
                status: 'draft',
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString()
            };
            invoices.unshift(duplicatedInvoice);
            persistInvoices({ silent: false });
            renderInvoiceList();
            loadInvoiceIntoForm(duplicatedInvoice);
            showAlert('Invoice duplicated as draft.', 'success');
        };

        const openInvoicePrint = (invoice) => {
            const win = window.open('', '_blank');
            if (!win) return;
            const currency = escapeHtml(invoice.currency || 'AED');
            const itemsMarkup = invoice.items.map(item => `
                <tr>
                    <td style="padding:8px 0;">${escapeHtml(item.name)}</td>
                    <td style="padding:8px 0; text-align:right;">${escapeHtml(item.quantity)}</td>
                    <td style="padding:8px 0; text-align:right;">${currency} ${escapeHtml(Number(item.unitPrice).toFixed(2))}</td>
                </tr>
            `).join('');
            win.document.write(`
                <html>
                    <head>
                        <title>${escapeHtml(invoice.number)}</title>
                        <style>
                            body { font-family: Helvetica, Arial, sans-serif; padding: 32px; color:#111; }
                            h1 { font-size: 20px; font-weight: 400; }
                            table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                            th { text-align: left; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid #ddd; padding-bottom: 8px; }
                            td { font-size: 13px; }
                        </style>
                    </head>
                    <body>
                        <h1>Invoice ${escapeHtml(invoice.number)}</h1>
                        <p>Issue date: ${escapeHtml(invoice.issueDate || '')}</p>
                        <p>Client: ${escapeHtml(invoice.client?.name || '')}</p>
                        <p>${escapeHtml(invoice.billingAddress || '')}</p>
                        <table>
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th style="text-align:right;">Qty</th>
                                    <th style="text-align:right;">Unit price</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${itemsMarkup}
                            </tbody>
                        </table>
                        <p style="margin-top:20px;">Total: ${currency} ${escapeHtml(Number(invoice.total || 0).toFixed(2))}</p>
                    </body>
                </html>
            `);
            win.document.close();
            win.focus();
            win.print();
        };

        document.addEventListener('DOMContentLoaded', () => {
            bindInvoiceDashboardControls();
            const invoiceItems = document.getElementById('invoiceItems');
            if (invoiceItems) {
                invoiceItems.innerHTML = invoiceItemTemplate();
                invoiceItems.addEventListener('input', updateInvoiceTotals);
                invoiceItems.addEventListener('click', (event) => {
                    if (event.target.classList.contains('invoice-item-remove')) {
                        event.target.closest('.invoice-item')?.remove();
                        updateInvoiceTotals();
                    }
                });
            }

            document.getElementById('addInvoiceItem')?.addEventListener('click', () => {
                if (!invoiceItems) return;
                invoiceItems.insertAdjacentHTML('beforeend', invoiceItemTemplate());
                updateInvoiceTotals();
            });

            ['invoiceTax', 'invoiceShipping', 'invoiceDiscount', 'invoiceCurrency'].forEach(id => {
                document.getElementById(id)?.addEventListener('input', updateInvoiceTotals);
            });

            const invoiceIssueDateEl = document.getElementById('invoiceIssueDate');
            const invoiceDueDateEl = document.getElementById('invoiceDueDate');
            if (invoiceIssueDateEl && invoiceDueDateEl) {
                invoiceIssueDateEl.addEventListener('change', () => {
                    const issueTs = Date.parse(invoiceIssueDateEl.value || '');
                    const dueTs = Date.parse(invoiceDueDateEl.value || '');
                    if (!Number.isFinite(issueTs)) return;
                    if (Number.isFinite(dueTs) && dueTs >= issueTs) return;
                    const due = new Date(issueTs);
                    due.setDate(due.getDate() + 7);
                    invoiceDueDateEl.value = due.toISOString().slice(0, 10);
                });
            }

            document.getElementById('saveInvoiceDraft')?.addEventListener('click', () => saveInvoice(true));
            document.getElementById('saveInvoice')?.addEventListener('click', () => saveInvoice(false));
            document.getElementById('resetInvoiceForm')?.addEventListener('click', resetInvoiceForm);

            document.getElementById('invoiceSearch')?.addEventListener('input', renderInvoiceList);
            document.getElementById('invoiceStatusFilter')?.addEventListener('change', renderInvoiceList);
            document.getElementById('invoiceCurrencyFilter')?.addEventListener('input', renderInvoiceList);

            const invoiceListEl = document.getElementById('invoiceList');
            invoiceListEl?.addEventListener('click', (event) => {
                const item = event.target.closest('.invoice-list-item[data-id]');
                if (!item) return;
                const invoice = invoices.find(inv => inv.id === item.dataset.id);
                if (!invoice) return;
                const clickedActionButton = event.target.closest('.invoice-list-actions .btn-small');
                if (!clickedActionButton) {
                    loadInvoiceIntoForm(invoice);
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-edit')) {
                    loadInvoiceIntoForm(invoice);
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-duplicate')) {
                    duplicateInvoice(invoice);
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-mark-paid')) {
                    invoice.status = 'paid';
                    invoice.updatedAt = new Date().toISOString();
                    persistInvoices({ silent: false });
                    renderInvoiceList();
                    showAlert('Invoice marked as paid.', 'success');
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-mark-unpaid')) {
                    invoice.status = 'unpaid';
                    invoice.updatedAt = new Date().toISOString();
                    persistInvoices({ silent: false });
                    renderInvoiceList();
                    showAlert('Invoice marked as unpaid.', 'success');
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-print')) {
                    openInvoicePrint(invoice);
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-email')) {
                    const subject = encodeURIComponent(`Invoice ${invoice.number}`);
                    const body = encodeURIComponent(`Invoice ${invoice.number}\nTotal: ${invoice.currency} ${Number(invoice.total || 0).toFixed(2)}`);
                    window.location.href = `mailto:${invoice.client?.email || ''}?subject=${subject}&body=${body}`;
                    return;
                }
                if (clickedActionButton.classList.contains('invoice-delete')) {
                    invoices = invoices.filter(inv => inv.id !== invoice.id);
                    persistInvoices({ silent: false });
                    renderInvoiceList();
                    showAlert('Invoice deleted.', 'success');
                }
            });

            invoiceListEl?.addEventListener('keydown', (event) => {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                const item = event.target.closest('.invoice-list-item[data-id]');
                if (!item || event.target.closest('.invoice-list-actions')) return;
                event.preventDefault();
                const invoice = invoices.find(inv => inv.id === item.dataset.id);
                if (invoice) {
                    loadInvoiceIntoForm(invoice);
                }
            });

            resetInvoiceForm();
        });

        // ===== CUSTOM ORDERS =====
        const CUSTOM_ORDER_KEY = 'ghoharyCustomOrders';
        const LEGACY_CUSTOM_ORDER_KEYS = [
            'ghoharyCustomOrders',
            'ghoharyCustomOrder',
            'ghoharyCustomOrdersV2',
            'ghCustomOrders',
            'ghoharyCustomerOrders',
            'ghohary_custom_orders',
            'ghohary-custom-orders',
            'customOrders',
            'custom_orders',
            'custom-orders'
        ];
        const CUSTOM_ORDER_DB = 'ghoharyCustomOrdersDB';
        const CUSTOM_ORDER_STORE = 'images';
        let customOrderImageBlob = null;
        let customOrderImageKey = '';
        let customOrderImageName = '';
        let customOrderImagePreviewUrl = '';
        let customOrdersSyncTimer = null;

        const openCustomOrderDB = () => new Promise((resolve, reject) => {
            const request = indexedDB.open(CUSTOM_ORDER_DB, 1);
            request.onupgradeneeded = () => {
                const db = request.result;
                if (!db.objectStoreNames.contains(CUSTOM_ORDER_STORE)) {
                    db.createObjectStore(CUSTOM_ORDER_STORE, { keyPath: 'id' });
                }
            };
            request.onsuccess = () => resolve(request.result);
            request.onerror = () => reject(request.error);
        });

        const saveCustomOrderImage = async (blob) => {
            const db = await openCustomOrderDB();
            const id = (crypto.randomUUID && crypto.randomUUID()) || `img_${Date.now()}`;
            return new Promise((resolve, reject) => {
                const tx = db.transaction(CUSTOM_ORDER_STORE, 'readwrite');
                tx.objectStore(CUSTOM_ORDER_STORE).put({ id, blob });
                tx.oncomplete = () => resolve(id);
                tx.onerror = () => reject(tx.error);
            });
        };

        const getCustomOrderImage = async (id) => {
            if (!id) return null;
            const db = await openCustomOrderDB();
            return new Promise((resolve) => {
                const tx = db.transaction(CUSTOM_ORDER_STORE, 'readonly');
                const request = tx.objectStore(CUSTOM_ORDER_STORE).get(id);
                request.onsuccess = () => resolve(request.result?.blob || null);
                request.onerror = () => resolve(null);
            });
        };

        const deleteCustomOrderImage = async (id) => {
            if (!id) return;
            const db = await openCustomOrderDB();
            return new Promise((resolve) => {
                const tx = db.transaction(CUSTOM_ORDER_STORE, 'readwrite');
                tx.objectStore(CUSTOM_ORDER_STORE).delete(id);
                tx.oncomplete = () => resolve();
                tx.onerror = () => resolve();
            });
        };

        const dataUrlToBlob = async (dataUrl) => {
            const response = await fetch(dataUrl);
            return response.blob();
        };

        const parseCustomOrdersPayload = (raw) => {
            if (!raw) return [];
            let parsed = raw;
            if (typeof raw === 'string') {
                try {
                    parsed = JSON.parse(raw);
                } catch (error) {
                    return [];
                }
            }
            if (Array.isArray(parsed)) return parsed;
            if (Array.isArray(parsed?.orders)) return parsed.orders;
            if (Array.isArray(parsed?.data)) return parsed.data;
            return [];
        };

        const customOrderIdentity = (order) => {
            const id = String(order?.id || '').trim();
            if (id) return `id:${id}`;
            const fallback = [
                String(order?.client?.name || '').trim().toLowerCase(),
                String(order?.client?.phone || '').trim().toLowerCase(),
                String(order?.product?.name || '').trim().toLowerCase(),
                String(order?.order?.orderDate || '').trim(),
                String(order?.order?.expectedDeliveryDate || '').trim()
            ].join('|');
            return `f:${fallback}`;
        };

        const toTimestamp = (order) => {
            const value = new Date(order?.updatedAt || order?.createdAt || 0).getTime();
            return Number.isFinite(value) ? value : 0;
        };

        const mergeCustomOrders = (...collections) => {
            const mergedMap = new Map();
            collections.forEach((collection) => {
                (Array.isArray(collection) ? collection : []).forEach((order) => {
                    if (!order || typeof order !== 'object') return;
                    if (!order.client || !order.product) return;
                    const key = customOrderIdentity(order);
                    const existing = mergedMap.get(key);
                    if (!existing || toTimestamp(order) >= toTimestamp(existing)) {
                        mergedMap.set(key, order);
                    }
                });
            });
            return Array.from(mergedMap.values()).sort((a, b) => toTimestamp(b) - toTimestamp(a));
        };

        const collectLegacyCustomOrders = () => {
            const collected = [];
            LEGACY_CUSTOM_ORDER_KEYS.forEach((key) => {
                try {
                    collected.push(...parseCustomOrdersPayload(localStorage.getItem(key)));
                } catch (error) {
                    // ignore key read errors
                }
                try {
                    collected.push(...parseCustomOrdersPayload(sessionStorage.getItem(key)));
                } catch (error) {
                    // ignore key read errors
                }
            });
            try {
                const legacyOrders = parseCustomOrdersPayload(localStorage.getItem('ghoharyOrders'));
                const customLike = legacyOrders.filter((order) => order?.client && order?.product && order?.measurements);
                collected.push(...customLike);
            } catch (error) {
                // ignore
            }
            return mergeCustomOrders(collected);
        };

        const parseLocalCustomOrders = () => {
            try {
                return collectLegacyCustomOrders();
            } catch (error) {
                return [];
            }
        };

        const syncCustomOrdersToApi = async ({ silent = false } = {}) => {
            try {
                const response = await adminFetch(CUSTOM_ORDERS_API, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ orders: customOrders })
                });
                if (!response.ok) {
                    throw new Error(`Sync failed (${response.status})`);
                }
                const payload = await response.json().catch(() => ({}));
                if (Array.isArray(payload?.orders)) {
                    customOrders = payload.orders;
                    localStorage.setItem(CUSTOM_ORDER_KEY, JSON.stringify(customOrders));
                }
                return true;
            } catch (error) {
                if (!silent) {
                    showAlert('Custom orders saved locally, but cloud sync failed.', 'error');
                }
                return false;
            }
        };

        const queueCustomOrdersSync = () => {
            if (customOrdersSyncTimer) {
                clearTimeout(customOrdersSyncTimer);
            }
            customOrdersSyncTimer = setTimeout(() => {
                customOrdersSyncTimer = null;
                syncCustomOrdersToApi({ silent: true });
            }, 220);
        };

        const updateCustomPayment = () => {
            const total = parseFloat(document.getElementById('customTotalAmount')?.value || '0');
            const advance = parseFloat(document.getElementById('customAdvancePaid')?.value || '0');
            const balance = Math.max(total - advance, 0);
            const statusEl = document.getElementById('customPaymentStatus');
            const balanceEl = document.getElementById('customBalance');
            const advanceLabel = document.getElementById('customAdvanceLabel');
            let status = 'unpaid';
            if (advance > 0 && advance < total) status = 'partially_paid';
            if (total > 0 && advance >= total) status = 'fully_paid';
            if (balanceEl) balanceEl.value = balance.toFixed(2);
            if (statusEl && !customStatusLocked) statusEl.value = status;
            if (advanceLabel) {
                advanceLabel.textContent = (total > 0 && advance >= total) ? 'Full payment' : 'Advance paid';
            }
        };

        const persistCustomOrders = () => {
            try {
                localStorage.setItem(CUSTOM_ORDER_KEY, JSON.stringify(customOrders));
                return true;
            } catch (error) {
                if (error?.name === 'QuotaExceededError') {
                    showAlert('Storage full. Images are stored separately; remove older orders if needed.', 'error');
                } else {
                    showAlert('Unable to save custom orders.', 'error');
                }
                return false;
            }
        };

        const resetCustomOrderForm = () => {
            customOrderEditingId = null;
            customOrderImageBlob = null;
            customOrderImageKey = '';
            customOrderImageName = '';
            if (customOrderImagePreviewUrl) {
                URL.revokeObjectURL(customOrderImagePreviewUrl);
                customOrderImagePreviewUrl = '';
            }
            customStatusLocked = false;
            document.getElementById('customClientName').value = '';
            document.getElementById('customClientTitle').value = 'Mr';
            document.getElementById('customClientPhoneCode').value = '';
            document.getElementById('customClientPhone').value = '';
            document.getElementById('customProductName').value = '';
            document.getElementById('customColorNumber').value = '';
            document.getElementById('customReferenceImage').value = '';
            document.getElementById('customChest').value = '';
            document.getElementById('customWaist').value = '';
            document.getElementById('customHip').value = '';
            document.getElementById('customHeight').value = '';
            document.getElementById('customShoulder').value = '';
            document.getElementById('customSleeves').value = '';
            document.getElementById('customOrderDate').value = '';
            document.getElementById('customDeliveryDate').value = '';
            document.getElementById('customTotalAmount').value = '';
            document.getElementById('customAdvancePaid').value = '';
            document.getElementById('customBalance').value = '';
            document.getElementById('customPaymentStatus').value = 'unpaid';
            const preview = document.getElementById('customReferencePreview');
            if (preview) {
                preview.src = '';
                preview.hidden = true;
            }
            updateCustomPayment();
        };

        const loadCustomOrders = async () => {
            if (authFailureHandled) {
                customOrders = [];
                renderCustomOrderList();
                return;
            }
            const localOrders = parseLocalCustomOrders();
            let remoteOrders = null;

            try {
                const response = await adminFetch(CUSTOM_ORDERS_API, { cache: 'no-store' });
                if (response.ok) {
                    const payload = await response.json().catch(() => ({}));
                    if (Array.isArray(payload?.orders)) {
                        remoteOrders = payload.orders;
                    } else if (Array.isArray(payload)) {
                        remoteOrders = payload;
                    }
                }
            } catch (error) {
                remoteOrders = null;
            }

            if (Array.isArray(remoteOrders) && remoteOrders.length) {
                customOrders = mergeCustomOrders(remoteOrders, localOrders);
                if (customOrders.length > remoteOrders.length) {
                    queueCustomOrdersSync();
                }
            } else if (localOrders.length) {
                customOrders = localOrders;
                queueCustomOrdersSync();
            } else {
                customOrders = Array.isArray(remoteOrders) ? remoteOrders : [];
            }

            try {
                localStorage.setItem(CUSTOM_ORDER_KEY, JSON.stringify(customOrders));
            } catch (error) {
                // Ignore cache write failures here; local persistence already handled elsewhere.
            }
            renderCustomOrderList();
            await migrateCustomOrderImages();
        };

        const migrateCustomOrderImages = async () => {
            let updated = false;
            for (const order of customOrders) {
                const imageData = order.product?.image;
                if (imageData && !order.product.imageKey) {
                    try {
                        const blob = await dataUrlToBlob(imageData);
                        const key = await saveCustomOrderImage(blob);
                        order.product.imageKey = key;
                        order.product.imageName = order.product.imageName || 'reference';
                        delete order.product.image;
                        updated = true;
                    } catch (error) {
                        // ignore migration errors
                    }
                }
            }
            if (updated) {
                const saved = persistCustomOrders();
                if (saved) queueCustomOrdersSync();
            }
        };

        const renderCustomOrderList = () => {
            const listEl = document.getElementById('customOrderList');
            updateAdminTabBadges();
            if (!listEl) return;
            const term = (document.getElementById('customOrderSearch')?.value || '').toLowerCase();
            const statusFilter = document.getElementById('customOrderStatusFilter')?.value || '';
            const deliveryFilter = document.getElementById('customOrderDeliveryFilter')?.value || '';
            const filtered = customOrders.filter(order => {
                const clientText = `${order.client?.name || ''} ${order.client?.phone || ''}`.toLowerCase();
                const matchesTerm = !term || clientText.includes(term);
                const matchesStatus = !statusFilter || (order.payment?.status || '') === statusFilter;
                const matchesDelivery = !deliveryFilter || (order.order?.expectedDeliveryDate || '') === deliveryFilter;
                return matchesTerm && matchesStatus && matchesDelivery;
            });
            if (!filtered.length) {
                listEl.innerHTML = '<p style="color:#999;">No custom orders yet.</p>';
                return;
            }
            listEl.innerHTML = filtered.map(order => {
                const statusLabel = (order.payment?.status || 'unpaid').replace('_', ' ');
                const clientTitle = order.client?.title ? `${order.client.title} ` : '';
                const clientName = order.client?.name || 'Client';
                const clientPhone = `${order.client?.phoneCode || ''}${order.client?.phone ? ` ${order.client.phone}` : ''}`.trim();
                const productName = order.product?.name || 'Custom piece';
                const deliveryDate = order.order?.expectedDeliveryDate || '';
                const balance = Number(order.payment?.balance || 0).toFixed(2);
                return `
                <div class="custom-order-item" data-id="${escapeHtml(order.id)}">
                    <div><strong>${escapeHtml(`${clientTitle}${clientName}`)}</strong>${clientPhone ? ` • ${escapeHtml(clientPhone)}` : ''}</div>
                    <div>${escapeHtml(productName)}</div>
                    <div>${escapeHtml(deliveryDate)} • ${escapeHtml(statusLabel)}</div>
                    <div>Balance: ${escapeHtml(balance)}</div>
                    ${order.isDraft ? '<div style="color:#999;">Draft</div>' : ''}
                    <div class="custom-order-list-actions">
                        <button type="button" class="btn-small custom-order-view">View</button>
                        <button type="button" class="btn-small custom-order-edit">Edit</button>
                        <button type="button" class="btn-small custom-order-mark-paid">Mark paid</button>
                        <button type="button" class="btn-small custom-order-print">PDF / Print</button>
                        <button type="button" class="btn-small custom-order-email">Email</button>
                        <button type="button" class="btn-small custom-order-delete">Delete</button>
                    </div>
                </div>
            `;
            }).join('');
        };

        const handleCustomOrderImage = (file) => {
            const preview = document.getElementById('customReferencePreview');
            if (!file || !preview) return;
            if (customOrderImagePreviewUrl) {
                URL.revokeObjectURL(customOrderImagePreviewUrl);
                customOrderImagePreviewUrl = '';
            }
            customOrderImageBlob = file;
            customOrderImageName = file.name || '';
            customOrderImageKey = '';
            customOrderImagePreviewUrl = URL.createObjectURL(file);
            preview.src = customOrderImagePreviewUrl;
            preview.hidden = false;
        };

        const saveCustomOrder = async (isDraft = false) => {
            updateCustomPayment();
            let imageKey = customOrderImageKey;
            let imageName = customOrderImageName;
            if (customOrderImageBlob) {
                if (customOrderImageKey) {
                    await deleteCustomOrderImage(customOrderImageKey);
                }
                try {
                    imageKey = await saveCustomOrderImage(customOrderImageBlob);
                } catch (error) {
                    showAlert('Unable to store reference image.', 'error');
                }
            }
            customOrderImageKey = imageKey || '';
            const order = {
                id: customOrderEditingId || `custom_${Date.now()}`,
                isDraft,
                client: {
                    title: document.getElementById('customClientTitle').value,
                    name: document.getElementById('customClientName').value.trim(),
                    phoneCode: document.getElementById('customClientPhoneCode').value.trim(),
                    phone: document.getElementById('customClientPhone').value.trim()
                },
                product: {
                    name: document.getElementById('customProductName').value.trim(),
                    colorNumber: document.getElementById('customColorNumber').value.trim(),
                    imageKey: imageKey || '',
                    imageName: imageName || ''
                },
                measurements: {
                    height: document.getElementById('customHeight').value.trim(),
                    shoulder: document.getElementById('customShoulder').value.trim(),
                    chest: document.getElementById('customChest').value.trim(),
                    waist: document.getElementById('customWaist').value.trim(),
                    hip: document.getElementById('customHip').value.trim(),
                    sleeves: document.getElementById('customSleeves').value.trim()
                },
                order: {
                    orderDate: document.getElementById('customOrderDate').value,
                    expectedDeliveryDate: document.getElementById('customDeliveryDate').value
                },
                payment: {
                    total: parseFloat(document.getElementById('customTotalAmount').value || '0'),
                    advance: parseFloat(document.getElementById('customAdvancePaid').value || '0'),
                    balance: parseFloat(document.getElementById('customBalance').value || '0'),
                    status: document.getElementById('customPaymentStatus').value
                },
                createdAt: customOrderEditingId ? undefined : new Date().toISOString(),
                updatedAt: new Date().toISOString()
            };

            const existingIndex = customOrders.findIndex(item => item.id === order.id);
            if (existingIndex >= 0) {
                customOrders[existingIndex] = { ...customOrders[existingIndex], ...order };
            } else {
                customOrders.unshift(order);
            }

            const saved = persistCustomOrders();
            if (!saved) return;
            queueCustomOrdersSync();
            renderCustomOrderList();
            showAlert(isDraft ? 'Draft saved.' : 'Custom order saved.', 'success');
        };

        const loadCustomOrderIntoForm = async (order) => {
            customOrderEditingId = order.id;
            customOrderImageBlob = null;
            customOrderImageKey = order.product.imageKey || '';
            customOrderImageName = order.product.imageName || '';
            if (customOrderImagePreviewUrl) {
                URL.revokeObjectURL(customOrderImagePreviewUrl);
                customOrderImagePreviewUrl = '';
            }
            customStatusLocked = true;
            document.getElementById('customClientTitle').value = order.client.title || 'Mr';
            document.getElementById('customClientName').value = order.client.name || '';
            document.getElementById('customClientPhoneCode').value = order.client.phoneCode || '';
            document.getElementById('customClientPhone').value = order.client.phone || '';
            document.getElementById('customProductName').value = order.product.name || '';
            document.getElementById('customColorNumber').value = order.product.colorNumber || '';
            document.getElementById('customChest').value = order.measurements.chest || '';
            document.getElementById('customWaist').value = order.measurements.waist || '';
            document.getElementById('customHip').value = order.measurements.hip || '';
            document.getElementById('customHeight').value = order.measurements.height || '';
            document.getElementById('customShoulder').value = order.measurements.shoulder || '';
            document.getElementById('customSleeves').value = order.measurements.sleeves || '';
            document.getElementById('customOrderDate').value = order.order.orderDate || '';
            document.getElementById('customDeliveryDate').value = order.order.expectedDeliveryDate || '';
            document.getElementById('customTotalAmount').value = order.payment.total ?? '';
            document.getElementById('customAdvancePaid').value = order.payment.advance ?? '';
            document.getElementById('customBalance').value = order.payment.balance ?? '';
            document.getElementById('customPaymentStatus').value = order.payment.status || 'unpaid';
            const preview = document.getElementById('customReferencePreview');
            if (preview) {
                if (customOrderImageKey) {
                    const blob = await getCustomOrderImage(customOrderImageKey);
                    if (blob) {
                        customOrderImagePreviewUrl = URL.createObjectURL(blob);
                        preview.src = customOrderImagePreviewUrl;
                        preview.hidden = false;
                    } else {
                        preview.hidden = true;
                    }
                } else {
                    preview.hidden = true;
                }
            }
            updateCustomPayment();
        };

        const openCustomOrderSummary = async (order, autoPrint = false) => {
            const win = window.open('', '_blank');
            if (!win) return;
            let imageBlock = '';
            if (!autoPrint) {
                if (order.product?.imageKey) {
                    const blob = await getCustomOrderImage(order.product.imageKey);
                    if (blob) {
                        const url = URL.createObjectURL(blob);
                        imageBlock = `<img src="${escapeHtml(url)}" alt="Reference" style="width:100%;height:auto;object-fit:contain;border:1px solid #e5e2dd;">`;
                    }
                }
                if (!imageBlock && order.product?.image) {
                    const directImage = sanitizeMediaUrl(order.product.image);
                    if (directImage) {
                        imageBlock = `<img src="${escapeHtml(directImage)}" alt="Reference" style="width:100%;height:auto;object-fit:contain;border:1px solid #e5e2dd;">`;
                    }
                }
            }
            const statusLabel = escapeHtml((order.payment?.status || '').replace('_', ' '));
            const clientTitle = order.client?.title ? `${order.client.title} ` : '';
            const phoneFull = `${order.client?.phoneCode || ''}${order.client?.phone ? ` ${order.client.phone}` : ''}`.trim();
            const safeClientName = escapeHtml(order.client?.name || '');
            const safeOrderDate = escapeHtml(order.order?.orderDate || '');
            const safeDeliveryDate = escapeHtml(order.order?.expectedDeliveryDate || '');
            const safeClientTitleName = escapeHtml(`${clientTitle}${order.client?.name || ''}`);
            const safePhoneFull = escapeHtml(phoneFull);
            const safeProductName = escapeHtml(order.product?.name || '');
            const safeColorNumber = escapeHtml(order.product?.colorNumber || '');
            const safeMeasurementHeight = escapeHtml(order.measurements?.height || '');
            const safeMeasurementShoulder = escapeHtml(order.measurements?.shoulder || '');
            const safeMeasurementChest = escapeHtml(order.measurements?.chest || '');
            const safeMeasurementWaist = escapeHtml(order.measurements?.waist || '');
            const safeMeasurementHip = escapeHtml(order.measurements?.hip || '');
            const safeMeasurementSleeves = escapeHtml(order.measurements?.sleeves || '');
            const safeTotal = escapeHtml(Number(order.payment?.total || 0).toFixed(2));
            const safeAdvance = escapeHtml(Number(order.payment?.advance || 0).toFixed(2));
            const safeBalance = escapeHtml(Number(order.payment?.balance || 0).toFixed(2));
            win.document.write(`
                <html>
                    <head>
                        <title>Custom Order ${safeClientName}</title>
                        <link rel="preconnect" href="https://fonts.googleapis.com">
                        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
                        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Montserrat:wght@300;400&display=swap" rel="stylesheet">
                        <style>
                            body { font-family: 'Montserrat', sans-serif; background:#F6F4F1; color:#111; margin:0; padding:40px 24px; }
                            .sheet { max-width: 860px; margin: 0 auto; background:#fff; border:1px solid #e5e2dd; padding:48px 56px; }
                            .brand { font-family: 'Cormorant Garamond', serif; font-size: 18px; letter-spacing: 0.2em; text-transform: uppercase; }
                            .title { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 300; margin: 8px 0 16px; }
                            .meta { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(17,17,17,0.6); display:flex; gap:16px; flex-wrap:wrap; }
                            .section { margin-top: 28px; }
                            .section-title { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(17,17,17,0.6); margin-bottom: 12px; }
                            .section p { font-size: 14px; margin: 4px 0; }
                            .divider { height:1px; background:#eee8e1; margin-top: 24px; }
                            .sheet-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 32px; align-items: start; }
                            .sheet-image { width: 100%; }
                            .sheet-image img { display: block; width: 100%; height: auto; }
                        </style>
                    </head>
                    <body>
                        <div class="sheet">
                            <div class="brand">GHOHARY</div>
                            <div class="meta">
                                <div>Order date: ${safeOrderDate}</div>
                                <div>Estimated delivery: ${safeDeliveryDate}</div>
                            </div>
                            <div class="divider"></div>
                            <div class="sheet-grid">
                                <div class="sheet-details">
                                    <div class="section">
                                    <div class="section-title">Client</div>
                                    <p>${safeClientTitleName}</p>
                                    <p>${safePhoneFull}</p>
                                    </div>
                                    <div class="section">
                                        <div class="section-title">Product</div>
                                        <p>${safeProductName}</p>
                                        <p>Color: ${safeColorNumber}</p>
                                    </div>
                                    <div class="section">
                                    <div class="section-title">Measurements</div>
                                    <p>Height: ${safeMeasurementHeight}</p>
                                    <p>Shoulder: ${safeMeasurementShoulder}</p>
                                    <p>Chest: ${safeMeasurementChest}</p>
                                    <p>Waist: ${safeMeasurementWaist}</p>
                                    <p>Hip: ${safeMeasurementHip}</p>
                                    <p>Sleeves: ${safeMeasurementSleeves}</p>
                                </div>
                                    <div class="section">
                                        <div class="section-title">Payment</div>
                                        <p>Total: ${safeTotal}</p>
                                        <p>Advance: ${safeAdvance}</p>
                                        <p>Balance: ${safeBalance}</p>
                                        <p>Status: ${statusLabel}</p>
                                    </div>
                                </div>
                                ${imageBlock ? `<div class="sheet-image">${imageBlock}</div>` : ''}
                            </div>
                        </div>
                    </body>
                </html>
            `);
            win.document.close();
            win.focus();
            if (autoPrint) {
                win.print();
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            removeLegacyAltSeoNotice();
            const legacyNoticeObserver = new MutationObserver((mutations) => {
                let shouldScan = false;
                for (const mutation of mutations) {
                    if (mutation.addedNodes && mutation.addedNodes.length) {
                        shouldScan = true;
                        break;
                    }
                }
                if (shouldScan) removeLegacyAltSeoNotice();
            });
            legacyNoticeObserver.observe(document.body, { childList: true, subtree: true });

            document.getElementById('customTotalAmount')?.addEventListener('input', () => {
                customStatusLocked = false;
                updateCustomPayment();
            });
            document.getElementById('customAdvancePaid')?.addEventListener('input', () => {
                customStatusLocked = false;
                updateCustomPayment();
            });
            document.getElementById('customPaymentStatus')?.addEventListener('change', () => {
                customStatusLocked = true;
            });
            document.getElementById('customReferenceImage')?.addEventListener('change', (event) => {
                const file = event.target.files?.[0];
                handleCustomOrderImage(file);
            });
            document.getElementById('saveCustomOrderDraft')?.addEventListener('click', async () => saveCustomOrder(true));
            document.getElementById('saveCustomOrder')?.addEventListener('click', async () => saveCustomOrder(false));
            document.getElementById('resetCustomOrder')?.addEventListener('click', resetCustomOrderForm);
            document.getElementById('customOrderSearch')?.addEventListener('input', renderCustomOrderList);
            document.getElementById('customOrderStatusFilter')?.addEventListener('change', renderCustomOrderList);
            document.getElementById('customOrderDeliveryFilter')?.addEventListener('change', renderCustomOrderList);
            document.getElementById('customOrderList')?.addEventListener('click', (event) => {
                const item = event.target.closest('.custom-order-item');
                if (!item) return;
                const order = customOrders.find(o => o.id === item.dataset.id);
                if (!order) return;
                if (event.target.classList.contains('custom-order-edit')) {
                    loadCustomOrderIntoForm(order);
                    return;
                }
                if (event.target.classList.contains('custom-order-view')) {
                    openCustomOrderSummary(order, false);
                    return;
                }
                if (event.target.classList.contains('custom-order-mark-paid')) {
                    order.payment.status = 'fully_paid';
                    order.payment.advance = order.payment.total;
                    order.payment.balance = 0;
                    order.updatedAt = new Date().toISOString();
                    const saved = persistCustomOrders();
                    if (saved) queueCustomOrdersSync();
                    renderCustomOrderList();
                    showAlert('Payment marked as fully paid.', 'success');
                    return;
                }
                if (event.target.classList.contains('custom-order-print')) {
                    openCustomOrderSummary(order, true);
                    return;
                }
                if (event.target.classList.contains('custom-order-email')) {
                    const subject = encodeURIComponent(`Custom Order for ${order.client.name || 'Client'}`);
                    const body = encodeURIComponent(`Custom Order\nProduct: ${order.product.name || ''}\nDelivery: ${order.order.expectedDeliveryDate || ''}\nBalance: ${Number(order.payment.balance || 0).toFixed(2)}`);
                    window.location.href = `mailto:?subject=${subject}&body=${body}`;
                    return;
                }
                if (event.target.classList.contains('custom-order-delete')) {
                    customOrders = customOrders.filter(o => o.id !== order.id);
                    const saved = persistCustomOrders();
                    if (saved) queueCustomOrdersSync();
                    renderCustomOrderList();
                    showAlert('Custom order deleted.', 'success');
                }
            });
        });


        async function loadShippingCountryCatalog() {
            if (shippingCountryCatalog.length) return;

            try {
                const response = await fetch('https://restcountries.com/v3.1/all?fields=name,cca2,region', { cache: 'force-cache' });
                if (response.ok) {
                    const countries = await response.json();
                    if (Array.isArray(countries)) {
                        shippingCountryCatalog = countries
                            .map((country) => {
                                const name = String(country?.name?.common || '').trim();
                                if (!name) return null;
                                const code = String(country?.cca2 || '').toUpperCase();
                                const id = slugifyShippingRegion(name);
                                if (!id) return null;
                                return {
                                    id,
                                    name,
                                    code,
                                    continent: continentKeyFromCountryMeta({ code, region: country?.region })
                                };
                            })
                            .filter(Boolean);
                    }
                }
            } catch (e) {
                shippingCountryCatalog = [];
            }

            if (!shippingCountryCatalog.length) {
                shippingCountryCatalog = FALLBACK_SHIPPING_COUNTRIES.map((country) => ({
                    id: slugifyShippingRegion(country.name),
                    name: country.name,
                    code: country.code,
                    continent: country.continent
                }));
            }

            const seen = new Set();
            shippingCountryCatalog = shippingCountryCatalog
                .filter((country) => {
                    if (!country?.id || seen.has(country.id)) return false;
                    seen.add(country.id);
                    return true;
                })
                .sort((a, b) => a.name.localeCompare(b.name));
        }

        function renderShippingCountryPicker() {
            const picker = document.getElementById('shippingCountryPicker');
            if (!picker) return;

            if (!shippingCountryCatalog.length) {
                picker.innerHTML = '<option value="">Loading countries...</option>';
                picker.disabled = true;
                return;
            }

            const existingIds = new Set(
                (shippingRegions || [])
                    .map((region) => String(region?.id || '').trim())
                    .filter(Boolean)
            );
            const available = (shippingCountryCatalog || []).filter((country) => !existingIds.has(country.id));

            if (!available.length) {
                picker.innerHTML = '<option value="">No countries left to add</option>';
                picker.disabled = true;
                return;
            }

            const optionsByGroup = SHIPPING_REGION_GROUPS.map((group) => {
                const options = available
                    .filter((country) => country.continent === group.key)
                    .sort((a, b) => a.name.localeCompare(b.name));
                if (!options.length) return '';
                const optionTags = options
                    .map((country) => `<option value="${escapeHtml(country.id)}">${escapeHtml(country.name)}</option>`)
                    .join('');
                return `<optgroup label="${group.label}">${optionTags}</optgroup>`;
            }).join('');

            picker.innerHTML = `<option value="">Select country to add</option>${optionsByGroup}`;
            picker.disabled = false;
        }

        async function loadShippingRegionsSettings() {
            shippingRegions = [];

            try {
                const response = await fetch(SHIPPING_REGIONS_API, { cache: 'no-store' });
                if (response.ok) {
                    const payload = await response.json();
                    if (Array.isArray(payload?.regions)) {
                        shippingRegions = payload.regions;
                    } else if (Array.isArray(payload)) {
                        shippingRegions = payload;
                    }
                }
            } catch (e) {
                shippingRegions = [];
            }

            if (!shippingRegions.length) {
                try {
                    const response = await fetch('shipping-regions.json', { cache: 'no-store' });
                    if (response.ok) {
                        shippingRegions = await response.json();
                    }
                } catch (e) {
                    shippingRegions = [];
                }
            }

            shippingRegions = (shippingRegions || [])
                .map(normalizeShippingRegionRecord)
                .filter(Boolean);

            renderShippingRegionsTable();
            loadShippingCountryCatalog()
                .then(() => renderShippingCountryPicker())
                .catch(() => renderShippingCountryPicker());
        }

        function updateShippingRegionCountChip() {
            const chip = document.getElementById('shippingRegionCountChip');
            if (!chip) return;
            const count = Array.isArray(shippingRegions) ? shippingRegions.length : 0;
            chip.textContent = `${count} ${count === 1 ? 'country' : 'countries'}`;
        }

        function renderShippingRegionsTable() {
            const container = document.getElementById('shippingRegionsTable');
            updateAdminTabBadges();
            if (!container) return;

            if (!shippingRegions.length) {
                container.innerHTML = '<div class="shipping-empty">No regions configured</div>';
                updateShippingRegionCountChip();
                renderShippingCountryPicker();
                return;
            }

            const renderRegionRow = (region, index) => `
                <div class="shipping-region-row" data-index="${index}">
                    <div class="shipping-region-field">
                        <input type="text" class="shipping-name" value="${escapeHtml(region.name || '')}" placeholder="Country" readonly>
                    </div>
                    <div class="shipping-region-field">
                        <button class="btn-small shipping-remove-btn" type="button" data-region-index="${index}">Remove</button>
                    </div>
                </div>
            `;

            const groupedRegionMap = SHIPPING_REGION_GROUPS.reduce((acc, group) => {
                acc[group.key] = [];
                return acc;
            }, {});

            shippingRegions.forEach((region, index) => {
                const key = getShippingRegionGroupKey(region);
                if (!groupedRegionMap[key]) groupedRegionMap[key] = [];
                groupedRegionMap[key].push({ region, index });
            });

            const groupedTable = SHIPPING_REGION_GROUPS.map(group => {
                const rows = (groupedRegionMap[group.key] || [])
                    .sort((a, b) => String(a.region.name || '').localeCompare(String(b.region.name || '')));

                if (!rows.length) return '';

                const groupEta = rows.find(({ region }) => String(region?.eta || '').trim())?.region?.eta || '';
                const groupPrice = rows.find(({ region }) => Number.isFinite(Number(region?.price)))?.region?.price || 0;
                const rowHtml = rows.map(({ region, index }) => renderRegionRow(region, index)).join('');
                const isCollapsed = shippingGroupCollapsedState[group.key] !== false;
                const groupCountLabel = `${rows.length} ${rows.length === 1 ? 'country' : 'countries'}`;
                return `
                    <div class="shipping-group-box${isCollapsed ? ' is-collapsed' : ''}" data-group-key="${group.key}">
                        <button type="button" class="shipping-group-toggle" data-group-key="${group.key}">
                            <span class="shipping-group-left">
                                <span class="shipping-group-title">${group.label}</span>
                                <span class="shipping-group-count">${groupCountLabel}</span>
                            </span>
                            <span class="shipping-group-chevron${isCollapsed ? '' : ' is-open'}" aria-hidden="true"></span>
                        </button>
                        <div class="shipping-group-content">
                            <div class="shipping-group-content-inner">
                                <div class="shipping-group-meta">
                                    <label class="shipping-group-meta-field">
                                        <span>Delivery Window</span>
                                        <input type="text" class="shipping-group-eta" value="${escapeHtml(groupEta)}" placeholder="5-7 business days">
                                    </label>
                                    <label class="shipping-group-meta-field">
                                        <span>Shipping Rate (AED)</span>
                                        <input type="number" class="shipping-group-price" value="${Number(groupPrice || 0)}" min="0" step="1" placeholder="120">
                                    </label>
                                </div>
                                <div class="shipping-region-list">${rowHtml}</div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = groupedTable || '<div class="shipping-empty">No regions configured</div>';
            updateShippingRegionCountChip();
            renderShippingCountryPicker();
        }

        function toggleShippingGroup(groupKey) {
            const groupBox = document.querySelector(`#shippingRegionsTable .shipping-group-box[data-group-key="${groupKey}"]`);
            if (!groupBox) {
                const currentlyCollapsed = shippingGroupCollapsedState[groupKey] !== false;
                shippingGroupCollapsedState[groupKey] = currentlyCollapsed ? false : true;
                renderShippingRegionsTable();
                return;
            }
            const nextCollapsed = !groupBox.classList.contains('is-collapsed');
            shippingGroupCollapsedState[groupKey] = nextCollapsed;
            groupBox.classList.toggle('is-collapsed', nextCollapsed);
            const chevron = groupBox.querySelector('.shipping-group-chevron');
            if (chevron) {
                chevron.classList.toggle('is-open', !nextCollapsed);
            }
        }

        function addShippingRegionRow() {
            const picker = document.getElementById('shippingCountryPicker');
            const id = String(picker?.value || '').trim();
            if (!id) {
                showAlert('Choose a country from the list first.', 'error');
                return;
            }
            const selectedCountry = (shippingCountryCatalog || []).find((country) => country.id === id);
            if (!selectedCountry) {
                showAlert('Select a valid country to add.', 'error');
                return;
            }
            if (shippingRegions.some(region => String(region?.id || '') === id || String(region?.name || '').toLowerCase() === selectedCountry.name.toLowerCase())) {
                showAlert('Country already exists in shipping regions.', 'error');
                return;
            }
            const groupKey = selectedCountry.continent || getShippingRegionGroupKey({ id, name: selectedCountry.name });
            const defaultEta = shippingRegions.find(region =>
                getShippingRegionGroupKey(region) === groupKey && String(region?.eta || '').trim()
            )?.eta || '';
            const defaultPrice = Number(
                shippingRegions.find(region => getShippingRegionGroupKey(region) === groupKey)?.price || 0
            );
            shippingRegions.push({
                id,
                name: selectedCountry.name,
                enabled: true,
                price: Number.isFinite(defaultPrice) ? defaultPrice : 0,
                eta: defaultEta,
                continent: groupKey
            });
            renderShippingRegionsTable();
        }

        function removeShippingRegion(index) {
            shippingRegions.splice(index, 1);
            renderShippingRegionsTable();
        }

        async function saveShippingRegions() {
            const groupBoxes = document.querySelectorAll('#shippingRegionsTable .shipping-group-box');
            const updated = [];
            const groupSortOrder = SHIPPING_REGION_GROUPS.reduce((acc, group, index) => {
                acc[group.key] = index;
                return acc;
            }, {});

            groupBoxes.forEach(groupBox => {
                const groupKey = String(groupBox.getAttribute('data-group-key') || '').trim();
                const eta = groupBox.querySelector('.shipping-group-eta')?.value.trim() || '';
                const priceRaw = Number(groupBox.querySelector('.shipping-group-price')?.value || 0);
                const price = Number.isFinite(priceRaw) ? Math.max(0, priceRaw) : 0;
                groupBox.querySelectorAll('.shipping-region-row').forEach(row => {
                    const name = row.querySelector('.shipping-name')?.value.trim();
                    if (!name) return;
                    const id = slugifyShippingRegion(name);
                    updated.push({
                        id,
                        name,
                        enabled: true,
                        eta,
                        price,
                        continent: groupKey || getShippingRegionGroupKey({ id, name })
                    });
                });
            });

            if (!updated.length) {
                showAlert('Add at least one country before saving.', 'error');
                return;
            }

            shippingRegions = updated
                .map(normalizeShippingRegionRecord)
                .filter(Boolean)
                .sort((a, b) => {
                    const aKey = getShippingRegionGroupKey(a);
                    const bKey = getShippingRegionGroupKey(b);
                    const aOrder = Number.isFinite(groupSortOrder[aKey]) ? groupSortOrder[aKey] : 999;
                    const bOrder = Number.isFinite(groupSortOrder[bKey]) ? groupSortOrder[bKey] : 999;
                    if (aOrder !== bOrder) return aOrder - bOrder;
                    return String(a.name || '').localeCompare(String(b.name || ''));
                });

            try {
                const response = await adminFetch(SHIPPING_REGIONS_API, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ regions: shippingRegions })
                });
                if (!response.ok) {
                    throw new Error(`Save failed (${response.status})`);
                }
                const payload = await response.json();
                if (Array.isArray(payload?.regions)) {
                    shippingRegions = payload.regions
                        .map(normalizeShippingRegionRecord)
                        .filter(Boolean);
                }
                showAlert('Shipping regions saved and synced to checkout.', 'success');
                renderShippingRegionsTable();
            } catch (e) {
                await loadShippingRegionsSettings();
                showAlert('Unable to sync shipping regions globally. Please try again.', 'error');
            }
        }

        async function resetShippingRegions() {
            try {
                const response = await adminFetch(SHIPPING_REGIONS_API, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ reset: true })
                });
                if (!response.ok) {
                    throw new Error('Reset failed');
                }
                const payload = await response.json();
                if (Array.isArray(payload?.regions)) {
                    shippingRegions = payload.regions
                        .map(normalizeShippingRegionRecord)
                        .filter(Boolean);
                }
                renderShippingRegionsTable();
                showAlert('Shipping regions reset and synced.', 'success');
            } catch (e) {
                await loadShippingRegionsSettings();
                showAlert('Unable to reset globally. Please try again.', 'error');
            }
        }

        function resolveOrderCustomerName(order) {
            return order?.customer
                ? `${order.customer.firstName || ''} ${order.customer.lastName || ''}`.trim()
                : (order?.customerName || '');
        }

        function resolveOrderItems(order) {
            if (Array.isArray(order?.items)) return order.items;
            if (Array.isArray(order?.cart)) return order.cart;
            return [];
        }

        function resolveOrderTotalValue(order) {
            const items = resolveOrderItems(order);
            const itemsTotal = items.reduce((sum, item) => sum + (Number(item?.unitPrice || 0) * Number(item?.quantity || 1)), 0);
            const isUae = Boolean((order?.emirate || order?.customer?.emirate || '').trim());
            const subtotalValue = Number(order?.subtotal || itemsTotal || 0);
            const shipping = isUae ? 0 : Number(order?.totalShipping || 0);
            return Number(order?.totalAmount || order?.orderTotal || (subtotalValue + shipping) || 0);
        }

        function resolveOrderTimestamp(order) {
            const parsed = new Date(order?.createdAt || order?.date || 0).getTime();
            return Number.isFinite(parsed) ? parsed : 0;
        }

        function isOrderRefunded(order) {
            const refundedAmount = Number(
                order?.refundedAmount
                ?? order?.refundAmount
                ?? order?.amountRefunded
                ?? order?.totalRefunded
                ?? order?.refundTotal
                ?? 0
            );
            return refundedAmount > 0;
        }

        function normalizeOrdersListPreferences() {
            if (!ORDER_FILTER_OPTIONS.has(orderQuickFilter)) {
                orderQuickFilter = 'all';
            }
            if (!ORDER_SORT_OPTIONS.has(orderSortMode)) {
                orderSortMode = 'newest';
            }
        }

        function persistOrdersListPreferences() {
            localStorage.setItem(ORDER_FILTER_STORAGE_KEY, orderQuickFilter);
            localStorage.setItem(ORDER_SORT_STORAGE_KEY, orderSortMode);
        }

        function syncOrdersControlState() {
            const sortSelect = document.getElementById('orderSortSelect');
            if (sortSelect) {
                sortSelect.value = ORDER_SORT_OPTIONS.has(orderSortMode) ? orderSortMode : 'newest';
            }
            syncOrderSortSelectUi();

            document.querySelectorAll('#orders .orders-filter-pill[data-order-filter]').forEach((pill) => {
                const filter = String(pill.getAttribute('data-order-filter') || '').trim();
                const isActive = filter === orderQuickFilter;
                pill.classList.toggle('active', isActive);
                pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
                pill.setAttribute('role', 'tab');
                pill.setAttribute('tabindex', isActive ? '0' : '-1');
            });
        }

        function matchesOrderQuickFilter(order) {
            if (orderQuickFilter === 'all') return true;
            const telemetry = getOrderFulfillmentTelemetry(order);
            if (orderQuickFilter === 'unfulfilled') return telemetry.unfulfilled;
            if (orderQuickFilter === 'in-transit') return telemetry.inTransit;
            if (orderQuickFilter === 'delivered') return telemetry.delivered;
            if (orderQuickFilter === 'refunded') return isOrderRefunded(order);
            return true;
        }

        function compareOrdersByMode(a, b) {
            const tsA = resolveOrderTimestamp(a);
            const tsB = resolveOrderTimestamp(b);
            if (orderSortMode === 'oldest') return tsA - tsB;
            if (orderSortMode === 'total-high') return resolveOrderTotalValue(b) - resolveOrderTotalValue(a);
            if (orderSortMode === 'total-low') return resolveOrderTotalValue(a) - resolveOrderTotalValue(b);
            if (orderSortMode === 'customer-asc') {
                return resolveOrderCustomerName(a).toLowerCase().localeCompare(resolveOrderCustomerName(b).toLowerCase());
            }
            if (orderSortMode === 'customer-desc') {
                return resolveOrderCustomerName(b).toLowerCase().localeCompare(resolveOrderCustomerName(a).toLowerCase());
            }
            return tsB - tsA;
        }

        function updateOrdersResultsMeta(filteredCount = 0, totalCount = 0) {
            const metaEl = document.getElementById('ordersResultsMeta');
            if (!metaEl) return;
            if (totalCount <= 0) {
                metaEl.textContent = 'No orders found';
                return;
            }
            metaEl.textContent = `Showing ${filteredCount} of ${totalCount} orders`;
        }

        function bindOrdersToolbarControls() {
            normalizeOrdersListPreferences();
            syncOrdersControlState();
            initOrderSortSelectUi();
            const controls = document.getElementById('ordersCommandSurface');
            if (!controls) return;
            if (!controls.dataset.bound) {
                controls.dataset.bound = 'true';
                controls.addEventListener('click', (event) => {
                    const filterPill = event.target.closest('.orders-filter-pill[data-order-filter]');
                    if (!filterPill) return;
                    const nextFilter = String(filterPill.getAttribute('data-order-filter') || '').trim();
                    if (!ORDER_FILTER_OPTIONS.has(nextFilter) || nextFilter === orderQuickFilter) return;
                    orderQuickFilter = nextFilter;
                    persistOrdersListPreferences();
                    syncOrdersControlState();
                    renderOrdersTable();
                });
                const sortSelect = document.getElementById('orderSortSelect');
                if (sortSelect) {
                    sortSelect.addEventListener('change', () => {
                        const nextSort = String(sortSelect.value || '').trim();
                        orderSortMode = ORDER_SORT_OPTIONS.has(nextSort) ? nextSort : 'newest';
                        persistOrdersListPreferences();
                        syncOrdersControlState();
                        renderOrdersTable();
                    });
                }
            }
        }

        function forceBlackText(nodeList) {
            if (!nodeList || !nodeList.forEach) return;
            nodeList.forEach((el) => {
                if (!(el instanceof HTMLElement) && !(el instanceof SVGElement)) return;
                if (el instanceof SVGElement) {
                    el.style.setProperty('color', '#000000', 'important');
                    if (el.tagName.toLowerCase() === 'path' || el.tagName.toLowerCase() === 'svg') {
                        el.style.setProperty('stroke', '#000000', 'important');
                        el.style.setProperty('fill', 'none', 'important');
                    }
                    return;
                }
                el.style.setProperty('color', '#000000', 'important');
                if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
                    el.style.setProperty('color', '#000000', 'important');
                    el.style.setProperty('caret-color', '#000000', 'important');
                }
            });
        }

        function clearAdminPanelInlineColorLocks() {
            const adminShell = document.querySelector('.admin-menu-shell');
            if (!adminShell) return;
            adminShell.querySelectorAll('[style]').forEach((el) => {
                if (!(el instanceof HTMLElement) && !(el instanceof SVGElement)) return;
                el.style.removeProperty('color');
                el.style.removeProperty('caret-color');
                if (el instanceof SVGElement) {
                    el.style.removeProperty('stroke');
                    el.style.removeProperty('fill');
                }
            });
        }

        function clearOrdersInlineColorLocks() {
            const clearNodeStyles = (root) => {
                if (!root) return;
                root.querySelectorAll('[style]').forEach((el) => {
                    if (!(el instanceof HTMLElement) && !(el instanceof SVGElement)) return;
                    el.style.removeProperty('color');
                    el.style.removeProperty('caret-color');
                    if (el instanceof SVGElement) {
                        el.style.removeProperty('stroke');
                        el.style.removeProperty('fill');
                    }
                });
            };
            clearNodeStyles(document.getElementById('orders'));
            clearNodeStyles(document.getElementById('orderDetailPage'));
        }

        function enforceAdminPanelTextBlack() {
            const adminShell = document.querySelector('.admin-menu-shell');
            if (!adminShell) return;
            if (!document.body.classList.contains('admin-panel-force-black')) return;
            forceBlackText(adminShell.querySelectorAll('*'));
            forceBlackText(document.querySelectorAll('.admin-header svg, .admin-header svg path, .admin-menu-shell svg, .admin-menu-shell svg path'));
        }

        function enforceOrdersTextBlack() {
            if (!document.body.classList.contains('admin-orders-force-black')) {
                clearOrdersInlineColorLocks();
                enforceAdminPanelTextBlack();
                return;
            }
            const ordersRoot = document.getElementById('orders');
            if (ordersRoot) {
                forceBlackText(ordersRoot.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, strong, small, label, th, td, a, button, input, textarea, select'));
                forceBlackText(ordersRoot.querySelectorAll('th *, td *, .payment-text *, .fulfillment-text *, .order-link *'));
            }
            const detailRoot = document.getElementById('orderDetailPage');
            if (detailRoot) {
                forceBlackText(detailRoot.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, strong, small, label, th, td, a, button, input, textarea, select, div'));
                forceBlackText(detailRoot.querySelectorAll('svg, path'));
            }
            enforceAdminPanelTextBlack();
        }

        let ordersColorObserverBound = false;
        function bindOrdersColorObserver() {
            if (ordersColorObserverBound) return;
            const ordersRoot = document.getElementById('orders');
            const detailRoot = document.getElementById('orderDetailPage');
            if (!ordersRoot && !detailRoot) return;
            const observer = new MutationObserver(() => {
                if (!document.body.classList.contains('admin-orders-view')) {
                    enforceAdminPanelTextBlack();
                    return;
                }
                enforceOrdersTextBlack();
            });
            if (ordersRoot) observer.observe(ordersRoot, { childList: true, subtree: true, attributes: true });
            if (detailRoot) observer.observe(detailRoot, { childList: true, subtree: true, attributes: true });
            ordersColorObserverBound = true;
        }

        function productSortValue(product) {
            const updatedTs = Date.parse(product?.updatedAt || '');
            if (Number.isFinite(updatedTs)) return updatedTs;
            const createdTs = Date.parse(product?.createdAt || '');
            if (Number.isFinite(createdTs)) return createdTs;
            const numericId = Number(product?.id);
            if (Number.isFinite(numericId)) return numericId;
            return 0;
        }

        function normalizeProductsListPreferences() {
            if (!PRODUCT_FILTER_OPTIONS.has(productInventoryFilter)) {
                productInventoryFilter = 'all';
            }
            if (!PRODUCT_SORT_OPTIONS.has(productSortMode)) {
                productSortMode = 'newest';
            }
        }

        function persistProductsListPreferences() {
            localStorage.setItem(PRODUCT_FILTER_STORAGE_KEY, productInventoryFilter);
            localStorage.setItem(PRODUCT_SORT_STORAGE_KEY, productSortMode);
        }

        function syncProductsControlState() {
            const sortSelect = document.getElementById('productSortSelect');
            if (sortSelect) {
                sortSelect.value = PRODUCT_SORT_OPTIONS.has(productSortMode) ? productSortMode : 'newest';
            }
            syncProductSortSelectUi();

            document.querySelectorAll('#products .products-filter-pill[data-product-filter]').forEach((pill) => {
                const filter = String(pill.getAttribute('data-product-filter') || '').trim();
                const isActive = filter === productInventoryFilter;
                pill.classList.toggle('active', isActive);
                pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
                pill.setAttribute('role', 'tab');
                pill.setAttribute('tabindex', isActive ? '0' : '-1');
            });
        }

        function updateProductsControlStats() {
            const stats = {
                total: products.length,
                inStock: 0,
                outOfStock: 0,
                priceRequest: 0
            };

            products.forEach((product) => {
                const inventory = Number(product?._adminTotalInventory || 0);
                if (inventory > 0) {
                    stats.inStock += 1;
                } else {
                    stats.outOfStock += 1;
                }
                if (product?._adminHasPrice === false) {
                    stats.priceRequest += 1;
                }
            });

            const totalEl = document.getElementById('productsStatTotal');
            const inStockEl = document.getElementById('productsStatInStock');
            const outOfStockEl = document.getElementById('productsStatOutOfStock');
            const priceRequestEl = document.getElementById('productsStatPriceRequest');

            if (totalEl) totalEl.textContent = String(stats.total);
            if (inStockEl) inStockEl.textContent = String(stats.inStock);
            if (outOfStockEl) outOfStockEl.textContent = String(stats.outOfStock);
            if (priceRequestEl) priceRequestEl.textContent = String(stats.priceRequest);
        }

        function updateProductsResultsMeta(filteredCount) {
            const metaEl = document.getElementById('productsResultsMeta');
            if (!metaEl) return;
            const totalCount = products.length;
            if (totalCount === 0) {
                metaEl.textContent = 'No products in catalog';
                return;
            }
            metaEl.textContent = `Showing ${filteredCount} of ${totalCount} products`;
        }

        function matchesProductInventoryFilter(product) {
            if (productInventoryFilter === 'all') return true;
            const totalInventory = Number(product?._adminTotalInventory || 0);
            const variantCount = Number(product?._adminVariantCount || 1);
            const sizes = Array.isArray(product?.sizes) ? product.sizes : [];
            const inStockSizes = sizes.reduce((count, size) => {
                const quantity = Number(size?.inventory || 0);
                return quantity > 0 ? count + 1 : count;
            }, 0);
            const hasPrice = product?._adminHasPrice !== false;

            if (productInventoryFilter === 'in-stock') {
                return totalInventory > 0 && inStockSizes >= variantCount;
            }
            if (productInventoryFilter === 'low-stock') {
                return totalInventory > 0 && inStockSizes < variantCount;
            }
            if (productInventoryFilter === 'out-of-stock') {
                return totalInventory <= 0;
            }
            if (productInventoryFilter === 'price-request') {
                return !hasPrice;
            }
            return true;
        }

        function compareProductsByMode(a, b) {
            const nameA = String(a?.name || '').trim().toLowerCase();
            const nameB = String(b?.name || '').trim().toLowerCase();
            const inventoryA = Number(a?._adminTotalInventory || 0);
            const inventoryB = Number(b?._adminTotalInventory || 0);
            const priceA = Number.isFinite(a?._adminPriceValue) ? a._adminPriceValue : null;
            const priceB = Number.isFinite(b?._adminPriceValue) ? b._adminPriceValue : null;
            const tsA = Number.isFinite(a?._adminSortTs) ? a._adminSortTs : productSortValue(a);
            const tsB = Number.isFinite(b?._adminSortTs) ? b._adminSortTs : productSortValue(b);

            if (productSortMode === 'oldest') return tsA - tsB;
            if (productSortMode === 'name-asc') return nameA.localeCompare(nameB);
            if (productSortMode === 'name-desc') return nameB.localeCompare(nameA);
            if (productSortMode === 'price-high') {
                if (priceA === null && priceB === null) return 0;
                if (priceA === null) return 1;
                if (priceB === null) return -1;
                return priceB - priceA;
            }
            if (productSortMode === 'price-low') {
                if (priceA === null && priceB === null) return 0;
                if (priceA === null) return 1;
                if (priceB === null) return -1;
                return priceA - priceB;
            }
            if (productSortMode === 'inventory-high') return inventoryB - inventoryA;
            if (productSortMode === 'inventory-low') return inventoryA - inventoryB;
            return tsB - tsA;
        }

        function bindProductsToolbarControls() {
            const controlSurface = document.getElementById('productsControlSurface');
            if (!controlSurface || controlSurface.dataset.bound) {
                normalizeProductsListPreferences();
                syncProductsControlState();
                initProductSortSelectUi();
                return;
            }
            controlSurface.dataset.bound = 'true';
            normalizeProductsListPreferences();
            syncProductsControlState();
            initProductSortSelectUi();

            controlSurface.addEventListener('click', (event) => {
                const filterPill = event.target.closest('.products-filter-pill[data-product-filter]');
                if (!filterPill) return;
                const nextFilter = String(filterPill.getAttribute('data-product-filter') || '').trim();
                if (!PRODUCT_FILTER_OPTIONS.has(nextFilter) || nextFilter === productInventoryFilter) return;
                productInventoryFilter = nextFilter;
                persistProductsListPreferences();
                syncProductsControlState();
                renderProductsTable();
            });

            const sortSelect = document.getElementById('productSortSelect');
            if (sortSelect) {
                sortSelect.addEventListener('change', () => {
                    const nextSort = String(sortSelect.value || '').trim();
                    productSortMode = PRODUCT_SORT_OPTIONS.has(nextSort) ? nextSort : 'newest';
                    persistProductsListPreferences();
                    syncProductsControlState();
                    renderProductsTable();
                });
            }

            document.addEventListener('keydown', (event) => {
                if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
                const activeTab = document.querySelector('.tab-content.active');
                if (!activeTab || activeTab.id !== 'products' || isAddProductView) return;
                const target = event.target;
                const tagName = target && target.tagName ? String(target.tagName).toLowerCase() : '';
                if (tagName === 'input' || tagName === 'textarea' || tagName === 'select' || target?.isContentEditable) {
                    return;
                }
                const searchInput = document.getElementById('productSearchInput');
                if (!searchInput) return;
                event.preventDefault();
                searchInput.focus();
                searchInput.select();
            }, { passive: false });
        }

        function sanitizeProductsForAdmin(rawProducts) {
            if (!Array.isArray(rawProducts)) return [];
            return rawProducts
                .filter(item => item && typeof item === 'object')
                .map(item => {
                    const safeSizes = Array.isArray(item.sizes)
                        ? item.sizes.filter(sizeObj => sizeObj && typeof sizeObj === 'object')
                        : [];
                    const safeImages = Array.isArray(item.images)
                        ? item.images.filter(image => typeof image === 'string')
                        : [];

                    const variantCount = safeSizes.length || 1;
                    let totalInventory = 0;
                    let inStockSizes = 0;
                    for (const sizeObj of safeSizes) {
                        const quantity = Number(sizeObj?.inventory || 0);
                        totalInventory += quantity;
                        if (quantity > 0) inStockSizes += 1;
                    }

                    const inventoryLabel = totalInventory === 0
                        ? 'Out of stock'
                        : (inStockSizes < variantCount ? 'Partially out of stock' : 'In stock');
                    const rawPrice = typeof item?.price === 'string' ? item.price.replace(/,/g, '') : item?.price;
                    const parsedPrice = Number.parseFloat(rawPrice);
                    const hasPrice = !(item?.price === 'Price Upon Request' || item?.price === null || item?.price === undefined || item?.price === '');
                    const normalizedPrice = (item?.price === 'Price Upon Request' || item?.price === null || item?.price === undefined || item?.price === '')
                        ? 'Price Upon Request'
                        : (Number.isFinite(parsedPrice)
                            ? `${parsedPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} AED`
                            : String(item.price));
                    const previewImage = safeImages.length ? safeImages[0] : '';
                    const previewImageSanitized = sanitizeMediaUrl(previewImage);
                    const searchText = [
                        item?.name,
                        item?.sku,
                        item?.category,
                        item?.subcategory
                    ]
                        .map((value) => String(value || '').toLowerCase())
                        .join(' ');

                    return {
                        ...item,
                        sizes: safeSizes,
                        images: safeImages,
                        _adminVariantCount: variantCount,
                        _adminTotalInventory: totalInventory,
                        _adminInventoryLabel: inventoryLabel,
                        _adminPriceDisplay: normalizedPrice,
                        _adminPriceValue: Number.isFinite(parsedPrice) && hasPrice ? parsedPrice : null,
                        _adminHasPrice: hasPrice,
                        _adminSortTs: productSortValue(item),
                        _adminPreviewImage: previewImage,
                        _adminPreviewImageSanitized: previewImageSanitized,
                        _adminSearchText: searchText
                    };
                })
                .sort((a, b) => productSortValue(b) - productSortValue(a));
        }

        function getFilteredProductsForAdmin() {
            const needle = String(productSearchTerm || '').trim().toLowerCase();
            const filtered = products.filter((product) => {
                const haystack = typeof product?._adminSearchText === 'string'
                    ? product._adminSearchText
                    : [
                        product?.name,
                        product?.sku,
                        product?.category,
                        product?.subcategory
                    ]
                        .map((value) => String(value || '').toLowerCase())
                        .join(' ');
                if (needle && !haystack.includes(needle)) {
                    return false;
                }
                return matchesProductInventoryFilter(product);
            });
            return filtered.sort(compareProductsByMode);
        }

        function updateProductsStats() {
            const totalProductsEl = document.getElementById('totalProducts');
            if (totalProductsEl) totalProductsEl.textContent = products.length;

            let totalStock = 0;
            products.forEach(p => {
                if (Number.isFinite(p?._adminTotalInventory)) {
                    totalStock += p._adminTotalInventory;
                } else if (Array.isArray(p.sizes)) {
                    p.sizes.forEach(s => {
                        totalStock += Number(s.inventory || 0);
                    });
                }
            });
            const totalInventoryEl = document.getElementById('totalInventory');
            if (totalInventoryEl) totalInventoryEl.textContent = totalStock;
            updateProductsControlStats();
            updateAdminTabBadges();
        }

        function upsertProductInAdminState(rawProduct, options = {}) {
            if (!rawProduct || typeof rawProduct !== 'object') return;
            const productId = String(rawProduct.id || '').trim();
            if (!productId) return;

            const { prepend = false } = options;
            const currentRawProducts = Array.isArray(products)
                ? products.map((product) => ({ ...product }))
                : [];
            const existingIndex = currentRawProducts.findIndex((product) => String(product?.id || '') === productId);

            if (existingIndex >= 0) {
                currentRawProducts[existingIndex] = { ...currentRawProducts[existingIndex], ...rawProduct };
            } else if (prepend) {
                currentRawProducts.unshift(rawProduct);
            } else {
                currentRawProducts.push(rawProduct);
            }

            products = sanitizeProductsForAdmin(currentRawProducts);
            updateProductsStats();
            renderProductsSurfaces();
        }

        function renderProductsSurfaces() {
            try {
                normalizeProductsListPreferences();
                syncProductsControlState();
                updateProductsControlStats();
                renderProductsTable();
            } catch (renderError) {
                console.error('[Admin] Failed to render products table:', renderError);
                const tbody = document.getElementById('productsTable');
                if (tbody) {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #999;">Products loaded, but table rendering failed.</td></tr>';
                }
            }
        }

        function readProductsSummaryCache() {
            try {
                const raw = localStorage.getItem(ADMIN_PRODUCTS_CACHE_KEY);
                if (!raw) return [];
                const parsed = JSON.parse(raw);
                if (!parsed || typeof parsed !== 'object') return [];
                const ageMs = Date.now() - Number(parsed.ts || 0);
                if (!Number.isFinite(ageMs) || ageMs > ADMIN_PRODUCTS_CACHE_TTL_MS) return [];
                return Array.isArray(parsed.products) ? parsed.products : [];
            } catch (error) {
                return [];
            }
        }

        function writeProductsSummaryCache(rawProducts) {
            try {
                if (!Array.isArray(rawProducts)) return;
                localStorage.setItem(ADMIN_PRODUCTS_CACHE_KEY, JSON.stringify({
                    ts: Date.now(),
                    products: rawProducts
                }));
            } catch (error) {
                // Ignore cache write failures.
            }
        }

        function hydrateProductsFromCache() {
            const cached = readProductsSummaryCache();
            if (!cached.length) return false;
            products = sanitizeProductsForAdmin(cached);
            updateProductsStats();
            renderProductsSurfaces();
            return true;
        }

        // Load products
        async function loadProducts(options = {}) {
            const {
                silent = false,
                retries = 1,
                notify = false,
                summary = true,
                renderSurfaces = true
            } = options;
            let lastError = null;

            if (summary && products.length === 0) {
                hydrateProductsFromCache();
            }

            for (let attempt = 0; attempt <= retries; attempt += 1) {
                try {
                    const query = summary ? '?summary=1' : '';
                    const response = await fetch(`${API_BASE}/api/products${query}`, { cache: 'no-store' });
                    if (!response.ok) {
                        throw new Error(`Failed to load products (${response.status})`);
                    }

                    const data = await response.json();
                    if (!Array.isArray(data)) {
                        throw new Error('Invalid products payload');
                    }

                    products = sanitizeProductsForAdmin(data);
                    if (summary) {
                        writeProductsSummaryCache(data);
                    }
                    updateProductsStats();
                    if (renderSurfaces) {
                        renderProductsSurfaces();
                    } else {
                        updateAdminTabBadges();
                    }

                    if (pendingEditProductId) {
                        await editProduct(pendingEditProductId);
                        pendingEditProductId = null;
                    }

                    return true;
                } catch (error) {
                    lastError = error;
                    if (attempt < retries) {
                        await new Promise(resolve => setTimeout(resolve, 350));
                    }
                }
            }

            console.error('[Admin] Failed to load products:', lastError);
            const tbody = document.getElementById('productsTable');
            if (renderSurfaces && tbody && !products.length) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #999;">Products are syncing. Please refresh in a moment.</td></tr>';
            }
            return false;
        }

        function closeProductActionMenus(exceptMenu = null) {
            document.querySelectorAll('#productsTable .action-menu.is-open').forEach((menu) => {
                if (exceptMenu && menu === exceptMenu) return;
                menu.classList.remove('is-open', 'active');
                const trigger = menu.previousElementSibling;
                if (trigger && trigger.classList.contains('action-menu-btn')) {
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });
        }

        function bindProductsTableEvents() {
            if (productsTableEventsBound) return;
            const tbody = document.getElementById('productsTable');
            if (!tbody) return;

            tbody.addEventListener('click', async (event) => {
                const menuBtn = event.target.closest('.action-menu-btn');
                if (menuBtn) {
                    event.preventDefault();
                    event.stopPropagation();
                    const menu = menuBtn.nextElementSibling;
                    if (!menu || !menu.classList.contains('action-menu')) return;
                    const shouldOpen = !menu.classList.contains('is-open');
                    closeProductActionMenus(shouldOpen ? menu : null);
                    if (shouldOpen) {
                        menu.classList.add('is-open');
                        menuBtn.setAttribute('aria-expanded', 'true');
                    } else {
                        menu.classList.remove('is-open', 'active');
                        menuBtn.setAttribute('aria-expanded', 'false');
                    }
                    return;
                }

                const actionItem = event.target.closest('.action-item');
                if (actionItem) {
                    event.preventDefault();
                    event.stopPropagation();
                    const productId = actionItem.getAttribute('data-product-id');
                    closeProductActionMenus();

                    if (actionItem.classList.contains('edit-action')) {
                        await editProduct(productId);
                        return;
                    }
                    if (actionItem.classList.contains('duplicate-action')) {
                        await duplicateProduct(productId);
                        return;
                    }
                    if (actionItem.classList.contains('delete-action')) {
                        if (confirm('Are you sure you want to delete this product?')) {
                            await deleteProductNow(productId);
                        }
                        return;
                    }
                }

                const productRow = event.target.closest('tr.product-row[data-product-id]');
                if (productRow && !event.target.closest('.action-menu-container')) {
                    const rowProductId = String(productRow.getAttribute('data-product-id') || '').trim();
                    if (rowProductId) {
                        await editProduct(rowProductId);
                    }
                }
            });

            tbody.addEventListener('keydown', async (event) => {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                const row = event.target.closest('tr.product-row[data-product-id]');
                if (!row || event.target.closest('.action-menu-container')) return;
                event.preventDefault();
                const rowProductId = String(row.getAttribute('data-product-id') || '').trim();
                if (!rowProductId) return;
                await editProduct(rowProductId);
            });

            document.addEventListener('click', (event) => {
                if (!event.target.closest('#productsTable .action-menu-container')) {
                    closeProductActionMenus();
                }
            }, { passive: true });

            productsTableEventsBound = true;
        }

        function renderProductRowHtml(p, rowIndex = 0) {
            const variantCount = Number.isFinite(p?._adminVariantCount)
                ? p._adminVariantCount
                : ((Array.isArray(p?.sizes) ? p.sizes.length : 0) || 1);
            const inventoryLabel = p?._adminInventoryLabel || 'Out of stock';
            const priceDisplay = p?._adminPriceDisplay || 'Price Upon Request';
            const imageSrcRaw = typeof p?._adminPreviewImageSanitized === 'string' && p._adminPreviewImageSanitized
                ? p._adminPreviewImageSanitized
                : (typeof p?._adminPreviewImage === 'string'
                    ? p._adminPreviewImage
                    : ((p.images && p.images.length > 0) ? p.images[0] : ''));
            const imageSrc = (typeof p?._adminPreviewImageSanitized === 'string' && p._adminPreviewImageSanitized)
                ? p._adminPreviewImageSanitized
                : sanitizeMediaUrl(imageSrcRaw);
            const thumbnailSrc = optimizeProductThumbnailUrl(imageSrc);
            const eagerImage = rowIndex < 2;
            const imageLoading = eagerImage ? 'eager' : 'lazy';
            const imagePriority = rowIndex < 2 ? 'high' : 'low';
            const safeProductName = escapeHtml(p?.name || '-');
            const safeVariantCount = escapeHtml(`${variantCount} variants`);
            const safeSku = escapeHtml(p?.sku || '-');
            const safePriceDisplay = escapeHtml(priceDisplay);
            const safeInventoryLabel = escapeHtml(inventoryLabel);
            const safeProductId = escapeHtml(p?.id);
            const rowAriaLabel = escapeHtml(`Open ${p?.name || 'product'} for editing`);
            const imagePreviewHtml = thumbnailSrc
                ? `<div class="product-thumb-frame"><img src="${escapeHtml(thumbnailSrc)}" alt="${safeProductName}" class="product-thumb" width="96" height="126" loading="${imageLoading}" decoding="async" fetchpriority="${imagePriority}"></div>`
                : '<div class="product-thumb-frame"><div class="product-thumb product-thumb--placeholder" aria-hidden="true"></div></div>';

            const inventoryStatusClass = inventoryLabel === 'In stock'
                ? 'status--online'
                : (inventoryLabel === 'Out of stock' ? 'status--offline' : 'status--warning');

            return `
                <tr class="product-row" data-product-id="${safeProductId}" tabindex="0" role="button" aria-label="${rowAriaLabel}" style="animation: pcRowSlideIn 0.28s ease both; animation-delay: ${Math.min(rowIndex * 0.03, 0.6)}s;">
                    <td>
                        <div class="product-name-cell">
                            ${imagePreviewHtml}
                            <div class="product-name-text">
                                <div class="product-detail-name">${safeProductName}</div>
                                <div class="product-detail-meta">${safeVariantCount}</div>
                            </div>
                        </div>
                    </td>
                    <td>Physical</td>
                    <td>${safeSku}</td>
                    <td>${safePriceDisplay}</td>
                    <td><span class="inventory-status-badge ${inventoryStatusClass}"><span class="status-dot"></span>${safeInventoryLabel}</span></td>
                    <td>
                        <div class="action-menu-container">
                            <button class="action-menu-btn" data-product-id="${safeProductId}" title="Product actions" aria-label="Open product actions" aria-haspopup="menu" aria-expanded="false">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="5" r="1"></circle>
                                    <circle cx="12" cy="12" r="1"></circle>
                                    <circle cx="12" cy="19" r="1"></circle>
                                </svg>
                            </button>
                            <div class="action-menu" role="menu">
                                <button class="action-item edit-action" data-product-id="${safeProductId}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                    Edit
                                </button>
                                <button class="action-item duplicate-action" data-product-id="${safeProductId}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M8 5H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1"></path>
                                        <path d="M16 3h6v6"></path>
                                        <path d="M16 3l4 4"></path>
                                    </svg>
                                    Duplicate
                                </button>
                                <button class="action-item delete-action" data-product-id="${safeProductId}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            `;
        }

        // Render products table
        function renderProductsTable() {
            const tbody = document.getElementById('productsTable');
            updateAdminTabBadges();
            if (!tbody) return;
            bindProductsTableEvents();
            bindProductsToolbarControls();
            closeProductActionMenus();
            updateProductsControlStats();

            const renderToken = ++productsRenderToken;
            if (products.length === 0) {
                updateProductsResultsMeta(0);
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #999;">No products added yet</td></tr>';
                return;
            }

            const filteredProducts = getFilteredProductsForAdmin();
            updateProductsResultsMeta(filteredProducts.length);
            if (!filteredProducts.length) {
                const emptyLabel = productSearchTerm
                    ? 'No products match your search.'
                    : (productInventoryFilter !== 'all'
                        ? 'No products match this filter.'
                        : 'No products added yet');
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #999;">${emptyLabel}</td></tr>`;
                return;
            }

            const renderList = [...filteredProducts];
            const immediateRenderLimit = 320;

            if (renderList.length <= immediateRenderLimit) {
                let html = '';
                for (let i = 0; i < renderList.length; i += 1) {
                    html += renderProductRowHtml(renderList[i], i);
                }
                if (renderToken !== productsRenderToken) return;
                tbody.innerHTML = html;
                return;
            }

            const firstChunkSize = 80;
            const chunkSize = 140;
            let cursor = 0;

            const renderChunk = () => {
                if (renderToken !== productsRenderToken) return;
                const size = cursor === 0 ? firstChunkSize : chunkSize;
                const end = Math.min(cursor + size, renderList.length);
                let html = '';
                for (let i = cursor; i < end; i += 1) {
                    html += renderProductRowHtml(renderList[i], i);
                }
                if (cursor === 0) {
                    tbody.innerHTML = html;
                } else {
                    tbody.insertAdjacentHTML('beforeend', html);
                }
                cursor = end;
                if (cursor < renderList.length) {
                    window.requestAnimationFrame(renderChunk);
                }
            };

            window.requestAnimationFrame(renderChunk);
        }

        async function toggleProductVisibility(productId) {
                const productIndex = products.findIndex(p => String(p.id) === String(productId));
                if (productIndex !== -1) {
                    const updated = { ...products[productIndex], visible: !products[productIndex].visible };
                    const response = await adminFetch(`${API_BASE}/api/products/${productId}`, {
                        method: 'PUT',
                        headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                        body: JSON.stringify({ visible: updated.visible })
                    });
                if (response.ok) {
                    loadProducts();
                } else {
                    showAlert('Error updating visibility', 'error');
                }
            }
        }

        async function fetchProductById(productId) {
            const cached = products.find(p => String(p.id) === String(productId));
            const cachedHasDetails = Boolean(
                cached
                && Array.isArray(cached.images)
                && Array.isArray(cached.sizes)
                && cached.images.length >= 0
                && cached.sizes.length > 0
            );
            if (cachedHasDetails) {
                return cached;
            }
            try {
                const response = await fetch(`${API_BASE}/api/products/${encodeURIComponent(productId)}`, { cache: 'no-store' });
                if (!response.ok) {
                    return cached || null;
                }
                const product = await response.json();
                if (product && typeof product === 'object') {
                    const index = products.findIndex(p => String(p.id) === String(productId));
                    if (index >= 0) {
                        products[index] = { ...products[index], ...product };
                    } else {
                        products.push(product);
                    }
                    return products[index >= 0 ? index : products.length - 1];
                }
            } catch (error) {
                // Fall back to cached product below.
            }
            return cached || null;
        }

        async function editProduct(productId) {
            if (!isAddProductView) {
                window.location.href = `admin.html?view=add-product&edit=${encodeURIComponent(productId)}`;
                return;
            }
            const product = await fetchProductById(productId);
            if (!product) {
                showAlert('Unable to load the product for editing. Please refresh and try again.', 'error');
                return;
            }
            const productSubnavTitle = document.getElementById('productSubnavTitle');
            if (productSubnavTitle) {
                productSubnavTitle.textContent = product.name || 'Edit Product';
            }

            // Populate form with product data
            document.getElementById('productName').value = product.name;
            document.getElementById('productCategory').value = product.category;
            const productSubcategoryInput = document.getElementById('productSubcategory');
            if (productSubcategoryInput) productSubcategoryInput.value = product.subcategory || '';
            document.getElementById('productSku').value = product.sku || '';
            document.getElementById('productPrice').value = product.price === 'Price Upon Request' ? '' : product.price;
            document.getElementById('productDescription').value = product.description || '';

            // Set selected sizes
            resetBaseSizeButtons();
            if (product.sizes && product.sizes.length > 0) {
                product.sizes.forEach(sizeObj => {
                    let btn = findSizeButton(sizeObj.size);
                    if (!btn && sizeSelector) {
                        btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'size-btn';
                        btn.dataset.size = String(sizeObj.size || '').trim();
                        btn.dataset.custom = 'true';
                        btn.textContent = String(sizeObj.size || '').trim();
                        attachSizeButtonHandler(btn);
                        sizeSelector.appendChild(btn);
                    }
                    if (btn) {
                        btn.classList.add('active');
                        btn.dataset.inventory = String(normalizeSizeInventory(sizeObj.inventory, 1));
                        if (sizeObj.price !== undefined && sizeObj.price !== null) {
                            btn.dataset.price = sizeObj.price;
                        }
                    }
                });
                updateSelectedSizesDisplay();
            }

            // Clear images and store product ID for update
            imageFiles = product.images || []; // Load existing image URLs
            imageAltTexts = Array.isArray(product.imageAlts) ? product.imageAlts.slice() : [];
            if (imageAltTexts.length < imageFiles.length) {
                imageAltTexts = imageAltTexts.concat(new Array(imageFiles.length - imageAltTexts.length).fill(''));
            }
            if (imageAltTexts.length > imageFiles.length) {
                imageAltTexts = imageAltTexts.slice(0, imageFiles.length);
            }
            imagePreviewContainer.innerHTML = '';
            document.getElementById('imagePreview').innerHTML = '';
            document.getElementById('productImages').value = '';
            
            // Render existing images
            selectedImageIndex = -1;
            renderImagePreview();

            // Load videos
            videoFiles = product.videos || [];
            if (videoPreviewContainer) {
                videoPreviewContainer.innerHTML = '';
                if (videoFiles.length > 0) {
                    videoFiles.forEach((url, index) => {
                        renderVideoItem(url, index);
                    });
                }
            }
            
            // Store the product ID being edited
            const form = document.getElementById('productForm');
            if (form) {
                form.dataset.editingProductId = String(productId);
            }
            sessionStorage.setItem(EDITING_PRODUCT_KEY, String(productId));

            // Scroll to form
            document.getElementById('productForm').scrollIntoView({ behavior: 'smooth' });
            
            // Change submit button text
            const submitBtn = getProductSubmitButton();
            const originalText = submitBtn.textContent;
            submitBtn.textContent = 'Update Product';
            submitBtn.dataset.originalText = originalText;
            updateProductComposerIndicators();
        }

        async function duplicateProduct(productId) {
            const product = await fetchProductById(productId);
            if (!product) return;

            try {
                const newProduct = {
                    ...product,
                    name: product.name + ' (Copy)'
                };
                delete newProduct.id;
                delete newProduct.createdAt;
                delete newProduct.sku;

                const response = await adminFetch(`${API_BASE}/api/products`, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify(newProduct)
                });
                if (!response.ok) {
                    throw new Error('Failed to duplicate product');
                }

                showAlert('Product duplicated successfully!', 'success');
                loadProducts();
            } catch (error) {
                showAlert('Error duplicating product: ' + error.message, 'error');
            }
        }

        async function deleteProductNow(productId) {
            try {
                const response = await adminFetch(`${API_BASE}/api/products/${productId}`, {
                    method: 'DELETE'
                });
                if (!response.ok) {
                    throw new Error('Failed to delete product');
                }
                showAlert('Product deleted successfully!', 'success');
                loadProducts();
            } catch (error) {
                showAlert('Error deleting product: ' + error.message, 'error');
            }
        }

        // Load orders
        async function loadOrders() {
            try {
                const response = await adminFetch(`${API_BASE}/api/admin/orders?limit=500&includeIncomplete=1`);
                if (!response.ok) {
                    throw new Error('Orders API not available');
                }
                const data = await response.json();
                orders = data.orders || [];

                const totalOrdersEl = document.getElementById('totalOrders');
                if (totalOrdersEl) {
                    totalOrdersEl.textContent = data.pagination?.total || orders.length;
                }
                
                normalizeOrders();
                renderOrdersTable();
                if (pendingOrderOpen) {
                    const nextOrder = pendingOrderOpen;
                    pendingOrderOpen = null;
                    viewOrder(nextOrder);
                }
            } catch (error) {
                if (authFailureHandled) {
                    orders = [];
                    renderOrdersTable();
                    return;
                }
                console.warn('Orders API failed, using localStorage fallback.', error);
                orders = JSON.parse(localStorage.getItem('ghoharyOrders') || '[]');
                normalizeOrders();
                const totalOrdersEl = document.getElementById('totalOrders');
                if (totalOrdersEl) {
                    totalOrdersEl.textContent = orders.length;
                }
                renderOrdersTable();
                if (pendingOrderOpen) {
                    const nextOrder = pendingOrderOpen;
                    pendingOrderOpen = null;
                    viewOrder(nextOrder);
                }
            }
        }

        async function recoverOrder() {
            const refInput = document.getElementById('recoverOrderRef');
            const statusEl = document.getElementById('recoverOrderStatus');
            const recoverBtn = document.getElementById('recoverOrderBtn');

            if (!refInput) return;

            const reference = refInput.value.trim();

            if (!reference) {
                showAlert('Enter a charge or payment ID.', 'error');
                return;
            }

            const payload = reference.startsWith('pi_')
                ? { paymentIntentId: reference }
                : reference.startsWith('ch_')
                    ? { chargeId: reference }
                    : null;

            if (!payload) {
                showAlert('Use a valid Stripe Charge ID (ch_) or Payment Intent ID (pi_).', 'error');
                return;
            }

            if (statusEl) statusEl.textContent = 'Recovering...';
            if (recoverBtn) recoverBtn.disabled = true;

            try {
                const response = await adminFetch(`${API_BASE}/api/admin/orders/recover`, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify(payload)
                });
                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                    throw new Error(data.error || 'Unable to recover order.');
                }

                if (data?.order?.orderNumber) {
                    showAlert(`Order ${data.order.orderNumber} recovered.`, 'success');
                } else {
                    showAlert('Order recovery complete.', 'success');
                }

                if (statusEl) statusEl.textContent = data?.restored ? 'Recovered.' : 'Already recorded.';
                await loadOrders();
            } catch (error) {
                showAlert(error.message || 'Unable to recover order.', 'error');
                if (statusEl) statusEl.textContent = 'Recovery failed.';
            } finally {
                if (recoverBtn) recoverBtn.disabled = false;
            }
        }

        function getOrderFulfillmentTelemetry(order) {
            const baseStatus = String(order?.fulfillmentStatus || order?.orderStatus || order?.status || '').toLowerCase();
            const deliveryStatus = String(order?.deliveryStatus || '').toLowerCase();
            const trackingValue = String(
                order?.trackingNumber
                || order?.tracking
                || order?.trackingNo
                || order?.awb
                || ''
            ).trim();
            const hasTracking = Boolean(trackingValue);
            const delivered = ['delivered', 'delivery complete', 'complete', 'completed'].some((label) =>
                baseStatus.includes(label) || deliveryStatus.includes(label)
            );
            const fulfilled = delivered || hasTracking || /ship|transit|fulfilled|fulfill|out for delivery/.test(baseStatus);
            return {
                delivered,
                unfulfilled: !fulfilled,
                inTransit: fulfilled && !delivered
            };
        }

        function updateOrdersConsoleStats() {
            const totalEl = document.getElementById('fxOrdersTotal');
            const unfulfilledEl = document.getElementById('fxOrdersUnfulfilled');
            const transitEl = document.getElementById('fxOrdersTransit');
            const deliveredEl = document.getElementById('fxOrdersDelivered');
            const signalEl = document.getElementById('fxOrdersSignal');
            if (!totalEl && !unfulfilledEl && !transitEl && !deliveredEl && !signalEl) return;

            const safeOrders = Array.isArray(orders) ? orders : [];
            let unfulfilled = 0;
            let inTransit = 0;
            let delivered = 0;

            safeOrders.forEach((order) => {
                const telemetry = getOrderFulfillmentTelemetry(order);
                if (telemetry.unfulfilled) unfulfilled += 1;
                if (telemetry.inTransit) inTransit += 1;
                if (telemetry.delivered) delivered += 1;
            });

            if (totalEl) totalEl.textContent = String(safeOrders.length);
            if (unfulfilledEl) unfulfilledEl.textContent = String(unfulfilled);
            if (transitEl) transitEl.textContent = String(inTransit);
            if (deliveredEl) deliveredEl.textContent = String(delivered);
            if (signalEl) {
                if (unfulfilled > 0) {
                    signalEl.textContent = 'Attention';
                } else if (inTransit > 0) {
                    signalEl.textContent = 'Live';
                } else {
                    signalEl.textContent = 'Stable';
                }
            }
        }

        // Render orders table
        function renderOrdersTable() {
            const tbody = document.getElementById('ordersTable');
            updateAdminTabBadges();
            updateOrdersConsoleStats();
            normalizeOrdersListPreferences();
            syncOrdersControlState();
            const safeOrders = Array.isArray(orders) ? orders : [];

            if (!tbody) {
                updateOrdersResultsMeta(0, safeOrders.length);
                window.requestAnimationFrame(enforceOrdersTextBlack);
                return;
            }

            const filteredOrders = safeOrders
                .filter(matchesOrderQuickFilter)
                .filter((order) => {
                    if (!orderSearchTerm) return true;
                    const customerName = resolveOrderCustomerName(order);
                    const orderNumber = order?.orderNumber || '';
                    const items = resolveOrderItems(order);
                    const itemNames = items.map((item) => item?.name || '').join(' ');
                    const itemCodes = items.map((item) => item?.sku || item?.productSku || item?.productId || item?.id || '').join(' ');
                    const haystack = `${orderNumber} ${customerName} ${itemNames} ${itemCodes}`.toLowerCase();
                    return haystack.includes(orderSearchTerm);
                })
                .sort(compareOrdersByMode);

            updateOrdersResultsMeta(filteredOrders.length, safeOrders.length);

            if (safeOrders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="orders-empty-state-cell">No orders found</td></tr>';
                window.requestAnimationFrame(enforceOrdersTextBlack);
                return;
            }

            if (filteredOrders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="orders-empty-state-cell">No orders match current filters</td></tr>';
                window.requestAnimationFrame(enforceOrdersTextBlack);
                return;
            }

            tbody.innerHTML = filteredOrders.map(o => {
                const orderId = o._id || o.orderNumber || '';
                const customerName = resolveOrderCustomerName(o) || '-';
                const totalValue = resolveOrderTotalValue(o);
                const dateValue = new Date(o.createdAt || o.date || Date.now()).toLocaleString('en-GB', {
                    day: '2-digit',
                    month: 'long',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                });
                const refundedAmount = Number(
                    o.refundedAmount
                    ?? o.refundAmount
                    ?? o.amountRefunded
                    ?? o.totalRefunded
                    ?? o.refundTotal
                    ?? 0
                );
                const paymentLabel = refundedAmount > 0
                    ? (refundedAmount >= totalValue ? 'Refunded' : 'Partially refunded')
                    : 'Paid';
                const telemetry = getOrderFulfillmentTelemetry(o);
                let fulfillmentLabel = 'Unfulfilled';
                let fulfillmentClass = 'unfulfilled';
                if (telemetry.delivered) {
                    fulfillmentLabel = 'Delivered';
                    fulfillmentClass = 'delivered';
                } else if (telemetry.inTransit) {
                    fulfillmentLabel = 'Fulfilled';
                    fulfillmentClass = 'fulfilled';
                }
                const itemsCount = resolveOrderItems(o).reduce((sum, item) => sum + Number(item?.quantity || 1), 0);
                const safeOrderId = escapeHtml(orderId);
                const safeOrderNumber = escapeHtml(o.orderNumber || '-');
                const safeDateValue = escapeHtml(dateValue);
                const safeCustomerName = escapeHtml(customerName || '-');
                const safeItemsCount = escapeHtml(itemsCount || '-');
                const safeTotalValue = escapeHtml(totalValue.toLocaleString());
                const safePaymentLabel = escapeHtml(paymentLabel);
                const safeFulfillmentLabel = escapeHtml(fulfillmentLabel);
                return `
                <tr class="order-row" data-order-id="${safeOrderId}" tabindex="0">
                    <td><button type="button" class="order-link" data-order-open>${safeOrderNumber}</button></td>
                    <td>${safeDateValue}</td>
                    <td>${safeCustomerName}</td>
                    <td>${safeItemsCount}</td>
                    <td>AED ${safeTotalValue}</td>
                    <td><span class="payment-text">${safePaymentLabel}</span></td>
                    <td><span class="fulfillment-text ${fulfillmentClass}">${safeFulfillmentLabel}</span></td>
                </tr>
                `;
            }).join('');
            window.requestAnimationFrame(enforceOrdersTextBlack);
        }

        function normalizeOrders() {
            orders = orders.map(order => {
                if (order.orderNumber === 'GH31450802') {
                    return {
                        ...order,
                        subtotal: 4,
                        totalShipping: 0,
                        orderTotal: 4
                    };
                }
                return order;
            });
        }

        // Handle add product
        async function handleAddProduct(e) {
            e.preventDefault();
            if (isProductSubmitInFlight) return;

            // Validate form
            const name = document.getElementById('productName').value;
            const category = document.getElementById('productCategory').value;
            
            if (!name || !category) {
                showAlert('Please fill in all required fields', 'error');
                return;
            }

            const selectedSizeBtns = document.querySelectorAll('.size-btn.active');
            if (selectedSizeBtns.length === 0) {
                showAlert('Please select at least one size', 'error');
                return;
            }

            // Inventory management is removed from admin; keep existing stock on edits,
            // and default new sizes to 1 so products stay sellable.
            const sizes = Array.from(selectedSizeBtns).map(btn => {
                const sizeValue = btn.getAttribute('data-size');
                const rawInventory = Number(btn.dataset.inventory);
                const inventory = Number.isFinite(rawInventory) ? Math.max(0, rawInventory) : 1;
                const existingSizePrice = btn.dataset.price !== undefined && btn.dataset.price !== '' ? Number(btn.dataset.price) : null;
                return {
                    size: sizeValue,
                    inventory: inventory,
                    price: Number.isFinite(existingSizePrice) ? existingSizePrice : null
                };
            });

            // Check if we're editing or adding
            const editingProductId = resolveEditingProductId();
            const isEditing = Boolean(editingProductId);
            const submitBtn = getProductSubmitButton();
            isProductSubmitInFlight = true;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.setAttribute('aria-busy', 'true');
                submitBtn.textContent = isEditing ? 'Updating...' : 'Saving...';
            }

            try {
                const images = [];
                const imageAlts = [];
                imageFiles.forEach((url, idx) => {
                    if (url) {
                        images.push(url);
                        imageAlts.push((imageAltTexts[idx] || '').trim());
                    }
                });
                const existingProduct = isEditing
                    ? products.find(p => String(p.id) === String(editingProductId))
                    : null;
                const optionLabel = existingProduct ? (existingProduct.optionLabel || '') : '';
                const optionPrice = existingProduct ? String(existingProduct.optionPrice || '').trim() : '';
                const colors = existingProduct && Array.isArray(existingProduct.colors) ? existingProduct.colors : [];
                const visibilityOnline = existingProduct
                    ? (existingProduct.visibility ? existingProduct.visibility.online !== false : existingProduct.visible !== false)
                    : true;
                const visibilityPos = existingProduct
                    ? (existingProduct.visibility ? existingProduct.visibility.pos === true : false)
                    : false;
                const preorder = Boolean(existingProduct && existingProduct.preorder);

                const payload = {
                    name: name,
                    category: category,
                    subcategory: existingProduct ? (existingProduct.subcategory || '') : '',
                    price: document.getElementById('productPrice').value || 'Price Upon Request',
                    description: document.getElementById('productDescription').value,
                    sizes: sizes,
                    colors: colors,
                    images: images,
                    imageAlts: imageAlts,
                    videos: videoFiles.filter(Boolean),
                    imageCount: images.length,
                    visibility: {
                        online: visibilityOnline,
                        pos: visibilityPos
                    },
                    visible: visibilityOnline,
                    preorder: preorder
                };

                if (optionLabel) {
                    payload.optionLabel = optionLabel;
                }
                if (optionPrice) {
                    payload.optionPrice = optionPrice;
                }

                const successMessage = isEditing ? 'Product updated successfully!' : 'Product added successfully!';
                let savedProduct = null;

                if (isEditing) {
                    const response = await adminFetch(`${API_BASE}/api/products/${editingProductId}`, {
                        method: 'PUT',
                        headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                        body: JSON.stringify(payload)
                    });
                    if (!response.ok) {
                        const detail = await response.text();
                        throw new Error(`Failed to update product (${response.status}) ${detail}`);
                    }
                    savedProduct = await response.json().catch(() => null);
                } else {
                    const response = await adminFetch(`${API_BASE}/api/products`, {
                        method: 'POST',
                        headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                        body: JSON.stringify(payload)
                    });
                    if (!response.ok) {
                        const detail = await response.text();
                        throw new Error(`Failed to add product (${response.status}) ${detail}`);
                    }
                    savedProduct = await response.json().catch(() => null);
                }

                if (savedProduct) {
                    upsertProductInAdminState(savedProduct, { prepend: !isEditing });
                }
                
                // Reset form
                document.getElementById('productForm').reset();
                document.getElementById('productForm').dataset.editingProductId = '';
                sessionStorage.removeItem(EDITING_PRODUCT_KEY);
                document.getElementById('imagePreview').innerHTML = '';
                if (videoPreviewContainer) {
                    videoPreviewContainer.innerHTML = '';
                }
                const selectedSizesDisplay = document.getElementById('selectedSizes');
                if (selectedSizesDisplay) {
                    selectedSizesDisplay.textContent = '';
                    selectedSizesDisplay.style.display = 'none';
                }
                resetBaseSizeButtons();
                imageFiles = [];
                imageAltTexts = [];
                videoFiles = [];
                updateSelectedSizesDisplay();
                
                // Reset button text
                if (submitBtn && submitBtn.dataset.originalText) {
                    submitBtn.textContent = submitBtn.dataset.originalText;
                }
                showAlert(successMessage, 'success');
                loadProducts({
                    silent: true,
                    retries: 1,
                    renderSurfaces: !isAddProductView
                }).catch(() => {
                    // Non-blocking background sync.
                });
            } catch (error) {
                console.error('[Admin] Product save failed:', error);
                showAlert('Error: ' + error.message, 'error');
            } finally {
                isProductSubmitInFlight = false;
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.removeAttribute('aria-busy');
                    const isStillEditing = Boolean(resolveEditingProductId());
                    if (isStillEditing) {
                        submitBtn.textContent = 'Update Product';
                    } else {
                        submitBtn.dataset.originalText = 'Add Product';
                        submitBtn.textContent = 'Add Product';
                    }
                }
            }
        }

        const productFormEl = document.getElementById('productForm');
        if (productFormEl) {
            productFormEl.addEventListener('submit', handleAddProduct);
        }

        const productNameInput = document.getElementById('productName');
        if (productNameInput) {
            productNameInput.addEventListener('input', () => {
                if (!isAddProductView) return;
                const productSubnavTitle = document.getElementById('productSubnavTitle');
                if (productSubnavTitle) {
                    const value = productNameInput.value.trim();
                    productSubnavTitle.textContent = value || 'Add New Product';
                }
                updateProductComposerIndicators();
            });
        }

        ['productCategory', 'productPrice', 'productDescription'].forEach((id) => {
            const field = document.getElementById(id);
            if (!field) return;
            field.addEventListener('input', updateProductComposerIndicators);
            field.addEventListener('change', updateProductComposerIndicators);
        });

        document.addEventListener('keydown', (event) => {
            if (!(event.metaKey || event.ctrlKey)) return;
            if (String(event.key).toLowerCase() !== 's') return;
            if (!isAddProductView) return;
            const form = document.getElementById('productForm');
            if (!form) return;
            event.preventDefault();
            if (isProductSubmitInFlight) return;
            form.requestSubmit();
        });

        // Handle bulk price update
        async function handleBulkPriceUpdate(e) {
            e.preventDefault();
            const data = document.getElementById('bulkPriceData').value;
            const lines = data.trim().split('\n');
            
            const updates = [];
            for (const line of lines) {
                const [sku, price] = line.split(',');
                const product = products.find(p => p.sku === sku.trim());
                if (product) {
                    updates.push({ productId: product._id, price: parseFloat(price) });
                }
            }

            if (updates.length === 0) {
                showAlert('No matching products found', 'error');
                return;
            }

            try {
                const response = await adminFetch(`${API_BASE}/admin/products/bulk/prices`, {
                    method: 'POST',
                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ updates })
                });

                if (response.ok) {
                    const result = await response.json();
                    showAlert(`Updated ${result.updated} products`);
                    loadProducts();
                }
            } catch (error) {
                showAlert('Error: ' + error.message, 'error');
            }
        }

        async function viewOrder(id) {
            const order = orders.find(o => o._id === id || o.orderNumber === id);
            if (!order) {
                showAlert('Order not found', 'error');
                return;
            }

            const pickNumber = (...values) => {
                for (const value of values) {
                    if (value === undefined || value === null || value === '') continue;
                    const parsed = Number(value);
                    if (Number.isFinite(parsed)) return parsed;
                }
                return null;
            };

            const customerName = order.customer
                ? `${order.customer.firstName || ''} ${order.customer.lastName || ''}`.trim()
                : (order.customerName || '-');
            const resolvedItems = Array.isArray(order.items) && order.items.length > 0
                ? order.items
                : (Array.isArray(order.cart) ? order.cart : []);
            const itemsTotal = resolvedItems.length
                ? resolvedItems.reduce((sum, item) => {
                    const itemPrice = pickNumber(item.unitPrice, item.price, item.amount, item.total, item.lineTotal, item.subtotal);
                    const qty = Number(item.quantity || 1);
                    return sum + ((itemPrice || 0) * qty);
                }, 0)
                : 0;
            const subtotalValue = pickNumber(order.subtotal, order.subTotal, order.orderSubtotal, order.itemsSubtotal);
            const derivedSubtotal = subtotalValue !== null && subtotalValue > 0 ? subtotalValue : (itemsTotal || 0);
            const totalValue = pickNumber(order.totalAmount, order.orderTotal, order.total);
            let shipping = pickNumber(
                order.totalShipping,
                order.shipping,
                order.shippingAmount,
                order.shippingCost,
                order.shippingPrice,
                order.shippingTotal,
                order.deliveryFee
            );
            if (shipping === null && totalValue !== null && derivedSubtotal !== null && totalValue >= derivedSubtotal) {
                shipping = totalValue - derivedSubtotal;
            }
            if (shipping === null) shipping = 0;
            const finalTotal = totalValue !== null ? totalValue : (derivedSubtotal + shipping);
            const total = finalTotal.toLocaleString();
            const status = order.orderStatus || 'Paid';
            const resolveOrderStatusTone = (value) => {
                const statusValue = String(value || '').toLowerCase();
                if (/paid|succeeded|completed|delivered/.test(statusValue)) return 'tone-paid';
                if (/pending|processing|underway|in progress/.test(statusValue)) return 'tone-pending';
                if (/failed|cancel|refunded|unpaid|void/.test(statusValue)) return 'tone-issue';
                return '';
            };
            const orderStatusTone = resolveOrderStatusTone(status);
            const date = new Date(order.createdAt || order.date || Date.now()).toLocaleString();
            const items = await enrichOrderItemsWithSku(resolvedItems, pickNumber);
            const shippingName = order.customer?.firstName || (order.customerName || '').split(' ')[0] || '';
            const shippingLast = order.customer?.lastName || (order.customerName || '').split(' ').slice(1).join(' ') || '';
            const detailPage = document.getElementById('orderDetailPage');
            if (!detailPage) {
                showAlert('Order view unavailable.', 'error');
                return;
            }
            if (detailPage.__closeCleanupTimer) {
                clearTimeout(detailPage.__closeCleanupTimer);
                detailPage.__closeCleanupTimer = null;
            }
            const resolveItemIdentity = (item, itemName) => {
                const directSku = String(item?.sku || item?.productSku || item?.variantSku || '').trim();
                if (directSku) return `SKU ${directSku}`;

                const directProductId = String(item?.productId || item?.id || '').trim();
                if (directProductId) {
                    return `ID ${directProductId}`;
                }

                return 'SKU -';
            };

            detailPage.innerHTML = `
                <div class="order-detail-shell">
                    <div class="order-detail-top">
                        <button type="button" class="order-detail-back">Back to orders</button>
                        <span class="order-detail-status${orderStatusTone ? ` ${orderStatusTone}` : ''}">${escapeHtml(status)}</span>
                    </div>
                    <div class="order-detail-header">
                        <div>
                            <div class="order-detail-eyebrow">Order</div>
                            <div class="order-detail-title">${escapeHtml(order.orderNumber || id)}</div>
                        </div>
                        <div class="order-detail-total">AED ${total}</div>
                    </div>
                    <div class="order-detail-summary">
                        <div><span>Date</span><div>${escapeHtml(date)}</div></div>
                        <div><span>Subtotal</span><div>AED ${derivedSubtotal.toLocaleString()}</div></div>
                        <div><span>Shipping</span><div>AED ${shipping.toLocaleString()}</div></div>
                    </div>
                    <div class="order-detail-grid">
                        <section class="order-detail-card">
                            <h4>Customer</h4>
                            <div class="shipping-address-grid order-detail-display">
                                <div class="shipping-field shipping-field-wide">${escapeHtml(customerName || '-')}</div>
                                <div class="shipping-field shipping-field-wide">${escapeHtml(order.email || '-')}</div>
                                <div class="shipping-field shipping-field-wide" id="orderPhoneDisplay">${escapeHtml(order.phone || '-')}</div>
                            </div>
                            <div class="shipping-address-grid order-detail-edit-field" data-field="orderPhone">
                                <div class="shipping-field shipping-field-wide">${escapeHtml(customerName || '-')}</div>
                                <div class="shipping-field shipping-field-wide">${escapeHtml(order.email || '-')}</div>
                                <input class="shipping-field shipping-field-wide" id="orderPhoneInput" type="text" value="${escapeHtml(order.phone || '')}" placeholder="Phone">
                            </div>
                        </section>
                        <section class="order-detail-card">
                            <h4>Shipping address</h4>
                            <div class="shipping-address-grid order-detail-display">
                                <div class="shipping-field" id="orderShipFirstDisplay">${escapeHtml(shippingName)}</div>
                                <div class="shipping-field" id="orderShipLastDisplay">${escapeHtml(shippingLast)}</div>
                                <div class="shipping-field shipping-field-wide" id="orderShipAddressDisplay">${escapeHtml(order.address || '')}</div>
                                <div class="shipping-field" id="orderShipZipDisplay">${escapeHtml(order.zip || '')}</div>
                                <div class="shipping-field" id="orderShipCityDisplay">${escapeHtml(order.city || '')}</div>
                                <div class="shipping-field shipping-field-wide" id="orderShipCountryDisplay">${escapeHtml(order.country || '')}</div>
                            </div>
                            <div class="shipping-address-grid order-detail-edit-field" data-field="shippingAddress">
                                <div class="shipping-field" id="orderShipFirstEdit">${escapeHtml(shippingName)}</div>
                                <div class="shipping-field" id="orderShipLastEdit">${escapeHtml(shippingLast)}</div>
                                <input class="shipping-field shipping-field-wide" id="orderAddressInput" type="text" value="${escapeHtml(order.address || '')}" placeholder="Street address">
                                <input class="shipping-field" id="orderZipInput" type="text" value="${escapeHtml(order.zip || '')}" placeholder="Postal code">
                                <input class="shipping-field" id="orderCityInput" type="text" value="${escapeHtml(order.city || '')}" placeholder="City">
                                <input class="shipping-field shipping-field-wide" id="orderCountryInput" type="text" value="${escapeHtml(order.country || '')}" placeholder="Country">
                            </div>
                        </section>
                    </div>
                    <section class="order-detail-card order-detail-tracking">
                        <h4>Tracking</h4>
                        <div class="tracking-fields">
                            <div class="tracking-field">
                                <label for="trackingNumberInput">Tracking Number (FedEx / DHL)</label>
                                <input class="tracking-input" id="trackingNumberInput" type="text" placeholder="Enter tracking number" value="${escapeHtml(order.trackingNumber || '')}">
                            </div>
                        </div>
                        <div class="tracking-live" id="trackingLiveStatus"></div>
                    </section>
                    <section class="order-detail-card">
                        <h4>Items</h4>
                        <div class="order-items">
                            ${items.length > 0 ? items.map(item => {
                                const name = item.name || 'GHOHARY Item';
                                const size = item.size ? `Size ${item.size}` : 'Size -';
                                const qty = Number(item.quantity || 1);
                                const itemPrice = pickNumber(item.unitPrice, item.price, item.amount, item.total, item.lineTotal, item.subtotal);
                                const lineTotal = Number.isFinite(itemPrice) ? `AED ${(itemPrice * qty).toLocaleString()}` : `x${qty}`;
                                const identityLabel = resolveItemIdentity(item, name);
                                return `<div class="order-item-row"><div class="order-item-main"><div class="order-item-name">${escapeHtml(name)}</div><div class="order-item-meta">${escapeHtml(size)} · Qty ${qty}</div><div class="order-item-identity">${escapeHtml(identityLabel)}</div></div><div class="order-item-value">${escapeHtml(lineTotal)}</div></div>`;
                            }).join('') : '<div class="order-item-row"><div class="order-item-main"><div class="order-item-name">-</div><div class="order-item-meta">No items</div></div><div class="order-item-value">-</div></div>'}
                        </div>
                    </section>
                    <div class="order-detail-actions-bottom">
                        <div class="order-detail-actions-meta">Secure update channel</div>
                        <div class="order-detail-action-buttons">
                            <button type="button" class="order-detail-edit-btn" id="toggleOrderEdit">Edit details</button>
                            <button class="btn-track-send" id="sendTrackingBtn">Save updates</button>
                        </div>
                    </div>
                </div>
            `;

            detailPage.classList.remove('editing');
            detailPage.classList.add('active');
            detailPage.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            document.documentElement.classList.add('order-deeplink');
            window.requestAnimationFrame(enforceOrdersTextBlack);
            const url = new URL(window.location.href);
            const orderKey = order.orderNumber || order._id || id;
            if (orderKey) {
                url.searchParams.set('order', orderKey);
                history.replaceState({}, '', url);
            }

            let onEscKeydown = null;
            const close = () => {
                detailPage.classList.remove('active');
                detailPage.classList.remove('editing');
                detailPage.setAttribute('aria-hidden', 'true');
                if (onEscKeydown) {
                    document.removeEventListener('keydown', onEscKeydown);
                    onEscKeydown = null;
                }
                const currentUrl = new URL(window.location.href);
                currentUrl.searchParams.delete('order');
                history.replaceState({}, '', currentUrl);
                detailPage.__closeCleanupTimer = window.setTimeout(() => {
                    detailPage.innerHTML = '';
                    document.body.style.overflow = '';
                    document.documentElement.classList.remove('order-deeplink');
                    detailPage.__closeCleanupTimer = null;
                }, 220);
            };

            detailPage.querySelector('.order-detail-back')?.addEventListener('click', close);
            onEscKeydown = (event) => {
                if (event.key === 'Escape') {
                    close();
                }
            };
            document.addEventListener('keydown', onEscKeydown);

            const actionsMeta = detailPage.querySelector('.order-detail-actions-meta');
            const setActionsMetaText = (value) => {
                if (actionsMeta) actionsMeta.textContent = value;
            };
            setActionsMetaText('Secure update channel');

            const toggleEditBtn = detailPage.querySelector('#toggleOrderEdit');
            if (toggleEditBtn) {
                toggleEditBtn.addEventListener('click', () => {
                    const editing = detailPage.classList.toggle('editing');
                    toggleEditBtn.textContent = editing ? 'Done' : 'Edit details';
                    setActionsMetaText(editing ? 'Edit mode enabled' : 'Secure update channel');
                });
            }

            const trackingLive = detailPage.querySelector('#trackingLiveStatus');
            const trackingNumberValue = order.trackingNumber || '';
            const resolveTrackingTone = (statusValue) => {
                const value = String(statusValue || '').toLowerCase();
                if (/delivered|completed|complete/.test(value)) return 'tone-delivered';
                if (/transit|out for delivery|shipped|picked|in progress/.test(value)) return 'tone-transit';
                if (/exception|failed|delay|cancel|return|hold|problem/.test(value)) return 'tone-issue';
                return 'tone-pending';
            };
            const renderTrackingLoading = (message = 'Loading live tracking...') => {
                if (!trackingLive) return;
                trackingLive.innerHTML = `
                    <div class="tracking-live-loading">
                        <div class="tracking-loading-top">${escapeHtml(message)}</div>
                        <div class="tracking-loading-bars">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                `;
            };
            const renderTrackingLive = (summary) => {
                if (!trackingLive) return;
                const statusLabel = summary?.status ? String(summary.status) : 'Pending';
                const statusTone = resolveTrackingTone(statusLabel);
                const lastScan = summary.lastScan
                    ? `${summary.lastScan.description}${summary.lastScan.location ? ` · ${summary.lastScan.location}` : ''}${summary.lastScan.date ? ` · ${summary.lastScan.date}` : ''}`
                    : 'No scans yet.';
                const scans = Array.isArray(summary.scans) ? summary.scans : [];
                const historyMarkup = scans.length
                    ? scans.map((scan, index) => {
                        const scanTitle = String(scan.description || 'Scan update');
                        const scanMeta = [scan.location, scan.date].filter(Boolean).join(' · ') || 'No location details';
                        return `
                            <div class="tracking-timeline-item${index === 0 ? ' is-latest' : ''}">
                                <div class="tracking-timeline-node" aria-hidden="true"></div>
                                <div>
                                    <div class="tracking-timeline-title">${escapeHtml(scanTitle)}</div>
                                    <div class="tracking-timeline-meta">${escapeHtml(scanMeta)}</div>
                                </div>
                            </div>
                        `;
                    }).join('')
                    : '<div class="tracking-empty-note">No scan history available yet.</div>';
                trackingLive.innerHTML = `
                    <div class="tracking-live-grid">
                        <div class="tracking-live-stat">
                            <span>Status</span>
                            <div class="tracking-live-stat-value"><span class="tracking-status-pill ${statusTone}">${escapeHtml(statusLabel)}</span></div>
                        </div>
                        <div class="tracking-live-stat">
                            <span>Last Scan</span>
                            <div class="tracking-live-stat-value">${escapeHtml(lastScan)}</div>
                        </div>
                        <div class="tracking-live-stat">
                            <span>Estimated Delivery</span>
                            <div class="tracking-live-stat-value">${escapeHtml(summary.estimatedDelivery || 'Pending')}</div>
                        </div>
                    </div>
                    <div class="tracking-history-panel">
                        <div class="tracking-history-title">Scan Timeline</div>
                        <div class="tracking-timeline">${historyMarkup}</div>
                    </div>
                `;
                window.requestAnimationFrame(enforceOrdersTextBlack);
            };

            if (trackingLive && trackingNumberValue) {
                renderTrackingLoading();
                fetch(`${API_BASE}/api/fedex-track`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ trackingNumber: trackingNumberValue })
                })
                    .then(res => res.json().then(data => ({ ok: res.ok, data })))
                    .then(({ ok, data }) => {
                        if (!ok || !data?.summary) {
                            throw new Error(data?.error || 'Unable to load tracking.');
                        }
                        renderTrackingLive(data.summary);
                    })
                    .catch((error) => {
                        trackingLive.innerHTML = `<div class="tracking-empty-note">${escapeHtml(error.message || 'Unable to load tracking.')}</div>`;
                    });
            } else if (trackingLive) {
                trackingLive.innerHTML = '<div class="tracking-empty-note">Add a tracking number to load live tracking updates.</div>';
            }

            const sendBtn = detailPage.querySelector('#sendTrackingBtn');
            if (sendBtn) {
                const originalSendText = sendBtn.textContent;
                const setSaveState = (saving) => {
                    sendBtn.disabled = saving;
                    sendBtn.textContent = saving ? 'Saving...' : originalSendText;
                    sendBtn.style.opacity = saving ? '0.72' : '1';
                    sendBtn.style.cursor = saving ? 'wait' : '';
                };
                sendBtn.addEventListener('click', () => {
                    setSaveState(true);
                    setActionsMetaText('Saving updates...');
                    const trackingNumber = detailPage.querySelector('#trackingNumberInput').value.trim();
                    const phoneValue = detailPage.querySelector('#orderPhoneInput')?.value.trim() || '';
                    const addressValue = detailPage.querySelector('#orderAddressInput')?.value.trim() || '';
                    const zipValue = detailPage.querySelector('#orderZipInput')?.value.trim() || '';
                    const cityValue = detailPage.querySelector('#orderCityInput')?.value.trim() || '';
                    const countryValue = detailPage.querySelector('#orderCountryInput')?.value.trim() || '';

                    const payload = {
                        orderNumber: order.orderNumber || undefined,
                        paymentIntentId: order.paymentIntentId || undefined,
                        updates: {
                            trackingNumber,
                            phone: phoneValue,
                            address: addressValue,
                            zip: zipValue,
                            city: cityValue,
                            country: countryValue
                        }
                    };
                    if (trackingNumber) {
                        payload.updates.orderStatus = 'shipped';
                    }

                    adminFetch(`${API_BASE}/api/admin/orders/update`, {
                        method: 'POST',
                        headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                        body: JSON.stringify(payload)
                    })
                        .then(res => res.json().then(data => ({ ok: res.ok, data })))
                        .then(({ ok, data }) => {
                            if (!ok) {
                                throw new Error(data.error || 'Unable to update order');
                            }

                            order.trackingNumber = trackingNumber;
                            if (trackingNumber) {
                                order.orderStatus = 'shipped';
                                order.status = 'shipped';
                            }
                            order.phone = phoneValue;
                            order.address = addressValue;
                            order.zip = zipValue;
                            order.city = cityValue;
                            order.country = countryValue;
                            const phoneDisplay = detailPage.querySelector('#orderPhoneDisplay');
                            if (phoneDisplay) {
                                phoneDisplay.textContent = phoneValue || '-';
                            }
                            const shipAddressDisplay = detailPage.querySelector('#orderShipAddressDisplay');
                            const shipZipDisplay = detailPage.querySelector('#orderShipZipDisplay');
                            const shipCityDisplay = detailPage.querySelector('#orderShipCityDisplay');
                            const shipCountryDisplay = detailPage.querySelector('#orderShipCountryDisplay');
                            if (shipAddressDisplay) shipAddressDisplay.textContent = addressValue || '';
                            if (shipZipDisplay) shipZipDisplay.textContent = zipValue || '';
                            if (shipCityDisplay) shipCityDisplay.textContent = cityValue || '';
                            if (shipCountryDisplay) shipCountryDisplay.textContent = countryValue || '';

                            const serverOrder = data && typeof data.order === 'object' ? data.order : null;
                            const nextOrder = serverOrder ? { ...order, ...serverOrder } : { ...order };
                            const matchedIndex = orders.findIndex((candidate) =>
                                isSameOrderRecord(candidate, nextOrder) || isSameOrderRecord(candidate, order)
                            );
                            if (matchedIndex >= 0) {
                                orders[matchedIndex] = {
                                    ...orders[matchedIndex],
                                    ...nextOrder
                                };
                            } else {
                                orders.unshift(nextOrder);
                            }
                            localStorage.setItem('ghoharyOrders', JSON.stringify(orders));
                            renderOrdersTable();
                            showAlert('Order details saved.', 'success');
                            setSaveState(false);
                            setActionsMetaText(detailPage.classList.contains('editing') ? 'Edit mode enabled' : 'Secure update channel');
                            window.requestAnimationFrame(enforceOrdersTextBlack);

                            if (trackingLive && trackingNumber) {
                                renderTrackingLoading();
                                fetch(`${API_BASE}/api/fedex-track`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ trackingNumber })
                                })
                                    .then(res => res.json().then(data => ({ ok: res.ok, data })))
                                    .then(({ ok, data }) => {
                                        if (!ok || !data?.summary) {
                                            throw new Error(data?.error || 'Unable to load tracking.');
                                        }
                                        renderTrackingLive(data.summary);
                                        window.requestAnimationFrame(enforceOrdersTextBlack);
                                    })
                                    .catch((error) => {
                                        trackingLive.innerHTML = `<div class="tracking-empty-note">${escapeHtml(error.message || 'Unable to load tracking.')}</div>`;
                                    });
                            } else if (trackingLive) {
                                trackingLive.innerHTML = '<div class="tracking-empty-note">Add a tracking number to load live tracking updates.</div>';
                            }
                        })
                        .catch((error) => {
                            setSaveState(false);
                            setActionsMetaText(detailPage.classList.contains('editing') ? 'Edit mode enabled' : 'Secure update channel');
                            showAlert(error.message || 'Unable to update order', 'error');
                        });
                });
            }
        }

        // Size Button Selection
        function findSizeButton(sizeValue) {
            return Array.from(document.querySelectorAll('.size-btn')).find((btn) => (
                String(btn.getAttribute('data-size') || '') === String(sizeValue || '')
            )) || null;
        }

        function normalizeSizeInventory(value, fallback = 1) {
            const parsed = Number(value);
            if (!Number.isFinite(parsed)) return fallback;
            return Math.max(0, Math.round(parsed));
        }

        function resetBaseSizeButtons() {
            document.querySelectorAll('.size-btn').forEach((btn) => {
                btn.classList.remove('active');
                delete btn.dataset.inventory;
                delete btn.dataset.price;
                if (btn.dataset.custom === 'true') {
                    btn.remove();
                }
            });
        }

        function renderSizeInventoryMatrix(selectedButtons = []) {
            const matrix = document.getElementById('sizeInventoryMatrix');
            if (!matrix) return;
            const safeButtons = Array.isArray(selectedButtons)
                ? selectedButtons
                : Array.from(selectedButtons || []);

            if (!safeButtons.length) {
                matrix.innerHTML = '<div class="size-inventory-empty">Select sizes to set inventory per size.</div>';
                return;
            }

            let totalInventory = 0;
            const rowsHtml = safeButtons.map((btn) => {
                const sizeValue = String(btn.getAttribute('data-size') || '').trim();
                const inventoryValue = normalizeSizeInventory(btn.dataset.inventory, 1);
                btn.dataset.inventory = String(inventoryValue);
                totalInventory += inventoryValue;
                return `
                    <div class="size-inventory-row" data-size="${escapeHtml(sizeValue)}">
                        <span class="size-inventory-size">Size ${escapeHtml(sizeValue)}</span>
                        <div class="size-inventory-controls">
                            <button type="button" class="size-inventory-step" data-size="${escapeHtml(sizeValue)}" data-step="-1" aria-label="Decrease inventory">-</button>
                            <input type="number" class="size-inventory-input" data-size="${escapeHtml(sizeValue)}" value="${inventoryValue}" min="0" step="1" inputmode="numeric" aria-label="Inventory for size ${escapeHtml(sizeValue)}">
                            <button type="button" class="size-inventory-step" data-size="${escapeHtml(sizeValue)}" data-step="1" aria-label="Increase inventory">+</button>
                        </div>
                    </div>
                `;
            }).join('');

            matrix.innerHTML = `
                <div class="size-inventory-head">
                    <span>Size Inventory</span>
                    <div class="size-inventory-head-actions">
                        <button type="button" class="size-inventory-bulk-btn" data-bulk="1">Set 1</button>
                        <button type="button" class="size-inventory-bulk-btn" data-bulk="3">Set 3</button>
                        <button type="button" class="size-inventory-bulk-btn" data-bulk="0">Clear</button>
                        <span class="size-inventory-total">Total ${totalInventory}</span>
                    </div>
                </div>
                <div class="size-inventory-grid">${rowsHtml}</div>
            `;
        }

        function attachSizeButtonHandler(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                this.classList.toggle('active');
                if (this.classList.contains('active') && this.dataset.inventory === undefined) {
                    this.dataset.inventory = '1';
                }
                updateSelectedSizesDisplay();
            });
        }

        document.querySelectorAll('.size-btn').forEach(btn => attachSizeButtonHandler(btn));

        const addCustomSizeBtn = document.getElementById('addCustomSize');
        const customSizeInput = document.getElementById('customSizeInput');
        const clearSizesBtn = document.getElementById('clearSizes');
        const sizeSelector = document.getElementById('sizeSelector');
        const sizeInventoryMatrix = document.getElementById('sizeInventoryMatrix');

        if (sizeInventoryMatrix && !sizeInventoryMatrix.dataset.bound) {
            sizeInventoryMatrix.dataset.bound = 'true';
            sizeInventoryMatrix.addEventListener('click', (event) => {
                const bulkBtn = event.target.closest('.size-inventory-bulk-btn[data-bulk]');
                if (bulkBtn) {
                    event.preventDefault();
                    const bulkValue = normalizeSizeInventory(bulkBtn.getAttribute('data-bulk'), 0);
                    const activeButtons = Array.from(document.querySelectorAll('.size-btn.active'));
                    activeButtons.forEach((btn) => {
                        btn.dataset.inventory = String(bulkValue);
                    });
                    renderSizeInventoryMatrix(activeButtons);
                    updateProductComposerIndicators();
                    return;
                }
                const stepBtn = event.target.closest('.size-inventory-step[data-size][data-step]');
                if (!stepBtn) return;
                event.preventDefault();
                const sizeValue = String(stepBtn.getAttribute('data-size') || '').trim();
                const stepValue = Number(stepBtn.getAttribute('data-step'));
                const targetBtn = findSizeButton(sizeValue);
                if (!targetBtn) return;
                const currentInventory = normalizeSizeInventory(targetBtn.dataset.inventory, 1);
                const nextInventory = normalizeSizeInventory(currentInventory + (Number.isFinite(stepValue) ? stepValue : 0), 0);
                targetBtn.dataset.inventory = String(nextInventory);
                renderSizeInventoryMatrix(Array.from(document.querySelectorAll('.size-btn.active')));
                updateProductComposerIndicators();
            });

            sizeInventoryMatrix.addEventListener('input', (event) => {
                const inventoryInput = event.target.closest('.size-inventory-input[data-size]');
                if (!inventoryInput) return;
                const sizeValue = String(inventoryInput.getAttribute('data-size') || '').trim();
                const targetBtn = findSizeButton(sizeValue);
                if (!targetBtn) return;
                const rawValue = String(inventoryInput.value || '').trim();
                if (!rawValue) {
                    targetBtn.dataset.inventory = '0';
                    updateProductComposerIndicators();
                    return;
                }
                targetBtn.dataset.inventory = String(normalizeSizeInventory(rawValue, 0));
                updateProductComposerIndicators();
            });

            sizeInventoryMatrix.addEventListener('change', (event) => {
                const inventoryInput = event.target.closest('.size-inventory-input[data-size]');
                if (!inventoryInput) return;
                const sizeValue = String(inventoryInput.getAttribute('data-size') || '').trim();
                const targetBtn = findSizeButton(sizeValue);
                if (!targetBtn) return;
                const normalizedValue = normalizeSizeInventory(inventoryInput.value, 0);
                targetBtn.dataset.inventory = String(normalizedValue);
                renderSizeInventoryMatrix(Array.from(document.querySelectorAll('.size-btn.active')));
                updateProductComposerIndicators();
            });
        }

        if (addCustomSizeBtn && customSizeInput && sizeSelector) {
            addCustomSizeBtn.addEventListener('click', (e) => {
                e.preventDefault();
                const value = customSizeInput.value.trim();
                if (!value) return;
                const existing = sizeSelector.querySelector(`.size-btn[data-size="${value}"]`);
                if (existing) {
                    existing.classList.add('active');
                    updateSelectedSizesDisplay();
                    customSizeInput.value = '';
                    return;
                }
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'size-btn';
                btn.dataset.size = value;
                btn.dataset.custom = 'true';
                btn.textContent = value;
                attachSizeButtonHandler(btn);
                sizeSelector.appendChild(btn);
                btn.classList.add('active');
                customSizeInput.value = '';
                updateSelectedSizesDisplay();
            });
        }

        if (clearSizesBtn) {
            clearSizesBtn.addEventListener('click', (e) => {
                e.preventDefault();
                document.querySelectorAll('.size-btn').forEach(btn => {
                    btn.classList.remove('active');
                    delete btn.dataset.inventory;
                    delete btn.dataset.price;
                    if (btn.dataset.custom === 'true') {
                        btn.remove();
                    }
                });
                updateSelectedSizesDisplay();
            });
        }

        updateSelectedSizesDisplay();

        function updateSelectedSizesDisplay() {
            const selectedBtns = Array.from(document.querySelectorAll('.size-btn.active'));
            const selectedSizes = selectedBtns.map(btn => btn.getAttribute('data-size'));
            const display = document.getElementById('selectedSizes');

            if (display) {
                if (selectedSizes.length) {
                    display.style.display = 'flex';
                    display.innerHTML = selectedSizes
                        .map(size => `<button type="button" class="size-chip" data-size="${size}">Size ${size} ×</button>`)
                        .join(' ');
                } else {
                    display.innerHTML = '';
                    display.style.display = 'none';
                }

                display.querySelectorAll('.size-chip').forEach(chip => {
                    chip.addEventListener('click', () => {
                        const sizeValue = chip.getAttribute('data-size');
                        const btn = document.querySelector(`.size-btn[data-size="${sizeValue}"]`);
                        if (btn) {
                            btn.classList.remove('active');
                            if (btn.dataset.custom === 'true') {
                                btn.remove();
                            }
                        }
                        updateSelectedSizesDisplay();
                    });
                });
            }
            renderSizeInventoryMatrix(selectedBtns);
            updateProductComposerIndicators();
        }

        // Image Preview and Reordering
        const productImagesInput = document.getElementById('productImages');
        const imagePreviewContainer = document.getElementById('imagePreview');
        const productVideosInput = document.getElementById('productVideos');
        const videoPreviewContainer = document.getElementById('videoPreview');

        const inferContentType = (file) => {
            if (file && file.type) return file.type;
            const name = (file && file.name ? file.name : '').toLowerCase();
            if (name.endsWith('.jpg') || name.endsWith('.jpeg')) return 'image/jpeg';
            if (name.endsWith('.png')) return 'image/png';
            if (name.endsWith('.webp')) return 'image/webp';
            if (name.endsWith('.heic')) return 'image/heic';
            if (name.endsWith('.heif')) return 'image/heif';
            if (name.endsWith('.avif')) return 'image/avif';
            if (name.endsWith('.gif')) return 'image/gif';
            if (name.endsWith('.mp4')) return 'video/mp4';
            if (name.endsWith('.webm')) return 'video/webm';
            if (name.endsWith('.mov')) return 'video/quicktime';
            return '';
        };
        const normalizeUploadErrorMessage = (error, fallback = 'Upload failed') => {
            const rawMessage = String(error?.message || error || '').trim();
            if (!rawMessage) return fallback;
            try {
                const parsed = JSON.parse(rawMessage);
                if (parsed && typeof parsed === 'object') {
                    const detail = String(parsed.error || parsed.message || '').trim();
                    if (detail) return detail;
                }
            } catch (_) {
                // Not JSON, use raw message.
            }
            return rawMessage.length > 240 ? `${rawMessage.slice(0, 237)}...` : rawMessage;
        };

        const uploadViaApiUpload = async (file, contentType, label) => {
            const filename = encodeURIComponent(file.name || `${label}-${Date.now()}`);
            if (label === 'image') {
                setUploadProgress(12, `Uploading ${file.name || 'image'}...`);
            } else {
                setVideoProgress(12, `Uploading ${file.name || 'video'}...`);
            }
            const response = await adminFetch(`${API_BASE}/api/upload?filename=${filename}`, {
                method: 'POST',
                headers: buildAdminHeaders({ 'content-type': contentType }),
                body: await file.arrayBuffer()
            });
            if (!response.ok) {
                let detail = '';
                try {
                    const payload = await response.json();
                    detail = String(payload?.error || payload?.message || '').trim();
                } catch (_) {
                    try {
                        detail = String(await response.text()).trim();
                    } catch (__){
                        detail = '';
                    }
                }
                throw new Error(detail || `Upload failed (${response.status})`);
            }
            const data = await response.json();
            if (label === 'image') {
                setUploadProgress(100, 'Upload complete');
            } else {
                setVideoProgress(100, 'Upload complete');
            }
            return data?.url || null;
        };

        const readFileAsDataUrl = (file, maxBytes = Number.POSITIVE_INFINITY) => new Promise((resolve, reject) => {
            try {
                if (!file || !file.size) return resolve(null);
                if (file.size > maxBytes) return resolve(null);
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result || null);
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(file);
            } catch (error) {
                reject(error);
            }
        });

        const imageDropzone = document.getElementById('imageDropzone');
        const uploadProgress = document.getElementById('uploadProgress');
        const uploadProgressText = document.getElementById('uploadProgressText');
        const uploadProgressBar = uploadProgress ? uploadProgress.querySelector('span') : null;
        const videoDropzone = document.getElementById('videoDropzone');
        const videoUploadProgress = document.getElementById('videoUploadProgress');
        const videoUploadProgressText = document.getElementById('videoUploadProgressText');
        const videoUploadProgressBar = videoUploadProgress ? videoUploadProgress.querySelector('span') : null;
        const videoUrlInput = document.getElementById('videoUrlInput');
        const addVideoUrlBtn = document.getElementById('addVideoUrl');

        function setUploadProgress(percent, label) {
            if (!uploadProgress) return;
            uploadProgress.classList.add('active');
            if (uploadProgressBar) {
                uploadProgressBar.style.width = `${Math.max(0, Math.min(100, percent))}%`;
            }
            if (uploadProgressText) {
                uploadProgressText.textContent = label || 'Uploading...';
            }
            if (percent >= 100 && activeUploads === 0) {
                setTimeout(() => {
                    uploadProgress.classList.remove('active');
                }, 900);
            }
        }

        function setVideoProgress(percent, label) {
            if (!videoUploadProgress) return;
            videoUploadProgress.classList.add('active');
            if (videoUploadProgressBar) {
                videoUploadProgressBar.style.width = `${Math.max(0, Math.min(100, percent))}%`;
            }
            if (videoUploadProgressText) {
                videoUploadProgressText.textContent = label || 'Uploading...';
            }
            if (percent >= 100 && activeVideoUploads === 0) {
                setTimeout(() => {
                    videoUploadProgress.classList.remove('active');
                }, 900);
            }
        }

        async function addImageFiles(newFiles) {
            if (!newFiles.length) return;
            const remainingSlots = Math.max(0, 10 - imageFiles.length);
            if (remainingSlots === 0) {
                showAlert('You can upload up to 10 images', 'error');
                return;
            }
            const filesToAdd = newFiles.slice(0, remainingSlots);
            let addedCount = 0;
            let uploadedCount = 0;
            let localOnlyCount = 0;

            for (const file of filesToAdd) {
                const localUrl = await readFileAsDataUrl(file);
                if (!localUrl) continue;
                const insertionIndex = imageFiles.length;
                imageFiles.push(localUrl);
                imageAltTexts.push('');
                addedCount += 1;
                renderImagePreview();

                const uploadedUrl = await uploadImageFile(file);
                if (uploadedUrl) {
                    imageFiles[insertionIndex] = uploadedUrl;
                    uploadedCount += 1;
                } else {
                    localOnlyCount += 1;
                }
            }

            if (addedCount === 0) {
                showAlert('Unable to add images. Please try again or use smaller files.', 'error');
            }
            selectedImageIndex = -1;
            renderImagePreview();
        }

        async function addVideoFiles(newFiles) {
            if (!newFiles.length) return;
            const remainingSlots = Math.max(0, 5 - videoFiles.length);
            if (remainingSlots === 0) {
                showAlert('You can upload up to 5 videos', 'error');
                return;
            }
            const filesToAdd = newFiles.slice(0, remainingSlots);
            const uploadResults = await Promise.all(filesToAdd.map((file) => uploadVideoFile(file)));
            uploadResults.forEach((uploadResult) => {
                if (uploadResult) {
                    videoFiles.push(uploadResult);
                }
            });
            renderVideoPreview();
        }

        function addVideoUrl(url) {
            if (!url) return;
            const trimmed = url.trim();
            if (!trimmed) return;
            if (videoFiles.length >= 5) {
                showAlert('You can upload up to 5 videos', 'error');
                return;
            }
            videoFiles.push(trimmed);
            renderVideoPreview();
        }

        if (productImagesInput) {
            productImagesInput.addEventListener('change', async function() {
                const selectedFiles = Array.from(this.files || []);
                if (!selectedFiles.length) return;
                await addImageFiles(selectedFiles);
                this.value = '';
            });
        }

        if (productVideosInput) {
            productVideosInput.addEventListener('change', async function() {
                await addVideoFiles(Array.from(this.files));
                this.value = '';
            });
        }

        if (addVideoUrlBtn && videoUrlInput) {
            addVideoUrlBtn.addEventListener('click', (e) => {
                e.preventDefault();
                addVideoUrl(videoUrlInput.value);
                videoUrlInput.value = '';
            });
        }

        if (imageDropzone && productImagesInput) {
            const openImagePicker = () => {
                if (typeof productImagesInput.showPicker === 'function') {
                    productImagesInput.showPicker();
                } else {
                    productImagesInput.click();
                }
            };
            imageDropzone.addEventListener('click', (e) => {
                const clickTarget = e.target instanceof Element ? e.target : null;
                if (clickTarget && clickTarget.closest('label[for="productImages"]')) return;
                openImagePicker();
            });
            imageDropzone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    openImagePicker();
                }
            });
            imageDropzone.addEventListener('dragover', (e) => {
                e.preventDefault();
                imageDropzone.classList.add('drag-over');
            });
            imageDropzone.addEventListener('dragleave', () => {
                imageDropzone.classList.remove('drag-over');
            });
            imageDropzone.addEventListener('drop', async (e) => {
                e.preventDefault();
                imageDropzone.classList.remove('drag-over');
                const droppedFiles = Array.from(e.dataTransfer.files || []).filter(file => {
                    const contentType = inferContentType(file);
                    return contentType.startsWith('image/');
                });
                await addImageFiles(droppedFiles);
            });
        }

        if (videoDropzone && productVideosInput) {
            videoDropzone.addEventListener('click', () => productVideosInput.click());
            videoDropzone.addEventListener('dragover', (e) => {
                e.preventDefault();
                videoDropzone.classList.add('drag-over');
            });
            videoDropzone.addEventListener('dragleave', () => {
                videoDropzone.classList.remove('drag-over');
            });
            videoDropzone.addEventListener('drop', async (e) => {
                e.preventDefault();
                videoDropzone.classList.remove('drag-over');
                const droppedFiles = Array.from(e.dataTransfer.files || []).filter(file => {
                    const contentType = inferContentType(file);
                    return contentType.startsWith('video/');
                });
                await addVideoFiles(droppedFiles);
            });
        }

        function renderImagePreview() {
            if (!imagePreviewContainer) return;
            imagePreviewContainer.innerHTML = '';
            const fragment = document.createDocumentFragment();

            imageFiles.forEach((url, index) => {
                const item = renderImageItem(url, index, url, imageAltTexts[index] || '');
                if (item) fragment.appendChild(item);
            });
            imagePreviewContainer.appendChild(fragment);
            updateProductComposerIndicators();
            queueProductDraftSave();
        }

        function renderVideoPreview() {
            if (!videoPreviewContainer) return;
            videoPreviewContainer.innerHTML = '';
            videoFiles.forEach((url, index) => {
                renderVideoItem(url, index);
            });
            queueProductDraftSave();
        }

        async function uploadImageFile(file) {
            try {
                const contentType = inferContentType(file);
                if (!contentType || !contentType.startsWith('image/')) {
                    showAlert('Unsupported image format. Use JPG, PNG, WEBP, HEIC, or AVIF.', 'error');
                    return null;
                }
                activeUploads += 1;
                setUploadProgress(6, `Preparing ${file.name || 'image'}...`);
                let directUrl = null;
                let lastUploadError = null;
                try {
                    directUrl = await uploadViaApiUpload(file, contentType, 'image');
                } catch (apiError) {
                    lastUploadError = apiError;
                }
                if (!directUrl) {
                    // Final fallback: inline image as data URL so add/edit product still works.
                    try {
                        const dataUrl = await readFileAsDataUrl(file);
                        if (dataUrl) {
                            directUrl = dataUrl;
                            console.warn('[Admin] Using inline image fallback (data URL).');
                        }
                    } catch (inlineError) {
                        lastUploadError = inlineError;
                    }
                }
                if (!directUrl) {
                    throw (lastUploadError || new Error('Upload failed'));
                }
                activeUploads = Math.max(0, activeUploads - 1);
                if (activeUploads === 0) setUploadProgress(100, 'Upload complete');
                return directUrl || null;
            } catch (error) {
                activeUploads = Math.max(0, activeUploads - 1);
                setUploadProgress(0, 'Upload failed');
                showAlert(`Upload failed: ${normalizeUploadErrorMessage(error, 'Unable to upload image.')}`, 'error');
                return null;
            }
        }

        async function uploadVideoFile(file) {
            try {
                const contentType = inferContentType(file);
                if (!contentType || !contentType.startsWith('video/')) {
                    showAlert('Unsupported video format. Use MP4, MOV, or WEBM.', 'error');
                    return null;
                }
                activeVideoUploads += 1;
                setVideoProgress(6, `Preparing ${file.name || 'video'}...`);
                let directUrl = null;
                let lastUploadError = null;
                try {
                    directUrl = await uploadViaApiUpload(file, contentType, 'video');
                } catch (apiError) {
                    lastUploadError = apiError;
                }
                if (!directUrl) {
                    throw (lastUploadError || new Error('Upload failed'));
                }
                activeVideoUploads = Math.max(0, activeVideoUploads - 1);
                if (activeVideoUploads === 0) setVideoProgress(100, 'Upload complete');
                return directUrl || null;
            } catch (error) {
                activeVideoUploads = Math.max(0, activeVideoUploads - 1);
                setVideoProgress(0, 'Upload failed');
                showAlert(`Upload failed: ${normalizeUploadErrorMessage(error, 'Unable to upload video.')}`, 'error');
                return null;
            }
        }

        function renderImageItem(file, index, imgSrc, altText = '') {
            const item = document.createElement('div');
            item.className = 'image-preview-item';
            item.draggable = true;
            item.file = file;
            item.dataset.index = index;
            const safeImgSrc = sanitizeMediaUrl(imgSrc) || '/placeholder.jpg';
            
            if (index === selectedImageIndex) {
                item.classList.add('selected');
            }
            
            // Use the provided imgSrc (data URL or URL string)
            item.innerHTML = `
                <img src="${escapeHtml(safeImgSrc)}" alt="Preview">
                <div class="image-preview-controls">
                    <button type="button" class="image-preview-btn remove" title="Remove image">&times;</button>
                </div>
            `;

            item.addEventListener('click', (e) => {
                e.stopPropagation();
                selectedImageIndex = index;
                renderImagePreview();
            });

            const removeBtn = item.querySelector('.remove');
            if (removeBtn) {
                removeBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    imageFiles.splice(index, 1);
                    imageAltTexts.splice(index, 1);
                    if (selectedImageIndex >= imageFiles.length) {
                        selectedImageIndex = imageFiles.length - 1;
                    }
                    renderImagePreview();
                });
            }

            item.addEventListener('dragstart', handleDragStart);
            item.addEventListener('dragover', handleDragOver);
            item.addEventListener('dragleave', handleDragLeave);
            item.addEventListener('drop', handleDrop);
            item.addEventListener('dragend', handleDragEnd);

            return item;
        }

        function renderVideoItem(url, index) {
            if (!videoPreviewContainer) return;
            const safeVideoUrl = sanitizeMediaUrl(url);
            if (!safeVideoUrl) return;
            const item = document.createElement('div');
            item.className = 'image-preview-item video-preview-item';
            item.dataset.index = index;
            item.innerHTML = `
                <span class="image-index">${index + 1}</span>
                <video src="${escapeHtml(safeVideoUrl)}" muted playsinline></video>
                <div class="image-preview-controls">
                    <button type="button" class="image-preview-btn move-left" title="Move left">←</button>
                    <button type="button" class="image-preview-btn move-right" title="Move right">→</button>
                    <button type="button" class="image-preview-btn remove" title="Remove video">&times;</button>
                </div>
            `;

            const moveLeftButton = item.querySelector('.move-left');
            const moveRightButton = item.querySelector('.move-right');
            if (moveLeftButton) {
                moveLeftButton.disabled = index === 0;
            }
            if (moveRightButton) {
                moveRightButton.disabled = index === videoFiles.length - 1;
            }

            item.querySelector('.remove').addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                videoFiles.splice(index, 1);
                renderVideoPreview();
            });

            item.querySelector('.move-left').addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (index > 0) {
                    [videoFiles[index - 1], videoFiles[index]] = [videoFiles[index], videoFiles[index - 1]];
                    renderVideoPreview();
                }
            });

            item.querySelector('.move-right').addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (index < videoFiles.length - 1) {
                    [videoFiles[index + 1], videoFiles[index]] = [videoFiles[index], videoFiles[index + 1]];
                    renderVideoPreview();
                }
            });

            videoPreviewContainer.appendChild(item);
        }

        let draggedItem = null;
        let draggedIndex = null;

        function handleDragStart(e) {
            draggedItem = this;
            draggedIndex = Array.from(imagePreviewContainer.children).indexOf(this);
            this.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/html', this.innerHTML);
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            
            // Visual feedback for drop position
            if (this !== draggedItem) {
                this.classList.add('drag-over');
            }
        }

        function handleDragLeave(e) {
            if (this !== draggedItem) {
                this.classList.remove('drag-over');
            }
        }

        function handleDrop(e) {
            e.preventDefault();
            this.classList.remove('drag-over');
            
            if (draggedItem && draggedItem !== this) {
                const allItems = Array.from(imagePreviewContainer.children);
                const targetIndex = allItems.indexOf(this);
                // Remove dragged item from array
                const draggedFile = imageFiles[draggedIndex];
                const draggedAlt = imageAltTexts[draggedIndex];
                imageFiles.splice(draggedIndex, 1);
                imageAltTexts.splice(draggedIndex, 1);
                
                // Insert at appropriate position
                imageFiles.splice(targetIndex, 0, draggedFile);
                imageAltTexts.splice(targetIndex, 0, draggedAlt);
                renderImagePreview();
            }
        }

        function handleDragEnd(e) {
            this.classList.remove('dragging');
            
            // Remove drag-over effect from all items
            document.querySelectorAll('.image-preview-item').forEach(item => {
                item.classList.remove('drag-over');
            });
            
            draggedItem = null;
            draggedIndex = null;
        }

        // ===== EXPORT/IMPORT FUNCTIONALITY =====
        const exportBtn = document.getElementById('exportBtn');
        const importBtn = document.getElementById('importBtn');
        const importFile = document.getElementById('importFile');
        const clearCacheBtn = document.getElementById('clearCacheBtn');
        const recoverOrderBtn = document.getElementById('recoverOrderBtn');

        if (exportBtn) {
            exportBtn.addEventListener('click', function(e) {
                e.preventDefault();
                try {
                    const dataStr = JSON.stringify(products, null, 2);
                    const dataBlob = new Blob([dataStr], { type: 'application/json' });
                    const url = URL.createObjectURL(dataBlob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `ghohary-products-${new Date().toISOString().split('T')[0]}.json`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);
                    showAlert('Products exported successfully!', 'success');
                } catch (error) {
                    showAlert('Error exporting products: ' + error.message, 'error');
                }
            });
        }

        if (importBtn) {
            importBtn.addEventListener('click', async function(e) {
                e.preventDefault();
                if (!importFile.files || importFile.files.length === 0) {
                    showAlert('Please select a file to import', 'error');
                    return;
                }

                const file = importFile.files[0];
                const reader = new FileReader();

                reader.onload = async function(e) {
                    try {
                        const importedData = JSON.parse(e.target.result);
                        
                        if (!Array.isArray(importedData)) {
                            showAlert('Invalid file format. Expected an array of products.', 'error');
                            return;
                        }

                        for (const importedProduct of importedData) {
                            if (importedProduct.id) {
                                const updateResponse = await adminFetch(`${API_BASE}/api/products/${importedProduct.id}`, {
                                    method: 'PUT',
                                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                                    body: JSON.stringify(importedProduct)
                                });
                                if (updateResponse.status === 404) {
                                    await adminFetch(`${API_BASE}/api/products`, {
                                        method: 'POST',
                                        headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                                        body: JSON.stringify(importedProduct)
                                    });
                                }
                            } else {
                                await adminFetch(`${API_BASE}/api/products`, {
                                    method: 'POST',
                                    headers: buildAdminHeaders({ 'Content-Type': 'application/json' }),
                                    body: JSON.stringify(importedProduct)
                                });
                            }
                        }
                        
                        // Clear import input
                        importFile.value = '';
                        
                        // Refresh display
                        loadProducts();
                        
                        showAlert(`Successfully imported ${importedData.length} product(s)!`, 'success');
                    } catch (error) {
                        showAlert('Error importing products: ' + error.message, 'error');
                    }
                };

                reader.readAsText(file);
            });
        }

        if (clearCacheBtn) {
            clearCacheBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if (!confirm('Clear cached catalog data on this device?')) {
                    return;
                }
                localStorage.removeItem('ghoharyCatalogCache');
                localStorage.removeItem('ghoharyProducts');
                localStorage.removeItem('ghoharyCatalogCacheVersion');
                localStorage.removeItem('ghoharySubcategoryFilter');
                showAlert('Catalog cache cleared. Reload collections to refresh.', 'success');
            });
        }

        if (recoverOrderBtn) {
            recoverOrderBtn.addEventListener('click', function(e) {
                e.preventDefault();
                recoverOrder();
            });
        }

    </script>

    <div id="orderDetailPage" class="order-detail-page" aria-hidden="true"></div>

    <!-- FINAL THEME OVERRIDE — parsed last, wins all cascade battles -->
    <style id="ghohary-clean-override">
        /* Kill dark body background — no exceptions */
        html, body,
        body.admin-orders-view, body.admin-products-view, body.admin-analytics-view,
        body.admin-custom-orders-view, body.admin-invoices-view, body.admin-settings-view,
        .order-deeplink body {
            background: #f5f5f5 !important;
            background-image: none !important;
        }

        /* Kill ALL pseudo-element effects on every element */
        *::before, *::after {
            background: none !important;
            background-image: none !important;
            box-shadow: none !important;
            animation: none !important;
            content: none !important;
            display: none !important;
            opacity: 0 !important;
        }

        /* Re-allow specific ::before/::after we NEED */
        .admin-menu-intro::before {
            content: 'GHOHARY' !important;
            display: block !important;
            font-size: 18px !important;
            font-weight: 600 !important;
            color: #fff !important;
            letter-spacing: 0.14em !important;
            margin-bottom: 4px !important;
            opacity: 1 !important;
        }

        .admin-menu-intro::after {
            content: 'Admin' !important;
            display: block !important;
            font-size: 11px !important;
            color: rgba(255,255,255,0.35) !important;
            letter-spacing: 0.08em !important;
            opacity: 1 !important;
        }

        /* Fixed left sidebar */
        .admin-header {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            bottom: 0 !important;
            width: 240px !important;
            height: 100vh !important;
            background: #000 !important;
            background-image: none !important;
            border: none !important;
            border-right: 1px solid rgba(255,255,255,0.06) !important;
            box-shadow: none !important;
            z-index: 100 !important;
            overflow-y: auto !important;
            display: flex !important;
            flex-direction: column !important;
        }

        /* Main content offset from sidebar */
        .container {
            margin-left: 240px !important;
            width: calc(100% - 240px) !important;
            max-width: none !important;
            background: #f5f5f5 !important;
            background-image: none !important;
            padding: clamp(20px, 3vw, 32px) !important;
            min-height: 100vh !important;
        }

        /* All text black in content area */
        .container, .container * { color: #000 !important; }

        /* Sidebar nav tabs */
        .admin-guided-tabs {
            display: flex !important;
            flex-direction: column !important;
            gap: 4px !important;
            padding: 0 !important;
            margin: 0 !important;
            flex-wrap: nowrap !important;
        }

        .admin-guided-tabs .tab-btn {
            width: 100% !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            color: rgba(255,255,255,0.5) !important;
            text-align: left !important;
            padding: 10px 12px !important;
            border-radius: 8px !important;
            cursor: pointer !important;
        }

        .admin-guided-tabs .tab-btn.active {
            background: rgba(255,255,255,0.1) !important;
            color: #fff !important;
        }

        /* Cards white */
        .fx-orders-card {
            background: #fff !important;
            border: 1px solid rgba(0,0,0,0.08) !important;
            box-shadow: none !important;
        }

        .orders-command-surface {
            background: #fff !important;
            border: 1px solid rgba(0,0,0,0.08) !important;
            box-shadow: none !important;
        }

        .order-table-block {
            background: #fff !important;
            border: 1px solid rgba(0,0,0,0.08) !important;
            box-shadow: none !important;
        }

        @media (max-width: 900px) {
            .admin-header {
                position: relative !important;
                width: 100% !important;
                height: auto !important;
                flex-direction: row !important;
                padding: 12px 16px !important;
            }
            .container {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }
    </style>
</body>
</html>
