            }

            body.admin-products-view.admin-add-product-view #products .size-inventory-row {
                flex-wrap: wrap;
            }

            body.admin-products-view.admin-add-product-view #products .size-inventory-controls {
                width: 100%;
                justify-content: flex-end;
            }
        }

        /* ===== Add Product Final Polish ===== */
        body.admin-products-view.admin-add-product-view,
        body.admin-products-view.admin-add-product-view .container {
            background:
                radial-gradient(1200px 520px at 12% -18%, rgba(238, 243, 252, 0.15), transparent 70%),
