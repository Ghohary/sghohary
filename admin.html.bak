        /* ===== Custom Orders High-Security Theme ===== */
        body.admin-custom-orders-view .container {
            background:
                radial-gradient(1200px 560px at 8% 8%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 60%),
                radial-gradient(900px 420px at 92% 88%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 62%),
                linear-gradient(180deg, #131a25 0%, #0e141d 100%) !important;
            position: relative;
            overflow: hidden;
        }

        body.admin-custom-orders-view .container::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
            background-size: 22px 22px;
            opacity: 0.34;
            pointer-events: none;
            z-index: 0;
        }

        body.admin-custom-orders-view .container > * {
            position: relative;
            z-index: 1;
        }

        #custom-orders.tab-content {
            margin-top: 0;
            padding: clamp(24px, 3.4vw, 34px);
            border-radius: 22px;
            border: 1px solid rgba(158, 193, 233, 0.30);
            background:
                linear-gradient(155deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 60%),
                linear-gradient(180deg, rgba(23, 27, 33, 0.84) 0%, rgba(16, 19, 24, 0.8) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 24px 48px rgba(4, 9, 15, 0.44),
                0 0 0 1px rgba(97, 129, 163, 0.16),
                0 0 34px rgba(106, 160, 222, 0.08);
            position: relative;
            overflow: hidden;
            -webkit-backdrop-filter: blur(8px) saturate(120%);
            backdrop-filter: blur(8px) saturate(120%);
        }

        #custom-orders.tab-content::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
            background-size: 18px 18px;
            opacity: 0.36;
            pointer-events: none;
        }

        #custom-orders.tab-content::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: -36%;
            height: 42%;
            background: linear-gradient(
                180deg,
                rgba(125, 190, 255, 0) 0%,
                rgba(125, 190, 255, 0.14) 45%,
                rgba(125, 190, 255, 0) 100%
            );
            opacity: 0.55;
            animation: ordersPanelSweep 8.6s ease-in-out infinite;
            pointer-events: none;
        }

        #custom-orders.tab-content > * {
            position: relative;
            z-index: 1;
        }

        #custom-orders,
        #custom-orders * {
            color: var(--admin-tech-text);
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        }

        #custom-orders h2 {
            font-size: clamp(24px, 2.5vw, 34px);
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #f3f8ff;
            margin-bottom: 22px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(166, 202, 241, 0.24);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        #custom-orders h2::after {
            content: none;
        }

        #custom-orders h2::before {
            content: 'ATELIER OPS';
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 26px;
            padding: 0 10px;
            border-radius: 999px;
            border: 1px solid rgba(166, 202, 241, 0.38);
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%);
            color: #dbeaff;
            font-size: 9px;
            letter-spacing: 0.16em;
            font-weight: 500;
            text-transform: uppercase;
            flex-shrink: 0;
        }

        #custom-orders .custom-order-layout {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
            gap: clamp(14px, 1.9vw, 20px);
        }

        #custom-orders .custom-order-card {
            border: 1px solid rgba(158, 193, 233, 0.30);
            border-radius: 18px;
            padding: clamp(16px, 2vw, 22px);
            background:
                linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.06),
                0 12px 26px rgba(4, 9, 15, 0.3);
            -webkit-backdrop-filter: blur(6px);
            backdrop-filter: blur(6px);
        }

        #custom-orders .custom-order-card h4 {
            margin: 0 0 10px;
            font-size: 12px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #aebed0;
            font-weight: 500;
            line-height: 1.3;
        }

        #custom-orders .custom-order-grid {
            gap: 12px;
        }

        #custom-orders .custom-order-grid.two-col {
            column-gap: 12px;
            row-gap: 12px;
        }

        #custom-orders .custom-order-stack h4 + .custom-order-grid {
            margin-bottom: 12px;
        }

        #custom-orders .custom-order-grid label,
        #custom-orders .custom-order-image label {
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #a6bdd7;
            margin-bottom: 8px;
            font-weight: 500;
            line-height: 1.25;
        }

        #custom-orders .custom-order-grid input,
        #custom-orders .custom-order-grid select,
        #custom-orders .custom-order-grid textarea,
        #custom-orders .custom-order-filters input,
        #custom-orders .custom-order-filters select {
            width: 100%;
            min-height: 44px;
            border-radius: 12px;
            border: 1px solid rgba(181, 201, 225, 0.34);
            background: rgba(10, 16, 24, 0.72);
            color: #eaf3ff;
            padding: 10px 12px;
            font-size: 14px;
            font-weight: 400;
            line-height: 1.35;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        #custom-orders .custom-order-grid input:focus,
        #custom-orders .custom-order-grid select:focus,
        #custom-orders .custom-order-grid textarea:focus,
        #custom-orders .custom-order-filters input:focus,
        #custom-orders .custom-order-filters select:focus {
            outline: none;
            border-color: rgba(184, 214, 247, 0.78);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 0 0 3px rgba(158, 193, 233, 0.16);
        }

        #custom-orders .custom-order-grid input::placeholder,
        #custom-orders .custom-order-grid textarea::placeholder,
        #custom-orders .custom-order-filters input::placeholder {
            color: rgba(201, 217, 236, 0.62);
