        body.admin-products-view.admin-add-product-view #products .product-primary-actions .back-to-products {
            border: 1px solid var(--ap-line-soft) !important;
            background: linear-gradient(180deg, rgba(45, 52, 64, 0.9) 0%, rgba(29, 34, 43, 0.96) 100%) !important;
            color: var(--ap-text-main) !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit {
            border: 1px solid rgba(247, 251, 255, 0.88) !important;
            background: linear-gradient(180deg, rgba(245, 249, 255, 0.99) 0%, rgba(202, 211, 226, 0.97) 100%) !important;
            color: #111824 !important;
