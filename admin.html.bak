        }

        .admin-header::before {
            opacity: 0.2 !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, rgba(104, 153, 233, 0) 0%, rgba(104, 153, 233, 0.82) 50%, rgba(104, 153, 233, 0) 100%) !important;
            box-shadow: none !important;
