        /* ===== Executive Future Override ===== */
        :root {
            --ef-ink: #e9f1ff;
            --ef-muted: #a8b8d1;
            --ef-line: rgba(134, 166, 214, 0.28);
            --ef-line-strong: rgba(191, 219, 255, 0.72);
            --ef-surface: #0f1a2b;
            --ef-surface-soft: #0b1322;
            --ef-accent: #3f7de0;
            --ef-accent-strong: #2456ae;
        }

        body {
            background:
                radial-gradient(980px 420px at -8% -10%, rgba(84, 129, 201, 0.28) 0%, rgba(84, 129, 201, 0) 62%),
                radial-gradient(860px 340px at 108% 108%, rgba(58, 98, 162, 0.22) 0%, rgba(58, 98, 162, 0) 64%),
                linear-gradient(180deg, #0a1220 0%, #050b15 100%) !important;
