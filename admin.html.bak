            color: #6f6f77 !important;
        }

        /* ===== Analytics Panel ===== */
        #analytics .analytics-command-surface {
            border: 1px solid #d1d1d8;
            border-radius: 16px;
            background: #ffffff;
            padding: 14px;
            display: grid;
            gap: 12px;
            margin-bottom: 14px;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        }

        #analytics,
        #analytics * {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
        }

        #analytics h2 {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-weight: 500;
            letter-spacing: 0.01em;
            text-transform: none;
            color: #111111;
        }

        #analytics .analytics-kpi-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        #analytics .analytics-kpi {
            border: 1px solid #d1d1d8;
            border-radius: 12px;
            background: #ffffff;
            padding: 10px 12px;
            display: grid;
            gap: 6px;
        }

        #analytics .analytics-kpi span {
            color: #66666f;
            font-size: 11px;
            letter-spacing: 0.04em;
            text-transform: none;
            font-weight: 500;
        }

        #analytics .analytics-kpi strong {
            color: #111111;
            font-size: clamp(20px, 2.2vw, 28px);
            line-height: 1;
            font-weight: 600;
            letter-spacing: 0;
        }

        #analytics .analytics-results-meta {
            color: #66666f;
            font-size: 12px;
        }

        #analytics .analytics-layout {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 12px;
        }

        #analytics .analytics-card {
            border: 1px solid #d1d1d8;
            border-radius: 16px;
            background: #ffffff;
            padding: 14px;
            display: grid;
            gap: 10px;
        }

        #analytics .analytics-card h4 {
            color: #111111;
            font-size: 12px;
            letter-spacing: 0.02em;
            text-transform: none;
            font-weight: 500;
        }

        #analytics .analytics-globe-card {
            grid-row: span 2;
        }

        #analytics .analytics-globe-stage {
            border: 1px solid #d1d1d8;
            border-radius: 14px;
            background: #ffffff;
            width: 100%;
            min-height: 380px;
            padding: 10px;
            display: grid;
            place-items: center;
        }

        #analytics #analyticsGlobeCanvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        #analytics .analytics-globe-caption {
            color: #66666f;
            font-size: 12px;
        }

        #analytics .analytics-list {
            border: 1px solid #d1d1d8;
            border-radius: 12px;
            background: #ffffff;
            max-height: 320px;
            overflow: auto;
        }

        #analytics .analytics-list-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 10px;
            align-items: center;
            padding: 10px 12px;
            border-bottom: 1px solid #ececf0;
        }

        #analytics .analytics-list-row:last-child {
            border-bottom: 0;
        }

        #analytics .analytics-list-main {
            min-width: 0;
            display: grid;
            gap: 4px;
        }

        #analytics .analytics-list-title {
            color: #111111;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #analytics .analytics-list-subtitle {
            color: #66666f;
            font-size: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #analytics .analytics-list-subtitle-secondary {
            color: #7a7a82;
            font-size: 11px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #analytics #analyticsLiveList {
            display: grid;
            gap: 0;
            padding: 0;
            background: #ffffff !important;
            border: 1px solid #d8d9e0;
            border-radius: 14px;
            overflow: hidden;
        }

        #analytics #analyticsLiveList .analytics-empty {
            background: #ffffff !important;
            padding: 14px 16px;
        }

        #analytics .analytics-live-row {
            display: flex;
            align-items: center;
            border-bottom: 1px solid #ececf2;
            background: #ffffff !important;
            padding: 5px 8px;
            min-height: 48px;
            transition: background 0.16s ease;
            cursor: default;
            user-select: text;
        }

        #analytics .analytics-live-row:last-child {
            border-bottom: 0;
        }

        #analytics .analytics-live-row:hover {
            background: #f8f8fa !important;
        }

        #analytics .analytics-live-row:focus-visible {
            outline: 1px solid #111111;
            outline-offset: -1px;
        }

        #analytics .analytics-live-main {
            min-width: 0;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 2px;
        }

        #analytics .analytics-live-head {
            display: flex;
            align-items: center;
            gap: 5px;
            min-width: 0;
        }

        #analytics .analytics-live-dot {
            width: 4px;
            height: 4px;
            border-radius: 999px;
            background: #111111;
            box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.08);
            flex-shrink: 0;
        }

        #analytics .analytics-visitor-number {
            color: #0f1115 !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            letter-spacing: 0.01em;
            line-height: 1.15 !important;
            white-space: nowrap;
            flex-shrink: 0;
        }

        #analytics .analytics-visitor-location {
            color: #2e3138 !important;
            font-size: 10px !important;
            font-weight: 500 !important;
            line-height: 1.2 !important;
            margin-left: auto;
            max-width: 58%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: right;
        }

        #analytics .analytics-visitor-page {
            color: #676b73 !important;
            font-size: 10px !important;
            font-weight: 400 !important;
            line-height: 1.2 !important;
            max-width: 100%;
            max-height: none;
            margin-top: 0;
            opacity: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: none;
            pointer-events: auto;
        }

        #analytics .analytics-list-meta {
            color: #444444;
            font-size: 11px;
            letter-spacing: 0.02em;
            text-transform: none;
            white-space: nowrap;
        }

        #analytics .analytics-empty {
            color: #66666f;
            font-size: 12px;
            padding: 14px;
        }

        @media (max-width: 1100px) {
            #analytics .analytics-kpi-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            #analytics .analytics-layout {
                grid-template-columns: 1fr;
            }

            #analytics .analytics-globe-card {
                grid-row: auto;
            }

            #analytics .analytics-globe-stage {
                min-height: 300px;
            }
        }

        /* Futuristic Analytics Override */
        @keyframes analyticsPanelPulse {
            0%, 100% {
                box-shadow: inset 0 0 0 1px rgba(155, 188, 240, 0.18), 0 18px 36px rgba(0, 0, 0, 0.34);
            }
            50% {
                box-shadow: inset 0 0 0 1px rgba(170, 205, 255, 0.3), 0 24px 44px rgba(0, 0, 0, 0.42);
            }
        }

        @keyframes analyticsScanSweep {
            0% {
                transform: translateX(-120%);
                opacity: 0;
            }
            28% {
                opacity: 0.45;
            }
            100% {
                transform: translateX(160%);
                opacity: 0;
            }
        }

        @keyframes analyticsGridDrift {
            0% {
                transform: translate3d(0, 0, 0);
            }
            100% {
                transform: translate3d(0, 20px, 0);
            }
        }

        body.admin-analytics-view {
            background:
                radial-gradient(circle at 14% 4%, rgba(86, 130, 215, 0.24) 0%, rgba(86, 130, 215, 0) 36%),
                radial-gradient(circle at 82% 12%, rgba(72, 104, 168, 0.2) 0%, rgba(72, 104, 168, 0) 38%),
                linear-gradient(180deg, #0f1724 0%, #0a111b 100%) !important;
            background-attachment: fixed;
        }

        body.admin-analytics-view::before,
        body.admin-analytics-view::after {
            content: none !important;
            display: none !important;
            background: none !important;
        }

        body.admin-analytics-view .container {
            background: transparent !important;
            background-image: none !important;
        }

        body.admin-analytics-view .container::before,
        body.admin-analytics-view .container::after {
            content: none !important;
            display: none !important;
            background: none !important;
        }

        body.admin-analytics-view .admin-header,
        body.admin-analytics-view .admin-menu-shell {
            background: rgba(12, 18, 28, 0.9) !important;
            border-color: #2a3d5f !important;
            box-shadow: inset 0 0 0 1px rgba(123, 158, 214, 0.14), 0 18px 34px rgba(0, 0, 0, 0.3) !important;
        }

        body.admin-analytics-view #analytics.tab-content {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            min-height: calc(100vh - 170px);
            background:
                radial-gradient(circle at 12% 8%, rgba(88, 129, 205, 0.22) 0%, rgba(88, 129, 205, 0) 34%),
                radial-gradient(circle at 86% 22%, rgba(72, 109, 174, 0.16) 0%, rgba(72, 109, 174, 0) 38%),
                linear-gradient(180deg, #0f1724 0%, #0a111b 100%) !important;
            border: 1px solid #223552 !important;
            box-shadow: inset 0 0 0 1px rgba(123, 157, 214, 0.14), 0 20px 44px rgba(0, 0, 0, 0.4) !important;
        }

        body.admin-analytics-view #analytics.tab-content::before {
            content: "" !important;
            display: block !important;
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                linear-gradient(120deg, rgba(143, 185, 255, 0.08) 0%, rgba(143, 185, 255, 0) 46%),
                repeating-linear-gradient(
                    to right,
                    rgba(124, 154, 205, 0.07) 0px,
                    rgba(124, 154, 205, 0.07) 1px,
                    rgba(124, 154, 205, 0) 1px,
                    rgba(124, 154, 205, 0) 22px
                );
            opacity: 0.42 !important;
            z-index: 0;
        }

        body.admin-analytics-view #analytics.tab-content::after {
            content: "" !important;
            display: block !important;
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 50% 50%, rgba(97, 132, 196, 0.18) 0%, rgba(97, 132, 196, 0) 62%);
            z-index: 0;
        }

        body.admin-analytics-view #analytics > * {
            position: relative;
            z-index: 2;
        }

        body.admin-analytics-view #analytics,
        body.admin-analytics-view #analytics * {
            color: #d7e6ff !important;
        }

        body.admin-analytics-view #analytics h2 {
            color: #eef5ff !important;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-size: clamp(18px, 2vw, 22px);
            font-weight: 600;
        }

        body.admin-analytics-view #analytics .analytics-command-surface {
            background: linear-gradient(180deg, rgba(19, 30, 47, 0.96) 0%, rgba(13, 21, 34, 0.96) 100%) !important;
            border: 1px solid #314a6f !important;
            border-radius: 18px;
            box-shadow: inset 0 0 0 1px rgba(133, 168, 224, 0.16), 0 16px 30px rgba(0, 0, 0, 0.3) !important;
            margin-bottom: 16px;
            padding: 15px;
        }

        body.admin-analytics-view #analytics .analytics-kpi-grid {
            gap: 12px;
        }

        body.admin-analytics-view #analytics .analytics-kpi {
            background: linear-gradient(180deg, rgba(16, 25, 40, 0.98) 0%, rgba(10, 16, 27, 0.98) 100%) !important;
            border: 1px solid #3a547f !important;
            border-radius: 14px;
            padding: 12px 13px;
            animation: analyticsPanelPulse 5.2s ease-in-out infinite;
        }

        body.admin-analytics-view #analytics .analytics-kpi span {
            color: #94acd2 !important;
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
        }

        body.admin-analytics-view #analytics .analytics-kpi strong {
            color: #f5f9ff !important;
            text-shadow: 0 0 14px rgba(118, 169, 245, 0.3);
            font-size: clamp(21px, 2.3vw, 29px);
            font-weight: 600;
        }

        body.admin-analytics-view #analytics .analytics-results-meta {
            color: #9eb5d8 !important;
            font-size: 11px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        body.admin-analytics-view #analytics .analytics-layout {
            gap: 14px;
        }

        body.admin-analytics-view #analytics .analytics-card {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(18, 27, 41, 0.97) 0%, rgba(11, 17, 27, 0.97) 100%) !important;
            border: 1px solid #334c74 !important;
            border-radius: 18px;
            box-shadow: inset 0 0 0 1px rgba(137, 170, 224, 0.12), 0 16px 30px rgba(0, 0, 0, 0.28) !important;
            padding: 14px;
        }

        body.admin-analytics-view #analytics .analytics-card::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                linear-gradient(116deg, rgba(134, 173, 244, 0.12) 0%, rgba(134, 173, 244, 0) 40%),
                linear-gradient(0deg, rgba(0, 0, 0, 0) 76%, rgba(114, 145, 198, 0.12) 100%);
            z-index: 0;
        }

        body.admin-analytics-view #analytics .analytics-card::after {
            content: "";
            position: absolute;
            inset: 1px;
            border: 1px solid rgba(162, 191, 237, 0.16);
            border-radius: 16px;
            pointer-events: none;
            z-index: 0;
        }

        body.admin-analytics-view #analytics .analytics-card > * {
            position: relative;
            z-index: 1;
        }

        body.admin-analytics-view #analytics .analytics-card h4 {
            color: #e5efff !important;
            font-size: 11px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-weight: 600;
        }

        body.admin-analytics-view #analytics .analytics-list {
            background: linear-gradient(180deg, rgba(14, 22, 34, 0.95) 0%, rgba(8, 13, 22, 0.95) 100%) !important;
            border: 1px solid #38537f !important;
            border-radius: 14px;
            box-shadow: inset 0 0 0 1px rgba(132, 165, 218, 0.11), 0 10px 22px rgba(0, 0, 0, 0.25) !important;
            scrollbar-width: thin;
            scrollbar-color: #50668c rgba(0, 0, 0, 0.18);
        }

        body.admin-analytics-view #analytics .analytics-list::-webkit-scrollbar {
            width: 7px;
        }

        body.admin-analytics-view #analytics .analytics-list::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.18);
            border-radius: 10px;
        }

        body.admin-analytics-view #analytics .analytics-list::-webkit-scrollbar-thumb {
            background: #4f668d;
            border-radius: 10px;
            border: 1px solid rgba(10, 16, 25, 0.4);
        }

        body.admin-analytics-view #analytics .analytics-list-row {
            position: relative;
            border-bottom: 1px solid rgba(119, 150, 202, 0.22);
            background: transparent !important;
            transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
        }

        body.admin-analytics-view #analytics .analytics-list-row:hover {
            background: rgba(103, 139, 198, 0.12) !important;
            border-color: rgba(146, 176, 226, 0.44);
            transform: translateY(-1px);
        }

        body.admin-analytics-view #analytics .analytics-list-title {
            color: #edf4ff !important;
            font-weight: 500;
        }

        body.admin-analytics-view #analytics .analytics-list-subtitle {
            color: #a8bddd !important;
        }

        body.admin-analytics-view #analytics .analytics-list-meta {
            color: #9fb6d9 !important;
            letter-spacing: 0.03em;
        }

        body.admin-analytics-view #analytics .analytics-empty {
            color: #91a8cb !important;
        }

        body.admin-analytics-view #analytics #analyticsLiveList {
            background: linear-gradient(180deg, rgba(14, 22, 34, 0.95) 0%, rgba(8, 13, 22, 0.95) 100%) !important;
            border: 1px solid #38537f !important;
            border-radius: 14px;
        }

        body.admin-analytics-view #analytics #analyticsLiveList .analytics-empty {
            background: transparent !important;
        }

        body.admin-analytics-view #analytics .analytics-live-row {
            position: relative;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(126, 160, 215, 0.2);
            background: transparent !important;
            padding: 5px 8px;
            min-height: 48px;
        }

        body.admin-analytics-view #analytics .analytics-live-row:hover {
            background: rgba(98, 138, 203, 0.18) !important;
            border-bottom-color: rgba(144, 176, 225, 0.48);
        }

        body.admin-analytics-view #analytics .analytics-live-row:focus-visible {
            outline: 1px solid #88aff0;
            outline-offset: -1px;
        }

        body.admin-analytics-view #analytics .analytics-live-dot {
            background: #37f190;
            box-shadow: 0 0 0 2px rgba(55, 241, 144, 0.2), 0 0 10px rgba(55, 241, 144, 0.55);
        }

        body.admin-analytics-view #analytics .analytics-visitor-number {
            color: #f4f8ff !important;
            font-size: 11px !important;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        body.admin-analytics-view #analytics .analytics-visitor-location {
            color: #c2d5f1 !important;
            font-size: 10px !important;
        }

        body.admin-analytics-view #analytics .analytics-visitor-page {
            color: #9db5db !important;
            font-size: 10px !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-card {
            background: linear-gradient(180deg, #121924 0%, #0c1119 100%) !important;
            border-color: #273348 !important;
            box-shadow: inset 0 0 0 1px rgba(179, 208, 255, 0.08), 0 16px 34px rgba(0, 0, 0, 0.34) !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-card h4 {
            color: #dbe5f4 !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-stage {
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at 35% 20%, #1c2738 0%, #0d141f 58%, #070b12 100%) !important;
            border-color: #2e3d58 !important;
            box-shadow: inset 0 0 0 1px rgba(160, 190, 238, 0.12), 0 12px 28px rgba(0, 0, 0, 0.36) !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-stage::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                linear-gradient(120deg, rgba(140, 178, 240, 0.1) 0%, rgba(140, 178, 240, 0) 45%),
                repeating-linear-gradient(
                    to bottom,
                    rgba(136, 167, 217, 0.07) 0px,
                    rgba(136, 167, 217, 0.07) 1px,
                    rgba(136, 167, 217, 0) 2px,
                    rgba(136, 167, 217, 0) 4px
                );
            z-index: 1;
        }

        body.admin-analytics-view #analytics .analytics-globe-stage::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 50% 50%, rgba(102, 142, 209, 0.18) 0%, rgba(102, 142, 209, 0) 64%);
            z-index: 1;
        }

        body.admin-analytics-view #analytics #analyticsGlobeCanvas {
            position: relative;
            z-index: 2;
        }

        body.admin-analytics-view #analytics .analytics-globe-caption {
            color: #9da9bf !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-card {
            border-color: #2b4165 !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-card h4,
        body.admin-analytics-view #analytics .analytics-live-card h4,
        body.admin-analytics-view #analytics .analytics-recent-card h4 {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        body.admin-analytics-view #analytics .analytics-globe-card h4::before,
        body.admin-analytics-view #analytics .analytics-live-card h4::before,
        body.admin-analytics-view #analytics .analytics-recent-card h4::before {
            content: "";
            width: 16px;
            height: 16px;
            border-radius: 999px;
            border: 1px solid rgba(156, 188, 238, 0.65);
            box-shadow: inset 0 0 0 2px rgba(15, 22, 34, 0.96), 0 0 12px rgba(125, 167, 240, 0.28);
            background: radial-gradient(circle at 34% 34%, rgba(173, 205, 255, 0.95) 0%, rgba(86, 128, 210, 0.42) 46%, rgba(19, 28, 42, 0.95) 100%);
        }

        body.admin-analytics-view #analytics .analytics-live-card::before,
        body.admin-analytics-view #analytics .analytics-recent-card::before {
            background:
                repeating-linear-gradient(
                    to right,
                    rgba(121, 158, 224, 0.08) 0px,
                    rgba(121, 158, 224, 0.08) 1px,
                    rgba(121, 158, 224, 0) 1px,
                    rgba(121, 158, 224, 0) 26px
                ),
                linear-gradient(116deg, rgba(132, 170, 234, 0.12) 0%, rgba(132, 170, 234, 0) 44%);
            animation: analyticsGridDrift 5.5s linear infinite;
        }

        body.admin-analytics-view #analytics .analytics-globe-caption {
            margin-top: -2px;
            padding: 8px 10px;
            border-radius: 10px;
            border: 1px solid rgba(132, 164, 214, 0.24);
            background: linear-gradient(180deg, rgba(16, 25, 38, 0.8) 0%, rgba(11, 17, 27, 0.8) 100%);
            letter-spacing: 0.03em;
        }

        /* Futuristic Admin Console Override */
        @keyframes adminConsolePulse {
            0%, 100% {
                box-shadow: inset 0 0 0 1px rgba(131, 171, 232, 0.16), 0 20px 34px rgba(0, 0, 0, 0.32);
            }
            50% {
                box-shadow: inset 0 0 0 1px rgba(156, 198, 255, 0.28), 0 24px 40px rgba(0, 0, 0, 0.38);
            }
        }

        @keyframes adminTabSweep {
            0% {
                transform: translateX(-130%);
                opacity: 0;
            }
            32% {
                opacity: 0.42;
            }
            100% {
                transform: translateX(170%);
                opacity: 0;
            }
        }

        body .admin-header {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            animation: none !important;
        }

        body .admin-header::before,
        body .admin-header::after {
            content: none !important;
            display: none !important;
            background: none !important;
        }

        body .admin-menu-shell {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(15, 23, 35, 0.96) 0%, rgba(9, 14, 22, 0.96) 100%) !important;
            border: 1px solid #314968 !important;
            border-radius: 20px !important;
            box-shadow: inset 0 0 0 1px rgba(132, 169, 227, 0.12), 0 18px 34px rgba(0, 0, 0, 0.34) !important;
            animation: adminConsolePulse 5.2s ease-in-out infinite;
        }

        body .admin-menu-shell::before {
            content: "" !important;
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                linear-gradient(118deg, rgba(151, 188, 243, 0.12) 0%, rgba(151, 188, 243, 0) 42%),
                repeating-linear-gradient(
                    to right,
                    rgba(129, 164, 223, 0.08) 0px,
                    rgba(129, 164, 223, 0.08) 1px,
                    rgba(129, 164, 223, 0) 1px,
                    rgba(129, 164, 223, 0) 24px
                );
            opacity: 0.44;
        }

        body .admin-menu-shell::after {
            content: "" !important;
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 50% 0%, rgba(97, 139, 212, 0.2) 0%, rgba(97, 139, 212, 0) 64%);
            opacity: 0.6;
        }

        body .admin-menu-shell > * {
            position: relative;
            z-index: 1;
        }

        body .admin-menu-hint {
            color: #e8f1ff !important;
            border: 1px solid rgba(134, 168, 219, 0.4) !important;
            background: linear-gradient(180deg, rgba(22, 33, 50, 0.86) 0%, rgba(13, 20, 31, 0.86) 100%) !important;
            box-shadow: inset 0 0 0 1px rgba(142, 173, 224, 0.14) !important;
        }

        body .admin-guided-tabs .tab-btn {
            position: relative;
            overflow: hidden;
            border-radius: 16px !important;
            border: 1px solid #3a5477 !important;
            background: linear-gradient(180deg, rgba(23, 35, 53, 0.95) 0%, rgba(14, 22, 33, 0.95) 100%) !important;
            color: #d9e8ff !important;
            box-shadow: inset 0 0 0 1px rgba(125, 160, 212, 0.1), 0 12px 24px rgba(0, 0, 0, 0.24) !important;
            transform: none !important;
            transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease !important;
        }

        body .admin-guided-tabs .tab-btn::before {
            content: "" !important;
            position: absolute;
            left: -24%;
            top: 0;
            width: 26%;
            height: 100%;
            pointer-events: none;
            background: linear-gradient(90deg, rgba(124, 167, 234, 0) 0%, rgba(124, 167, 234, 0.35) 50%, rgba(124, 167, 234, 0) 100%);
            opacity: 0;
        }

        body .admin-guided-tabs .tab-btn:hover,
        body .admin-guided-tabs .tab-btn:focus-visible {
            border-color: #5e85bb !important;
            background: linear-gradient(180deg, rgba(28, 42, 64, 0.96) 0%, rgba(17, 27, 42, 0.96) 100%) !important;
            box-shadow: inset 0 0 0 1px rgba(147, 181, 232, 0.18), 0 16px 28px rgba(0, 0, 0, 0.3) !important;
        }

        body .admin-guided-tabs .tab-btn:hover::before,
        body .admin-guided-tabs .tab-btn:focus-visible::before {
            animation: adminTabSweep 1.25s ease-out;
        }

        body .admin-guided-tabs .tab-btn.active,
        body .admin-guided-tabs .tab-btn:active {
            border-color: #88b4ff !important;
            background: linear-gradient(180deg, rgba(40, 59, 88, 0.98) 0%, rgba(23, 35, 53, 0.98) 100%) !important;
            box-shadow: inset 0 0 0 1px rgba(166, 201, 255, 0.3), 0 18px 30px rgba(0, 0, 0, 0.32), 0 0 18px rgba(108, 155, 235, 0.26) !important;
        }

        body .tab-btn-title {
            color: #eef5ff !important;
            font-weight: 600 !important;
            letter-spacing: 0.02em !important;
        }

        body .tab-btn-desc {
            color: #a8c0e6 !important;
            opacity: 1 !important;
        }

        body .admin-guided-tabs .tab-btn.active .tab-btn-title,
        body .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: #f3f8ff !important;
        }

        body .tab-btn-icon {
            border: 1px solid #4e6f9d !important;
            background: linear-gradient(180deg, rgba(35, 51, 76, 0.9) 0%, rgba(19, 30, 47, 0.9) 100%) !important;
            color: #d7e9ff !important;
            box-shadow: inset 0 0 0 1px rgba(141, 173, 219, 0.14) !important;
        }

        body .admin-guided-tabs .tab-btn.active .tab-btn-icon {
            border-color: #8ab8ff !important;
            background: linear-gradient(180deg, rgba(51, 74, 110, 0.95) 0%, rgba(31, 46, 68, 0.95) 100%) !important;
            color: #f2f8ff !important;
            box-shadow: inset 0 0 0 1px rgba(170, 205, 255, 0.24), 0 0 12px rgba(118, 168, 245, 0.3) !important;
        }

        body .admin-quick-actions {
            gap: 10px !important;
        }

        body .admin-quick-btn {
            border-radius: 999px !important;
            border: 1px solid #4f6d95 !important;
            background: linear-gradient(180deg, rgba(30, 44, 66, 0.95) 0%, rgba(16, 25, 39, 0.95) 100%) !important;
            color: #e7f1ff !important;
            box-shadow: inset 0 0 0 1px rgba(141, 175, 226, 0.14), 0 10px 18px rgba(0, 0, 0, 0.24) !important;
            transform: none !important;
        }

        body .admin-quick-btn:hover,
        body .admin-quick-btn:focus-visible {
            border-color: #88b3f8 !important;
            background: linear-gradient(180deg, rgba(43, 63, 93, 0.95) 0%, rgba(24, 38, 58, 0.95) 100%) !important;
            color: #f3f8ff !important;
            box-shadow: inset 0 0 0 1px rgba(170, 205, 255, 0.24), 0 14px 24px rgba(0, 0, 0, 0.3), 0 0 16px rgba(109, 156, 234, 0.22) !important;
        }

        body .fx-admin-bar {
            border: 1px solid #3a5275 !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(20, 31, 48, 0.9) 0%, rgba(12, 18, 29, 0.9) 100%) !important;
            box-shadow: inset 0 0 0 1px rgba(130, 165, 219, 0.12), 0 12px 22px rgba(0, 0, 0, 0.26) !important;
        }

        body .fx-admin-pill,
        body .fx-admin-pill:first-child {
            border: 1px solid rgba(136, 170, 222, 0.36) !important;
            border-radius: 999px !important;
            background: linear-gradient(180deg, rgba(29, 43, 64, 0.92) 0%, rgba(15, 24, 38, 0.92) 100%) !important;
            color: #d8e9ff !important;
            box-shadow: inset 0 0 0 1px rgba(134, 168, 219, 0.14) !important;
        }

        body .fx-admin-pill span,
        body .fx-admin-pill strong,
        body .fx-admin-pill:first-child strong {
            color: #deedff !important;
        }

        body .fx-admin-dot {
            background: radial-gradient(circle at 35% 35%, #76ffc0 0%, #2adf8c 58%, #10a25d 100%) !important;
            box-shadow: 0 0 10px rgba(58, 244, 159, 0.56), 0 0 0 2px rgba(58, 244, 159, 0.18) !important;
        }

        @keyframes analyticsFeedSweepVertical {
            0% {
                transform: translateY(-100%);
                opacity: 0;
            }
            14% {
                opacity: 0.44;
            }
            58% {
                opacity: 0.36;
            }
            100% {
                transform: translateY(100%);
                opacity: 0;
            }
        }

        @keyframes analyticsFeedSweepSoft {
            0% {
                transform: translateY(-140%);
                opacity: 0;
            }
            24% {
                opacity: 0.26;
            }
            100% {
                transform: translateY(140%);
                opacity: 0;
            }
        }

        @keyframes analyticsGlobeStageSweep {
            0% {
                transform: translateX(-135%) rotate(-13deg);
                opacity: 0;
            }
            18% {
                opacity: 0.44;
            }
            100% {
                transform: translateX(160%) rotate(-13deg);
                opacity: 0;
            }
        }

        /* Absolute final lock to beat legacy overlapping white/black rules */
        body .admin-menu-shell,
        body .admin-menu-shell * {
            color: #e8f2ff !important;
        }

        body .admin-menu-shell svg,
        body .admin-menu-shell svg path,
        body .admin-menu-shell svg line,
        body .admin-menu-shell svg circle,
        body .admin-menu-shell svg polyline,
        body .admin-menu-shell svg rect {
            color: #ddecff !important;
            stroke: #ddecff !important;
        }

        body .admin-menu-shell .admin-guided-tabs .tab-btn,
        body .admin-menu-shell .admin-guided-tabs .tab-btn .tab-btn-title,
        body .admin-menu-shell .admin-guided-tabs .tab-btn .tab-btn-desc,
        body .admin-menu-shell .admin-quick-btn,
        body .admin-menu-shell .admin-menu-hint {
            color: #eef6ff !important;
        }

        body #fxAdminBar {
            border: 1px solid #3f5b84 !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(21, 31, 47, 0.9) 0%, rgba(11, 18, 29, 0.9) 100%) !important;
            box-shadow: inset 0 0 0 1px rgba(139, 173, 224, 0.12), 0 12px 24px rgba(0, 0, 0, 0.28) !important;
            padding: 8px !important;
        }

        body #fxAdminBar .fx-admin-pill,
        body #fxAdminBar .fx-admin-pill:first-child {
            min-height: 40px !important;
            height: 40px !important;
            border-radius: 999px !important;
            border: 1px solid rgba(139, 174, 223, 0.44) !important;
            background: linear-gradient(180deg, rgba(31, 46, 68, 0.94) 0%, rgba(16, 24, 38, 0.94) 100%) !important;
            color: #e6f1ff !important;
            box-shadow: inset 0 0 0 1px rgba(129, 163, 214, 0.16), 0 10px 18px rgba(0, 0, 0, 0.26) !important;
            text-transform: uppercase !important;
        }

        body #fxAdminBar .fx-admin-pill:hover,
        body #fxAdminBar .fx-admin-pill:focus-visible {
            border-color: rgba(169, 201, 249, 0.8) !important;
            background: linear-gradient(180deg, rgba(45, 67, 99, 0.96) 0%, rgba(24, 38, 58, 0.96) 100%) !important;
            color: #f3f9ff !important;
            box-shadow: inset 0 0 0 1px rgba(176, 210, 255, 0.24), 0 12px 22px rgba(0, 0, 0, 0.32), 0 0 14px rgba(108, 155, 235, 0.22) !important;
        }

        body #fxAdminBar .fx-admin-pill span,
        body #fxAdminBar .fx-admin-pill strong,
        body #fxAdminBar .fx-admin-pill:first-child strong {
            color: #eaf3ff !important;
        }

        body #fxAdminBar .fx-admin-dot {
            background: radial-gradient(circle at 35% 35%, #76ffc0 0%, #2adf8c 58%, #10a25d 100%) !important;
            box-shadow: 0 0 10px rgba(58, 244, 159, 0.56), 0 0 0 2px rgba(58, 244, 159, 0.18) !important;
        }

        body.admin-analytics-view #analytics.tab-content {
            border-radius: 24px !important;
        }

        body.admin-analytics-view #analytics.tab-content::before,
        body.admin-analytics-view #analytics.tab-content::after {
            border-radius: inherit !important;
        }

        body.admin-analytics-view #analytics .analytics-command-surface {
            border-radius: 20px !important;
        }

        body.admin-analytics-view #analytics .analytics-live-card .analytics-list,
        body.admin-analytics-view #analytics .analytics-recent-card .analytics-list {
            position: relative;
            overflow: hidden;
            isolation: isolate;
        }

        body.admin-analytics-view #analytics .analytics-live-card .analytics-list::before,
        body.admin-analytics-view #analytics .analytics-recent-card .analytics-list::before,
        body.admin-analytics-view #analytics .analytics-live-card .analytics-list::after,
        body.admin-analytics-view #analytics .analytics-recent-card .analytics-list::after {
            content: none !important;
            display: none !important;
            animation: none !important;
            background: none !important;
            filter: none !important;
        }

        body.admin-analytics-view #analytics .analytics-live-card .analytics-list > *,
        body.admin-analytics-view #analytics .analytics-recent-card .analytics-list > * {
            position: relative;
            z-index: 1;
        }

        body.admin-analytics-view #analytics .analytics-live-card::before,
        body.admin-analytics-view #analytics .analytics-recent-card::before {
            content: none !important;
            display: none !important;
            background: none !important;
            animation: none !important;
        }

        body.admin-analytics-view #analytics .analytics-live-row::before,
        body.admin-analytics-view #analytics .analytics-list-row::before,
        body.admin-analytics-view #analytics .analytics-live-row:hover::before,
        body.admin-analytics-view #analytics .analytics-list-row:hover::before {
            content: none !important;
            display: none !important;
            animation: none !important;
            background: none !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-stage {
            border-radius: 16px !important;
        }

        body.admin-analytics-view #analytics .analytics-globe-scan {
            display: none !important;
            animation: none !important;
            background: none !important;
        }

        /* ===== Unified Futuristic Console Lock ===== */
        :root {
            --uf-bg-1: #08101d;
            --uf-bg-2: #0d1727;
            --uf-bg-3: #132236;
            --uf-surface-1: rgba(17, 28, 44, 0.9);
            --uf-surface-2: rgba(12, 20, 33, 0.94);
            --uf-card-1: rgba(24, 37, 58, 0.86);
            --uf-card-2: rgba(16, 26, 42, 0.92);
            --uf-line: rgba(136, 174, 228, 0.3);
            --uf-line-strong: rgba(181, 210, 252, 0.62);
            --uf-text: #eef5ff;
            --uf-muted: #acc0de;
            --uf-accent-1: #6da4ef;
            --uf-accent-2: #4372b5;
            --uf-shadow: 0 18px 38px rgba(2, 9, 17, 0.44);
        }

        body.admin-invoices-view .container,
        body.admin-custom-orders-view .container,
        body.legacy-products-disabled.admin-products-view .container,
        body.admin-settings-view .container {
            background:
                radial-gradient(1060px 520px at 6% 4%, rgba(136, 176, 238, 0.12) 0%, rgba(136, 176, 238, 0) 62%),
                radial-gradient(980px 420px at 94% 88%, rgba(90, 132, 202, 0.14) 0%, rgba(90, 132, 202, 0) 66%),
                linear-gradient(180deg, var(--uf-bg-1) 0%, var(--uf-bg-2) 56%, var(--uf-bg-3) 100%) !important;
        }

        body.admin-invoices-view #invoices.tab-content,
        body.admin-custom-orders-view #custom-orders.tab-content,
        body.legacy-products-disabled.admin-products-view #products.tab-content,
        body.admin-settings-view #settings.tab-content {
            margin-top: 0 !important;
            padding: clamp(22px, 3vw, 34px) !important;
            border-radius: 24px !important;
            border: 1px solid var(--uf-line) !important;
            background:
                linear-gradient(180deg, var(--uf-surface-1) 0%, var(--uf-surface-2) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(217, 231, 252, 0.1),
                var(--uf-shadow),
                0 0 28px rgba(92, 138, 208, 0.16) !important;
            position: relative;
            overflow: hidden;
            -webkit-backdrop-filter: blur(8px) saturate(118%);
            backdrop-filter: blur(8px) saturate(118%);
        }

        body.admin-invoices-view #invoices.tab-content::before,
        body.admin-custom-orders-view #custom-orders.tab-content::before,
        body.legacy-products-disabled.admin-products-view #products.tab-content::before,
        body.admin-settings-view #settings.tab-content::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(153, 187, 238, 0.08) 1px, transparent 1px),
                linear-gradient(90deg, rgba(153, 187, 238, 0.08) 1px, transparent 1px);
            background-size: 22px 22px;
            opacity: 0.2;
            pointer-events: none;
        }

        body.admin-invoices-view #invoices.tab-content > *,
        body.admin-custom-orders-view #custom-orders.tab-content > *,
        body.legacy-products-disabled.admin-products-view #products.tab-content > *,
        body.admin-settings-view #settings.tab-content > * {
            position: relative;
            z-index: 1;
        }

        body.admin-invoices-view #invoices :is(h2, h3, h4),
        body.admin-custom-orders-view #custom-orders :is(h2, h3, h4),
        body.legacy-products-disabled.admin-products-view #products :is(.product-header-link, .product-header-subtitle, .form-section-title, .products-results-meta),
        body.admin-settings-view #settings :is(.shipping-panel-title, .shipping-panel-subtitle, .shipping-note, .shipping-group-title, .shipping-group-count) {
            color: var(--uf-text) !important;
        }

        body.admin-invoices-view #invoices :is(.invoice-card, .invoice-list-item),
        body.admin-custom-orders-view #custom-orders :is(.custom-order-card, .custom-order-item),
        body.legacy-products-disabled.admin-products-view #products :is(.products-control-surface, .products-table-shell, .products-stat-chip, .form-section, .form-section-card, .product-info-section, .product-sizes-section),
        body.admin-settings-view #settings :is(.settings-card.shipping-settings, .shipping-group-box, .shipping-region-row, .shipping-actions, .shipping-note) {
            border: 1px solid var(--uf-line) !important;
            background: linear-gradient(180deg, var(--uf-card-1) 0%, var(--uf-card-2) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(221, 235, 255, 0.08),
                0 12px 24px rgba(1, 7, 14, 0.36) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table,
        body.legacy-products-disabled.admin-products-view #products .products-table thead,
        body.legacy-products-disabled.admin-products-view #products .products-table tbody {
            background: transparent !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table th,
        body.legacy-products-disabled.admin-products-view #products .products-table td {
            color: var(--uf-text) !important;
            border-color: rgba(153, 187, 238, 0.22) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table tbody tr,
        body.admin-invoices-view #invoices .invoice-list-item,
        body.admin-custom-orders-view #custom-orders .custom-order-item,
        body.admin-settings-view #settings .shipping-region-row {
            background: rgba(30, 46, 71, 0.54) !important;
            border-color: rgba(153, 187, 238, 0.24) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table tbody tr:hover,
        body.admin-invoices-view #invoices .invoice-list-item:hover,
        body.admin-custom-orders-view #custom-orders .custom-order-item:hover,
        body.admin-settings-view #settings .shipping-region-row:hover {
            background: rgba(52, 77, 116, 0.7) !important;
            border-color: rgba(181, 210, 252, 0.56) !important;
            transform: none !important;
        }

        body.admin-invoices-view #invoices :is(input, select, textarea):not([type="file"]),
        body.admin-custom-orders-view #custom-orders :is(input, select, textarea):not([type="file"]),
        body.legacy-products-disabled.admin-products-view #products :is(input, select, textarea):not([type="file"]),
        body.admin-settings-view #settings :is(input, select, textarea):not([type="file"]) {
            border: 1px solid rgba(162, 196, 244, 0.34) !important;
            background: linear-gradient(180deg, rgba(19, 31, 50, 0.9) 0%, rgba(14, 24, 39, 0.94) 100%) !important;
            color: var(--uf-text) !important;
            box-shadow: none !important;
        }

        body.admin-invoices-view #invoices :is(input, select, textarea):focus,
        body.admin-custom-orders-view #custom-orders :is(input, select, textarea):focus,
        body.legacy-products-disabled.admin-products-view #products :is(input, select, textarea):focus,
        body.admin-settings-view #settings :is(input, select, textarea):focus {
            border-color: var(--uf-line-strong) !important;
            box-shadow: 0 0 0 3px rgba(149, 189, 248, 0.2) !important;
        }

        body.admin-invoices-view #invoices :is(.btn, .btn-small),
        body.admin-custom-orders-view #custom-orders :is(.btn, .btn-small),
        body.legacy-products-disabled.admin-products-view #products :is(.products-filter-pill, .btn, .btn-small, .products-sort-trigger, .back-to-products, .add-product-link, .add-product-submit),
        body.admin-settings-view #settings :is(.btn, .btn-small, .shipping-action-add, .shipping-action-save, .shipping-remove-btn, .shipping-group-toggle) {
            border: 1px solid rgba(164, 198, 245, 0.46) !important;
            background: linear-gradient(180deg, rgba(59, 92, 141, 0.76) 0%, rgba(37, 63, 101, 0.84) 100%) !important;
            color: #f8fbff !important;
            box-shadow:
                inset 0 1px 0 rgba(232, 242, 255, 0.18),
                0 10px 20px rgba(1, 8, 16, 0.34) !important;
            transform: none !important;
        }

        body.admin-invoices-view #invoices :is(.btn:hover, .btn-small:hover, .btn:focus-visible, .btn-small:focus-visible),
        body.admin-custom-orders-view #custom-orders :is(.btn:hover, .btn-small:hover, .btn:focus-visible, .btn-small:focus-visible),
        body.legacy-products-disabled.admin-products-view #products :is(.products-filter-pill:hover, .btn:hover, .btn-small:hover, .products-sort-trigger:hover, .back-to-products:hover, .add-product-link:hover, .add-product-submit:hover),
        body.legacy-products-disabled.admin-products-view #products :is(.products-filter-pill:focus-visible, .btn:focus-visible, .btn-small:focus-visible, .products-sort-trigger:focus-visible, .back-to-products:focus-visible, .add-product-link:focus-visible, .add-product-submit:focus-visible),
        body.admin-settings-view #settings :is(.btn:hover, .btn-small:hover, .shipping-action-add:hover, .shipping-action-save:hover, .shipping-remove-btn:hover, .shipping-group-toggle:hover),
        body.admin-settings-view #settings :is(.btn:focus-visible, .btn-small:focus-visible, .shipping-action-add:focus-visible, .shipping-action-save:focus-visible, .shipping-remove-btn:focus-visible, .shipping-group-toggle:focus-visible) {
            border-color: var(--uf-line-strong) !important;
            background: linear-gradient(180deg, var(--uf-accent-1) 0%, var(--uf-accent-2) 100%) !important;
            color: #f8fbff !important;
            box-shadow:
                inset 0 1px 0 rgba(238, 247, 255, 0.24),
                0 14px 24px rgba(2, 9, 18, 0.4),
                0 0 18px rgba(130, 174, 243, 0.24) !important;
        }

        body.admin-invoices-view #invoices :is(.invoice-status-badge, .invoice-payment-status),
        body.admin-settings-view #settings .shipping-panel-chip {
            color: var(--uf-text) !important;
            border-color: rgba(174, 204, 246, 0.46) !important;
            background: linear-gradient(180deg, rgba(52, 80, 121, 0.72) 0%, rgba(33, 56, 90, 0.82) 100%) !important;
        }

        /* ===== No White Residue Lock ===== */
        body.legacy-products-disabled.admin-products-view #products :is(.products-sort-select, .products-sort-menu, .futuristic-select, .futuristic-select-menu, .action-menu, #productListSection, .products-table-shell, .products-control-surface),
        body.admin-invoices-view #invoices :is(.invoice-command-surface, .invoice-kpi, .invoice-quick-filter, .invoice-filters, .invoice-items, .invoice-item, .invoice-totals, .invoice-actions, .invoice-list),
        body.admin-custom-orders-view #custom-orders :is(.custom-order-filters, .custom-order-image, .custom-order-actions, .custom-order-list, .custom-order-list-actions),
        body.admin-settings-view #settings :is(.shipping-box-layout, .shipping-group-meta, .shipping-region-list, .shipping-country-picker) {
            border: 1px solid var(--uf-line) !important;
            background: linear-gradient(180deg, var(--uf-card-1) 0%, var(--uf-card-2) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(221, 235, 255, 0.08),
                0 10px 20px rgba(1, 7, 14, 0.34) !important;
            color: var(--uf-text) !important;
        }

        body.legacy-products-disabled.admin-products-view #products :is(.action-menu-btn, .invoice-quick-filter, #productsTable > tr > td[colspan]) {
            border: 1px solid rgba(164, 198, 245, 0.46) !important;
            background: linear-gradient(180deg, rgba(59, 92, 141, 0.76) 0%, rgba(37, 63, 101, 0.84) 100%) !important;
            color: #f8fbff !important;
            box-shadow:
                inset 0 1px 0 rgba(232, 242, 255, 0.18),
                0 10px 20px rgba(1, 8, 16, 0.34) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .action-menu-btn:hover,
        body.legacy-products-disabled.admin-products-view #products .action-menu-btn:focus-visible {
            border-color: var(--uf-line-strong) !important;
            background: linear-gradient(180deg, var(--uf-accent-1) 0%, var(--uf-accent-2) 100%) !important;
            color: #f8fbff !important;
        }

        body.legacy-products-disabled.admin-products-view #products :is(.products-sort-option, .futuristic-select-option, .action-item),
        body.admin-invoices-view #invoices :is(.invoice-quick-filter) {
            background: rgba(40, 61, 92, 0.54) !important;
            color: var(--uf-text) !important;
            border-color: rgba(153, 187, 238, 0.24) !important;
        }

        body.legacy-products-disabled.admin-products-view #products :is(.products-sort-option:hover, .products-sort-option:focus-visible, .futuristic-select-option:hover, .futuristic-select-option:focus-visible, .action-item:hover, .action-item:focus-visible),
        body.admin-invoices-view #invoices :is(.invoice-quick-filter:hover, .invoice-quick-filter:focus-visible) {
            background: rgba(68, 99, 147, 0.72) !important;
            color: #f8fbff !important;
            border-color: var(--uf-line-strong) !important;
        }

        body.legacy-products-disabled.admin-products-view #products :is(input, select, textarea)::placeholder,
        body.admin-invoices-view #invoices :is(input, select, textarea)::placeholder,
        body.admin-custom-orders-view #custom-orders :is(input, select, textarea)::placeholder,
        body.admin-settings-view #settings :is(input, select, textarea)::placeholder {
            color: rgba(198, 216, 243, 0.74) !important;
        }

        /* ===== Final White Overlap Purge ===== */
        body.admin-invoices-view,
        body.admin-custom-orders-view,
        body.admin-settings-view,
        body.admin-analytics-view,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) {
            background:
                radial-gradient(1000px 460px at 8% 2%, rgba(113, 153, 219, 0.12) 0%, rgba(113, 153, 219, 0) 58%),
                radial-gradient(940px 440px at 92% 94%, rgba(92, 130, 193, 0.13) 0%, rgba(92, 130, 193, 0) 62%),
                linear-gradient(180deg, #08101d 0%, #0d1727 52%, #132236 100%) !important;
            color: #eef5ff !important;
        }

        body.admin-invoices-view::before,
        body.admin-invoices-view::after,
        body.admin-custom-orders-view::before,
        body.admin-custom-orders-view::after,
        body.admin-settings-view::before,
        body.admin-settings-view::after,
        body.admin-analytics-view::before,
        body.admin-analytics-view::after,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view)::before,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view)::after {
            background: none !important;
            opacity: 0 !important;
        }

        body.admin-invoices-view .container,
        body.admin-custom-orders-view .container,
        body.admin-settings-view .container,
        body.admin-analytics-view .container,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) .container {
            background: transparent !important;
            box-shadow: none !important;
        }

        body.admin-invoices-view .admin-header,
        body.admin-custom-orders-view .admin-header,
        body.admin-settings-view .admin-header,
        body.admin-analytics-view .admin-header,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) .admin-header {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
        }

        body.admin-invoices-view .admin-menu-shell,
        body.admin-custom-orders-view .admin-menu-shell,
        body.admin-settings-view .admin-menu-shell,
        body.admin-analytics-view .admin-menu-shell,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) .admin-menu-shell {
            background: linear-gradient(180deg, rgba(15, 23, 35, 0.96) 0%, rgba(9, 14, 22, 0.96) 100%) !important;
            border-color: #314968 !important;
        }

        body.admin-invoices-view :is(#invoices.tab-content),
        body.admin-custom-orders-view :is(#custom-orders.tab-content),
        body.admin-settings-view :is(#settings.tab-content),
        body.admin-analytics-view :is(#analytics.tab-content),
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) :is(#products.tab-content) {
            background: linear-gradient(180deg, rgba(17, 28, 44, 0.9) 0%, rgba(12, 20, 33, 0.94) 100%) !important;
            border-color: rgba(136, 174, 228, 0.3) !important;
            color: #eef5ff !important;
        }

        body.admin-invoices-view #invoices :is(.invoice-command-surface, .invoice-kpi, .invoice-card, .invoice-item, .invoice-items, .invoice-totals, .invoice-actions, .invoice-filters, .invoice-list, .invoice-list-item, .invoice-quick-filter),
        body.admin-custom-orders-view #custom-orders :is(.custom-order-card, .custom-order-image, .custom-order-actions, .custom-order-list, .custom-order-item, .custom-order-filters),
        body.admin-settings-view #settings :is(.settings-card.shipping-settings, .shipping-box-layout, .shipping-group-box, .shipping-group-meta, .shipping-region-list, .shipping-region-row, .shipping-actions, .shipping-country-picker, .shipping-note),
        body.admin-analytics-view #analytics :is(.analytics-command-surface, .analytics-kpi, .analytics-card, .analytics-list, .analytics-live-row, .analytics-list-row, .analytics-globe-stage),
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products :is(.product-header, #productListSection, .products-control-surface, .products-stat-chip, .products-table-shell, .products-table tbody tr, .products-select-wrap, .products-sort-select, .products-sort-menu, .action-menu, .action-menu-btn, .products-filter-pill) {
            border-color: rgba(136, 174, 228, 0.3) !important;
            background: linear-gradient(180deg, rgba(24, 37, 58, 0.86) 0%, rgba(16, 26, 42, 0.92) 100%) !important;
            color: #eef5ff !important;
        }

        body.admin-invoices-view :is(input, select, textarea):not([type="file"]),
        body.admin-custom-orders-view :is(input, select, textarea):not([type="file"]),
        body.admin-settings-view :is(input, select, textarea):not([type="file"]),
        body.admin-analytics-view :is(input, select, textarea):not([type="file"]),
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) :is(input, select, textarea):not([type="file"]) {
            background: linear-gradient(180deg, rgba(19, 31, 50, 0.9) 0%, rgba(14, 24, 39, 0.94) 100%) !important;
            border-color: rgba(162, 196, 244, 0.34) !important;
            color: #eef5ff !important;
        }

        body.admin-invoices-view select option,
        body.admin-custom-orders-view select option,
        body.admin-settings-view select option,
        body.admin-analytics-view select option,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) select option,
        body.admin-invoices-view select optgroup,
        body.admin-custom-orders-view select optgroup,
        body.admin-settings-view select optgroup,
        body.admin-analytics-view select optgroup,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) select optgroup {
            background: #111b2a !important;
            color: #eef5ff !important;
        }

        /* ===== Orders Quantum Command ===== */
        @keyframes oqSweepDown {
            0% {
                transform: translateY(-120%);
                opacity: 0;
            }
            14% {
                opacity: 0.22;
            }
            100% {
                transform: translateY(140%);
                opacity: 0;
            }
        }

        @keyframes oqPulseDot {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(109, 246, 217, 0.22), 0 0 0 1px rgba(109, 246, 217, 0.28);
            }
            50% {
                box-shadow: 0 0 0 7px rgba(109, 246, 217, 0), 0 0 0 1px rgba(109, 246, 217, 0.5);
            }
        }

        @keyframes oqGlowShift {
            0%, 100% {
                opacity: 0.42;
            }
            50% {
                opacity: 0.84;
            }
        }

        body.admin-orders-view #orders.tab-content {
            --oq-bg-0: #030405;
            --oq-bg-1: #070a0d;
            --oq-bg-2: #0f141b;
            --oq-panel-a: rgba(13, 18, 24, 0.92);
            --oq-panel-b: rgba(9, 13, 18, 0.96);
            --oq-card-a: rgba(15, 21, 28, 0.92);
            --oq-card-b: rgba(10, 15, 21, 0.96);
            --oq-line: rgba(146, 159, 175, 0.24);
            --oq-line-strong: rgba(186, 199, 215, 0.54);
            --oq-text: #f7f9fc;
            --oq-muted: #98a4b3;
            --oq-accent: #6df6d9;
            --oq-accent-soft: rgba(109, 246, 217, 0.22);
            --oq-warn: #ffd6a0;
            --oq-shadow: 0 30px 62px rgba(0, 0, 0, 0.52);
            background:
                radial-gradient(1200px 560px at 8% -12%, rgba(109, 246, 217, 0.1) 0%, rgba(109, 246, 217, 0) 64%),
                radial-gradient(900px 440px at 94% 104%, rgba(213, 223, 236, 0.1) 0%, rgba(213, 223, 236, 0) 66%),
                linear-gradient(180deg, var(--oq-bg-0) 0%, var(--oq-bg-1) 44%, var(--oq-bg-2) 100%) !important;
            border: 1px solid var(--oq-line) !important;
            border-radius: 24px !important;
            box-shadow: var(--oq-shadow) !important;
            color: var(--oq-text) !important;
            position: relative;
            overflow: hidden;
            isolation: isolate;
        }

        body.admin-orders-view #orders.tab-content::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                repeating-linear-gradient(90deg, rgba(158, 170, 186, 0.07) 0 1px, transparent 1px 34px),
                repeating-linear-gradient(0deg, rgba(158, 170, 186, 0.06) 0 1px, transparent 1px 34px);
            opacity: 0.12;
            z-index: 0;
        }

        body.admin-orders-view #orders.tab-content::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(109, 246, 217, 0) 0%, rgba(109, 246, 217, 0.18) 42%, rgba(109, 246, 217, 0) 100%);
            animation: oqSweepDown 10.5s linear infinite;
            z-index: 0;
        }

        body.admin-orders-view #orders.tab-content > * {
            position: relative;
            z-index: 1;
        }

        body.admin-orders-view #orders,
        body.admin-orders-view #orders * {
            font-family: "Sora", "Montserrat", "Helvetica Neue", Helvetica, Arial, sans-serif !important;
        }

        body.admin-orders-view #orders h2 {
            color: var(--oq-text) !important;
            font-weight: 720 !important;
            letter-spacing: 0.08em !important;
            text-transform: uppercase !important;
            font-size: clamp(25px, 2.2vw, 35px) !important;
            margin-bottom: 22px !important;
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        body.admin-orders-view #orders h2::before {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: radial-gradient(circle at 35% 35%, #d6fff3 0%, #7df8dd 52%, #25caa8 100%);
            animation: oqPulseDot 2.8s ease-in-out infinite;
        }

        body.admin-orders-view #orders h2::after {
            content: "Command Matrix";
            margin-left: 7px;
            padding: 4px 10px;
            border-radius: 999px;
            border: 1px solid rgba(161, 174, 191, 0.4);
            background: rgba(10, 15, 21, 0.72);
            color: var(--oq-muted) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 10px !important;
            letter-spacing: 0.09em !important;
            text-transform: uppercase;
            font-weight: 500 !important;
        }

        body.admin-orders-view #orders .fx-orders-grid {
            gap: 12px !important;
        }

        body.admin-orders-view #orders .fx-orders-card {
            border: 1px solid var(--oq-line) !important;
            background: linear-gradient(180deg, var(--oq-card-a) 0%, var(--oq-card-b) 100%) !important;
            border-radius: 15px !important;
            box-shadow: inset 0 1px 0 rgba(220, 226, 236, 0.07), 0 12px 24px rgba(0, 0, 0, 0.34) !important;
            position: relative;
            overflow: hidden;
        }

        body.admin-orders-view #orders .fx-orders-card::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 2px;
            background: linear-gradient(90deg, rgba(109, 246, 217, 0) 0%, rgba(109, 246, 217, 0.86) 52%, rgba(109, 246, 217, 0) 100%);
            animation: oqGlowShift 2.8s ease-in-out infinite;
        }

        body.admin-orders-view #orders .fx-orders-label,
        body.admin-orders-view #orders .fx-orders-meta {
            color: var(--oq-muted) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.08em !important;
            text-transform: uppercase !important;
            font-size: 10px !important;
        }

        body.admin-orders-view #orders .fx-orders-value {
            color: var(--oq-text) !important;
            font-weight: 760 !important;
            text-shadow: 0 0 16px rgba(109, 246, 217, 0.2);
        }

        body.admin-orders-view #orders .orders-command-surface,
        body.admin-orders-view #orders .order-table-block {
            border: 1px solid var(--oq-line) !important;
            background: linear-gradient(180deg, var(--oq-panel-a) 0%, var(--oq-panel-b) 100%) !important;
            box-shadow: inset 0 1px 0 rgba(226, 233, 241, 0.06), 0 16px 34px rgba(0, 0, 0, 0.36) !important;
            border-radius: 16px !important;
        }

        body.admin-orders-view #orders .orders-results-meta,
        body.admin-orders-view #orders .order-search label,
        body.admin-orders-view #orders .orders-select-wrap span {
            color: var(--oq-muted) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.07em !important;
            text-transform: uppercase !important;
        }

        body.admin-orders-view #orders .order-search {
            border: 1px solid rgba(154, 168, 186, 0.32) !important;
            background: linear-gradient(180deg, rgba(11, 16, 22, 0.92) 0%, rgba(8, 12, 17, 0.95) 100%) !important;
            box-shadow: none !important;
        }

        body.admin-orders-view #orders .order-search input,
        body.admin-orders-view #orders .orders-sort-trigger {
            border: 1px solid rgba(159, 173, 191, 0.34) !important;
            background: linear-gradient(180deg, rgba(8, 12, 17, 0.94) 0%, rgba(6, 9, 13, 0.97) 100%) !important;
            color: var(--oq-text) !important;
            box-shadow: none !important;
            border-radius: 11px !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
        }

        body.admin-orders-view #orders .order-search input::placeholder {
            color: rgba(154, 166, 182, 0.88) !important;
        }

        body.admin-orders-view #orders .order-search input:focus,
        body.admin-orders-view #orders .orders-sort-trigger:hover,
        body.admin-orders-view #orders .orders-sort-trigger:focus-visible {
            border-color: var(--oq-line-strong) !important;
            box-shadow: 0 0 0 3px var(--oq-accent-soft) !important;
            outline: none !important;
        }

        body.admin-orders-view #orders .orders-sort-select,
        body.admin-orders-view #orders .orders-sort-menu {
            border: 1px solid var(--oq-line) !important;
            background: linear-gradient(180deg, rgba(12, 18, 24, 0.98) 0%, rgba(8, 12, 17, 0.98) 100%) !important;
            box-shadow: 0 16px 30px rgba(0, 0, 0, 0.42) !important;
        }

        body.admin-orders-view #orders .orders-filter-pill {
            border: 1px solid rgba(161, 174, 192, 0.32) !important;
            background: linear-gradient(180deg, rgba(14, 20, 27, 0.92) 0%, rgba(10, 15, 21, 0.95) 100%) !important;
            color: #e9eef6 !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.07em !important;
            text-transform: uppercase !important;
            transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease !important;
        }

        body.admin-orders-view #orders .orders-filter-pill:hover,
        body.admin-orders-view #orders .orders-filter-pill:focus-visible {
            border-color: rgba(203, 213, 226, 0.62) !important;
            background: linear-gradient(180deg, rgba(22, 31, 42, 0.95) 0%, rgba(14, 20, 28, 0.96) 100%) !important;
            box-shadow: 0 0 0 2px rgba(148, 162, 178, 0.16) !important;
            color: #f8fbff !important;
            outline: none !important;
        }

        body.admin-orders-view #orders .orders-filter-pill.active {
            border-color: rgba(109, 246, 217, 0.7) !important;
            background: linear-gradient(180deg, rgba(18, 44, 40, 0.94) 0%, rgba(11, 32, 28, 0.96) 100%) !important;
            box-shadow: 0 0 0 2px rgba(109, 246, 217, 0.14), 0 8px 14px rgba(0, 0, 0, 0.34) !important;
            color: #e7fff9 !important;
        }

        body.admin-orders-view #orders .orders-sort-option {
            border: 1px solid transparent !important;
            border-radius: 10px !important;
            background: transparent !important;
            color: #e7edf6 !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.04em !important;
        }

        body.admin-orders-view #orders .orders-sort-option:hover,
        body.admin-orders-view #orders .orders-sort-option:focus-visible,
        body.admin-orders-view #orders .orders-sort-option.active {
            border-color: rgba(182, 194, 210, 0.56) !important;
            background: rgba(30, 40, 52, 0.76) !important;
            color: #ffffff !important;
            outline: none !important;
        }

        body.admin-orders-view #orders .order-table-block {
            overflow: hidden !important;
        }

        body.admin-orders-view #orders .order-table-block::before {
            content: none !important;
        }

        body.admin-orders-view #orders .order-table-block table,
        body.admin-orders-view #orders .order-table-block thead,
        body.admin-orders-view #orders .order-table-block tbody {
            background: transparent !important;
        }

        body.admin-orders-view #orders .order-table-block thead th {
            background: rgba(14, 20, 27, 0.96) !important;
            color: #c9d3df !important;
            border-bottom: 1px solid rgba(157, 170, 186, 0.34) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            font-size: 10px !important;
        }

        body.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(9, 13, 18, 0.9) !important;
            border-top: 1px solid rgba(98, 111, 126, 0.22) !important;
            box-shadow: none !important;
            transition: background-color 0.16s ease, border-color 0.16s ease !important;
        }

        body.admin-orders-view #orders .order-table-block tbody tr:nth-child(even) {
            background: rgba(12, 17, 23, 0.92) !important;
        }

        body.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            background: rgba(20, 28, 37, 0.95) !important;
            border-color: rgba(170, 184, 201, 0.46) !important;
            box-shadow: inset 3px 0 0 rgba(109, 246, 217, 0.64) !important;
            transform: none !important;
        }

        body.admin-orders-view #orders .order-table-block tbody tr td {
            color: var(--oq-text) !important;
            border-bottom-color: rgba(90, 104, 119, 0.24) !important;
        }

        body.admin-orders-view #orders .order-table-block tbody tr td:first-child::before {
            content: none !important;
            display: none !important;
        }

        body.admin-orders-view #orders .order-link {
            color: #edf7ff !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.03em !important;
            text-decoration: none !important;
            border-radius: 8px;
        }

        body.admin-orders-view #orders .order-link:hover,
        body.admin-orders-view #orders .order-link:focus-visible {
            color: var(--oq-accent) !important;
            text-shadow: 0 0 12px rgba(109, 246, 217, 0.42);
            outline: none !important;
        }

        body.admin-orders-view #orders .payment-text,
        body.admin-orders-view #orders .fulfillment-text {
            border: 1px solid rgba(161, 175, 191, 0.42) !important;
            background: linear-gradient(180deg, rgba(25, 34, 45, 0.88) 0%, rgba(15, 23, 33, 0.9) 100%) !important;
            color: #f0f5fb !important;
            box-shadow: none !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.07em !important;
            text-transform: uppercase !important;
            font-size: 10px !important;
        }

        body.admin-orders-view #orders .fulfillment-text.fulfilled,
        body.admin-orders-view #orders .fulfillment-text.delivered {
            border-color: rgba(109, 246, 217, 0.66) !important;
            background: linear-gradient(180deg, rgba(16, 47, 41, 0.92) 0%, rgba(10, 30, 27, 0.96) 100%) !important;
            color: #e0fff6 !important;
        }

        body.admin-orders-view #orders .fulfillment-text.unfulfilled {
            border-color: rgba(255, 214, 160, 0.62) !important;
            background: linear-gradient(180deg, rgba(63, 46, 27, 0.92) 0%, rgba(42, 30, 18, 0.95) 100%) !important;
            color: #ffe8c7 !important;
        }

        body.admin-orders-view #orders .orders-empty-state-cell {
            color: #c5d0dc !important;
            background: rgba(12, 18, 24, 0.93) !important;
            border: 1px dashed rgba(144, 159, 177, 0.4) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.06em !important;
            text-transform: uppercase !important;
        }

        body.admin-orders-view #orderDetailPage.order-detail-page {
            background: rgba(2, 4, 6, 0.88) !important;
            -webkit-backdrop-filter: blur(14px) saturate(116%);
            backdrop-filter: blur(14px) saturate(116%);
        }

        body.admin-orders-view #orderDetailPage .order-detail-shell {
            background:
                radial-gradient(980px 420px at 0% -10%, rgba(109, 246, 217, 0.12) 0%, rgba(109, 246, 217, 0) 65%),
                linear-gradient(180deg, rgba(10, 15, 20, 0.99) 0%, rgba(6, 10, 15, 0.99) 100%) !important;
            border: 1px solid rgba(145, 160, 178, 0.38) !important;
            border-radius: 22px !important;
            box-shadow: 0 30px 66px rgba(0, 0, 0, 0.62) !important;
        }

        body.admin-orders-view #orderDetailPage :is(.order-detail-eyebrow, .order-detail-actions-meta, .order-item-identity, .tracking-timeline-meta, .tracking-history-title, .tracking-live-stat > span) {
            color: var(--oq-muted) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.07em !important;
            text-transform: uppercase !important;
        }

        body.admin-orders-view #orderDetailPage :is(.order-detail-title, .order-detail-total, .order-item-name, .tracking-live-stat-value, .tracking-timeline-title) {
            color: #f8fbff !important;
        }

        body.admin-orders-view #orderDetailPage :is(.order-detail-summary, .order-detail-card, .tracking-history-panel, .tracking-live-grid, .order-item-row) {
            background: linear-gradient(180deg, rgba(14, 20, 27, 0.93) 0%, rgba(9, 14, 19, 0.95) 100%) !important;
            border-color: rgba(131, 145, 161, 0.34) !important;
        }

        body.admin-orders-view #orderDetailPage :is(input, select, textarea, .tracking-input, .shipping-field) {
            background: linear-gradient(180deg, rgba(7, 11, 15, 0.95) 0%, rgba(4, 7, 11, 0.97) 100%) !important;
            border-color: rgba(154, 168, 186, 0.34) !important;
            color: #f2f7fd !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
        }

        body.admin-orders-view #orderDetailPage :is(input, select, textarea, .tracking-input, .shipping-field):focus {
            border-color: rgba(186, 199, 214, 0.62) !important;
            box-shadow: 0 0 0 3px rgba(109, 246, 217, 0.14) !important;
        }

        body.admin-orders-view #orderDetailPage :is(.order-detail-back, .order-detail-edit-btn, .btn-track-send) {
            border: 1px solid rgba(160, 174, 192, 0.44) !important;
            background: linear-gradient(180deg, rgba(23, 32, 42, 0.92) 0%, rgba(14, 21, 30, 0.94) 100%) !important;
            color: #f1f7ff !important;
            box-shadow: none !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.06em !important;
            text-transform: uppercase !important;
        }

        body.admin-orders-view #orderDetailPage :is(.order-detail-back:hover, .order-detail-edit-btn:hover, .btn-track-send:hover) {
            border-color: rgba(109, 246, 217, 0.72) !important;
            background: linear-gradient(180deg, rgba(16, 49, 42, 0.95) 0%, rgba(10, 33, 28, 0.97) 100%) !important;
            color: #e5fff7 !important;
            box-shadow: 0 0 0 2px rgba(109, 246, 217, 0.16) !important;
        }

        body.admin-orders-view .admin-menu-shell {
            background: linear-gradient(180deg, rgba(9, 14, 19, 0.96) 0%, rgba(6, 9, 14, 0.98) 100%) !important;
            border-color: rgba(142, 156, 173, 0.36) !important;
            box-shadow: inset 0 0 0 1px rgba(171, 184, 199, 0.12), 0 20px 40px rgba(0, 0, 0, 0.42) !important;
        }

        body.admin-orders-view .admin-guided-tabs .tab-btn {
            border-color: rgba(147, 161, 179, 0.34) !important;
            background: linear-gradient(180deg, rgba(15, 22, 30, 0.94) 0%, rgba(9, 14, 20, 0.95) 100%) !important;
            color: #eef5ff !important;
        }

        body.admin-orders-view .admin-guided-tabs .tab-btn:hover,
        body.admin-orders-view .admin-guided-tabs .tab-btn:focus-visible {
            border-color: rgba(196, 207, 220, 0.62) !important;
            background: linear-gradient(180deg, rgba(23, 33, 45, 0.95) 0%, rgba(14, 21, 30, 0.97) 100%) !important;
            color: #ffffff !important;
        }

        body.admin-orders-view .admin-guided-tabs .tab-btn.active,
        body.admin-orders-view .admin-guided-tabs .tab-btn:active {
            border-color: rgba(109, 246, 217, 0.72) !important;
            background: linear-gradient(180deg, rgba(17, 49, 43, 0.95) 0%, rgba(11, 31, 28, 0.97) 100%) !important;
            color: #e6fff8 !important;
            box-shadow: inset 0 0 0 1px rgba(173, 255, 238, 0.2), 0 12px 22px rgba(0, 0, 0, 0.38), 0 0 14px rgba(109, 246, 217, 0.18) !important;
        }

        body.admin-orders-view .fx-admin-bar .fx-admin-pill {
            border-color: rgba(148, 162, 179, 0.34) !important;
            background: linear-gradient(180deg, rgba(14, 20, 27, 0.9) 0%, rgba(9, 14, 19, 0.94) 100%) !important;
            color: #ebf2fb !important;
        }

        body.admin-orders-view .fx-admin-bar .fx-admin-dot {
            background: #6df6d9 !important;
            box-shadow: 0 0 0 3px rgba(109, 246, 217, 0.18) !important;
        }

        /* ===== Products Cyber Grid ===== */
        @keyframes pcGridSweep {
            0% {
                transform: translateY(-118%);
                opacity: 0;
            }
            14% {
                opacity: 0.3;
            }
            100% {
                transform: translateY(128%);
                opacity: 0;
            }
        }

        @keyframes pcLinePulse {
            0%, 100% {
                opacity: 0.46;
            }
            50% {
                opacity: 0.9;
            }
        }

        body.admin-products-view:not(.admin-add-product-view) .container {
            background:
                radial-gradient(1200px 560px at 4% 0%, rgba(105, 255, 206, 0.12) 0%, rgba(105, 255, 206, 0) 65%),
                radial-gradient(900px 440px at 98% 100%, rgba(176, 194, 223, 0.1) 0%, rgba(176, 194, 223, 0) 66%),
                linear-gradient(180deg, #030405 0%, #07090d 50%, #0d1218 100%) !important;
            border-color: rgba(140, 158, 181, 0.28) !important;
            box-shadow: 0 24px 52px rgba(0, 0, 0, 0.48) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products.tab-content {
            --pc-bg-0: #020304;
            --pc-bg-1: #070a0d;
            --pc-bg-2: #0d1319;
            --pc-panel-a: rgba(14, 20, 28, 0.92);
            --pc-panel-b: rgba(9, 13, 19, 0.96);
            --pc-card-a: rgba(15, 22, 30, 0.92);
            --pc-card-b: rgba(9, 14, 20, 0.96);
            --pc-line: rgba(145, 162, 184, 0.28);
            --pc-line-strong: rgba(186, 203, 223, 0.56);
            --pc-text: #f4f9ff;
            --pc-muted: #9eafc6;
            --pc-accent: #69ffce;
            --pc-accent-soft: rgba(105, 255, 206, 0.2);
            background:
                radial-gradient(860px 320px at 0% -8%, rgba(105, 255, 206, 0.11) 0%, rgba(105, 255, 206, 0) 68%),
                linear-gradient(180deg, var(--pc-bg-0) 0%, var(--pc-bg-1) 47%, var(--pc-bg-2) 100%) !important;
            border: 1px solid var(--pc-line) !important;
            border-radius: 22px !important;
            color: var(--pc-text) !important;
            box-shadow: 0 28px 58px rgba(0, 0, 0, 0.5) !important;
            position: relative;
            overflow: hidden;
            isolation: isolate;
        }

        body.admin-products-view:not(.admin-add-product-view) #products.tab-content::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background:
                repeating-linear-gradient(90deg, rgba(175, 189, 209, 0.08) 0 1px, transparent 1px 30px),
                repeating-linear-gradient(0deg, rgba(175, 189, 209, 0.06) 0 1px, transparent 1px 30px);
            opacity: 0.16;
            z-index: 0;
        }

        body.admin-products-view:not(.admin-add-product-view) #products.tab-content::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(105, 255, 206, 0) 0%, rgba(105, 255, 206, 0.2) 45%, rgba(105, 255, 206, 0) 100%);
            animation: pcGridSweep 10.2s linear infinite;
            z-index: 0;
        }

        body.admin-products-view:not(.admin-add-product-view) #products.tab-content > * {
            position: relative;
            z-index: 1;
        }

        body.admin-products-view:not(.admin-add-product-view) #products,
        body.admin-products-view:not(.admin-add-product-view) #products * {
