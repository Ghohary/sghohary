                <div class="invoice-command-row">
                    <div class="invoice-quick-filters" role="tablist" aria-label="Invoice quick filters">
                        <button type="button" class="invoice-quick-filter active" data-invoice-quick-filter="all">All</button>
                        <button type="button" class="invoice-quick-filter" data-invoice-quick-filter="open">Open</button>
                        <button type="button" class="invoice-quick-filter" data-invoice-quick-filter="paid">Paid</button>
                        <button type="button" class="invoice-quick-filter" data-invoice-quick-filter="draft">Draft</button>
                        <button type="button" class="invoice-quick-filter" data-invoice-quick-filter="overdue">Overdue</button>
                    </div>
                    <div class="invoice-command-actions">
                        <button type="button" class="btn-small" id="invoiceCreateNewBtn">New Invoice</button>
                        <button type="button" class="btn-small" id="invoiceGenerateNumberBtn">Auto Number</button>
                    </div>
                </div>
                <div class="invoice-results-meta" id="invoiceResultsMeta">Showing 0 of 0 invoices</div>
            </div>
            <div class="invoice-layout">
                <div class="invoice-card">
                    <h4>
                        Invoice Details
                        <span class="invoice-editor-mode" id="invoiceEditorMode">New invoice</span>
