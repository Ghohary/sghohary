        body.admin-products-view.admin-add-product-view #products .image-dropzone {
            position: relative;
            min-height: 110px !important;
            border-radius: 16px !important;
            border: 1px dashed var(--ap-line-strong) !important;
            background: linear-gradient(180deg, rgba(31, 37, 47, 0.9) 0%, rgba(22, 26, 34, 0.96) 100%) !important;
            padding: 16px !important;
            display: flex !important;
            flex-direction: column;
            gap: 8px;
            align-items: center;
            justify-content: center;
            text-align: center;
            width: 100% !important;
            isolation: isolate;
            overflow: hidden;
            transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone:hover,
        body.admin-products-view.admin-add-product-view #products .image-dropzone.drag-over {
            border-color: rgba(248, 252, 255, 0.8) !important;
            background: linear-gradient(180deg, rgba(43, 50, 63, 0.94) 0%, rgba(30, 35, 44, 0.98) 100%) !important;
