                <div class="custom-order-card">
                    <h4>Custom Orders</h4>
                    <div class="custom-order-filters">
                        <input type="text" id="customOrderSearch" placeholder="Search by customer or phone">
                        <select id="customOrderStatusFilter">
                            <option value="">All payment statuses</option>
                            <option value="unpaid">Unpaid</option>
                            <option value="partially_paid">Partially paid</option>
