        /* ===== Light Futuristic Override ===== */
        :root {
            --lf-ink: #0f172a;
            --lf-muted: #5b6b84;
            --lf-line: rgba(18, 39, 72, 0.14);
            --lf-line-strong: rgba(56, 117, 210, 0.45);
            --lf-surface: #ffffff;
            --lf-surface-soft: #f6faff;
            --lf-accent: #2f70d4;
        }

        body {
            background:
                radial-gradient(980px 440px at -8% -10%, rgba(110, 170, 242, 0.16) 0%, rgba(110, 170, 242, 0) 62%),
                radial-gradient(860px 360px at 108% 108%, rgba(132, 186, 247, 0.15) 0%, rgba(132, 186, 247, 0) 62%),
                linear-gradient(180deg, #f7fbff 0%, #edf3fb 100%) !important;
            color: var(--lf-ink) !important;
        }

        body::before {
            opacity: 0.12 !important;
            background-size: 34px 34px !important;
            animation: none !important;
        }

        body::after {
            background: linear-gradient(180deg, rgba(143, 195, 255, 0.10) 0%, rgba(143, 195, 255, 0) 34%) !important;
            animation: none !important;
        }

        .admin-header {
            border-bottom: 1px solid var(--lf-line) !important;
            box-shadow: 0 10px 24px rgba(18, 39, 72, 0.12) !important;
            backdrop-filter: blur(10px) saturate(108%) !important;
            -webkit-backdrop-filter: blur(10px) saturate(108%) !important;
        }

        .admin-header::before {
            opacity: 0.14 !important;
        }

        .admin-header::after {
            box-shadow: none !important;
            background: linear-gradient(90deg, rgba(90, 151, 230, 0) 0%, rgba(90, 151, 230, 0.56) 50%, rgba(90, 151, 230, 0) 100%) !important;
        }

        .admin-menu-shell {
            border: 1px solid var(--lf-line) !important;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(246, 251, 255, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.9),
                0 10px 24px rgba(18, 39, 72, 0.11) !important;
        }

        .admin-menu-shell::after {
            content: none !important;
            display: none !important;
        }

        .admin-menu-hint {
            border: 1px solid rgba(112, 165, 236, 0.34) !important;
            background: rgba(231, 241, 253, 0.92) !important;
            color: #2b4f7b !important;
            box-shadow: none !important;
        }

        .admin-guided-tabs .tab-btn {
            border: 1px solid var(--lf-line) !important;
            background: linear-gradient(180deg, #ffffff 0%, #f6faff 100%) !important;
            color: var(--lf-ink) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.95),
                0 6px 14px rgba(18, 39, 72, 0.10) !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn::before,
        .admin-guided-tabs .tab-btn::after {
            content: none !important;
            display: none !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: var(--lf-line-strong) !important;
            background: linear-gradient(180deg, #f6faff 0%, #ecf4ff 100%) !important;
            color: #0d1d34 !important;
            box-shadow:
                0 8px 18px rgba(18, 39, 72, 0.14),
                0 0 0 1px rgba(120, 177, 244, 0.22) !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(45, 103, 192, 0.62) !important;
            background: linear-gradient(180deg, #2f70d4 0%, #1f4f9c 100%) !important;
            color: #ffffff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.22),
                0 9px 20px rgba(29, 72, 138, 0.30) !important;
        }

        .admin-guided-tabs .tab-btn.active:hover {
            background: linear-gradient(180deg, #377bdd 0%, #2559ad 100%) !important;
        }

        .tab-btn-title {
            color: inherit !important;
            text-shadow: none !important;
        }

        .tab-btn-desc {
            color: var(--lf-muted) !important;
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: rgba(236, 245, 255, 0.92) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders,
