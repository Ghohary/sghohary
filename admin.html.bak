        body.admin-products-view:not(.admin-add-product-view) #products #productsTable > tr > td[colspan] {
            color: #bccbde !important;
            background: rgba(12, 17, 24, 0.9) !important;
            border: 1px dashed rgba(140, 158, 180, 0.34) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            text-transform: uppercase !important;
            letter-spacing: 0.06em !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .admin-menu-shell {
            background: linear-gradient(180deg, rgba(9, 14, 20, 0.96) 0%, rgba(6, 10, 15, 0.98) 100%) !important;
            border-color: rgba(139, 157, 180, 0.36) !important;
            box-shadow: inset 0 0 0 1px rgba(171, 187, 208, 0.12), 0 22px 44px rgba(0, 0, 0, 0.42) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .admin-guided-tabs .tab-btn {
            border-color: rgba(145, 163, 186, 0.34) !important;
            background: linear-gradient(180deg, rgba(15, 22, 31, 0.94) 0%, rgba(9, 14, 20, 0.96) 100%) !important;
            color: #ebf4ff !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .admin-guided-tabs .tab-btn:hover,
        body.admin-products-view:not(.admin-add-product-view) .admin-guided-tabs .tab-btn:focus-visible {
            border-color: rgba(191, 206, 224, 0.62) !important;
            background: linear-gradient(180deg, rgba(23, 34, 46, 0.95) 0%, rgba(14, 22, 31, 0.97) 100%) !important;
            color: #ffffff !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .admin-guided-tabs .tab-btn.active,
        body.admin-products-view:not(.admin-add-product-view) .admin-guided-tabs .tab-btn:active {
            border-color: rgba(105, 255, 206, 0.72) !important;
            background: linear-gradient(180deg, rgba(17, 50, 41, 0.95) 0%, rgba(10, 32, 27, 0.97) 100%) !important;
            color: #e1fff5 !important;
            box-shadow: inset 0 0 0 1px rgba(166, 255, 235, 0.2), 0 12px 22px rgba(0, 0, 0, 0.38), 0 0 14px rgba(105, 255, 206, 0.18) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .admin-quick-actions .admin-quick-btn,
        body.admin-products-view:not(.admin-add-product-view) .fx-admin-bar .fx-admin-pill {
            border-color: rgba(146, 165, 188, 0.34) !important;
            background: linear-gradient(180deg, rgba(15, 22, 31, 0.92) 0%, rgba(9, 14, 20, 0.95) 100%) !important;
            color: #e7f1fd !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .fx-admin-bar .fx-admin-dot {
            background: #69ffce !important;
            box-shadow: 0 0 0 3px rgba(105, 255, 206, 0.18) !important;
        }

        @media (max-width: 900px) {
            body.admin-orders-view #orders.tab-content {
                border-radius: 18px !important;
            }

            body.admin-orders-view #orders h2::after {
                display: none;
            }

            body.admin-orders-view #orders .order-table-block {
                border-radius: 13px !important;
            }
        }

        /* ══════════════════════════════════════════════════
           ██ PRODUCTS COMMAND CENTER — APEX EDITION ██
           Holographic HUD · Neon Grid · Glassmorphism
           ══════════════════════════════════════════════════ */

        /* --- Global Keyframes --- */
        @keyframes pcHoloPulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }
        @keyframes pcBorderGlow {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        @keyframes pcStatCount {
            0% { opacity: 0; transform: translateY(8px) scale(0.92); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes pcRowSlideIn {
            0% { opacity: 0; transform: translateX(-12px); }
            100% { opacity: 1; transform: translateX(0); }
        }
        @keyframes pcRadarSweep {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes pcShimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        @keyframes pcPulseRing {
            0% { transform: scale(1); opacity: 0.6; }
            50% { transform: scale(1.06); opacity: 1; }
            100% { transform: scale(1); opacity: 0.6; }
        }
        @keyframes pcScanDown {
            0% { top: -2px; opacity: 0; }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% { top: calc(100% + 2px); opacity: 0; }
        }
        @keyframes pcFlicker {
            0%, 100% { opacity: 1; }
            92% { opacity: 1; }
            93% { opacity: 0.4; }
            94% { opacity: 1; }
            96% { opacity: 0.6; }
            97% { opacity: 1; }
        }

        /* --- Products Tab: Deep Space Background --- */
        body.admin-products-view:not(.admin-add-product-view) #products.tab-content {
            --pc-neon: #69ffce;
            --pc-neon-rgb: 105, 255, 206;
            --pc-neon-soft: rgba(105, 255, 206, 0.14);
            --pc-neon-mid: rgba(105, 255, 206, 0.36);
            --pc-neon-bright: rgba(105, 255, 206, 0.84);
            --pc-cyan: #4ae8ff;
            --pc-cyan-rgb: 74, 232, 255;
            --pc-purple: #a78bfa;
            --pc-purple-rgb: 167, 139, 250;
            --pc-surface-0: rgba(6, 9, 14, 0.97);
            --pc-surface-1: rgba(10, 15, 22, 0.94);
            --pc-surface-2: rgba(15, 21, 30, 0.92);
            --pc-glass: rgba(12, 17, 24, 0.72);
            --pc-glass-border: rgba(105, 255, 206, 0.22);
            background:
                radial-gradient(1200px 480px at 3% -5%, rgba(var(--pc-neon-rgb), 0.09) 0%, transparent 68%),
                radial-gradient(600px 300px at 95% 105%, rgba(var(--pc-cyan-rgb), 0.07) 0%, transparent 70%),
                radial-gradient(400px 200px at 50% 50%, rgba(var(--pc-purple-rgb), 0.04) 0%, transparent 80%),
                linear-gradient(180deg, #010203 0%, #050810 45%, #0a0f18 100%) !important;
        }

        /* Holographic grid overlay */
        body.admin-products-view:not(.admin-add-product-view) #products.tab-content::before {
            background:
                repeating-linear-gradient(90deg, rgba(var(--pc-neon-rgb), 0.05) 0 1px, transparent 1px 42px),
                repeating-linear-gradient(0deg, rgba(var(--pc-neon-rgb), 0.04) 0 1px, transparent 1px 42px) !important;
            opacity: 0.22 !important;
        }

        /* Vertical scan line */
        body.admin-products-view:not(.admin-add-product-view) #products.tab-content::after {
            content: "" !important;
            background: linear-gradient(180deg,
                rgba(var(--pc-neon-rgb), 0) 0%,
                rgba(var(--pc-neon-rgb), 0.06) 20%,
                rgba(var(--pc-neon-rgb), 0.28) 48%,
                rgba(var(--pc-neon-rgb), 0.06) 80%,
                rgba(var(--pc-neon-rgb), 0) 100%) !important;
            height: 120px !important;
            width: 100% !important;
            top: -120px;
            left: 0;
            animation: pcScanDown 8.6s ease-in-out infinite !important;
        }

        /* --- Header: Command Bar --- */
        body.admin-products-view:not(.admin-add-product-view) #products .product-header {
            background:
                linear-gradient(135deg, rgba(var(--pc-neon-rgb), 0.03) 0%, transparent 40%),
                linear-gradient(180deg, rgba(12, 17, 24, 0.94) 0%, rgba(8, 12, 18, 0.97) 100%) !important;
            border: 1px solid rgba(var(--pc-neon-rgb), 0.18) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.1),
                0 0 40px rgba(var(--pc-neon-rgb), 0.04),
                0 16px 32px rgba(0, 0, 0, 0.4) !important;
            border-radius: 16px !important;
            padding: 18px 24px !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-header-link {
            color: var(--pc-text) !important;
            font-weight: 700 !important;
            letter-spacing: 0.12em !important;
            text-shadow: 0 0 20px rgba(var(--pc-neon-rgb), 0.15) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-header-subtitle {
            color: var(--pc-neon) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.14em !important;
            font-size: 10px !important;
            text-shadow: 0 0 14px rgba(var(--pc-neon-rgb), 0.3) !important;
            animation: pcFlicker 6s linear infinite;
        }

        /* --- Action Buttons: Neon Glass --- */
        body.admin-products-view:not(.admin-add-product-view) #products .add-product-link,
        body.admin-products-view:not(.admin-add-product-view) #products .add-product-submit {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.52) !important;
            background:
                linear-gradient(135deg, rgba(var(--pc-neon-rgb), 0.08) 0%, rgba(var(--pc-neon-rgb), 0.02) 100%),
                linear-gradient(180deg, rgba(12, 38, 32, 0.95) 0%, rgba(8, 25, 21, 0.97) 100%) !important;
            color: var(--pc-neon) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.14),
                0 0 20px rgba(var(--pc-neon-rgb), 0.08),
                0 8px 20px rgba(0, 0, 0, 0.32) !important;
            text-shadow: 0 0 10px rgba(var(--pc-neon-rgb), 0.3) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-weight: 600 !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .add-product-link:hover,
        body.admin-products-view:not(.admin-add-product-view) #products .add-product-submit:hover {
            border-color: rgba(var(--pc-neon-rgb), 0.86) !important;
            background:
                linear-gradient(135deg, rgba(var(--pc-neon-rgb), 0.14) 0%, rgba(var(--pc-neon-rgb), 0.04) 100%),
                linear-gradient(180deg, rgba(16, 50, 42, 0.96) 0%, rgba(10, 34, 28, 0.98) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.22),
                0 0 36px rgba(var(--pc-neon-rgb), 0.18),
                0 12px 28px rgba(0, 0, 0, 0.4) !important;
            transform: none !important;
        }

        /* --- Search: Terminal Input --- */
        body.admin-products-view:not(.admin-add-product-view) #products .product-search-inline input {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.22) !important;
            background:
                linear-gradient(90deg, rgba(var(--pc-neon-rgb), 0.02) 0%, transparent 30%),
                linear-gradient(180deg, rgba(6, 9, 14, 0.96) 0%, rgba(4, 7, 11, 0.98) 100%) !important;
            color: var(--pc-text) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 12px !important;
            letter-spacing: 0.04em !important;
            border-radius: 10px !important;
            caret-color: var(--pc-neon) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-search-inline input::placeholder {
            color: rgba(var(--pc-neon-rgb), 0.32) !important;
            font-style: italic;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-search-inline input:focus {
            border-color: rgba(var(--pc-neon-rgb), 0.56) !important;
            box-shadow:
                0 0 0 3px rgba(var(--pc-neon-rgb), 0.1),
                0 0 24px rgba(var(--pc-neon-rgb), 0.06) !important;
        }

        /* --- Product List Panel: Holo Container --- */
        body.admin-products-view:not(.admin-add-product-view) #products #productListSection {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.16) !important;
            background:
                linear-gradient(180deg, rgba(8, 12, 18, 0.92) 0%, rgba(5, 8, 13, 0.96) 100%) !important;
            border-radius: 18px !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.06),
                0 0 48px rgba(var(--pc-neon-rgb), 0.03),
                0 20px 40px rgba(0, 0, 0, 0.42) !important;
            padding: 20px !important;
            position: relative;
            overflow: hidden;
        }

        /* Corner accent marks */
        body.admin-products-view:not(.admin-add-product-view) #products #productListSection::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 60px;
            height: 60px;
            border-top: 2px solid rgba(var(--pc-neon-rgb), 0.36);
            border-left: 2px solid rgba(var(--pc-neon-rgb), 0.36);
            border-radius: 18px 0 0 0;
            pointer-events: none;
            z-index: 2;
        }

        body.admin-products-view:not(.admin-add-product-view) #products #productListSection::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 60px;
            height: 60px;
            border-bottom: 2px solid rgba(var(--pc-neon-rgb), 0.36);
            border-right: 2px solid rgba(var(--pc-neon-rgb), 0.36);
            border-radius: 0 0 18px 0;
            pointer-events: none;
            z-index: 2;
        }

        /* --- Control Surface: Telemetry HUD --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-control-surface {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.14) !important;
            background:
                linear-gradient(135deg, rgba(var(--pc-neon-rgb), 0.02) 0%, transparent 50%),
                linear-gradient(180deg, rgba(10, 15, 22, 0.94) 0%, rgba(7, 11, 17, 0.97) 100%) !important;
            border-radius: 14px !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.08),
                0 8px 20px rgba(0, 0, 0, 0.3) !important;
            padding: 16px !important;
            margin-bottom: 16px !important;
        }

        /* --- Stat Cards: Holographic Counters --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-quick-stats {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 12px !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.18) !important;
            background:
                linear-gradient(145deg, rgba(var(--pc-neon-rgb), 0.04) 0%, rgba(var(--pc-cyan-rgb), 0.02) 50%, transparent 100%),
                linear-gradient(180deg, rgba(10, 15, 22, 0.92) 0%, rgba(6, 9, 14, 0.97) 100%) !important;
            border-radius: 14px !important;
            padding: 14px 16px !important;
            position: relative;
            overflow: hidden;
            min-height: 72px !important;
            display: grid !important;
            gap: 6px !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.1),
                0 0 20px rgba(var(--pc-neon-rgb), 0.03),
                0 10px 22px rgba(0, 0, 0, 0.28) !important;
        }

        /* Holographic top-bar glow */
        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip::before {
            content: "" !important;
            position: absolute !important;
            left: 12px !important;
            right: 12px !important;
            top: 0 !important;
            height: 1px !important;
            background: linear-gradient(90deg,
                rgba(var(--pc-neon-rgb), 0) 0%,
                rgba(var(--pc-neon-rgb), 0.64) 30%,
                rgba(var(--pc-cyan-rgb), 0.84) 52%,
                rgba(var(--pc-neon-rgb), 0.64) 70%,
                rgba(var(--pc-neon-rgb), 0) 100%) !important;
            animation: pcHoloPulse 3s ease-in-out infinite !important;
        }

        /* Shimmer effect on stat cards */
        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(105deg,
                transparent 40%,
                rgba(var(--pc-neon-rgb), 0.03) 48%,
                rgba(var(--pc-neon-rgb), 0.06) 50%,
                rgba(var(--pc-neon-rgb), 0.03) 52%,
                transparent 60%);
            background-size: 200% 100%;
            animation: pcShimmer 6s linear infinite;
            pointer-events: none;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-label {
            color: rgba(var(--pc-neon-rgb), 0.58) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 9px !important;
            letter-spacing: 0.2em !important;
            text-transform: uppercase !important;
            font-weight: 600 !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip strong {
            color: #ffffff !important;
            font-size: 26px !important;
            font-weight: 700 !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            text-shadow:
                0 0 14px rgba(var(--pc-neon-rgb), 0.26),
                0 0 40px rgba(var(--pc-neon-rgb), 0.08) !important;
            animation: pcStatCount 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
            line-height: 1 !important;
        }

        /* First stat chip (Total) gets special cyan accent */
        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:nth-child(1)::before {
            background: linear-gradient(90deg,
                rgba(var(--pc-cyan-rgb), 0) 0%,
                rgba(var(--pc-cyan-rgb), 0.74) 52%,
                rgba(var(--pc-cyan-rgb), 0) 100%) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:nth-child(1) strong {
            text-shadow:
                0 0 14px rgba(var(--pc-cyan-rgb), 0.3),
                0 0 40px rgba(var(--pc-cyan-rgb), 0.1) !important;
        }

        /* Third stat chip (Out of Stock) gets warning accent */
        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:nth-child(3)::before {
            background: linear-gradient(90deg,
                rgba(255, 118, 118, 0) 0%,
                rgba(255, 118, 118, 0.64) 52%,
                rgba(255, 118, 118, 0) 100%) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:nth-child(3) {
            border-color: rgba(255, 118, 118, 0.18) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:nth-child(3) .products-stat-label {
            color: rgba(255, 118, 118, 0.58) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:nth-child(3) strong {
            text-shadow:
                0 0 14px rgba(255, 118, 118, 0.28),
                0 0 40px rgba(255, 118, 118, 0.08) !important;
        }

        /* --- Filter Pills: Neon Capsules --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-filter-pill {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.2) !important;
            background: rgba(var(--pc-neon-rgb), 0.03) !important;
            color: rgba(var(--pc-neon-rgb), 0.72) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 10px !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            padding: 0 16px !important;
            min-height: 32px !important;
            border-radius: 999px !important;
            transition: all 0.16s ease !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-filter-pill:hover,
        body.admin-products-view:not(.admin-add-product-view) #products .products-filter-pill:focus-visible {
            border-color: rgba(var(--pc-neon-rgb), 0.48) !important;
            background: rgba(var(--pc-neon-rgb), 0.06) !important;
            color: var(--pc-neon) !important;
            box-shadow: 0 0 16px rgba(var(--pc-neon-rgb), 0.08) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-filter-pill.active {
            border-color: rgba(var(--pc-neon-rgb), 0.72) !important;
            background:
                linear-gradient(135deg, rgba(var(--pc-neon-rgb), 0.12) 0%, rgba(var(--pc-neon-rgb), 0.04) 100%) !important;
            color: var(--pc-neon) !important;
            box-shadow:
                inset 0 0 8px rgba(var(--pc-neon-rgb), 0.08),
                0 0 20px rgba(var(--pc-neon-rgb), 0.12),
                0 0 4px rgba(var(--pc-neon-rgb), 0.3) !important;
            text-shadow: 0 0 8px rgba(var(--pc-neon-rgb), 0.4) !important;
        }

        /* --- Results Meta: Data Feed --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-results-meta {
            color: rgba(var(--pc-neon-rgb), 0.44) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 10px !important;
            letter-spacing: 0.12em !important;
            text-transform: uppercase !important;
        }

        /* --- Sort Controls --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-sort-trigger {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.22) !important;
            background: rgba(6, 9, 14, 0.96) !important;
            color: rgba(var(--pc-neon-rgb), 0.68) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 10px !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-select-wrap span {
            color: rgba(var(--pc-neon-rgb), 0.38) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 9px !important;
            letter-spacing: 0.18em !important;
        }

        /* --- Table: Data Matrix --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table-shell {
            border-top: 1px solid rgba(var(--pc-neon-rgb), 0.12) !important;
            border-radius: 0 0 16px 16px !important;
            overflow: hidden !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table {
            background: transparent !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table thead th {
            background: rgba(var(--pc-neon-rgb), 0.03) !important;
            color: rgba(var(--pc-neon-rgb), 0.52) !important;
            border-bottom: 1px solid rgba(var(--pc-neon-rgb), 0.16) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            text-transform: uppercase !important;
            letter-spacing: 0.18em !important;
            font-size: 9px !important;
            font-weight: 600 !important;
            padding: 14px 16px !important;
        }

        /* --- Table Rows: Holographic Data Lines --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr {
            background: rgba(6, 9, 14, 0.7) !important;
            border-top: 1px solid rgba(var(--pc-neon-rgb), 0.08) !important;
            transition: all 0.18s ease !important;
            box-shadow: none !important;
            position: relative;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr:nth-child(even) {
            background: rgba(10, 14, 20, 0.76) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr:hover {
            background:
                linear-gradient(90deg, rgba(var(--pc-neon-rgb), 0.04) 0%, rgba(var(--pc-cyan-rgb), 0.02) 50%, transparent 100%),
                rgba(14, 20, 28, 0.88) !important;
            border-color: rgba(var(--pc-neon-rgb), 0.32) !important;
            box-shadow:
                inset 3px 0 0 rgba(var(--pc-neon-rgb), 0.72),
                0 0 24px rgba(var(--pc-neon-rgb), 0.04) !important;
            transform: none !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr td {
            color: #e8eef6 !important;
            border-bottom-color: rgba(var(--pc-neon-rgb), 0.06) !important;
            font-size: 13px !important;
        }

        /* --- Product Thumbnail: Holo-Frame --- */
        body.admin-products-view:not(.admin-add-product-view) #products .product-thumb-frame {
            width: 100px !important;
            height: 132px !important;
            border-radius: 12px !important;
            border: 1px solid rgba(var(--pc-neon-rgb), 0.22) !important;
            background:
                linear-gradient(145deg, rgba(var(--pc-neon-rgb), 0.04) 0%, transparent 60%),
                linear-gradient(180deg, rgba(8, 12, 18, 0.96) 0%, rgba(5, 8, 13, 0.98) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.1),
                0 0 20px rgba(var(--pc-neon-rgb), 0.04),
                0 8px 18px rgba(0, 0, 0, 0.36) !important;
            position: relative;
            overflow: hidden;
        }

        /* Thumbnail holographic corner accents */
        body.admin-products-view:not(.admin-add-product-view) #products .product-thumb-frame::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 16px;
            height: 16px;
            border-top: 1.5px solid rgba(var(--pc-neon-rgb), 0.44);
            border-left: 1.5px solid rgba(var(--pc-neon-rgb), 0.44);
            border-radius: 12px 0 0 0;
            pointer-events: none;
            z-index: 1;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-thumb-frame::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 16px;
            height: 16px;
            border-bottom: 1.5px solid rgba(var(--pc-neon-rgb), 0.44);
            border-right: 1.5px solid rgba(var(--pc-neon-rgb), 0.44);
            border-radius: 0 0 12px 0;
            pointer-events: none;
            z-index: 1;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-thumb.product-thumb--placeholder {
            border: 1px dashed rgba(var(--pc-neon-rgb), 0.22) !important;
            background:
                repeating-linear-gradient(
                    -45deg,
                    rgba(var(--pc-neon-rgb), 0.02) 0px,
                    rgba(var(--pc-neon-rgb), 0.02) 12px,
                    rgba(var(--pc-neon-rgb), 0.01) 12px,
                    rgba(var(--pc-neon-rgb), 0.01) 24px
                ) !important;
        }

        /* --- Product Name & Meta: Data Labels --- */
        body.admin-products-view:not(.admin-add-product-view) #products .product-detail-name {
            color: #ffffff !important;
            font-weight: 620 !important;
            letter-spacing: 0.02em !important;
            font-size: 15px !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-detail-meta {
            color: rgba(var(--pc-neon-rgb), 0.42) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            letter-spacing: 0.08em !important;
            text-transform: uppercase !important;
            font-size: 10px !important;
        }

        /* Type, SKU, Price, Inventory columns */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table td:nth-child(2) {
            color: rgba(var(--pc-purple-rgb), 0.76) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 11px !important;
            letter-spacing: 0.06em !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table td:nth-child(3) {
            color: rgba(var(--pc-cyan-rgb), 0.64) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 11px !important;
            letter-spacing: 0.04em !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table td:nth-child(4) {
            color: #f0f5fc !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 13px !important;
            font-weight: 600 !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table td:nth-child(5) {
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 11px !important;
            letter-spacing: 0.04em !important;
        }

        /* --- Action Menu: Command Palette --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-menu-btn {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.24) !important;
            background: rgba(var(--pc-neon-rgb), 0.03) !important;
            color: rgba(var(--pc-neon-rgb), 0.72) !important;
            box-shadow: none !important;
            border-radius: 10px !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-menu-btn:hover,
        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-menu-btn:focus-visible {
            border-color: rgba(var(--pc-neon-rgb), 0.62) !important;
            background: rgba(var(--pc-neon-rgb), 0.08) !important;
            color: var(--pc-neon) !important;
            box-shadow: 0 0 16px rgba(var(--pc-neon-rgb), 0.1) !important;
            transform: none !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-menu {
            border: 1px solid rgba(var(--pc-neon-rgb), 0.2) !important;
            background:
                linear-gradient(180deg, rgba(10, 15, 22, 0.98) 0%, rgba(6, 9, 14, 0.99) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.08),
                0 0 32px rgba(var(--pc-neon-rgb), 0.06),
                0 20px 36px rgba(0, 0, 0, 0.5) !important;
            border-radius: 12px !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-item {
            color: #e7f0fc !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            font-size: 12px !important;
            letter-spacing: 0.04em !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-item:hover,
        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-item:focus-visible {
            background: rgba(var(--pc-neon-rgb), 0.06) !important;
            color: var(--pc-neon) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-item.delete-action {
            color: rgba(255, 118, 118, 0.84) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-item.delete-action:hover,
        body.admin-products-view:not(.admin-add-product-view) #products .products-table .action-item.delete-action:focus-visible {
            background: rgba(255, 60, 60, 0.08) !important;
            color: #ff9e9e !important;
        }

        /* --- Empty State: Terminal Output --- */
        body.admin-products-view:not(.admin-add-product-view) #products #productsTable > tr > td[colspan] {
            color: rgba(var(--pc-neon-rgb), 0.38) !important;
            background: rgba(var(--pc-neon-rgb), 0.02) !important;
            border: 1px dashed rgba(var(--pc-neon-rgb), 0.14) !important;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace !important;
            text-transform: uppercase !important;
            letter-spacing: 0.1em !important;
            font-size: 11px !important;
            border-radius: 12px !important;
            padding: 24px !important;
        }

        /* --- Stat Responsive --- */
        @media (max-width: 640px) {
            body.admin-products-view:not(.admin-add-product-view) #products .products-quick-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            }
            body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip strong {
                font-size: 20px !important;
            }
        }

        @media (max-width: 480px) {
            body.admin-products-view:not(.admin-add-product-view) #products .products-quick-stats {
                grid-template-columns: 1fr !important;
            }
        }

        /* --- Inventory Status Badges: HUD Indicators --- */
        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-family: "JetBrains Mono", "SF Mono", Menlo, monospace;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.06em;
            padding: 4px 12px 4px 8px;
            border-radius: 999px;
            white-space: nowrap;
        }

        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
            position: relative;
        }

        /* Online (In Stock) */
        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge.status--online {
            color: var(--pc-neon) !important;
            background: rgba(var(--pc-neon-rgb), 0.06) !important;
            border: 1px solid rgba(var(--pc-neon-rgb), 0.24) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge.status--online .status-dot {
            background: var(--pc-neon);
            box-shadow: 0 0 6px rgba(var(--pc-neon-rgb), 0.6), 0 0 14px rgba(var(--pc-neon-rgb), 0.2);
            animation: pcPulseRing 2s ease-in-out infinite;
        }

        /* Offline (Out of Stock) */
        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge.status--offline {
            color: rgba(255, 118, 118, 0.86) !important;
            background: rgba(255, 60, 60, 0.06) !important;
            border: 1px solid rgba(255, 60, 60, 0.2) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge.status--offline .status-dot {
            background: rgba(255, 100, 100, 0.86);
            box-shadow: 0 0 6px rgba(255, 60, 60, 0.4);
        }

        /* Warning (Partially Out of Stock) */
        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge.status--warning {
            color: rgba(255, 200, 80, 0.86) !important;
            background: rgba(255, 200, 80, 0.06) !important;
            border: 1px solid rgba(255, 200, 80, 0.2) !important;
        }

        body.admin-products-view:not(.admin-add-product-view) .inventory-status-badge.status--warning .status-dot {
            background: rgba(255, 190, 60, 0.86);
            box-shadow: 0 0 6px rgba(255, 190, 60, 0.4);
            animation: pcPulseRing 2.5s ease-in-out infinite;
        }

        /* --- Stat Card Hover: Reveal Effect --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip:hover {
            border-color: rgba(var(--pc-neon-rgb), 0.36) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.16),
                0 0 32px rgba(var(--pc-neon-rgb), 0.08),
                0 14px 28px rgba(0, 0, 0, 0.36) !important;
            transform: translateY(-1px);
            transition: all 0.2s ease !important;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-stat-chip {
            transition: all 0.2s ease !important;
            cursor: default;
        }

        /* --- Row Hover: Neon Left-Edge Animation --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr::before {
            content: "";
            position: absolute;
            left: 0;
            top: 20%;
            bottom: 20%;
            width: 0;
            background: var(--pc-neon);
            border-radius: 0 4px 4px 0;
            transition: all 0.2s ease;
            box-shadow: 0 0 8px rgba(var(--pc-neon-rgb), 0.4);
            opacity: 0;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr:hover::before {
            width: 3px;
            opacity: 1;
        }

        /* --- Product Name Hover Glow --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr:hover .product-detail-name {
            color: var(--pc-neon) !important;
            text-shadow: 0 0 16px rgba(var(--pc-neon-rgb), 0.2);
            transition: all 0.2s ease;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-detail-name {
            transition: all 0.2s ease;
        }

        /* --- Thumbnail Hover Effect --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr:hover .product-thumb-frame {
            border-color: rgba(var(--pc-neon-rgb), 0.44) !important;
            box-shadow:
                inset 0 1px 0 rgba(var(--pc-neon-rgb), 0.16),
                0 0 28px rgba(var(--pc-neon-rgb), 0.1),
                0 10px 24px rgba(0, 0, 0, 0.4) !important;
            transition: all 0.2s ease;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .product-thumb-frame {
            transition: all 0.2s ease;
        }

        /* --- Scrollbar: Neon Track --- */
        body.admin-products-view:not(.admin-add-product-view) #products .products-table-shell::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table-shell::-webkit-scrollbar-track {
            background: rgba(var(--pc-neon-rgb), 0.03);
            border-radius: 4px;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table-shell::-webkit-scrollbar-thumb {
            background: rgba(var(--pc-neon-rgb), 0.18);
            border-radius: 4px;
        }

        body.admin-products-view:not(.admin-add-product-view) #products .products-table-shell::-webkit-scrollbar-thumb:hover {
            background: rgba(var(--pc-neon-rgb), 0.34);
        }

        /* ═══════════════════════════════════════════════════
           CLEAN DASHBOARD — left sidebar + white content
           ═══════════════════════════════════════════════════ */

        /* Reset ALL dark theme variables */
        :root {
            --master-bg-a: #f5f5f5 !important;
            --master-bg-b: #f5f5f5 !important;
            --master-bg-c: #f5f5f5 !important;
            --master-text: #000 !important;
            --master-muted: #737373 !important;
            --master-glow: transparent !important;
            --master-accent-a: #000 !important;
            --master-accent-b: #000 !important;
            --master-soft-line: transparent !important;
            --master-strong-line: transparent !important;
            --admin-rail-width: 240px !important;
            --admin-rail-gap: 0px !important;
        }

        /* ── Kill every pseudo-element glow/grid/scan effect ── */
        html::before, html::after,
        body::before, body::after,
        .admin-header::before, .admin-header::after,
        .admin-menu-shell::before, .admin-menu-shell::after,
        .admin-guided-tabs .tab-btn::before,
        .admin-guided-tabs .tab-btn::after,
        #orders.tab-content::before, #orders.tab-content::after,
        #products.tab-content::before, #products.tab-content::after,
        #analytics.tab-content::before, #analytics.tab-content::after,
        #invoices.tab-content::before, #invoices.tab-content::after,
        #custom-orders.tab-content::before, #custom-orders.tab-content::after,
        #settings.tab-content::before, #settings.tab-content::after,
        .fx-orders-card::before, .fx-orders-card::after,
        .orders-command-surface::before, .orders-command-surface::after,
        .order-table-block::before, .order-table-block::after,
        .admin-quick-btn::before,
        .orders-filter-pill::before,
        .orders-sort-trigger::before,
        .orders-sort-option::before,
        .btn::before, .btn-small::before,
        .admin-logout-btn::before,
        button::before {
            display: none !important;
            content: none !important;
            opacity: 0 !important;
        }

        /* ── Base ── */
        html, body {
            background: #f5f5f5 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        body {
            font-family: 'Montserrat', system-ui, sans-serif !important;
            color: #000 !important;
            padding-top: 0 !important;
            display: flex !important;
            min-height: 100vh !important;
        }

        /* ── LEFT SIDEBAR ── */
        .admin-header {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            bottom: 0 !important;
            width: 240px !important;
            height: 100vh !important;
            background: #000 !important;
            border: none !important;
            border-right: 1px solid rgba(255,255,255,0.06) !important;
            box-shadow: none !important;
            z-index: 100 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }

        .admin-menu-shell {
            display: flex !important;
            flex-direction: column !important;
            height: 100% !important;
            padding: 24px 14px 14px !important;
            gap: 0 !important;
            background: transparent !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            overflow: visible !important;
        }

        .admin-menu-intro {
            display: block !important;
            margin: 0 0 24px 0 !important;
            padding: 0 6px !important;
        }

        .admin-menu-hint {
            display: none !important;
        }

        .admin-menu-intro::before {
            content: 'GHOHARY' !important;
            display: block !important;
            font-size: 18px !important;
            font-weight: 600 !important;
            color: #fff !important;
            letter-spacing: 0.14em !important;
            margin-bottom: 4px !important;
        }

        .admin-menu-intro::after {
            content: 'Admin' !important;
            display: block !important;
            font-size: 11px !important;
            color: rgba(255,255,255,0.35) !important;
            letter-spacing: 0.08em !important;
        }

        /* ── Sidebar nav tabs ── */
        .admin-guided-tabs {
            display: flex !important;
            flex-direction: column !important;
            gap: 4px !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
            flex-wrap: nowrap !important;
            grid-template-columns: none !important;
        }

        .admin-guided-tabs .tab-btn {
            display: flex !important;
            align-items: center !important;
            gap: 0 !important;
            width: 100% !important;
            min-height: auto !important;
            padding: 10px 12px !important;
            border-radius: 8px !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            color: rgba(255,255,255,0.5) !important;
            text-align: left !important;
            justify-content: flex-start !important;
            cursor: pointer !important;
            transition: background 0.15s, color 0.15s !important;
            transform: none !important;
            overflow: visible !important;
            flex: none !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            background: rgba(255,255,255,0.06) !important;
            color: #fff !important;
            box-shadow: none !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn:active {
            background: rgba(255,255,255,0.1) !important;
            box-shadow: none !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn.active {
            background: rgba(255,255,255,0.1) !important;
            color: #fff !important;
            border: none !important;
            box-shadow: none !important;
        }

        .admin-guided-tabs .tab-btn.active:hover {
            background: rgba(255,255,255,0.14) !important;
            box-shadow: none !important;
            transform: none !important;
        }

        .tab-btn-icon { display: none !important; }

        .tab-btn-copy {
            display: flex !important;
            flex-direction: column !important;
            gap: 2px !important;
            align-items: flex-start !important;
            text-align: left !important;
        }

        .tab-btn-title {
            font-size: 13px !important;
            font-weight: 500 !important;
            letter-spacing: 0 !important;
            color: inherit !important;
        }

        .tab-btn-desc {
            font-size: 10px !important;
            letter-spacing: 0 !important;
            color: rgba(255,255,255,0.3) !important;
        }

        .admin-guided-tabs .tab-btn:hover .tab-btn-title,
        .admin-guided-tabs .tab-btn:hover .tab-btn-desc { color: #fff !important; }

        .admin-guided-tabs .tab-btn.active .tab-btn-title { color: #fff !important; }
        .admin-guided-tabs .tab-btn.active .tab-btn-desc { color: rgba(255,255,255,0.5) !important; }

        /* ── Sidebar quick actions ── */
        .admin-quick-actions {
            display: flex !important;
            flex-direction: column !important;
            gap: 4px !important;
            padding: 16px 0 0 !important;
            margin-top: auto !important;
            border-top: 1px solid rgba(255,255,255,0.06) !important;
        }

        .admin-quick-btn {
            width: 100% !important;
            background: rgba(255,255,255,0.05) !important;
            border: 1px solid rgba(255,255,255,0.08) !important;
            border-radius: 6px !important;
            color: rgba(255,255,255,0.6) !important;
            font-size: 11px !important;
            font-weight: 500 !important;
            padding: 8px 12px !important;
            text-align: left !important;
            letter-spacing: 0 !important;
            text-transform: none !important;
            box-shadow: none !important;
            min-height: auto !important;
            cursor: pointer !important;
            transition: background 0.15s !important;
        }

        .admin-quick-btn:hover {
            background: rgba(255,255,255,0.1) !important;
            color: #fff !important;
            transform: none !important;
            box-shadow: none !important;
            letter-spacing: 0 !important;
        }

        /* ── Sidebar status bar ── */
        .fx-admin-bar {
            display: flex !important;
            flex-direction: column !important;
            gap: 0 !important;
            padding: 10px 0 0 !important;
            margin-top: 10px !important;
            border-top: 1px solid rgba(255,255,255,0.06) !important;
        }

        .fx-admin-pill {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 6px !important;
            font-size: 10px !important;
            color: rgba(255,255,255,0.3) !important;
            background: transparent !important;
            border: none !important;
            padding: 4px 6px !important;
            box-shadow: none !important;
        }

        .fx-admin-pill strong {
            color: rgba(255,255,255,0.55) !important;
            font-weight: 500 !important;
        }

        .fx-admin-dot {
            width: 6px !important;
            height: 6px !important;
            border-radius: 50% !important;
            background: #22c55e !important;
            box-shadow: none !important;
            animation: none !important;
        }

        /* ── MAIN CONTENT (right side) ── */
        .container {
            margin-left: 240px !important;
            width: calc(100% - 240px) !important;
            max-width: none !important;
            background: #f5f5f5 !important;
            padding: clamp(20px, 3vw, 32px) !important;
            min-height: 100vh !important;
        }

        /* ── Tab content panels ── */
        .tab-content,
        #orders.tab-content,
        #products.tab-content,
        #analytics.tab-content,
        #invoices.tab-content,
        #custom-orders.tab-content,
        #settings.tab-content {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin-top: 0 !important;
            animation: none !important;
            opacity: 1 !important;
            overflow: visible !important;
            position: static !important;
        }

        .tab-content h2, #orders h2 {
            font-family: 'Montserrat', system-ui, sans-serif !important;
            font-size: clamp(22px, 4vw, 28px) !important;
            font-weight: 600 !important;
            letter-spacing: -0.01em !important;
            color: #000 !important;
            margin-bottom: 20px !important;
            padding-bottom: 0 !important;
        }

        .tab-content h2::after { display: none !important; }

        .tab-content h3 {
            font-family: 'Montserrat', system-ui, sans-serif !important;
            font-size: clamp(16px, 3vw, 20px) !important;
            font-weight: 600 !important;
            letter-spacing: 0 !important;
            color: #000 !important;
            margin: 24px 0 16px !important;
        }

        #orders, #orders * { color: #000 !important; }
        #orders .payment-badge.paid, #orders .fulfillment-badge.delivered { color: #166534 !important; }
        #orders .fulfillment-badge.underway { color: #854d0e !important; }
        #orders .fulfillment-badge.unfulfilled { color: #991b1b !important; }

        /* ── KPI cards ── */
        .fx-orders-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 12px !important;
            margin-bottom: 20px !important;
        }

        .fx-orders-card {
            background: #fff !important;
            border: 1px solid rgba(0,0,0,0.08) !important;
            border-radius: 10px !important;
            padding: 16px 18px !important;
            box-shadow: none !important;
        }

        .fx-orders-label { font-size: 12px !important; font-weight: 500 !important; color: #737373 !important; letter-spacing: 0 !important; text-transform: none !important; margin-bottom: 6px !important; }
        .fx-orders-value { font-size: 28px !important; font-weight: 700 !important; color: #000 !important; letter-spacing: -0.02em !important; line-height: 1.1 !important; }
        .fx-orders-meta { font-size: 11px !important; color: #a3a3a3 !important; margin-top: 4px !important; letter-spacing: 0 !important; text-transform: none !important; }

        /* ── Search & controls ── */
        .orders-command-surface { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; padding: 16px 18px !important; margin-bottom: 16px !important; box-shadow: none !important; }

        #orders .order-search { display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 14px !important; }
        #orders .order-search label { font-size: 13px !important; font-weight: 500 !important; color: #000 !important; letter-spacing: 0 !important; text-transform: none !important; margin: 0 !important; white-space: nowrap !important; }
        #orders .order-search input { flex: 1 !important; height: 42px !important; min-height: 42px !important; border: 1px solid rgba(0,0,0,0.12) !important; border-radius: 8px !important; background: #fafafa !important; color: #000 !important; font-size: 13px !important; padding: 0 14px !important; }
        #orders .order-search input::placeholder { color: #b5b5b5 !important; }
        #orders .order-search input:focus { border-color: #000 !important; background: #fff !important; box-shadow: 0 0 0 2px rgba(0,0,0,0.06) !important; }

        .orders-filter-pills { display: flex !important; gap: 4px !important; }
        .orders-filter-pill { background: transparent !important; border: 1px solid rgba(0,0,0,0.1) !important; border-radius: 6px !important; color: #525252 !important; font-size: 12px !important; font-weight: 500 !important; padding: 7px 14px !important; letter-spacing: 0 !important; text-transform: none !important; box-shadow: none !important; min-height: auto !important; cursor: pointer !important; }
        .orders-filter-pill:hover { background: #f0f0f0 !important; border-color: rgba(0,0,0,0.2) !important; color: #000 !important; transform: none !important; box-shadow: none !important; letter-spacing: 0 !important; }
        .orders-filter-pill.active { background: #000 !important; border-color: #000 !important; color: #fff !important; box-shadow: none !important; }

        #orderSortSelect { position: absolute !important; opacity: 0 !important; pointer-events: none !important; width: 0 !important; height: 0 !important; }
        .orders-sort-trigger { background: #fff !important; border: 1px solid rgba(0,0,0,0.12) !important; border-radius: 6px !important; padding: 7px 14px !important; font-size: 12px !important; font-weight: 500 !important; color: #000 !important; box-shadow: none !important; letter-spacing: 0 !important; text-transform: none !important; min-height: auto !important; }
        .orders-sort-trigger:hover { border-color: #000 !important; transform: none !important; box-shadow: none !important; letter-spacing: 0 !important; background: #fff !important; }
        .orders-sort-menu { background: #fff !important; border: 1px solid rgba(0,0,0,0.1) !important; border-radius: 8px !important; box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important; }
        .orders-sort-option { padding: 8px 12px !important; font-size: 12px !important; color: #525252 !important; border-radius: 4px !important; background: transparent !important; border: none !important; box-shadow: none !important; letter-spacing: 0 !important; text-transform: none !important; }
        .orders-sort-option:hover { background: #f5f5f5 !important; color: #000 !important; transform: none !important; }
        .orders-sort-option.active { background: #000 !important; color: #fff !important; }
        .orders-results-meta { font-size: 11px !important; color: #a3a3a3 !important; margin-top: 12px !important; letter-spacing: 0 !important; text-transform: none !important; }

        /* ── Table ── */
        #orders .order-table-block { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; overflow: hidden !important; box-shadow: none !important; }
        #orders .order-table-block table { border-collapse: collapse !important; border-spacing: 0 !important; margin: 0 !important; }
        #orders .order-table-block thead, #orders .order-table-block thead tr { background: #fafafa !important; }
        #orders .order-table-block thead th { font-family: 'Montserrat', system-ui, sans-serif !important; font-size: 11px !important; font-weight: 600 !important; color: #737373 !important; letter-spacing: 0.02em !important; text-transform: uppercase !important; padding: 12px 16px !important; border-bottom: 1px solid rgba(0,0,0,0.06) !important; background: transparent !important; }
        #orders .order-table-block tbody tr { background: #fff !important; box-shadow: none !important; }
        #orders .order-table-block tbody tr td { padding: 14px 16px !important; font-size: 13px !important; color: #000 !important; border-bottom: 1px solid rgba(0,0,0,0.04) !important; }
        #orders .order-table-block tbody tr:hover td { background: #f9f9f9 !important; }
        .orders-empty-state-cell { font-size: 14px !important; color: #a3a3a3 !important; text-align: center !important; padding: 48px 16px !important; }

        /* ── Badges ── */
        .payment-badge, .fulfillment-badge { border-radius: 6px !important; font-size: 11px !important; font-weight: 500 !important; letter-spacing: 0 !important; text-transform: none !important; padding: 4px 10px !important; min-width: auto !important; }
        .payment-badge.paid { background: #dcfce7 !important; color: #166534 !important; border-color: transparent !important; }
        .fulfillment-badge.delivered { background: #dcfce7 !important; color: #166534 !important; border-color: transparent !important; }
        .fulfillment-badge.underway { background: #fef9c3 !important; color: #854d0e !important; border-color: transparent !important; }
        .fulfillment-badge.unfulfilled { background: #fee2e2 !important; color: #991b1b !important; border-color: transparent !important; }

        /* ── Logout ── */
        .admin-logout-btn { position: fixed !important; top: 16px !important; right: 20px !important; background: transparent !important; color: #737373 !important; border: 1px solid rgba(0,0,0,0.1) !important; border-radius: 6px !important; padding: 6px 14px !important; font-size: 11px !important; font-weight: 500 !important; letter-spacing: 0 !important; text-transform: none !important; z-index: 1002 !important; box-shadow: none !important; }
        .admin-logout-btn:hover { background: #f0f0f0 !important; color: #000 !important; transform: none !important; box-shadow: none !important; letter-spacing: 0 !important; }

        /* ── Forms ── */
        form { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; padding: clamp(20px, 4vw, 32px) !important; box-shadow: none !important; margin-bottom: 20px !important; }
        label { font-size: 12px !important; font-weight: 500 !important; color: #525252 !important; letter-spacing: 0 !important; text-transform: none !important; margin-bottom: 6px !important; }
        input, textarea, select { height: 42px !important; min-height: 42px !important; border: 1px solid rgba(0,0,0,0.12) !important; border-radius: 8px !important; background: #fff !important; color: #000 !important; font-size: 13px !important; padding: 0 14px !important; font-family: 'Montserrat', system-ui, sans-serif !important; font-weight: 400 !important; letter-spacing: 0 !important; }
        textarea { height: auto !important; min-height: 80px !important; padding: 12px 14px !important; }
        input:focus, textarea:focus, select:focus { border-color: #000 !important; box-shadow: 0 0 0 2px rgba(0,0,0,0.06) !important; background: #fff !important; }

        /* ── Buttons ── */
        button { font-family: 'Montserrat', system-ui, sans-serif !important; }
        .btn, .btn-small { background: #000 !important; color: #fff !important; border: none !important; border-radius: 8px !important; padding: 10px 20px !important; font-size: 12px !important; font-weight: 600 !important; letter-spacing: 0 !important; text-transform: none !important; box-shadow: none !important; }
        .btn:hover, .btn-small:hover { opacity: 0.85 !important; transform: none !important; box-shadow: none !important; letter-spacing: 0 !important; background: #000 !important; }
        .edit-btn { background: #f5f5f5 !important; color: #000 !important; border: 1px solid rgba(0,0,0,0.1) !important; }
        .delete-btn { background: #fee2e2 !important; color: #991b1b !important; }

        /* ── Shipping ── */
        .shipping-settings { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; padding: clamp(20px, 3vw, 28px) !important; }
        .shipping-panel-title { font-family: 'Montserrat', system-ui, sans-serif !important; color: #000 !important; font-weight: 600 !important; letter-spacing: 0 !important; }
        .shipping-panel-subtitle { color: #737373 !important; }
        .shipping-panel-chip { background: #f5f5f5 !important; border: 1px solid rgba(0,0,0,0.08) !important; color: #525252 !important; }
        .shipping-group-box { border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; background: #fff !important; box-shadow: none !important; }
        .shipping-group-toggle { border: 1px solid rgba(0,0,0,0.06) !important; border-radius: 8px !important; background: #fafafa !important; box-shadow: none !important; }
        .shipping-group-toggle:hover { background: #f0f0f0 !important; transform: none !important; }
        .shipping-group-title { color: #000 !important; }
        .shipping-group-count { color: #737373 !important; }
        .shipping-group-chevron { border: 1px solid rgba(0,0,0,0.15) !important; background: #f5f5f5 !important; box-shadow: none !important; }
        .shipping-group-chevron::before { background: #000 !important; }
        .shipping-group-chevron::after { background: #000 !important; }
        .shipping-group-box:not(.is-collapsed) .shipping-group-chevron { background: #000 !important; border-color: #000 !important; }
        .shipping-group-box:not(.is-collapsed) .shipping-group-chevron::before,
        .shipping-group-box:not(.is-collapsed) .shipping-group-chevron::after { background: #fff !important; }
        .shipping-group-meta-field span { color: #737373 !important; }
        .shipping-country-name { color: #000 !important; }

        /* ── Analytics ── */
        .analytics-command-surface { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; box-shadow: none !important; }
        .analytics-kpi span { color: #737373 !important; }
        .analytics-kpi strong { color: #000 !important; }
        .analytics-card { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; box-shadow: none !important; }
        .analytics-card h4 { font-family: 'Montserrat', system-ui, sans-serif !important; color: #000 !important; letter-spacing: 0 !important; }

        /* ── Invoice / Custom ── */
        .invoice-card, .custom-order-card { background: #fff !important; border: 1px solid rgba(0,0,0,0.08) !important; border-radius: 10px !important; }
        .invoice-card h4, .custom-order-card h4 { font-family: 'Montserrat', system-ui, sans-serif !important; color: #000 !important; letter-spacing: 0 !important; }

        /* ── Mobile: collapse sidebar to top ── */
        @media (max-width: 900px) {
            .admin-header {
                position: relative !important;
                width: 100% !important;
                height: auto !important;
                border-right: none !important;
                border-bottom: 1px solid rgba(255,255,255,0.06) !important;
            }

            .admin-menu-shell {
                flex-direction: column !important;
                height: auto !important;
                padding: 16px !important;
            }

            .admin-menu-intro {
                margin-bottom: 12px !important;
            }

            .admin-guided-tabs {
                flex-direction: row !important;
                flex-wrap: nowrap !important;
                overflow-x: auto !important;
                gap: 4px !important;
                -webkit-overflow-scrolling: touch !important;
            }

            .admin-guided-tabs .tab-btn {
                flex: none !important;
                width: auto !important;
            }

            .tab-btn-desc { display: none !important; }

            .admin-quick-actions {
                flex-direction: row !important;
                flex-wrap: wrap !important;
                border-top: none !important;
                padding-top: 8px !important;
                margin-top: 8px !important;
            }

            .admin-quick-btn { width: auto !important; }

            .fx-admin-bar {
                flex-direction: row !important;
                gap: 12px !important;
                border-top: none !important;
            }

            .container {
                margin-left: 0 !important;
                width: 100% !important;
                padding: 16px !important;
            }

            .fx-orders-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
        }

    </style>
</head>
<body>
    <!-- Luxury Header with Icons -->
    <div class="admin-header">
        <div class="admin-menu-shell">
            <div class="admin-menu-intro">
                <div class="admin-menu-hint" id="adminMenuHint">Orders</div>
            </div>

            <div class="tabs admin-guided-tabs">
                <button class="tab-btn active" data-tab="orders" data-tab-hint="Orders">
                    <span class="tab-btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M4.5 6.5h15"></path>
                            <path d="M4.5 12h15"></path>
                            <path d="M4.5 17.5h15"></path>
                        </svg>
                    </span>
                    <span class="tab-btn-copy">
                        <span class="tab-btn-title">Orders</span>
                        <span class="tab-btn-desc">Payments and fulfillment flow</span>
                    </span>
                </button>
                <button class="tab-btn" data-tab="analytics" data-tab-hint="Analytics">
                    <span class="tab-btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="8.5"></circle>
                            <path d="M3.5 12h17"></path>
                            <path d="M12 3.5v17"></path>
                        </svg>
                    </span>
                    <span class="tab-btn-copy">
                        <span class="tab-btn-title">Analytics</span>
                        <span class="tab-btn-desc">Live visitors and 24h activity</span>
                    </span>
                </button>
                <button class="tab-btn" data-tab="products" data-tab-hint="Products">
                    <span class="tab-btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M3.5 7.5h17v12h-17z"></path>
                            <path d="M8 7.5v-2.2a1.8 1.8 0 0 1 1.8-1.8h4.4A1.8 1.8 0 0 1 16 5.3v2.2"></path>
                        </svg>
                    </span>
                    <span class="tab-btn-copy">
                        <span class="tab-btn-title">Products</span>
                        <span class="tab-btn-desc">Catalog, media, and publishing</span>
                    </span>
                </button>
                <button class="tab-btn" data-tab="custom-orders" data-tab-hint="Custom Orders">
                    <span class="tab-btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M7 20.5h10"></path>
                            <path d="M12 3.5v17"></path>
                            <path d="M6.5 8.5h11"></path>
                        </svg>
                    </span>
                    <span class="tab-btn-copy">
                        <span class="tab-btn-title">Custom Orders</span>
                        <span class="tab-btn-desc">Bespoke client requests</span>
                    </span>
                </button>
                <button class="tab-btn" data-tab="invoices" data-tab-hint="Invoices">
                    <span class="tab-btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M6 3.5h12v17l-3-2.2-3 2.2-3-2.2-3 2.2z"></path>
                            <path d="M8.5 8h7"></path>
                            <path d="M8.5 12h7"></path>
                        </svg>
                    </span>
                    <span class="tab-btn-copy">
                        <span class="tab-btn-title">Invoices</span>
                        <span class="tab-btn-desc">Billing and payment records</span>
                    </span>
                </button>
                <button class="tab-btn" data-tab="settings" data-tab-hint="Shipping">
                    <span class="tab-btn-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M3.5 12h17"></path>
                            <path d="M12 3.5c3.6 0 6.5 3.8 6.5 8.5S15.6 20.5 12 20.5 5.5 16.7 5.5 12 8.4 3.5 12 3.5z"></path>
                            <path d="M12 3.5v17"></path>
                        </svg>
                    </span>
                    <span class="tab-btn-copy">
                        <span class="tab-btn-title">Shipping</span>
                        <span class="tab-btn-desc">Regions and delivery settings</span>
                    </span>
                </button>
            </div>
            <div class="admin-quick-actions" id="adminQuickActions">
                <button type="button" class="admin-quick-btn" data-admin-action="refresh-orders">Sync Orders</button>
                <button type="button" class="admin-quick-btn" data-admin-action="new-product">New Product</button>
                <button type="button" class="admin-quick-btn" data-admin-action="new-invoice">New Invoice</button>
            </div>
            <div class="fx-admin-bar" id="fxAdminBar" aria-label="Console Status">
                <div class="fx-admin-pill">
                    <span class="fx-admin-dot" aria-hidden="true"></span>
                    <strong id="fxAdminMode">Orders Console</strong>
                </div>
                <div class="fx-admin-pill">
                    <span>Node</span>
                    <strong>DXB-PRIME</strong>
                </div>
                <div class="fx-admin-pill">
                    <span>Local Time</span>
                    <strong id="fxAdminClock">--:--:--</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div id="alertContainer"></div>

        <!-- PRODUCTS TAB -->
        <div id="products" class="tab-content">
            <div class="product-header">
                <div class="product-header-titles">
                    <a href="admin.html" class="product-header-link">Products</a>
                    <div id="productSubnavTitle" class="product-header-subtitle">All Products</div>
                </div>
                <div class="product-header-actions">
                    <div class="product-primary-actions">
                        <a href="admin.html" class="back-to-products">Back to Products</a>
                        <button type="submit" form="productForm" class="btn add-product-submit" id="addProductSubmit">Add Product</button>
                        <a href="admin.html?view=add-product" class="btn add-product-link">Add Product</a>
                        <div class="product-search-inline">
                            <input id="productSearchInput" type="text" placeholder="Search by name, SKU, or collection">
                        </div>
                    </div>
                </div>
                </div>

            <div id="productFormSection">
                <form id="productForm">
                    <div class="form-section product-top-grid">
                        <div class="form-section-card">
                            <div class="form-section-title">Product Images</div>
                            <div class="media-section">
                                <div class="media-grid">
                                    <div class="media-block">
                                        <div id="imageDropzone" class="image-dropzone" role="button" tabindex="0" aria-label="Upload product images">
                                            <input type="file" id="productImages" class="image-dropzone-native-input" accept="image/*" multiple>
                                            <div class="image-dropzone-content">
                                                <span class="image-dropzone-title">Drop images here or click to upload</span>
                                                <label for="productImages" class="image-dropzone-link">Click to upload</label>
                                                <span class="image-dropzone-meta">Up to 10 images. JPG, PNG, WEBP, HEIC, AVIF.</span>
                                            </div>
                                        </div>
                                        <div class="upload-progress" id="uploadProgress">
                                            <div class="upload-progress-bar"><span></span></div>
                                            <div class="upload-progress-text" id="uploadProgressText">Uploading...</div>
                                        </div>
                                        <div id="imagePreview" class="image-preview-container"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section product-info-section">
                        <div class="form-section-title">Product Details</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Product Name *</label>
                                <input type="text" id="productName" required>
                            </div>
                            <div class="form-group">
                                <label>Collection *</label>
                                <div class="futuristic-select" id="productCategorySelectShell">
                                    <select id="productCategory" required>
                                        <option value="">Select Category</option>
                                        <option value="abaya">Abaya</option>
                                        <option value="evening">Ready To Wear</option>
                                        <option value="couture">Couture</option>
                                        <option value="bridal">Bridal</option>
                                    </select>
                                    <button type="button" class="futuristic-select-trigger" id="productCategoryTrigger" aria-haspopup="listbox" aria-expanded="false">
                                        <span id="productCategoryTriggerLabel">Select Category</span>
                                    </button>
                                    <div class="futuristic-select-menu" id="productCategoryMenu" role="listbox" tabindex="-1" aria-label="Collection options"></div>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>SKU (Auto-generated)</label>
                                <input type="text" id="productSku" placeholder="Assigned automatically after save" readonly>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Price (AED) - Optional (Leave blank for "Price Upon Request")</label>
                                <input type="number" id="productPrice" step="0.01" placeholder="Leave blank for price upon request">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Description (Optional)</label>
                            <textarea id="productDescription"></textarea>
                        </div>
                    </div>

                    <div class="form-section product-sizes-section">
                        <div class="form-section-title">Inventory by Size</div>
                        <div class="form-group">
                            <label>Available Sizes</label>
                            <div id="sizeSelector" class="size-selector">
                                <button type="button" class="size-btn" data-size="32">32</button>
                                <button type="button" class="size-btn" data-size="34">34</button>
                                <button type="button" class="size-btn" data-size="36">36</button>
                                <button type="button" class="size-btn" data-size="38">38</button>
                                <button type="button" class="size-btn" data-size="40">40</button>
                                <button type="button" class="size-btn" data-size="42">42</button>
                                <button type="button" class="size-btn" data-size="44">44</button>
                                <button type="button" class="size-btn" data-size="46">46</button>
                                <button type="button" class="size-btn" data-size="48">48</button>
                                <button type="button" class="size-btn" data-size="50">50</button>
                                <button type="button" class="size-btn" data-size="52">52</button>
                                <button type="button" class="size-btn universal" data-size="Universal">Universal</button>
                            </div>
                            <div id="selectedSizes" class="selected-sizes-display" aria-live="polite"></div>
                            <div id="sizeInventoryMatrix" class="size-inventory-matrix" aria-live="polite"></div>
                        </div>
                    </div>

                </form>
            </div>

            <div id="productListSection">
                <div class="products-control-surface" id="productsControlSurface">
                    <div class="products-quick-stats">
                        <div class="products-stat-chip">
                            <span class="products-stat-label">Total</span>
                            <strong id="productsStatTotal">0</strong>
                        </div>
                        <div class="products-stat-chip">
                            <span class="products-stat-label">In Stock</span>
                            <strong id="productsStatInStock">0</strong>
                        </div>
                        <div class="products-stat-chip">
                            <span class="products-stat-label">Out of Stock</span>
                            <strong id="productsStatOutOfStock">0</strong>
                        </div>
                        <div class="products-stat-chip">
                            <span class="products-stat-label">Price on Request</span>
                            <strong id="productsStatPriceRequest">0</strong>
                        </div>
                    </div>
                    <div class="products-control-row">
                        <div class="products-filter-pills" role="tablist" aria-label="Product filters">
                            <button type="button" class="products-filter-pill active" data-product-filter="all">All</button>
                            <button type="button" class="products-filter-pill" data-product-filter="in-stock">In Stock</button>
                            <button type="button" class="products-filter-pill" data-product-filter="low-stock">Low Stock</button>
                            <button type="button" class="products-filter-pill" data-product-filter="out-of-stock">Out of Stock</button>
                            <button type="button" class="products-filter-pill" data-product-filter="price-request">Price on Request</button>
                        </div>
                        <div class="products-select-controls">
                            <label class="products-select-wrap products-sort-wrap" for="productSortSelect">
                                <span>Sort</span>
                                <div class="products-sort-select" id="productSortShell">
                                    <select id="productSortSelect">
                                        <option value="newest">Newest</option>
                                        <option value="oldest">Oldest</option>
                                        <option value="name-asc">Name (A-Z)</option>
                                        <option value="name-desc">Name (Z-A)</option>
                                        <option value="price-high">Price (High-Low)</option>
                                        <option value="price-low">Price (Low-High)</option>
                                        <option value="inventory-high">Inventory (High-Low)</option>
                                        <option value="inventory-low">Inventory (Low-High)</option>
                                    </select>
                                    <button type="button" class="products-sort-trigger" id="productSortTrigger" aria-haspopup="listbox" aria-expanded="false">
                                        <span id="productSortTriggerLabel">Newest</span>
                                    </button>
                                    <div class="products-sort-menu" id="productSortMenu" role="listbox" tabindex="-1" aria-label="Sort options"></div>
                                </div>
                            </label>
                        </div>
                    </div>
                    <div class="products-results-meta" id="productsResultsMeta">Showing 0 of 0 products</div>
                </div>
                <div class="products-table-shell">
                    <table class="products-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>SKU</th>
                                <th>Price</th>
                                <th>Inventory</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="productsTable">
                            <tr><td colspan="6" style="text-align: center; color: #999;">Load products to view</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- ORDERS TAB -->
        <div id="orders" class="tab-content active">
            <h2>Orders</h2>

            <div class="fx-orders-grid" id="fxOrdersGrid" aria-label="Orders telemetry">
                <div class="fx-orders-card">
                    <div class="fx-orders-label">Total Orders</div>
                    <div class="fx-orders-value" id="fxOrdersTotal">0</div>
                    <div class="fx-orders-meta" id="fxOrdersSignal">Syncing</div>
                </div>
                <div class="fx-orders-card">
                    <div class="fx-orders-label">Unfulfilled</div>
                    <div class="fx-orders-value" id="fxOrdersUnfulfilled">0</div>
                    <div class="fx-orders-meta">Needs action</div>
                </div>
                <div class="fx-orders-card">
                    <div class="fx-orders-label">In Transit</div>
                    <div class="fx-orders-value" id="fxOrdersTransit">0</div>
                    <div class="fx-orders-meta">Live movement</div>
                </div>
                <div class="fx-orders-card">
                    <div class="fx-orders-label">Delivered</div>
                    <div class="fx-orders-value" id="fxOrdersDelivered">0</div>
                    <div class="fx-orders-meta">Completed</div>
                </div>
            </div>

            <div class="orders-command-surface" id="ordersCommandSurface">
                <div class="order-search">
                    <label for="orderSearchInput">Search orders</label>
                    <input id="orderSearchInput" type="text" placeholder="Order #, customer, product">
                </div>
                <div class="orders-control-row">
                    <div class="orders-filter-pills" role="tablist" aria-label="Order filters">
                        <button type="button" class="orders-filter-pill active" data-order-filter="all">All</button>
                        <button type="button" class="orders-filter-pill" data-order-filter="unfulfilled">Unfulfilled</button>
                        <button type="button" class="orders-filter-pill" data-order-filter="in-transit">In Transit</button>
                        <button type="button" class="orders-filter-pill" data-order-filter="delivered">Delivered</button>
                        <button type="button" class="orders-filter-pill" data-order-filter="refunded">Refunded</button>
                    </div>
                    <div class="orders-select-controls">
                        <label class="orders-select-wrap orders-sort-wrap" for="orderSortSelect">
                            <span>Sort</span>
                            <div class="orders-sort-select" id="orderSortShell">
                                <select id="orderSortSelect">
                                    <option value="newest">Newest</option>
                                    <option value="oldest">Oldest</option>
                                    <option value="total-high">Total (High-Low)</option>
                                    <option value="total-low">Total (Low-High)</option>
                                    <option value="customer-asc">Customer (A-Z)</option>
                                    <option value="customer-desc">Customer (Z-A)</option>
                                </select>
                                <button type="button" class="orders-sort-trigger" id="orderSortTrigger" aria-haspopup="listbox" aria-expanded="false">
                                    <span id="orderSortTriggerLabel">Newest</span>
                                </button>
                                <div class="orders-sort-menu" id="orderSortMenu" role="listbox" tabindex="-1" aria-label="Order sort options"></div>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="orders-results-meta" id="ordersResultsMeta">Showing 0 of 0 orders</div>
            </div>

            <div class="order-table-block">
                <table>
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Date created</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Payment</th>
                            <th>Fulfillment</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTable">
                        <tr><td colspan="7" class="orders-empty-state-cell">Load orders to view</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ANALYTICS TAB -->
        <div id="analytics" class="tab-content">
            <h2>Analytics Command</h2>
