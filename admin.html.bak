                linear-gradient(155deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 60%),
                linear-gradient(180deg, rgba(23, 27, 33, 0.84) 0%, rgba(16, 19, 24, 0.8) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 24px 48px rgba(4, 9, 15, 0.44),
                0 0 0 1px rgba(97, 129, 163, 0.16),
                0 0 34px rgba(106, 160, 222, 0.08);
            position: relative;
            overflow: hidden;
            -webkit-backdrop-filter: blur(8px) saturate(120%);
            backdrop-filter: blur(8px) saturate(120%);
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products.tab-content::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
            background-size: 18px 18px;
            opacity: 0.36;
            pointer-events: none;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products.tab-content::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: -36%;
            height: 42%;
            background: linear-gradient(
                180deg,
                rgba(125, 190, 255, 0) 0%,
                rgba(125, 190, 255, 0.14) 45%,
                rgba(125, 190, 255, 0) 100%
            );
            opacity: 0.55;
            animation: ordersPanelSweep 8.6s ease-in-out infinite;
            pointer-events: none;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products.tab-content > * {
            position: relative;
            z-index: 1;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products * {
            color: var(--admin-tech-text);
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-header {
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(166, 202, 241, 0.24);
            align-items: center;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-header-link {
            color: #f3f8ff;
            letter-spacing: 0.08em;
            font-size: clamp(24px, 2.5vw, 34px);
            text-transform: uppercase;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-header-link::before {
            content: 'CATALOG NODE';
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 26px;
            padding: 0 10px;
            border-radius: 999px;
            border: 1px solid rgba(176, 209, 245, 0.38);
            background: rgba(39, 60, 89, 0.52);
            color: #d7e9ff;
            font-size: 9px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            font-weight: 600;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-header-subtitle {
            color: #a8bdd4;
            letter-spacing: 0.14em;
            font-size: 11px;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions {
            gap: 10px;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions .btn,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions .back-to-products {
            min-height: 46px;
            border-radius: 999px;
            padding: 0 20px;
            border: 1px solid rgba(166, 202, 241, 0.32);
            background: rgba(18, 28, 41, 0.72);
            color: #eaf3ff;
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            box-shadow: none;
            transform: none;
            transition: border-color 0.24s ease, background 0.24s ease, color 0.24s ease;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions .btn:hover,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions .back-to-products:hover,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions .btn:focus-visible,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-primary-actions .back-to-products:focus-visible {
            background: rgba(30, 45, 64, 0.84);
            border-color: rgba(186, 216, 249, 0.56);
            color: #ffffff;
            transform: none;
            letter-spacing: 0.12em;
            box-shadow: none;
            outline: none;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .add-product-link {
            background: linear-gradient(180deg, rgba(49, 72, 104, 0.78), rgba(36, 54, 78, 0.86));
            border-color: rgba(183, 215, 249, 0.5);
            color: #f2f8ff;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-search-inline input {
            height: 46px;
            border-radius: 999px;
            border: 1px solid rgba(166, 202, 241, 0.34);
            background: rgba(16, 24, 36, 0.74);
            color: #edf5ff;
            box-shadow: none;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-search-inline input::placeholder {
            color: #95a8bf;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-search-inline input:focus {
            border-color: rgba(190, 219, 249, 0.58);
            box-shadow: 0 0 0 3px rgba(115, 161, 209, 0.18);
            outline: none;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products #productListSection {
            border: 1px solid rgba(143, 178, 214, 0.3);
            border-radius: 18px;
            background:
                linear-gradient(180deg, rgba(22, 30, 43, 0.82) 0%, rgba(15, 22, 33, 0.8) 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
            padding: 18px;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table {
            border-spacing: 0 12px;
            background: transparent;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table th {
            background: rgba(16, 24, 35, 0.8);
            border-top: 1px solid rgba(166, 202, 241, 0.26);
            border-bottom: 1px solid rgba(166, 202, 241, 0.26);
            color: #c4d7ed;
            letter-spacing: 0.12em;
            font-size: 11px;
            font-weight: 500;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table thead th:first-child {
            border-left: 1px solid rgba(166, 202, 241, 0.26);
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table thead th:last-child {
            border-right: 1px solid rgba(166, 202, 241, 0.26);
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr {
            background: rgba(18, 25, 35, 0.78);
            outline: 1px solid rgba(138, 173, 207, 0.34);
            box-shadow: none;
            transition: background-color 0.16s ease, outline-color 0.16s ease;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table tbody tr:hover {
            background: rgba(24, 35, 49, 0.86);
            outline-color: rgba(183, 215, 248, 0.54);
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .products-table td {
            color: #e8f2fd;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-thumb-frame {
            border: 1px solid rgba(163, 196, 230, 0.34);
            background: rgba(16, 24, 35, 0.74);
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-thumb.product-thumb--placeholder {
            border: 1px dashed rgba(182, 211, 242, 0.28);
            background: repeating-linear-gradient(
                -45deg,
                rgba(35, 48, 66, 0.88) 0px,
                rgba(35, 48, 66, 0.88) 12px,
                rgba(26, 38, 53, 0.9) 12px,
                rgba(26, 38, 53, 0.9) 24px
            );
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-detail-name {
            color: #f3f8ff;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .product-detail-meta {
            color: #a7bbd0;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-menu-btn {
            border-color: rgba(166, 202, 241, 0.34);
            background: rgba(18, 29, 42, 0.82);
            color: #e8f1fc;
            transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-menu-btn:hover,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-menu-btn:focus-visible {
            background: rgba(34, 50, 71, 0.9);
            border-color: rgba(194, 221, 250, 0.56);
            color: #ffffff;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-menu {
            border-color: rgba(143, 178, 214, 0.42);
            background: linear-gradient(180deg, rgba(17, 26, 38, 0.94) 0%, rgba(11, 18, 27, 0.96) 100%);
            box-shadow: 0 16px 34px rgba(5, 11, 18, 0.52);
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-item {
            color: #e8f2fd;
            transition: background 0.16s ease, color 0.16s ease;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-item:hover,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-item:focus-visible {
            background: rgba(48, 70, 98, 0.5);
            color: #ffffff;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-item.delete-action {
            border-top: 1px solid rgba(166, 202, 241, 0.24);
            color: #ffcbcb;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-item.delete-action:hover,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products .action-item.delete-action:focus-visible {
            background: rgba(117, 45, 45, 0.52);
            color: #ffeaea;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products #productsTable > tr > td[colspan] {
            color: #a8bed6 !important;
            background: rgba(16, 23, 33, 0.68);
            border-radius: 14px;
            border: 1px dashed rgba(156, 191, 227, 0.32);
            padding: 18px !important;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products #productDataSection h3 {
            color: #c7daef;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products #productDataSection form {
            border: 1px solid rgba(143, 178, 214, 0.32) !important;
            background:
                linear-gradient(180deg, rgba(22, 32, 46, 0.82) 0%, rgba(14, 22, 34, 0.84) 100%) !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;
            border-radius: 14px;
        }

        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products #productDataSection h4,
        body.legacy-products-disabled.admin-products-view:not(.admin-add-product-view) #products #productDataSection p {
            color: #d7e7fa !important;
        }

        @media (max-width: 1160px) {
            #custom-orders .custom-order-layout {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 900px) {
            #custom-orders.tab-content {
                padding: 18px;
            }

            #custom-orders .custom-order-card {
                padding: 14px;
            }

            #custom-orders .custom-order-grid.two-col {
                grid-template-columns: 1fr;
            }

            #custom-orders .custom-order-actions .btn,
            #custom-orders .custom-order-actions .btn-small,
            #custom-orders .custom-order-list-actions .btn-small {
                min-width: 100%;
            }
        }

        /* ===== Final Futuristic Shell Override ===== */
        :root {
            --ops-bg-deep: #050914;
            --ops-bg-mid: #0b1422;
            --ops-bg-glass: rgba(8, 15, 27, 0.82);
            --ops-line: rgba(142, 191, 248, 0.34);
            --ops-line-strong: rgba(196, 228, 255, 0.74);
            --ops-text: #ecf6ff;
            --ops-muted: #9fb9d6;
            --ops-neon: #8fc8ff;
            --ops-neon-soft: rgba(143, 200, 255, 0.38);
        }

        body {
            position: relative;
            background:
                radial-gradient(1300px 640px at -4% -12%, rgba(91, 139, 203, 0.30) 0%, rgba(91, 139, 203, 0) 66%),
                radial-gradient(1040px 520px at 108% 104%, rgba(64, 102, 156, 0.30) 0%, rgba(64, 102, 156, 0) 64%),
                linear-gradient(180deg, #0b1322 0%, #060a13 100%) !important;
            color: var(--ops-text);
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(213, 232, 255, 0.042) 1px, transparent 1px),
                linear-gradient(90deg, rgba(213, 232, 255, 0.04) 1px, transparent 1px);
            background-size: 24px 24px;
            opacity: 0.52;
            pointer-events: none;
            z-index: 0;
            animation: techGridDrift 34s linear infinite;
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(75% 42% at 50% -12%, rgba(181, 220, 255, 0.16) 0%, rgba(181, 220, 255, 0) 100%),
                linear-gradient(180deg, rgba(214, 236, 255, 0.09) 0%, rgba(214, 236, 255, 0) 32%);
            pointer-events: none;
            z-index: 0;
            animation: ambientFlux 18s ease-in-out infinite;
        }

        .admin-header,
        .container {
            position: relative;
            z-index: 1;
        }

        .container {
            max-width: min(1700px, 96vw);
            margin: 0 auto;
            padding: clamp(16px, 2.4vw, 30px) clamp(18px, 2.9vw, 38px) clamp(26px, 3.2vw, 44px);
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        .admin-header {
            top: 0;
            position: sticky;
            border-bottom: 1px solid rgba(149, 198, 255, 0.24) !important;
            backdrop-filter: blur(14px) saturate(128%);
            -webkit-backdrop-filter: blur(14px) saturate(128%);
            box-shadow: 0 16px 36px rgba(2, 7, 14, 0.46) !important;
        }

        .admin-header::before {
            opacity: 0.46 !important;
        }

        .admin-header::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 1px;
            background: linear-gradient(90deg, rgba(182, 216, 252, 0) 0%, rgba(182, 216, 252, 0.92) 50%, rgba(182, 216, 252, 0) 100%);
            pointer-events: none;
            box-shadow: 0 0 14px rgba(182, 216, 252, 0.48);
        }

        .admin-menu-shell {
            padding: 10px clamp(18px, 2.6vw, 34px) 12px;
            border-radius: 18px;
            border: 1px solid rgba(153, 204, 255, 0.34);
            background:
                radial-gradient(160% 100% at 50% 0%, rgba(150, 206, 255, 0.10) 0%, rgba(150, 206, 255, 0) 55%),
                linear-gradient(180deg, rgba(16, 27, 44, 0.88) 0%, rgba(7, 13, 24, 0.92) 100%);
            box-shadow:
                inset 0 1px 0 rgba(238, 247, 255, 0.12),
                inset 0 -1px 0 rgba(127, 175, 229, 0.18),
                0 18px 34px rgba(3, 8, 15, 0.4),
                0 0 0 1px rgba(98, 143, 194, 0.18);
            position: relative;
            overflow: hidden;
        }

        .admin-menu-shell::after {
            content: '';
            position: absolute;
            inset: -30% -45%;
            background: linear-gradient(100deg, rgba(164, 216, 255, 0) 0%, rgba(164, 216, 255, 0.16) 45%, rgba(164, 216, 255, 0) 70%);
            pointer-events: none;
            animation: shellSweep 12s linear infinite;
        }

        .admin-menu-intro {
            display: block !important;
            margin: 0 0 10px;
        }

        .admin-menu-hint {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            border-radius: 999px;
            padding: 0 12px;
            border: 1px solid rgba(158, 204, 255, 0.34);
            background: rgba(12, 21, 34, 0.72);
            color: #cfe5ff;
            font-size: 10px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 0 16px rgba(123, 179, 238, 0.18);
        }

        .admin-guided-tabs {
            display: grid !important;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 11px;
            width: 100%;
            align-items: stretch;
        }

        .admin-guided-tabs .tab-btn {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            min-height: 62px;
            border-radius: 14px;
            border: 1px solid var(--ops-line);
            background:
                linear-gradient(180deg, rgba(18, 30, 47, 0.92) 0%, rgba(8, 14, 25, 0.96) 100%);
            color: var(--ops-text);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                inset 0 -1px 0 rgba(127, 175, 229, 0.14),
                0 10px 20px rgba(2, 7, 13, 0.34);
            transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, transform 0.2s ease;
            will-change: auto;
        }

        .admin-guided-tabs .tab-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -120%;
            width: 60%;
            height: 100%;
            background: linear-gradient(100deg, rgba(167, 215, 255, 0) 0%, rgba(167, 215, 255, 0.34) 55%, rgba(167, 215, 255, 0) 100%);
            z-index: 0;
            transform: skewX(-18deg);
            transition: left 0.5s ease;
            pointer-events: none;
        }

        .admin-guided-tabs .tab-btn::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            border: 1px solid rgba(210, 233, 255, 0);
            box-shadow: 0 0 0 rgba(147, 203, 255, 0);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            pointer-events: none;
            z-index: 0;
        }

        .admin-guided-tabs .tab-btn > * {
            position: relative;
            z-index: 1;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            background:
                linear-gradient(180deg, rgba(7, 13, 24, 0.98) 0%, rgba(4, 8, 16, 0.99) 100%);
            border-color: var(--ops-line-strong);
            color: #ffffff;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.11),
                inset 0 -1px 0 rgba(146, 198, 255, 0.22),
                0 14px 26px rgba(3, 8, 15, 0.42),
                0 0 18px rgba(140, 199, 255, 0.24);
            transform: translateY(-1px);
        }

        .admin-guided-tabs .tab-btn:hover::before,
        .admin-guided-tabs .tab-btn:focus-visible::before {
            left: 130%;
        }

        .admin-guided-tabs .tab-btn:hover::after,
        .admin-guided-tabs .tab-btn:focus-visible::after {
            border-color: rgba(210, 233, 255, 0.5);
            box-shadow: inset 0 0 0 1px rgba(159, 207, 255, 0.24);
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            background:
                linear-gradient(180deg, rgba(76, 116, 161, 0.84) 0%, rgba(45, 72, 105, 0.90) 100%);
            border-color: rgba(203, 231, 255, 0.86);
            color: #ffffff;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.16),
                inset 0 -1px 0 rgba(184, 218, 255, 0.24),
                0 12px 24px rgba(3, 8, 15, 0.4),
                0 0 20px rgba(140, 199, 255, 0.3);
            transform: none;
        }

        .admin-guided-tabs .tab-btn.active::after {
            border-color: rgba(211, 234, 255, 0.58);
            box-shadow: inset 0 0 0 1px rgba(176, 213, 251, 0.30), 0 0 16px rgba(146, 198, 255, 0.26);
        }

        .tab-btn-copy {
            gap: 2px;
        }

        .tab-btn-title {
            font-size: 13px;
            font-weight: 500;
            color: #f3f8ff;
            letter-spacing: 0.04em;
            text-shadow: 0 0 8px rgba(147, 203, 255, 0.16);
        }

        .tab-btn-desc {
            font-size: 11px;
            color: var(--ops-muted);
            letter-spacing: 0.03em;
        }

        .admin-guided-tabs .tab-btn:hover .tab-btn-desc,
        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: #dbedff;
        }

        .tab-content.active {
            animation: adminPanelReveal 0.28s cubic-bezier(0.22, 1, 0.36, 1);
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            border: 1px solid rgba(170, 215, 255, 0.34) !important;
            border-radius: 20px;
            background:
                radial-gradient(1100px 420px at -8% -12%, rgba(116, 172, 235, 0.24) 0%, rgba(116, 172, 235, 0) 64%),
                radial-gradient(980px 360px at 108% 112%, rgba(78, 126, 182, 0.24) 0%, rgba(78, 126, 182, 0) 64%),
                linear-gradient(160deg, rgba(10, 17, 29, 0.98) 0%, rgba(7, 12, 21, 0.99) 42%, rgba(5, 9, 16, 0.99) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(248, 252, 255, 0.07),
                inset 0 -1px 0 rgba(120, 170, 230, 0.14),
                0 26px 58px rgba(1, 5, 10, 0.56) !important;
            position: relative;
            overflow: hidden;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(205, 230, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(205, 230, 255, 0.03) 1px, transparent 1px);
            background-size: 22px 22px;
            opacity: 0.42;
            pointer-events: none;
            z-index: 0;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::after {
            content: '';
            position: absolute;
            left: -18%;
            right: -18%;
            top: -24%;
            height: 42%;
            background: linear-gradient(180deg, rgba(170, 215, 255, 0) 0%, rgba(170, 215, 255, 0.19) 50%, rgba(170, 215, 255, 0) 100%);
            opacity: 0.7;
            pointer-events: none;
            z-index: 0;
            animation: ordersSweep360 7.8s ease-in-out infinite;
        }

        body.legacy-orders-disabled.admin-orders-view #orders > * {
            position: relative;
            z-index: 1;
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2 {
            font-size: clamp(18px, 2.2vw, 24px);
            font-weight: 500;
            letter-spacing: 0.18em;
            color: #f2f8ff;
            margin-bottom: 14px;
            border-bottom: none;
            padding-bottom: 0;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-shadow: 0 0 16px rgba(152, 206, 255, 0.2);
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2::before {
            content: '';
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: var(--ops-neon);
            box-shadow: 0 0 14px rgba(143, 200, 255, 0.88);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            display: grid;
            grid-template-columns: minmax(120px, 170px) 1fr;
            gap: 12px;
            align-items: center;
            border: 1px solid rgba(166, 202, 241, 0.32);
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(14, 23, 36, 0.78) 0%, rgba(8, 13, 22, 0.84) 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(87, 131, 184, 0.16);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search label {
            color: #a5c0de;
            letter-spacing: 0.18em;
            font-size: 10px;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input {
            border: 1px solid rgba(176, 205, 236, 0.46);
            background: rgba(6, 11, 19, 0.86);
            color: #edf6ff;
            min-height: 46px;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input:focus {
            border-color: rgba(201, 228, 255, 0.9);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 0 0 3px rgba(143, 200, 255, 0.2), 0 0 18px rgba(143, 200, 255, 0.22);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border: 1px solid rgba(166, 202, 241, 0.34) !important;
            border-radius: 16px;
            background: linear-gradient(180deg, rgba(12, 19, 31, 0.88) 0%, rgba(7, 12, 21, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.06),
                inset 0 -1px 0 rgba(120, 170, 230, 0.14),
                0 18px 34px rgba(1, 6, 12, 0.48) !important;
            position: relative;
            overflow: hidden;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 1px;
            background: linear-gradient(90deg, rgba(169, 209, 255, 0) 0%, rgba(169, 209, 255, 0.85) 50%, rgba(169, 209, 255, 0) 100%);
            box-shadow: 0 0 14px rgba(169, 209, 255, 0.34);
            pointer-events: none;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block table,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead tr,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block th,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block td {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead th {
            color: #9fb6cf !important;
            font-size: 10px;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            font-weight: 500;
            padding: 0 12px 10px;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: linear-gradient(145deg, rgba(17, 28, 44, 0.9) 0%, rgba(10, 17, 28, 0.93) 100%) !important;
            outline: 1px solid rgba(164, 196, 233, 0.26);
            outline-offset: -1px;
            border-radius: 12px;
            transition: outline-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, transform 0.16s ease;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            background: linear-gradient(145deg, rgba(30, 48, 73, 0.95) 0%, rgba(14, 24, 39, 0.95) 100%) !important;
            outline-color: rgba(184, 214, 247, 0.72);
            box-shadow: 0 14px 28px rgba(2, 7, 14, 0.46), 0 0 18px rgba(143, 200, 255, 0.20);
            transform: translateX(2px);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr td {
            color: #edf6ff !important;
            padding: 14px 12px;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link {
            color: #f5faff;
            font-weight: 600;
            text-shadow: 0 0 8px rgba(145, 200, 255, 0.18);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .payment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text {
            border: 1px solid rgba(171, 210, 252, 0.46);
            background: rgba(96, 137, 182, 0.24);
            color: #ebf5ff;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 0 14px rgba(143, 200, 255, 0.12);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.fulfilled,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.delivered {
            border-color: rgba(150, 229, 190, 0.62);
            background: rgba(36, 127, 87, 0.42);
            color: #eafff4;
            box-shadow: 0 0 18px rgba(102, 224, 170, 0.2);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.unfulfilled {
            border-color: rgba(255, 163, 163, 0.58);
            background: rgba(137, 52, 52, 0.44);
            color: #ffeded;
            box-shadow: 0 0 18px rgba(255, 167, 167, 0.18);
        }

        body.legacy-orders-disabled.admin-orders-view #orders #ordersTable tr td[colspan] {
            color: #afc6de !important;
            border: 1px dashed rgba(169, 209, 255, 0.30);
            background: rgba(11, 18, 30, 0.64);
            border-radius: 12px;
        }

        @media (max-width: 1180px) {
            .admin-guided-tabs {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 900px) {
            .admin-menu-intro {
                margin-bottom: 8px;
            }

            .admin-menu-hint {
                width: 100%;
                justify-content: center;
                text-align: center;
            }

            .admin-guided-tabs {
                grid-template-columns: 1fr;
            }

            body.legacy-orders-disabled.admin-orders-view #orders .order-search {
                grid-template-columns: 1fr;
                gap: 8px;
            }
        }

        @keyframes adminPanelReveal {
            0% {
                opacity: 0;
                transform: translateY(8px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes techGridDrift {
            0% {
                background-position: 0 0, 0 0;
            }
            100% {
                background-position: 24px 24px, -24px -24px;
            }
        }

        @keyframes ambientFlux {
            0%,
            100% {
                opacity: 0.88;
                filter: saturate(100%);
            }
            50% {
                opacity: 1;
                filter: saturate(120%);
            }
        }

        @keyframes shellSweep {
            0% {
                transform: translateX(-40%);
            }
            100% {
                transform: translateX(40%);
            }
        }

        @keyframes ordersSweep360 {
            0% {
                top: -24%;
                opacity: 0;
            }
            16% {
                opacity: 0.78;
            }
            56% {
                opacity: 0.2;
            }
            100% {
                top: 115%;
                opacity: 0;
            }
        }

        /* ===== Ultra Future Override ===== */
        :root {
            --ultra-neon-cyan: #a7deff;
            --ultra-neon-blue: #77b8ff;
            --ultra-deep-1: #030711;
            --ultra-deep-2: #081124;
            --ultra-glass-1: rgba(9, 17, 31, 0.90);
            --ultra-glass-2: rgba(5, 10, 21, 0.94);
            --ultra-border: rgba(169, 214, 255, 0.36);
            --ultra-border-strong: rgba(212, 235, 255, 0.78);
            --ultra-text: #eff8ff;
            --ultra-muted: #a9c4e0;
        }

        body {
            background:
                radial-gradient(1400px 680px at -10% -16%, rgba(96, 153, 224, 0.34) 0%, rgba(96, 153, 224, 0) 66%),
                radial-gradient(1120px 540px at 108% 108%, rgba(70, 116, 178, 0.34) 0%, rgba(70, 116, 178, 0) 66%),
                linear-gradient(180deg, #08101e 0%, #040914 100%) !important;
        }

        .admin-header {
            border-bottom-color: rgba(173, 217, 255, 0.32) !important;
            box-shadow: 0 20px 42px rgba(1, 5, 12, 0.58) !important;
        }

        .admin-menu-shell {
            border-color: var(--ultra-border) !important;
            background:
                radial-gradient(180% 110% at 50% -14%, rgba(167, 222, 255, 0.16) 0%, rgba(167, 222, 255, 0) 56%),
                linear-gradient(180deg, rgba(12, 22, 40, 0.92) 0%, rgba(4, 10, 20, 0.96) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(248, 253, 255, 0.14),
                inset 0 -1px 0 rgba(140, 189, 242, 0.20),
                0 22px 40px rgba(2, 6, 12, 0.48),
                0 0 0 1px rgba(96, 146, 204, 0.20),
                0 0 30px rgba(120, 186, 255, 0.12) !important;
        }

        .admin-menu-shell::before {
            opacity: 0.5 !important;
        }

        .admin-menu-shell::after {
            animation: shellSweepUltra 9.5s linear infinite !important;
            opacity: 0.9;
        }

        .admin-menu-hint {
            border-color: rgba(174, 217, 255, 0.46);
            background: linear-gradient(180deg, rgba(13, 24, 40, 0.88) 0%, rgba(6, 13, 24, 0.92) 100%);
            color: #d8ecff;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 0 20px rgba(139, 196, 255, 0.22);
        }

        .admin-guided-tabs {
            gap: 12px;
        }

        .admin-guided-tabs .tab-btn {
            border-color: var(--ultra-border) !important;
            background:
                linear-gradient(180deg, rgba(14, 26, 46, 0.94) 0%, rgba(6, 12, 24, 0.96) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(248, 253, 255, 0.12),
                inset 0 -1px 0 rgba(144, 192, 245, 0.18),
                0 12px 22px rgba(2, 7, 14, 0.38) !important;
        }

        .admin-guided-tabs .tab-btn::before {
            background: linear-gradient(100deg, rgba(175, 223, 255, 0) 0%, rgba(175, 223, 255, 0.40) 52%, rgba(175, 223, 255, 0) 100%) !important;
            width: 58%;
        }

        .admin-guided-tabs .tab-btn::after {
            border-color: rgba(213, 236, 255, 0.08);
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: var(--ultra-border-strong) !important;
            background:
                linear-gradient(180deg, rgba(4, 10, 21, 0.98) 0%, rgba(2, 7, 15, 0.99) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.14),
                inset 0 -1px 0 rgba(164, 208, 255, 0.24),
                0 16px 30px rgba(1, 6, 12, 0.52),
                0 0 26px rgba(128, 195, 255, 0.34) !important;
            transform: translateY(-2px);
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(217, 238, 255, 0.9) !important;
            background:
                linear-gradient(180deg, rgba(99, 151, 212, 0.84) 0%, rgba(50, 84, 128, 0.90) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.20),
                inset 0 -1px 0 rgba(194, 224, 255, 0.30),
                0 14px 28px rgba(1, 6, 12, 0.50),
                0 0 28px rgba(138, 203, 255, 0.42) !important;
        }

        .tab-btn-title {
            color: var(--ultra-text);
            text-shadow: 0 0 12px rgba(164, 215, 255, 0.32);
            letter-spacing: 0.05em;
        }

        .tab-btn-desc {
            color: var(--ultra-muted);
        }

        .admin-guided-tabs .tab-btn:hover .tab-btn-title,
        .admin-guided-tabs .tab-btn.active .tab-btn-title {
            color: #ffffff;
        }

        .admin-guided-tabs .tab-btn:hover .tab-btn-desc,
        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: #e2f2ff;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            border-color: rgba(178, 221, 255, 0.42) !important;
            background:
                radial-gradient(1180px 460px at -10% -14%, rgba(124, 186, 255, 0.28) 0%, rgba(124, 186, 255, 0) 66%),
                radial-gradient(1040px 390px at 110% 112%, rgba(85, 137, 196, 0.28) 0%, rgba(85, 137, 196, 0) 64%),
                linear-gradient(160deg, rgba(8, 15, 29, 0.98) 0%, rgba(4, 9, 19, 0.99) 42%, rgba(2, 6, 14, 0.99) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(248, 253, 255, 0.10),
                inset 0 -1px 0 rgba(130, 182, 238, 0.18),
                0 30px 62px rgba(0, 3, 10, 0.66),
                0 0 36px rgba(117, 186, 255, 0.16) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::after {
            animation: ordersSweepUltra 6.9s ease-in-out infinite !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            border-color: rgba(179, 219, 255, 0.40);
            background: linear-gradient(180deg, rgba(10, 18, 32, 0.84) 0%, rgba(4, 10, 21, 0.90) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                inset 0 -1px 0 rgba(130, 181, 236, 0.16),
                0 0 0 1px rgba(82, 128, 185, 0.18);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input {
            border-color: rgba(193, 227, 255, 0.52);
            background: linear-gradient(180deg, rgba(5, 10, 19, 0.88) 0%, rgba(2, 7, 14, 0.92) 100%);
            color: #eff8ff;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input:focus {
            border-color: rgba(220, 240, 255, 0.94);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 0 0 3px rgba(143, 200, 255, 0.24),
                0 0 24px rgba(143, 200, 255, 0.28);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border-color: rgba(178, 221, 255, 0.38) !important;
            background: linear-gradient(180deg, rgba(8, 14, 26, 0.90) 0%, rgba(3, 7, 16, 0.94) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.09),
                inset 0 -1px 0 rgba(132, 182, 236, 0.18),
                0 22px 40px rgba(0, 3, 10, 0.56),
                0 0 30px rgba(117, 186, 255, 0.14) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead th {
            color: #adc7e2 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            outline-color: rgba(177, 217, 255, 0.28);
            background: linear-gradient(145deg, rgba(12, 22, 38, 0.92) 0%, rgba(5, 11, 21, 0.95) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr td {
            color: #eef8ff !important;
            font-weight: 400;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            background: linear-gradient(145deg, rgba(25, 44, 69, 0.96) 0%, rgba(9, 18, 33, 0.97) 100%) !important;
            outline-color: rgba(202, 234, 255, 0.80);
            box-shadow:
                0 16px 32px rgba(0, 4, 10, 0.58),
                0 0 24px rgba(130, 194, 255, 0.28);
            transform: translateX(3px);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr td:first-child {
            position: relative;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr td:first-child::before {
            content: '';
            position: absolute;
            left: 0;
            top: 18%;
            bottom: 18%;
            width: 2px;
            border-radius: 999px;
            background: rgba(136, 198, 255, 0.24);
            box-shadow: 0 0 10px rgba(136, 198, 255, 0.16);
            transition: background 0.18s ease, box-shadow 0.18s ease;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover td:first-child::before {
            background: rgba(172, 220, 255, 0.88);
            box-shadow: 0 0 16px rgba(172, 220, 255, 0.56);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link {
            color: #f3faff;
            text-shadow: 0 0 12px rgba(155, 210, 255, 0.30);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link:hover,
        body.legacy-orders-disabled.admin-orders-view #orders .order-link:focus-visible {
            color: #ffffff;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .payment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text {
            border-color: rgba(187, 223, 255, 0.54);
            background: linear-gradient(180deg, rgba(91, 135, 186, 0.36) 0%, rgba(63, 102, 148, 0.42) 100%);
            color: #edf8ff;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.16),
                0 0 18px rgba(131, 198, 255, 0.22);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.fulfilled,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.delivered {
            border-color: rgba(166, 239, 204, 0.72);
            background: linear-gradient(180deg, rgba(38, 130, 90, 0.50) 0%, rgba(23, 99, 69, 0.58) 100%);
            box-shadow: 0 0 20px rgba(102, 224, 170, 0.28);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.unfulfilled {
            border-color: rgba(255, 173, 173, 0.66);
            background: linear-gradient(180deg, rgba(138, 53, 53, 0.58) 0%, rgba(112, 42, 42, 0.64) 100%);
            box-shadow: 0 0 20px rgba(255, 167, 167, 0.24);
        }

        @media (prefers-reduced-motion: reduce) {
            body::before,
            body::after,
            .admin-menu-shell::after,
            body.legacy-orders-disabled.admin-orders-view #orders.tab-content::after {
                animation: none !important;
            }

            .admin-guided-tabs .tab-btn,
            body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
                transition: none !important;
            }
        }

        @keyframes shellSweepUltra {
            0% {
                transform: translateX(-56%);
                opacity: 0;
            }
            15% {
                opacity: 0.92;
            }
            70% {
                opacity: 0.3;
            }
            100% {
                transform: translateX(56%);
                opacity: 0;
            }
        }

        @keyframes ordersSweepUltra {
            0% {
                top: -26%;
                opacity: 0;
            }
            14% {
                opacity: 0.86;
            }
            55% {
                opacity: 0.24;
            }
            100% {
                top: 116%;
                opacity: 0;
            }
        }

        /* ===== Futuristic Perfection Override ===== */
        :root {
            --future-bg-0: #060b13;
            --future-bg-1: #0b1320;
            --future-bg-2: #101b2d;
            --future-surface: rgba(10, 18, 31, 0.90);
            --future-surface-strong: rgba(6, 12, 23, 0.94);
            --future-border: rgba(162, 208, 255, 0.30);
            --future-border-strong: rgba(208, 234, 255, 0.78);
            --future-text: #edf6ff;
            --future-muted: #a8c1db;
            --future-accent: #8ec9ff;
        }

        body {
            background:
                radial-gradient(1200px 560px at 2% -10%, rgba(96, 151, 219, 0.20) 0%, rgba(96, 151, 219, 0) 66%),
                radial-gradient(980px 460px at 98% 108%, rgba(72, 116, 175, 0.20) 0%, rgba(72, 116, 175, 0) 64%),
                linear-gradient(180deg, var(--future-bg-1) 0%, var(--future-bg-0) 100%) !important;
            color: var(--future-text);
        }

        body::before {
            opacity: 0.24 !important;
            background-size: 30px 30px !important;
            animation: none !important;
        }

        body::after {
            background:
                radial-gradient(65% 36% at 50% -10%, rgba(165, 214, 255, 0.12) 0%, rgba(165, 214, 255, 0) 100%),
                linear-gradient(180deg, rgba(199, 229, 255, 0.05) 0%, rgba(199, 229, 255, 0) 30%) !important;
            animation: none !important;
            opacity: 1 !important;
        }

        .admin-header {
            border-bottom: 1px solid rgba(160, 205, 251, 0.24) !important;
            backdrop-filter: blur(12px) saturate(118%) !important;
            -webkit-backdrop-filter: blur(12px) saturate(118%) !important;
            box-shadow: 0 14px 30px rgba(2, 7, 13, 0.42) !important;
        }

        .admin-header::after {
            box-shadow: 0 0 10px rgba(176, 216, 255, 0.20) !important;
        }

        .admin-menu-shell {
            border: 1px solid var(--future-border) !important;
            background:
                linear-gradient(180deg, rgba(16, 27, 43, 0.86) 0%, rgba(8, 14, 25, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                inset 0 -1px 0 rgba(135, 182, 232, 0.14),
                0 14px 30px rgba(2, 7, 13, 0.34) !important;
        }

        .admin-menu-shell::after {
            content: none !important;
            display: none !important;
        }

        .admin-menu-hint {
            border: 1px solid rgba(166, 208, 248, 0.34) !important;
            background: rgba(9, 17, 31, 0.74) !important;
            color: #d3e8fc !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
        }

        .admin-guided-tabs {
            gap: 10px;
        }

        .admin-guided-tabs .tab-btn {
            min-height: 60px;
            border-radius: 14px;
            border: 1px solid var(--future-border) !important;
            background:
                linear-gradient(180deg, rgba(16, 27, 43, 0.90) 0%, rgba(8, 14, 25, 0.94) 100%) !important;
            color: var(--future-text);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 8px 16px rgba(2, 7, 13, 0.30) !important;
            transform: none !important;
            transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
