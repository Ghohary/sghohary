        body.admin-invoices-view #invoices .btn,
        body.admin-invoices-view #invoices .btn-small,
        body.admin-custom-orders-view #custom-orders .btn,
        body.admin-custom-orders-view #custom-orders .btn-small,
        body.legacy-products-disabled.admin-products-view #products .btn,
        body.legacy-products-disabled.admin-products-view #products .btn-small,
        body.legacy-products-disabled.admin-products-view #products .back-to-products,
        body.admin-settings-view #settings .btn,
        body.admin-settings-view #settings .btn-small,
        body.admin-settings-view #settings .shipping-remove-btn {
            border: 1px solid rgba(158, 193, 233, 0.30) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            color: #eaf3ff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 10px 22px rgba(4, 9, 15, 0.34) !important;
            transform: none !important;
        }

        body.admin-invoices-view #invoices .btn:hover,
        body.admin-invoices-view #invoices .btn-small:hover,
        body.admin-custom-orders-view #custom-orders .btn:hover,
        body.admin-custom-orders-view #custom-orders .btn-small:hover,
        body.legacy-products-disabled.admin-products-view #products .btn:hover,
        body.legacy-products-disabled.admin-products-view #products .btn-small:hover,
        body.legacy-products-disabled.admin-products-view #products .back-to-products:hover,
        body.admin-settings-view #settings .btn:hover,
        body.admin-settings-view #settings .btn-small:hover,
        body.admin-settings-view #settings .shipping-remove-btn:hover {
            background: linear-gradient(180deg, rgba(28, 41, 58, 0.92) 0%, rgba(15, 24, 36, 0.94) 100%) !important;
            border-color: var(--ac-line-strong) !important;
            color: #ffffff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 14px 26px rgba(5, 11, 18, 0.45) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table thead th,
        body.legacy-products-disabled.admin-products-view #products .products-table td,
        body.admin-invoices-view #invoices .invoice-total-row,
        body.admin-custom-orders-view #custom-orders .custom-order-item,
        body.admin-settings-view #settings .shipping-group-count {
            color: #eaf3ff !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table tbody tr {
            background: rgba(16, 25, 38, 0.94) !important;
            outline: 1px solid rgba(158, 193, 233, 0.24) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table tbody tr:hover {
            background: linear-gradient(180deg, rgba(28, 41, 58, 0.92) 0%, rgba(15, 24, 36, 0.94) 100%) !important;
            outline-color: var(--ac-line-strong) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table .action-menu-btn,
        body.legacy-products-disabled.admin-products-view #products .products-table .action-menu,
        body.legacy-products-disabled.admin-products-view #products .products-table .action-item {
            border-color: rgba(158, 193, 233, 0.30) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            color: #eaf3ff !important;
        }

        body.legacy-products-disabled.admin-products-view #products .size-btn {
            border-color: rgba(158, 193, 233, 0.30) !important;
            background: rgba(16, 25, 38, 0.86) !important;
