        /* ===== Apex 0.01% Override ===== */
        :root {
            --apx-bg: #eff3f9;
            --apx-bg-soft: #e8eef7;
            --apx-ink: #0f1828;
            --apx-muted: #5d6d85;
            --apx-line: rgba(20, 39, 70, 0.14);
            --apx-line-strong: rgba(74, 124, 205, 0.52);
            --apx-surface: #ffffff;
            --apx-surface-soft: #f7faff;
            --apx-dark-1: #0b1220;
            --apx-dark-2: #141f35;
            --apx-accent: #3f7de0;
            --apx-accent-strong: #2456ae;
        }

        body {
            background:
                radial-gradient(980px 420px at -8% -10%, rgba(103, 149, 224, 0.20) 0%, rgba(103, 149, 224, 0) 62%),
                radial-gradient(840px 320px at 108% 106%, rgba(124, 166, 230, 0.16) 0%, rgba(124, 166, 230, 0) 64%),
                linear-gradient(180deg, var(--apx-bg) 0%, var(--apx-bg-soft) 100%) !important;
            color: var(--apx-ink) !important;
        }

        body::before {
            opacity: 0.10 !important;
            background-size: 34px 34px !important;
            background-image:
                linear-gradient(rgba(82, 122, 188, 0.11) 1px, transparent 1px),
                linear-gradient(90deg, rgba(82, 122, 188, 0.11) 1px, transparent 1px) !important;
        }

        body::after {
            background:
                radial-gradient(64% 34% at 50% -14%, rgba(173, 205, 252, 0.20) 0%, rgba(173, 205, 252, 0) 100%),
                linear-gradient(180deg, rgba(189, 218, 255, 0.12) 0%, rgba(189, 218, 255, 0) 36%) !important;
        }

        .admin-header {
            border-bottom: 1px solid rgba(113, 151, 214, 0.26) !important;
            box-shadow: 0 14px 30px rgba(12, 28, 52, 0.20) !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, rgba(104, 153, 233, 0) 0%, rgba(104, 153, 233, 0.72) 50%, rgba(104, 153, 233, 0) 100%) !important;
        }

        .admin-menu-shell {
            border: 1px solid rgba(116, 156, 220, 0.28) !important;
            background:
                linear-gradient(180deg, rgba(11, 18, 32, 0.95) 0%, rgba(20, 31, 52, 0.94) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(203, 223, 255, 0.18),
                0 14px 28px rgba(7, 15, 30, 0.34) !important;
        }

        .admin-menu-intro {
            display: block !important;
        }

        .admin-menu-hint {
            border: 1px solid rgba(133, 174, 240, 0.36) !important;
            background: rgba(20, 33, 54, 0.78) !important;
            color: #d3e7ff !important;
            letter-spacing: 0.08em !important;
            box-shadow: inset 0 1px 0 rgba(215, 232, 255, 0.14) !important;
        }

        .admin-guided-tabs .tab-btn {
            border: 1px solid rgba(121, 162, 227, 0.34) !important;
            background: linear-gradient(180deg, rgba(20, 33, 54, 0.92) 0%, rgba(13, 23, 39, 0.94) 100%) !important;
            color: #e6f1ff !important;
            box-shadow:
                inset 0 1px 0 rgba(216, 234, 255, 0.14),
                0 8px 18px rgba(6, 14, 28, 0.30) !important;
            transform: none !important;
            transition: background 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
        }

        .admin-guided-tabs .tab-btn::before,
        .admin-guided-tabs .tab-btn::after {
            content: none !important;
            display: none !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: rgba(169, 204, 255, 0.68) !important;
            background: linear-gradient(180deg, rgba(28, 43, 67, 0.95) 0%, rgba(16, 28, 47, 0.96) 100%) !important;
            color: #ffffff !important;
            box-shadow:
                0 10px 20px rgba(7, 16, 31, 0.36),
                0 0 0 1px rgba(149, 194, 255, 0.22) !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(188, 219, 255, 0.84) !important;
            background: linear-gradient(180deg, var(--apx-accent) 0%, var(--apx-accent-strong) 100%) !important;
            color: #ffffff !important;
            box-shadow:
                inset 0 1px 0 rgba(232, 244, 255, 0.22),
                0 10px 22px rgba(19, 49, 97, 0.34) !important;
        }

        .admin-guided-tabs .tab-btn.active:hover {
            background: linear-gradient(180deg, #4a8aed 0%, #2c61ba 100%) !important;
        }

        .tab-btn-title {
            color: inherit !important;
