                            <label for="invoiceDueDate">Due date</label>
                            <input type="date" id="invoiceDueDate">
                        </div>
                        <div>
                            <label for="invoiceCountry">Country / Region</label>
                            <input type="text" id="invoiceCountry" placeholder="Country / Region">
                        </div>
                        <div>
                            <label for="invoiceCurrency">Currency</label>
                            <input type="text" id="invoiceCurrency" placeholder="AED">
                        </div>
                    </div>

                    <h4>Client Details</h4>
                    <div class="invoice-grid two-col">
                        <div>
                            <label for="invoiceClientName">Client name</label>
                            <input type="text" id="invoiceClientName">
                        </div>
                        <div>
                            <label for="invoiceClientEmail">Client email</label>
                            <input type="email" id="invoiceClientEmail">
                        </div>
                        <div>
                            <label for="invoiceClientPhone">Client phone</label>
                            <input type="text" id="invoiceClientPhone">
                        </div>
                    </div>
                    <div class="invoice-grid two-col">
                        <div>
                            <label for="invoiceBillingAddress">Billing address</label>
                            <textarea id="invoiceBillingAddress" rows="3"></textarea>
                        </div>
                        <div>
                            <label for="invoiceShippingAddress">Shipping address</label>
                            <textarea id="invoiceShippingAddress" rows="3"></textarea>
