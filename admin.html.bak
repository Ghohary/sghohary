            background: linear-gradient(180deg, rgba(52, 55, 61, 0.90) 0%, rgba(35, 38, 43, 0.94) 100%) !important;
            color: #f6f4f1 !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 10px 20px rgba(0, 0, 0, 0.42) !important;
        }

        #orderDetailPage .order-detail-back:hover,
        #orderDetailPage .order-detail-edit-btn:hover,
        #orderDetailPage .btn-track-send:hover {
            border-color: rgba(246, 229, 197, 0.84) !important;
            background: linear-gradient(180deg, rgba(208, 176, 120, 0.86) 0%, rgba(154, 128, 85, 0.90) 100%) !important;
            color: #1f1911 !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.24),
                0 14px 24px rgba(0, 0, 0, 0.46),
                0 0 16px rgba(205, 171, 112, 0.22) !important;
        }

        #orderDetailPage .tracking-input,
        #orderDetailPage input,
        #orderDetailPage select,
        #orderDetailPage textarea {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(34, 36, 41, 0.90) 0%, rgba(24, 26, 30, 0.94) 100%) !important;
            color: #f6f4f1 !important;
        }

        #orderDetailPage .tracking-input:focus,
        #orderDetailPage input:focus,
        #orderDetailPage select:focus,
        #orderDetailPage textarea:focus {
            border-color: rgba(246, 229, 197, 0.84) !important;
            box-shadow: 0 0 0 3px rgba(205, 171, 112, 0.18) !important;
        }

        #orderDetailPage .tracking-history-panel,
        #orderDetailPage .tracking-live-grid {
            border-color: rgba(255, 255, 255, 0.18) !important;
            background: linear-gradient(180deg, rgba(45, 48, 54, 0.76) 0%, rgba(30, 32, 37, 0.86) 100%) !important;
        }

        #orderDetailPage .tracking-status-pill.tone-delivered {
            border-color: rgba(146, 201, 158, 0.64) !important;
            background: linear-gradient(180deg, rgba(41, 75, 50, 0.82) 0%, rgba(28, 53, 36, 0.88) 100%) !important;
            color: #e8f5ea !important;
        }

        #orderDetailPage .tracking-status-pill.tone-transit,
        #orderDetailPage .tracking-status-pill.tone-pending {
            border-color: rgba(246, 229, 197, 0.74) !important;
            background: linear-gradient(180deg, rgba(206, 174, 118, 0.82) 0%, rgba(154, 128, 85, 0.90) 100%) !important;
            color: #1f1911 !important;
        }

        #orderDetailPage .tracking-status-pill.tone-issue {
            border-color: rgba(226, 160, 160, 0.66) !important;
            background: linear-gradient(180deg, rgba(90, 43, 43, 0.84) 0%, rgba(58, 27, 27, 0.90) 100%) !important;
            color: #ffe8e8 !important;
        }

        /* ===== Final Luxe Monochrome Palette ===== */
        :root {
            --final-bg-1: #0d0f12;
            --final-bg-2: #121419;
            --final-bg-3: #181b21;
            --final-surface-1: rgba(42, 46, 54, 0.88);
            --final-surface-2: rgba(30, 33, 40, 0.94);
            --final-line: rgba(255, 255, 255, 0.13);
            --final-line-strong: rgba(255, 255, 255, 0.30);
            --final-text: #f4f5f7;
            --final-muted: #c8ccd3;
            --final-accent-a: rgba(226, 230, 237, 0.96);
            --final-accent-b: rgba(182, 190, 202, 0.94);
            --final-accent-text: #1b1f27;
            --final-glow: rgba(226, 230, 237, 0.16);
        }

        html {
            background: linear-gradient(180deg, var(--final-bg-1) 0%, var(--final-bg-2) 54%, var(--final-bg-3) 100%) !important;
        }

        body,
        body.legacy-orders-disabled.admin-orders-view {
            background:
                radial-gradient(1180px 620px at 12% 8%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 62%),
                radial-gradient(1080px 560px at 88% 84%, rgba(232, 236, 244, 0.10) 0%, rgba(232, 236, 244, 0) 64%),
                linear-gradient(180deg, var(--final-bg-1) 0%, var(--final-bg-2) 54%, var(--final-bg-3) 100%) !important;
            color: var(--final-text) !important;
        }

        body::before,
        body.legacy-orders-disabled.admin-orders-view::before {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.10) 1px, transparent 1px) !important;
            background-size: 30px 30px !important;
            opacity: 0.2 !important;
        }

        body::after,
        body.legacy-orders-disabled.admin-orders-view::after {
            background:
                radial-gradient(820px 390px at 14% 16%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 72%),
                radial-gradient(880px 420px at 84% 80%, rgba(226, 230, 237, 0.14) 0%, rgba(226, 230, 237, 0) 74%) !important;
            opacity: 0.58 !important;
        }

        .admin-header {
            background: linear-gradient(180deg, rgba(18, 20, 25, 0.94) 0%, rgba(12, 14, 18, 0.96) 100%) !important;
            border-color: var(--final-line) !important;
            box-shadow:
                0 24px 50px rgba(0, 0, 0, 0.5),
                0 0 22px var(--final-glow) !important;
        }

        .admin-menu-shell {
            border-color: var(--final-line) !important;
            background: linear-gradient(180deg, rgba(28, 31, 37, 0.9) 0%, rgba(18, 20, 25, 0.94) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                0 20px 36px rgba(0, 0, 0, 0.42),
                0 0 22px var(--final-glow) !important;
        }

        .admin-menu-hint {
            border-color: rgba(255, 255, 255, 0.26) !important;
            background: linear-gradient(180deg, rgba(52, 56, 64, 0.74) 0%, rgba(34, 37, 43, 0.84) 100%) !important;
            color: var(--final-muted) !important;
        }

        .admin-guided-tabs .tab-btn {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(56, 60, 68, 0.82) 0%, rgba(36, 39, 46, 0.9) 100%) !important;
            color: var(--final-text) !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: var(--final-line-strong) !important;
            background: linear-gradient(180deg, rgba(70, 74, 83, 0.88) 0%, rgba(44, 48, 56, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.14),
                0 14px 26px rgba(0, 0, 0, 0.42),
                0 0 16px var(--final-glow) !important;
        }

        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(246, 248, 252, 0.9) !important;
            background: linear-gradient(180deg, var(--final-accent-a) 0%, var(--final-accent-b) 100%) !important;
            color: var(--final-accent-text) !important;
        }

        .tab-btn-icon {
            border-color: rgba(255, 255, 255, 0.24) !important;
            background: linear-gradient(180deg, rgba(98, 104, 116, 0.34) 0%, rgba(56, 60, 68, 0.5) 100%) !important;
            color: var(--final-text) !important;
        }

        .tab-btn-badge {
            border-color: rgba(255, 255, 255, 0.28) !important;
            background: linear-gradient(180deg, rgba(94, 100, 112, 0.42) 0%, rgba(56, 61, 69, 0.58) 100%) !important;
            color: var(--final-text) !important;
        }

        .tab-btn-badge.is-empty {
            color: rgba(207, 212, 220, 0.8) !important;
            border-color: rgba(255, 255, 255, 0.18) !important;
            background: linear-gradient(180deg, rgba(78, 83, 92, 0.24) 0%, rgba(50, 54, 61, 0.34) 100%) !important;
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-icon,
        .admin-guided-tabs .tab-btn.active .tab-btn-badge {
            border-color: rgba(246, 248, 252, 0.88) !important;
            background: linear-gradient(180deg, var(--final-accent-a) 0%, var(--final-accent-b) 100%) !important;
            color: var(--final-accent-text) !important;
            box-shadow: 0 0 14px var(--final-glow) !important;
        }

        .admin-quick-btn {
            border-color: rgba(255, 255, 255, 0.22) !important;
            color: var(--final-text) !important;
            background: linear-gradient(180deg, rgba(70, 74, 82, 0.56) 0%, rgba(40, 44, 51, 0.74) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.24),
                0 10px 18px rgba(0, 0, 0, 0.34) !important;
        }

        .admin-quick-btn:hover,
        .admin-quick-btn:focus-visible {
            border-color: rgba(246, 248, 252, 0.86) !important;
            background: linear-gradient(180deg, var(--final-accent-a) 0%, var(--final-accent-b) 100%) !important;
            color: var(--final-accent-text) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.3),
                0 14px 24px rgba(0, 0, 0, 0.42),
                0 0 16px var(--final-glow) !important;
        }

        .fx-admin-pill {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(52, 56, 64, 0.8) 0%, rgba(34, 37, 43, 0.88) 100%) !important;
            color: var(--final-text) !important;
        }

        .fx-admin-dot {
            background: linear-gradient(180deg, rgba(232, 236, 244, 1) 0%, rgba(183, 191, 203, 1) 100%) !important;
            box-shadow: 0 0 10px rgba(226, 230, 237, 0.52) !important;
        }

        #orders.tab-content,
        #invoices.tab-content,
        #custom-orders.tab-content,
        #products.tab-content,
        #settings.tab-content,
        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            border-color: rgba(255, 255, 255, 0.2) !important;
            background: linear-gradient(180deg, var(--final-surface-1) 0%, var(--final-surface-2) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                0 24px 44px rgba(0, 0, 0, 0.44),
                0 0 20px var(--final-glow) !important;
        }

        #orders .order-table-block,
        #products .products-table,
        #invoices .invoice-card,
        #custom-orders .custom-order-card,
        #settings .settings-card.shipping-settings,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border-color: rgba(255, 255, 255, 0.18) !important;
            background: linear-gradient(180deg, rgba(50, 54, 61, 0.84) 0%, rgba(34, 37, 43, 0.9) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                0 16px 28px rgba(0, 0, 0, 0.4) !important;
        }

        #orders .order-table-block tbody tr,
        #products .products-table tbody tr,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(43, 47, 54, 0.8) !important;
            border-color: rgba(255, 255, 255, 0.12) !important;
        }

        #orders .order-table-block tbody tr.order-row:hover,
        #products .products-table tbody tr:hover,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            background: linear-gradient(180deg, rgba(66, 71, 80, 0.9) 0%, rgba(48, 53, 60, 0.94) 100%) !important;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28) !important;
            transform: none !important;
        }

        #orders .order-search,
        #settings .shipping-group-box,
        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            border-color: rgba(255, 255, 255, 0.2) !important;
            background: linear-gradient(180deg, rgba(50, 54, 61, 0.74) 0%, rgba(34, 37, 43, 0.86) 100%) !important;
        }

        #products input,
        #products select,
        #products textarea,
        #orders input,
        #invoices input,
        #invoices select,
        #invoices textarea,
        #custom-orders input,
        #custom-orders select,
        #custom-orders textarea,
        #settings input,
        #settings select,
        #settings textarea,
        #orderDetailPage input,
        #orderDetailPage select,
        #orderDetailPage textarea {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(36, 39, 46, 0.9) 0%, rgba(25, 28, 34, 0.94) 100%) !important;
            color: var(--final-text) !important;
        }

        #products input:focus,
        #products select:focus,
        #products textarea:focus,
        #orders input:focus,
        #invoices input:focus,
        #invoices select:focus,
        #invoices textarea:focus,
        #custom-orders input:focus,
        #custom-orders select:focus,
        #custom-orders textarea:focus,
        #settings input:focus,
        #settings select:focus,
        #settings textarea:focus,
        #orderDetailPage input:focus,
        #orderDetailPage select:focus,
        #orderDetailPage textarea:focus {
            border-color: rgba(246, 248, 252, 0.82) !important;
            box-shadow: 0 0 0 3px rgba(226, 230, 237, 0.2) !important;
        }

        #products .btn,
        #products .btn-small,
        #products .back-to-products,
        #orders .btn,
        #orders .btn-small,
        #invoices .btn,
        #invoices .btn-small,
        #custom-orders .btn,
        #custom-orders .btn-small,
        #settings .btn,
        #settings .btn-small,
        #settings .shipping-remove-btn,
        #orderDetailPage .order-detail-back,
        #orderDetailPage .order-detail-edit-btn,
        #orderDetailPage .btn-track-send {
            border-color: rgba(255, 255, 255, 0.24) !important;
            background: linear-gradient(180deg, rgba(58, 63, 72, 0.9) 0%, rgba(38, 42, 49, 0.94) 100%) !important;
            color: var(--final-text) !important;
        }

        #products .btn:hover,
        #products .btn-small:hover,
        #products .back-to-products:hover,
        #orders .btn:hover,
        #orders .btn-small:hover,
        #invoices .btn:hover,
        #invoices .btn-small:hover,
        #custom-orders .btn:hover,
        #custom-orders .btn-small:hover,
        #settings .btn:hover,
        #settings .btn-small:hover,
        #settings .shipping-remove-btn:hover,
        #orderDetailPage .order-detail-back:hover,
        #orderDetailPage .order-detail-edit-btn:hover,
        #orderDetailPage .btn-track-send:hover {
            border-color: rgba(246, 248, 252, 0.86) !important;
            background: linear-gradient(180deg, var(--final-accent-a) 0%, var(--final-accent-b) 100%) !important;
            color: var(--final-accent-text) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.3),
                0 14px 24px rgba(0, 0, 0, 0.42),
                0 0 16px var(--final-glow) !important;
        }

        #orders .payment-text,
        #orders .fulfillment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .payment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text,
        #orderDetailPage .order-detail-status {
            border-color: rgba(255, 255, 255, 0.24) !important;
            background: linear-gradient(180deg, rgba(58, 63, 72, 0.88) 0%, rgba(38, 42, 49, 0.92) 100%) !important;
            color: var(--final-text) !important;
        }

        #orders .fulfillment-text.fulfilled,
        #orders .fulfillment-text.delivered,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.fulfilled,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.delivered,
        #orderDetailPage .order-detail-status.tone-paid,
        #orderDetailPage .tracking-status-pill.tone-delivered {
            border-color: rgba(230, 235, 243, 0.78) !important;
            background: linear-gradient(180deg, rgba(216, 223, 233, 0.9) 0%, rgba(171, 180, 194, 0.94) 100%) !important;
            color: var(--final-accent-text) !important;
        }

        #orders .fulfillment-text.unfulfilled,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.unfulfilled,
        #orderDetailPage .order-detail-status.tone-issue,
        #orderDetailPage .tracking-status-pill.tone-issue {
            border-color: rgba(157, 165, 178, 0.7) !important;
            background: linear-gradient(180deg, rgba(96, 102, 114, 0.9) 0%, rgba(67, 72, 83, 0.94) 100%) !important;
            color: #eef1f5 !important;
        }

        #orderDetailPage .order-detail-status.tone-pending,
        #orderDetailPage .tracking-status-pill.tone-transit,
        #orderDetailPage .tracking-status-pill.tone-pending {
            border-color: rgba(206, 214, 225, 0.76) !important;
            background: linear-gradient(180deg, rgba(189, 198, 211, 0.9) 0%, rgba(142, 151, 166, 0.94) 100%) !important;
            color: var(--final-accent-text) !important;
        }

        #orderDetailPage.order-detail-page {
            background:
                radial-gradient(860px 420px at 16% 10%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 68%),
                radial-gradient(900px 420px at 88% 86%, rgba(226, 230, 237, 0.16) 0%, rgba(226, 230, 237, 0) 72%),
                linear-gradient(180deg, rgba(14, 16, 20, 0.96) 0%, rgba(9, 10, 13, 0.98) 100%) !important;
        }

        #orderDetailPage .order-detail-shell {
            border-color: rgba(255, 255, 255, 0.24) !important;
            background: linear-gradient(180deg, rgba(38, 42, 49, 0.92) 0%, rgba(24, 27, 33, 0.96) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                0 24px 46px rgba(0, 0, 0, 0.56),
                0 0 22px var(--final-glow) !important;
        }

        #orderDetailPage .order-detail-summary,
        #orderDetailPage .order-detail-card,
        #orderDetailPage .tracking-history-panel,
        #orderDetailPage .tracking-live-grid {
            border-color: rgba(255, 255, 255, 0.18) !important;
            background: linear-gradient(180deg, rgba(50, 54, 61, 0.8) 0%, rgba(34, 37, 43, 0.9) 100%) !important;
        }

        #orderDetailPage .order-detail-title,
        #orderDetailPage .order-detail-total,
        #orderDetailPage .order-detail-value,
        #orderDetailPage .order-item-name,
        #orderDetailPage .tracking-live-stat-value {
            color: var(--final-text) !important;
        }

        #orderDetailPage .order-detail-eyebrow,
        #orderDetailPage .order-detail-summary span,
        #orderDetailPage .order-detail-card h4,
        #orderDetailPage .order-item-meta,
        #orderDetailPage .order-item-identity,
        #orderDetailPage .order-detail-actions-meta,
        #orders .orders-empty-state-cell {
            color: var(--final-muted) !important;
        }

        /* ===== Products Ultimate Refresh ===== */
        /* NOTE: legacy-products-disabled class is never applied to body — these rules are archived. */
        body.legacy-products-disabled.admin-products-view #products {
            --product-shell-top: rgba(36, 40, 48, 0.9);
            --product-shell-bottom: rgba(20, 23, 29, 0.96);
            --product-card-top: rgba(55, 61, 74, 0.84);
            --product-card-bottom: rgba(34, 38, 46, 0.92);
            --product-row-top: rgba(64, 70, 84, 0.86);
            --product-row-bottom: rgba(44, 49, 60, 0.92);
            --product-row-hover-top: rgba(82, 90, 106, 0.9);
            --product-row-hover-bottom: rgba(58, 64, 78, 0.94);
            --product-text-main: #f5f7fb;
            --product-text-soft: #b8becb;
            --product-line-soft: rgba(255, 255, 255, 0.16);
            --product-line-strong: rgba(255, 255, 255, 0.32);
            --product-focus-ring: rgba(239, 243, 250, 0.28);
        }

        body.legacy-products-disabled.admin-products-view .container {
            background: transparent !important;
        }

        body.legacy-products-disabled.admin-products-view #products.tab-content {
            margin-top: 0 !important;
            padding: clamp(22px, 3.2vw, 32px) !important;
            border-radius: 26px !important;
            border: 1px solid var(--product-line-soft) !important;
            background: linear-gradient(180deg, var(--product-shell-top) 0%, var(--product-shell-bottom) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 22px 46px rgba(0, 0, 0, 0.42) !important;
            -webkit-backdrop-filter: none !important;
            backdrop-filter: none !important;
            overflow: hidden;
        }

        body.legacy-products-disabled.admin-products-view #products.tab-content::before,
        body.legacy-products-disabled.admin-products-view #products.tab-content::after {
            display: none !important;
            content: none !important;
            animation: none !important;
            background: none !important;
        }

        body.legacy-products-disabled.admin-products-view #products,
        body.legacy-products-disabled.admin-products-view #products * {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
            color: var(--product-text-main);
        }

        body.legacy-products-disabled.admin-products-view #products button,
        body.legacy-products-disabled.admin-products-view #products .btn,
        body.legacy-products-disabled.admin-products-view #products .btn-small,
        body.legacy-products-disabled.admin-products-view #products .back-to-products {
            transition: background-color 0.14s ease, border-color 0.14s ease, color 0.14s ease, box-shadow 0.14s ease !important;
            transform: none !important;
            letter-spacing: 0.1em !important;
        }

        body.legacy-products-disabled.admin-products-view #products button::before,
        body.legacy-products-disabled.admin-products-view #products .btn::before,
        body.legacy-products-disabled.admin-products-view #products .btn-small::before,
        body.legacy-products-disabled.admin-products-view #products .back-to-products::before {
            content: none !important;
        }

        body.legacy-products-disabled.admin-products-view #products button:hover,
        body.legacy-products-disabled.admin-products-view #products .btn:hover,
        body.legacy-products-disabled.admin-products-view #products .btn-small:hover,
        body.legacy-products-disabled.admin-products-view #products .back-to-products:hover {
            transform: none !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header {
            display: grid !important;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: end;
            gap: 20px !important;
            margin-bottom: 22px !important;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--product-line-soft) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header-titles {
            gap: 8px !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header-link {
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-size: clamp(24px, 2.7vw, 32px) !important;
            font-weight: 500;
            color: var(--product-text-main) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header-link::before {
            content: none !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header-subtitle {
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-size: 11px !important;
            color: var(--product-text-soft) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header-actions,
        body.legacy-products-disabled.admin-products-view #products .product-primary-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-primary-actions .btn,
        body.legacy-products-disabled.admin-products-view #products .product-primary-actions .back-to-products {
            min-height: 46px;
            height: 46px;
            min-width: 148px;
            padding: 0 22px;
            border-radius: 999px !important;
