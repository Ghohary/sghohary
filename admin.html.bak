                                    <label for="customBalance">Remaining balance</label>
                                    <input type="number" id="customBalance" step="0.01" readonly>
                                </div>
                                <div>
                                    <label for="customPaymentStatus">Payment status</label>
                                    <select id="customPaymentStatus">
                                        <option value="unpaid">Unpaid</option>
                                        <option value="partially_paid">Partially paid</option>
