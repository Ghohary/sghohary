                    </div>

                    <div class="invoice-totals" id="invoiceTotals"></div>

                    <div class="invoice-grid">
                        <div>
                            <label for="invoiceNotes">Notes / terms</label>
                            <textarea id="invoiceNotes" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="invoice-actions">
                        <button type="button" class="btn" id="saveInvoiceDraft">Save draft</button>
                        <button type="button" class="btn" id="saveInvoice">Save invoice</button>
                        <button type="button" class="btn-small" id="resetInvoiceForm">Reset</button>
                    </div>
                </div>
                <div class="invoice-card">
                    <h4>Invoice Library</h4>
                    <div class="invoice-filters">
                        <input type="text" id="invoiceSearch" placeholder="Search by client or invoice number">
                        <select id="invoiceStatusFilter">
                            <option value="">All statuses</option>
