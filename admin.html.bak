        body.legacy-products-disabled.admin-products-view #products .size-btn.active {
            background: linear-gradient(180deg, #78a6ff 0%, #3f7de0 100%) !important;
            border-color: rgba(184, 214, 247, 0.90) !important;
            color: #0b1220 !important;
        }

        body.admin-settings-view #settings .shipping-group-toggle,
        body.admin-settings-view #settings .shipping-country-picker {
            border: 1px solid rgba(158, 193, 233, 0.30) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            color: #eaf3ff !important;
        }

        body.admin-settings-view #settings .shipping-group-title,
        body.admin-settings-view #settings .shipping-group-meta-field span,
        body.admin-settings-view #settings .shipping-panel-chip {
            color: #d8e5f7 !important;
        }

        /* ===== Access-Control Futuristic Boost ===== */
        :root {
            --ac-neon: #9ec6ff;
            --ac-neon-soft: rgba(158, 198, 255, 0.28);
            --ac-neon-cyan: #7edcff;
            --ac-neon-cyan-soft: rgba(126, 220, 255, 0.30);
        }

        body::after {
            content: "" !important;
            position: fixed;
            inset: -26%;
            pointer-events: none;
            background:
                radial-gradient(620px 340px at 18% 22%, rgba(126, 220, 255, 0.12) 0%, rgba(126, 220, 255, 0) 68%),
                radial-gradient(700px 380px at 84% 76%, rgba(132, 170, 255, 0.14) 0%, rgba(132, 170, 255, 0) 70%) !important;
            opacity: 0.58;
            animation: acNebulaDrift 12s ease-in-out infinite !important;
            z-index: 0;
        }

        .admin-header {
            border-bottom: 1px solid rgba(184, 214, 247, 0.40) !important;
            box-shadow: 0 16px 34px rgba(0, 0, 0, 0.28), 0 0 24px rgba(126, 220, 255, 0.12) !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, rgba(126, 220, 255, 0) 0%, rgba(126, 220, 255, 0.85) 50%, rgba(126, 220, 255, 0) 100%) !important;
            opacity: 0.62 !important;
            animation: acHeaderBeam 3.8s ease-in-out infinite;
        }

        .admin-menu-shell,
        #orders.tab-content,
        #invoices.tab-content,
        #custom-orders.tab-content,
        #products.tab-content,
        #settings.tab-content {
            position: relative;
            overflow: hidden;
            border-color: rgba(184, 214, 247, 0.42) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 16px 30px rgba(4, 9, 15, 0.34),
                0 0 0 1px rgba(120, 158, 212, 0.16),
                0 0 30px rgba(120, 166, 232, 0.14) !important;
        }

        .admin-menu-shell::after,
        #orders.tab-content::after,
        #invoices.tab-content::after,
        #custom-orders.tab-content::after,
        #products.tab-content::after,
        #settings.tab-content::after {
            content: "" !important;
            display: block !important;
            position: absolute;
            left: -24%;
            right: -24%;
            top: -36%;
            height: 48%;
            background: linear-gradient(
                180deg,
                rgba(126, 220, 255, 0) 0%,
                rgba(126, 220, 255, 0.18) 44%,
                rgba(126, 220, 255, 0) 100%
            ) !important;
            pointer-events: none;
            mix-blend-mode: screen;
            opacity: 0.64;
            animation: acFutureSweep 5.8s ease-in-out infinite;
            z-index: 0;
        }

        .admin-menu-shell > *,
        #orders.tab-content > *,
        #invoices.tab-content > *,
        #custom-orders.tab-content > *,
        #products.tab-content > *,
        #settings.tab-content > * {
            position: relative;
            z-index: 1;
        }

        .admin-guided-tabs .tab-btn {
            position: relative;
            overflow: hidden;
            border-radius: 14px !important;
            transition:
                background 0.14s ease,
                border-color 0.14s ease,
                box-shadow 0.14s ease,
                transform 0.14s ease,
                color 0.14s ease !important;
            will-change: transform, box-shadow;
        }

        .admin-guided-tabs .tab-btn::before {
            content: "" !important;
            display: block !important;
            position: absolute;
            inset: 1px;
            border-radius: 12px;
            background: radial-gradient(100% 120% at 50% 0%, rgba(126, 220, 255, 0.22) 0%, rgba(126, 220, 255, 0) 72%);
            opacity: 0;
            transition: opacity 0.14s ease;
            pointer-events: none;
        }

        .admin-guided-tabs .tab-btn::after {
            content: "" !important;
            display: block !important;
            position: absolute;
            left: 18%;
            right: 18%;
            bottom: 6px;
            height: 2px;
            border-radius: 999px;
            background: linear-gradient(90deg, rgba(126, 220, 255, 0) 0%, rgba(126, 220, 255, 0.92) 50%, rgba(126, 220, 255, 0) 100%);
            opacity: 0;
            transform: translateY(3px);
            transition: opacity 0.14s ease, transform 0.14s ease;
            pointer-events: none;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            transform: translateY(-2px);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 14px 26px rgba(5, 11, 18, 0.45),
                0 0 18px var(--ac-neon-soft) !important;
        }

        .admin-guided-tabs .tab-btn:hover::before,
        .admin-guided-tabs .tab-btn:focus-visible::before {
            opacity: 1;
        }

        .admin-guided-tabs .tab-btn:hover::after,
        .admin-guided-tabs .tab-btn:focus-visible::after {
            opacity: 0.8;
            transform: translateY(0);
        }

        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(184, 214, 247, 0.86) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.24),
                0 14px 28px rgba(10, 35, 74, 0.48),
                0 0 22px rgba(120, 171, 244, 0.34),
                0 0 30px rgba(126, 220, 255, 0.20) !important;
        }

        .admin-guided-tabs .tab-btn.active::after {
            opacity: 1;
            transform: translateY(0);
        }

        .admin-guided-tabs .tab-btn.active:hover {
            transform: translateY(-1px);
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-title {
            color: #f7fbff !important;
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: rgba(231, 243, 255, 0.90) !important;
        }

        body.legacy-products-disabled.admin-products-view #products input:focus,
        body.legacy-products-disabled.admin-products-view #products select:focus,
        body.legacy-products-disabled.admin-products-view #products textarea:focus,
        body.admin-invoices-view #invoices input:focus,
        body.admin-invoices-view #invoices select:focus,
        body.admin-invoices-view #invoices textarea:focus,
        body.admin-custom-orders-view #custom-orders input:focus,
        body.admin-custom-orders-view #custom-orders select:focus,
        body.admin-custom-orders-view #custom-orders textarea:focus,
        body.admin-settings-view #settings input:focus,
        body.admin-settings-view #settings select:focus,
        body.admin-settings-view #settings textarea:focus,
        body.legacy-orders-disabled.admin-orders-view #orders input:focus {
            border-color: var(--ac-neon-cyan) !important;
            box-shadow:
                0 0 0 4px rgba(134, 171, 219, 0.18),
                0 0 16px rgba(120, 166, 232, 0.18),
                0 0 24px var(--ac-neon-cyan-soft) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table tbody tr,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            transition: background 0.14s ease, outline-color 0.14s ease, box-shadow 0.14s ease !important;
        }

        body.legacy-products-disabled.admin-products-view #products .products-table tbody tr:hover,
        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            box-shadow:
                0 10px 22px rgba(5, 11, 18, 0.40),
                0 0 14px rgba(120, 166, 232, 0.16),
                0 0 22px rgba(126, 220, 255, 0.12) !important;
        }

        #orders .orders-empty-state-cell {
            text-align: center !important;
            color: #d8e5f7 !important;
            font-weight: 500 !important;
            letter-spacing: 0.04em;
            padding: 24px 12px !important;
        }

        @keyframes acFutureSweep {
            0% {
                top: -36%;
                opacity: 0;
            }
            16% {
                opacity: 0.64;
            }
            58% {
                opacity: 0.20;
            }
            100% {
                top: 122%;
                opacity: 0;
            }
        }

        @keyframes acNebulaDrift {
            0% {
                transform: translate3d(0, 0, 0);
                opacity: 0.48;
            }
            50% {
                transform: translate3d(-1.2%, -1%, 0);
                opacity: 0.66;
            }
            100% {
                transform: translate3d(0, 0, 0);
                opacity: 0.48;
            }
        }

        @keyframes acHeaderBeam {
            0% {
                opacity: 0.12;
            }
            50% {
                opacity: 0.64;
            }
            100% {
                opacity: 0.12;
            }
        }

        /* ===== Futuristic Premium Layer ===== */
        :root {
            --fx-void: #070c14;
            --fx-deep: #0e1828;
            --fx-panel: rgba(9, 16, 29, 0.78);
            --fx-panel-strong: rgba(11, 20, 36, 0.86);
            --fx-line: rgba(116, 174, 255, 0.36);
            --fx-line-strong: rgba(153, 209, 255, 0.78);
            --fx-ice: #dff2ff;
            --fx-muted: #9fb8d8;
            --fx-cyan: #78d7ff;
            --fx-azure: #88a7ff;
            --fx-violet: #97a3ff;
        }

        html,
        body {
            background:
                radial-gradient(1200px 620px at 12% 8%, rgba(120, 215, 255, 0.16) 0%, rgba(120, 215, 255, 0) 62%),
                radial-gradient(920px 480px at 88% 84%, rgba(136, 167, 255, 0.18) 0%, rgba(136, 167, 255, 0) 66%),
                linear-gradient(180deg, #090f18 0%, #070c14 100%) !important;
            color: var(--fx-ice) !important;
        }

        body::before {
            background-image:
                linear-gradient(rgba(148, 192, 255, 0.08) 1px, transparent 1px),
                linear-gradient(90deg, rgba(148, 192, 255, 0.08) 1px, transparent 1px) !important;
            background-size: 34px 34px !important;
            opacity: 0.55 !important;
            animation: none !important;
        }

        body::after {
            background:
                radial-gradient(640px 340px at 12% 16%, rgba(120, 215, 255, 0.18) 0%, rgba(120, 215, 255, 0) 72%),
                radial-gradient(860px 380px at 84% 74%, rgba(136, 167, 255, 0.20) 0%, rgba(136, 167, 255, 0) 74%) !important;
            opacity: 0.72 !important;
            animation: fxNebulaPulse 10.8s ease-in-out infinite !important;
        }

        .admin-header {
            background: linear-gradient(180deg, rgba(9, 16, 29, 0.94) 0%, rgba(7, 13, 24, 0.96) 100%) !important;
            border-bottom: 1px solid var(--fx-line) !important;
            box-shadow:
                0 18px 40px rgba(2, 6, 14, 0.58),
                0 0 26px rgba(120, 215, 255, 0.14) !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, rgba(120, 215, 255, 0) 0%, rgba(120, 215, 255, 0.95) 50%, rgba(120, 215, 255, 0) 100%) !important;
            height: 2px !important;
            opacity: 0.72 !important;
            animation: fxBeamSweep 4.4s ease-in-out infinite !important;
        }

        .admin-menu-shell {
            border: 1px solid var(--fx-line) !important;
            border-radius: 20px !important;
            background:
                linear-gradient(180deg, rgba(13, 23, 41, 0.82) 0%, rgba(8, 14, 26, 0.88) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 20px 40px rgba(3, 8, 17, 0.58),
                0 0 34px rgba(120, 215, 255, 0.12) !important;
        }

        .admin-menu-hint {
            border: 1px solid var(--fx-line) !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(16, 29, 49, 0.76) 0%, rgba(10, 17, 30, 0.84) 100%) !important;
            color: var(--fx-muted) !important;
            letter-spacing: 0.06em;
        }

        .fx-admin-bar {
            margin-top: 12px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .fx-admin-pill {
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 8px 14px;
            border: 1px solid rgba(120, 215, 255, 0.30);
            border-radius: 999px;
            background: linear-gradient(180deg, rgba(16, 28, 48, 0.72) 0%, rgba(10, 17, 30, 0.82) 100%);
            color: #dff2ff;
            font-size: 11px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }

        .fx-admin-pill strong {
            color: #f4fbff;
            font-weight: 600;
            letter-spacing: 0.12em;
        }

        .fx-admin-dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #88ffa5;
            box-shadow: 0 0 12px rgba(136, 255, 165, 0.72);
            animation: fxPulseDot 2s ease-in-out infinite;
        }

        .admin-guided-tabs {
            margin-top: 12px !important;
            gap: 10px !important;
        }

        .admin-guided-tabs .tab-btn {
            border-radius: 14px !important;
            border: 1px solid rgba(120, 215, 255, 0.34) !important;
            background: linear-gradient(180deg, rgba(18, 33, 56, 0.78) 0%, rgba(11, 19, 34, 0.84) 100%) !important;
            color: #e7f5ff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 10px 20px rgba(3, 8, 17, 0.46),
                0 0 0 1px rgba(120, 215, 255, 0.09) !important;
            transform: translateY(0);
            transition:
                transform 0.12s ease,
                border-color 0.12s ease,
                background 0.12s ease,
                box-shadow 0.12s ease !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            transform: translateY(-2px);
            border-color: rgba(153, 209, 255, 0.88) !important;
            background: linear-gradient(180deg, rgba(24, 42, 70, 0.86) 0%, rgba(12, 22, 38, 0.90) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.13),
                0 14px 28px rgba(4, 10, 20, 0.52),
                0 0 20px rgba(120, 215, 255, 0.28) !important;
        }

        .admin-guided-tabs .tab-btn.active {
            border-color: var(--fx-line-strong) !important;
            background:
                linear-gradient(180deg, rgba(131, 165, 255, 0.94) 0%, rgba(88, 126, 232, 0.92) 55%, rgba(68, 106, 210, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.28),
                0 16px 30px rgba(5, 17, 45, 0.56),
                0 0 26px rgba(136, 167, 255, 0.40) !important;
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-title,
        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: #f4f9ff !important;
        }

        #orders.tab-content,
        #invoices.tab-content,
        #custom-orders.tab-content,
        #products.tab-content,
        #settings.tab-content {
            border: 1px solid rgba(120, 174, 255, 0.36) !important;
            border-radius: 20px !important;
            background:
                linear-gradient(180deg, rgba(12, 22, 38, 0.82) 0%, rgba(8, 14, 26, 0.88) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 24px 46px rgba(3, 7, 14, 0.54),
                0 0 32px rgba(120, 215, 255, 0.12) !important;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        #orders.tab-content::before,
        #invoices.tab-content::before,
        #custom-orders.tab-content::before,
        #products.tab-content::before,
        #settings.tab-content::before {
            opacity: 0.4 !important;
            background-size: 22px 22px !important;
        }

        #orders .order-table-block,
        #products .products-table,
        #invoices .invoice-card,
        #custom-orders .custom-order-card,
        #settings .settings-card.shipping-settings {
            border-color: rgba(130, 184, 255, 0.34) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 16px 30px rgba(3, 7, 15, 0.42) !important;
        }

        #orders .order-table-block thead th,
        #products .products-table thead th,
        #invoices .invoice-list-item,
        #custom-orders .custom-order-item {
            color: #d9eaff !important;
            letter-spacing: 0.10em;
            text-transform: uppercase;
            font-size: 11px;
        }

        #orders .order-table-block tbody tr,
        #products .products-table tbody tr {
            border-color: rgba(132, 181, 247, 0.24) !important;
            transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease !important;
        }

        #orders .order-table-block tbody tr.order-row:hover,
        #products .products-table tbody tr:hover {
            transform: translateY(-1px);
            box-shadow:
                0 12px 24px rgba(4, 10, 20, 0.48),
                0 0 18px rgba(120, 215, 255, 0.20) !important;
        }

        #products input,
        #products select,
        #products textarea,
        #orders input,
        #invoices input,
        #invoices select,
        #invoices textarea,
        #custom-orders input,
        #custom-orders select,
        #custom-orders textarea,
        #settings input,
        #settings select,
        #settings textarea {
            border-color: rgba(128, 182, 252, 0.34) !important;
            border-radius: 12px !important;
            background: linear-gradient(180deg, rgba(11, 18, 32, 0.82) 0%, rgba(8, 14, 24, 0.88) 100%) !important;
            color: #eef7ff !important;
        }

        #products input:focus,
        #products select:focus,
        #products textarea:focus,
        #orders input:focus,
        #invoices input:focus,
        #invoices select:focus,
        #invoices textarea:focus,
        #custom-orders input:focus,
        #custom-orders select:focus,
        #custom-orders textarea:focus,
        #settings input:focus,
        #settings select:focus,
        #settings textarea:focus {
            border-color: var(--fx-line-strong) !important;
            box-shadow:
                0 0 0 3px rgba(136, 167, 255, 0.20),
                0 0 18px rgba(120, 215, 255, 0.24) !important;
        }

        #products .btn,
        #products .btn-small,
        #products .back-to-products,
        #orders .btn,
        #orders .btn-small,
        #invoices .btn,
        #invoices .btn-small,
        #custom-orders .btn,
        #custom-orders .btn-small,
        #settings .btn,
        #settings .btn-small,
        #settings .shipping-remove-btn {
            border-radius: 999px !important;
            border: 1px solid rgba(128, 182, 252, 0.42) !important;
            background:
                linear-gradient(180deg, rgba(22, 38, 66, 0.82) 0%, rgba(11, 20, 36, 0.90) 100%) !important;
            color: #e9f6ff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.11),
                0 10px 20px rgba(3, 8, 17, 0.42) !important;
            transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease, background 0.12s ease !important;
        }

        #products .btn:hover,
        #products .btn-small:hover,
        #products .back-to-products:hover,
        #orders .btn:hover,
        #orders .btn-small:hover,
        #invoices .btn:hover,
        #invoices .btn-small:hover,
        #custom-orders .btn:hover,
        #custom-orders .btn-small:hover,
        #settings .btn:hover,
        #settings .btn-small:hover,
        #settings .shipping-remove-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(153, 209, 255, 0.88) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.15),
                0 14px 26px rgba(3, 8, 17, 0.52),
                0 0 18px rgba(120, 215, 255, 0.24) !important;
        }

        #products .products-table .action-menu-btn,
        #products .products-table .action-item {
            border-radius: 999px !important;
        }

        @media (max-width: 980px) {
            .fx-admin-bar {
                grid-template-columns: 1fr;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            body::after,
            .fx-admin-dot,
            .admin-header::after {
                animation: none !important;
            }
        }

        @keyframes fxPulseDot {
            0%, 100% {
                opacity: 0.85;
                transform: scale(1);
            }
            50% {
                opacity: 1;
                transform: scale(1.18);
            }
        }

        @keyframes fxNebulaPulse {
            0% {
                transform: translate3d(0, 0, 0);
                opacity: 0.66;
            }
            50% {
                transform: translate3d(-1.2%, -1%, 0);
                opacity: 0.82;
            }
            100% {
                transform: translate3d(0, 0, 0);
                opacity: 0.66;
            }
        }

        @keyframes fxBeamSweep {
            0%, 100% {
                opacity: 0.18;
            }
            50% {
                opacity: 0.78;
            }
        }

        /* ===== Orders Hyperdrive Layer ===== */
        body.legacy-orders-disabled.admin-orders-view #orders h2 {
            color: #f2f9ff !important;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            text-shadow: 0 0 24px rgba(120, 215, 255, 0.22);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin: 16px 0 18px;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-card {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(126, 186, 255, 0.34);
            border-radius: 14px;
            padding: 14px 14px 13px;
            background: linear-gradient(180deg, rgba(17, 31, 53, 0.82) 0%, rgba(10, 18, 33, 0.88) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 12px 24px rgba(3, 8, 16, 0.42);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-card::after {
            content: "";
            position: absolute;
            left: -35%;
            right: -35%;
            top: -35%;
            height: 48%;
            background: linear-gradient(
                180deg,
                rgba(120, 215, 255, 0) 0%,
                rgba(120, 215, 255, 0.20) 46%,
                rgba(120, 215, 255, 0) 100%
            );
            pointer-events: none;
            animation: fxOrdersSweep 6.2s ease-in-out infinite;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-label {
            font-size: 10px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #a7c0df;
            margin-bottom: 8px;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-value {
            font-size: clamp(24px, 2.6vw, 32px);
            line-height: 1;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: #f4fbff;
            margin-bottom: 8px;
            text-shadow: 0 0 16px rgba(120, 215, 255, 0.22);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-meta {
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #90afd3;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            position: relative;
            border-radius: 14px !important;
            border: 1px solid rgba(126, 186, 255, 0.34) !important;
            background: linear-gradient(180deg, rgba(17, 31, 53, 0.76) 0%, rgba(10, 18, 33, 0.86) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 10px 20px rgba(3, 8, 16, 0.40) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search label {
            color: #cfe4ff !important;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-size: 10px;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input {
            border-radius: 10px !important;
            border: 1px solid rgba(126, 186, 255, 0.30) !important;
            background: linear-gradient(180deg, rgba(12, 22, 38, 0.86) 0%, rgba(8, 14, 26, 0.90) 100%) !important;
            color: #eff8ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input::placeholder {
            color: #98b3d4 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input:focus {
            border-color: rgba(153, 209, 255, 0.90) !important;
            box-shadow:
                0 0 0 3px rgba(136, 167, 255, 0.20),
                0 0 16px rgba(120, 215, 255, 0.24) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border: 1px solid rgba(126, 186, 255, 0.34) !important;
            border-radius: 16px !important;
            overflow: hidden;
            background: linear-gradient(180deg, rgba(12, 22, 38, 0.84) 0%, rgba(8, 14, 26, 0.90) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 16px 30px rgba(3, 8, 16, 0.44),
                0 0 24px rgba(120, 215, 255, 0.10) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead th {
            color: #cae0fb !important;
            font-size: 10px;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            border-bottom-color: rgba(126, 186, 255, 0.26) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(12, 22, 38, 0.84) !important;
            border-bottom-color: rgba(126, 186, 255, 0.16) !important;
            transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            transform: translateY(-1px);
            background: linear-gradient(180deg, rgba(20, 36, 60, 0.92) 0%, rgba(12, 23, 39, 0.94) 100%) !important;
            box-shadow:
                0 12px 22px rgba(3, 8, 16, 0.48),
                0 0 16px rgba(120, 215, 255, 0.18) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link {
            color: #e5f2ff !important;
            letter-spacing: 0.08em;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link:hover,
        body.legacy-orders-disabled.admin-orders-view #orders .order-link:focus-visible {
            color: #ffffff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .payment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text {
            border-radius: 999px !important;
            border: 1px solid rgba(126, 186, 255, 0.36) !important;
            background: linear-gradient(180deg, rgba(20, 36, 60, 0.88) 0%, rgba(11, 20, 36, 0.90) 100%) !important;
            color: #dff1ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.fulfilled,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.delivered {
            border-color: rgba(108, 221, 165, 0.66) !important;
            background: linear-gradient(180deg, rgba(22, 77, 57, 0.80) 0%, rgba(13, 49, 37, 0.88) 100%) !important;
            color: #dcfff0 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.unfulfilled {
            border-color: rgba(255, 167, 167, 0.58) !important;
            background: linear-gradient(180deg, rgba(87, 32, 44, 0.82) 0%, rgba(55, 20, 27, 0.88) 100%) !important;
            color: #ffe5e9 !important;
        }

        #orderDetailPage.order-detail-page {
            background:
                radial-gradient(860px 420px at 16% 10%, rgba(120, 215, 255, 0.14) 0%, rgba(120, 215, 255, 0) 68%),
                radial-gradient(900px 420px at 88% 86%, rgba(136, 167, 255, 0.16) 0%, rgba(136, 167, 255, 0) 72%),
                linear-gradient(180deg, rgba(7, 12, 20, 0.96) 0%, rgba(6, 10, 16, 0.98) 100%) !important;
        }

        #orderDetailPage .order-detail-shell {
            border: 1px solid rgba(126, 186, 255, 0.34) !important;
            border-radius: 20px !important;
            background: linear-gradient(180deg, rgba(12, 22, 38, 0.88) 0%, rgba(8, 14, 26, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 24px 46px rgba(3, 8, 16, 0.62),
                0 0 26px rgba(120, 215, 255, 0.14) !important;
        }

        #orderDetailPage .order-detail-summary,
        #orderDetailPage .order-detail-card {
            border: 1px solid rgba(126, 186, 255, 0.28) !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(16, 29, 49, 0.78) 0%, rgba(9, 16, 30, 0.88) 100%) !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07) !important;
        }

        #orderDetailPage .order-detail-back,
        #orderDetailPage .order-detail-edit-btn,
        #orderDetailPage .btn-track-send {
            border-radius: 999px !important;
            border: 1px solid rgba(126, 186, 255, 0.42) !important;
            background: linear-gradient(180deg, rgba(22, 38, 66, 0.84) 0%, rgba(11, 20, 36, 0.92) 100%) !important;
            color: #e9f6ff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 10px 20px rgba(3, 8, 17, 0.48) !important;
        }

        #orderDetailPage .order-detail-back:hover,
        #orderDetailPage .order-detail-edit-btn:hover,
        #orderDetailPage .btn-track-send:hover {
            border-color: rgba(153, 209, 255, 0.90) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.15),
                0 14px 24px rgba(3, 8, 17, 0.56),
                0 0 18px rgba(120, 215, 255, 0.24) !important;
        }

        #orderDetailPage .order-detail-status {
            border-radius: 999px !important;
            letter-spacing: 0.11em;
            text-transform: uppercase;
            border-color: rgba(126, 186, 255, 0.38) !important;
            background: linear-gradient(180deg, rgba(20, 36, 60, 0.88) 0%, rgba(11, 20, 36, 0.92) 100%) !important;
            color: #e6f4ff !important;
        }

        @media (max-width: 1180px) {
            body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 700px) {
            body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-grid {
                grid-template-columns: 1fr;
            }
        }

        @keyframes fxOrdersSweep {
            0% {
                top: -40%;
                opacity: 0;
            }
            16% {
                opacity: 0.66;
            }
            58% {
                opacity: 0.18;
            }
            100% {
                top: 124%;
                opacity: 0;
            }
        }

        /* ===== Orders Surface Balance Fix ===== */
        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            padding-bottom: clamp(22px, 3vw, 30px) !important;
            border-color: rgba(142, 198, 255, 0.42) !important;
            background:
                radial-gradient(1180px 460px at -6% -14%, rgba(129, 200, 255, 0.24) 0%, rgba(129, 200, 255, 0) 66%),
                radial-gradient(1040px 420px at 108% 114%, rgba(137, 167, 255, 0.22) 0%, rgba(137, 167, 255, 0) 66%),
                linear-gradient(170deg, rgba(19, 38, 67, 0.86) 0%, rgba(16, 32, 56, 0.90) 48%, rgba(14, 28, 49, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 24px 44px rgba(5, 10, 20, 0.48),
                0 0 28px rgba(120, 215, 255, 0.16) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::before {
            opacity: 0.30 !important;
            background-size: 24px 24px !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::after {
            opacity: 0.44 !important;
            background: linear-gradient(
                180deg,
                rgba(139, 208, 255, 0) 0%,
                rgba(139, 208, 255, 0.20) 50%,
                rgba(139, 208, 255, 0) 100%
            ) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border-color: rgba(146, 202, 255, 0.38) !important;
            background: linear-gradient(180deg, rgba(18, 34, 60, 0.90) 0%, rgba(16, 29, 52, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.09),
                0 16px 28px rgba(5, 10, 20, 0.42),
                0 0 22px rgba(120, 215, 255, 0.12) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(22, 39, 67, 0.84) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-card {
            background: linear-gradient(180deg, rgba(21, 38, 66, 0.84) 0%, rgba(15, 27, 48, 0.90) 100%) !important;
            border-color: rgba(146, 202, 255, 0.34) !important;
        }

        /* ===== Orders Blue Clarity Override ===== */
        body.legacy-orders-disabled.admin-orders-view {
            background:
                radial-gradient(1280px 620px at 10% 8%, rgba(141, 210, 255, 0.22) 0%, rgba(141, 210, 255, 0) 64%),
                radial-gradient(1100px 560px at 90% 88%, rgba(146, 176, 255, 0.24) 0%, rgba(146, 176, 255, 0) 66%),
                linear-gradient(180deg, #1f4f8b 0%, #1a4375 52%, #173d6b 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view::before {
            background-image:
                linear-gradient(rgba(210, 232, 255, 0.14) 1px, transparent 1px),
                linear-gradient(90deg, rgba(210, 232, 255, 0.14) 1px, transparent 1px) !important;
            opacity: 0.42 !important;
        }

        body.legacy-orders-disabled.admin-orders-view::after {
            background:
                radial-gradient(760px 360px at 14% 18%, rgba(154, 220, 255, 0.24) 0%, rgba(154, 220, 255, 0) 72%),
                radial-gradient(880px 400px at 86% 78%, rgba(167, 190, 255, 0.22) 0%, rgba(167, 190, 255, 0) 74%) !important;
            opacity: 0.68 !important;
        }

        body.legacy-orders-disabled.admin-orders-view .container {
            background:
                linear-gradient(180deg, rgba(28, 74, 128, 0.50) 0%, rgba(22, 58, 101, 0.56) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            background:
                radial-gradient(1220px 520px at -6% -12%, rgba(168, 222, 255, 0.26) 0%, rgba(168, 222, 255, 0) 66%),
                radial-gradient(1080px 480px at 110% 114%, rgba(175, 196, 255, 0.24) 0%, rgba(175, 196, 255, 0) 66%),
                linear-gradient(170deg, rgba(40, 91, 152, 0.78) 0%, rgba(33, 79, 133, 0.84) 52%, rgba(29, 71, 121, 0.88) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.15),
                0 24px 44px rgba(27, 70, 118, 0.46),
                0 0 28px rgba(154, 220, 255, 0.26) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            background: linear-gradient(180deg, rgba(35, 82, 137, 0.84) 0%, rgba(31, 73, 123, 0.88) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 16px 28px rgba(28, 66, 112, 0.42),
                0 0 22px rgba(154, 220, 255, 0.18) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(36, 82, 136, 0.74) !important;
        }

        #orderDetailPage.order-detail-page {
            background:
                radial-gradient(960px 420px at 14% 12%, rgba(161, 223, 255, 0.24) 0%, rgba(161, 223, 255, 0) 70%),
                radial-gradient(940px 440px at 86% 84%, rgba(168, 190, 255, 0.22) 0%, rgba(168, 190, 255, 0) 72%),
                linear-gradient(180deg, rgba(24, 62, 106, 0.96) 0%, rgba(21, 54, 93, 0.98) 100%) !important;
        }

        #orderDetailPage .order-detail-shell {
            background: linear-gradient(180deg, rgba(41, 95, 158, 0.82) 0%, rgba(31, 74, 126, 0.90) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.14),
                0 24px 46px rgba(26, 61, 103, 0.52),
                0 0 26px rgba(154, 220, 255, 0.22) !important;
        }

        /* ===== Layout Reposition + Orders Background Cleanup ===== */
        body.legacy-orders-disabled.admin-orders-view .container {
            background: transparent !important;
        }

        body.legacy-orders-disabled.admin-orders-view .container::before,
        body.legacy-orders-disabled.admin-orders-view .container::after {
            content: none !important;
            display: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            background:
                linear-gradient(170deg, rgba(40, 91, 152, 0.82) 0%, rgba(33, 79, 133, 0.86) 52%, rgba(29, 71, 121, 0.90) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::before {
            opacity: 0.18 !important;
            background-size: 28px 28px !important;
        }

        @media (min-width: 1200px) {
            :root {
                --admin-rail-width: clamp(300px, 22vw, 360px);
                --admin-rail-gap: clamp(16px, 1.6vw, 24px);
            }

            .admin-header {
                position: fixed !important;
                top: var(--admin-rail-gap) !important;
                left: var(--admin-rail-gap) !important;
                bottom: var(--admin-rail-gap) !important;
                width: var(--admin-rail-width) !important;
                height: auto !important;
                z-index: 80 !important;
                border-radius: 22px !important;
                border-bottom: none !important;
                overflow: hidden;
                box-shadow:
                    0 24px 52px rgba(3, 8, 18, 0.56),
                    0 0 30px rgba(120, 215, 255, 0.16) !important;
            }

            .admin-header::after {
                top: auto !important;
                bottom: 0 !important;
                height: 2px !important;
            }

            .admin-menu-shell {
                height: 100% !important;
                display: flex !important;
                flex-direction: column !important;
                padding: 14px !important;
                border-radius: 0 !important;
            }

            .admin-menu-intro {
                margin: 0 0 10px !important;
            }

            .admin-guided-tabs {
                display: flex !important;
                flex-direction: column !important;
                gap: 10px !important;
                padding: 0 !important;
                margin: 0 !important;
                overflow: visible !important;
                flex-wrap: nowrap !important;
            }

            .admin-guided-tabs .tab-btn {
                width: 100% !important;
                min-height: 68px !important;
                justify-content: flex-start !important;
                text-align: left !important;
            }

            .tab-btn-copy {
                align-items: flex-start !important;
                text-align: left !important;
            }

            .fx-admin-bar {
                margin-top: auto !important;
                grid-template-columns: 1fr !important;
                gap: 8px !important;
                padding-top: 10px;
            }

            .container {
                width: calc(100vw - var(--admin-rail-width) - (var(--admin-rail-gap) * 3)) !important;
                max-width: none !important;
                margin-left: calc(var(--admin-rail-width) + (var(--admin-rail-gap) * 2)) !important;
                margin-right: var(--admin-rail-gap) !important;
                padding-top: var(--admin-rail-gap) !important;
            }
        }

        /* ===== Master Palette Override ===== */
        :root {
            --master-bg-a: #0f1012;
            --master-bg-b: #15171a;
            --master-bg-c: #1b1e22;
            --master-rail-a: rgba(12, 12, 14, 0.94);
            --master-rail-b: rgba(18, 19, 22, 0.96);
            --master-panel-a: rgba(30, 32, 36, 0.90);
            --master-panel-b: rgba(22, 24, 27, 0.94);
            --master-soft-line: rgba(255, 255, 255, 0.16);
            --master-strong-line: rgba(255, 255, 255, 0.38);
            --master-text: #f6f4f1;
            --master-muted: #d8d2c8;
            --master-glow: rgba(205, 171, 112, 0.22);
            --master-accent-a: rgba(207, 176, 122, 0.90);
            --master-accent-b: rgba(151, 125, 82, 0.94);
        }

        html {
            background: linear-gradient(180deg, var(--master-bg-a) 0%, var(--master-bg-b) 54%, var(--master-bg-c) 100%) !important;
        }

        body {
            background:
                radial-gradient(1180px 620px at 10% 8%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 62%),
                radial-gradient(1080px 560px at 86% 84%, rgba(202, 169, 114, 0.12) 0%, rgba(202, 169, 114, 0) 64%),
                linear-gradient(180deg, var(--master-bg-a) 0%, var(--master-bg-b) 54%, var(--master-bg-c) 100%) !important;
            color: var(--master-text) !important;
        }

        body::before {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.10) 1px, transparent 1px) !important;
            background-size: 30px 30px !important;
            opacity: 0.22 !important;
        }

        body::after {
            background:
                radial-gradient(820px 390px at 14% 16%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 72%),
                radial-gradient(880px 420px at 84% 80%, rgba(206, 172, 116, 0.14) 0%, rgba(206, 172, 116, 0) 74%) !important;
            opacity: 0.62 !important;
        }

        .container {
            background: transparent !important;
        }

        .admin-header {
            background: linear-gradient(180deg, var(--master-rail-a) 0%, var(--master-rail-b) 100%) !important;
            border-color: var(--master-soft-line) !important;
            box-shadow:
                0 24px 50px rgba(0, 0, 0, 0.48),
                0 0 24px var(--master-glow) !important;
        }

        .admin-menu-shell {
            border-color: var(--master-soft-line) !important;
            background: linear-gradient(180deg, rgba(24, 25, 28, 0.90) 0%, rgba(15, 16, 18, 0.94) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 20px 36px rgba(0, 0, 0, 0.42),
                0 0 22px rgba(205, 171, 112, 0.18) !important;
        }

        .admin-menu-hint {
            border-color: rgba(255, 255, 255, 0.28) !important;
            background: linear-gradient(180deg, rgba(45, 47, 52, 0.76) 0%, rgba(26, 28, 32, 0.84) 100%) !important;
            color: var(--master-muted) !important;
        }

        .admin-guided-tabs .tab-btn {
            border-color: rgba(255, 255, 255, 0.24) !important;
            background: linear-gradient(180deg, rgba(49, 52, 58, 0.84) 0%, rgba(30, 32, 37, 0.90) 100%) !important;
            color: var(--master-text) !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: rgba(255, 255, 255, 0.44) !important;
            background: linear-gradient(180deg, rgba(64, 67, 74, 0.88) 0%, rgba(39, 42, 48, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.14),
                0 14px 26px rgba(0, 0, 0, 0.42),
                0 0 16px rgba(205, 171, 112, 0.18) !important;
        }

        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(245, 229, 198, 0.78) !important;
            background: linear-gradient(180deg, var(--master-accent-a) 0%, var(--master-accent-b) 100%) !important;
            color: #1d1811 !important;
        }

        #orders.tab-content,
        #invoices.tab-content,
        #custom-orders.tab-content,
        #products.tab-content,
        #settings.tab-content {
            border-color: var(--master-soft-line) !important;
            background: linear-gradient(180deg, var(--master-panel-a) 0%, var(--master-panel-b) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 24px 44px rgba(0, 0, 0, 0.44),
                0 0 20px rgba(205, 171, 112, 0.14) !important;
        }

        #orders.tab-content::before,
        #invoices.tab-content::before,
        #custom-orders.tab-content::before,
        #products.tab-content::before,
        #settings.tab-content::before {
            opacity: 0.12 !important;
            background-size: 30px 30px !important;
        }

        #orders .order-table-block,
        #products .products-table,
        #invoices .invoice-card,
        #custom-orders .custom-order-card,
        #settings .settings-card.shipping-settings {
            border-color: rgba(255, 255, 255, 0.20) !important;
            background: linear-gradient(180deg, rgba(45, 48, 54, 0.84) 0%, rgba(30, 33, 38, 0.90) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 16px 28px rgba(0, 0, 0, 0.42) !important;
        }

        #orders .order-table-block tbody tr,
        #products .products-table tbody tr {
            background: rgba(40, 43, 48, 0.78) !important;
            border-color: rgba(255, 255, 255, 0.12) !important;
        }

        #orders .order-table-block tbody tr.order-row:hover,
        #products .products-table tbody tr:hover {
            background: linear-gradient(180deg, rgba(62, 66, 72, 0.88) 0%, rgba(45, 48, 54, 0.92) 100%) !important;
        }

        #orders .order-search,
        #settings .shipping-group-box {
            border-color: rgba(255, 255, 255, 0.20) !important;
            background: linear-gradient(180deg, rgba(45, 48, 54, 0.74) 0%, rgba(28, 31, 36, 0.86) 100%) !important;
        }

        #products input,
        #products select,
        #products textarea,
        #orders input,
        #invoices input,
        #invoices select,
        #invoices textarea,
        #custom-orders input,
        #custom-orders select,
        #custom-orders textarea,
        #settings input,
        #settings select,
        #settings textarea {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(34, 36, 41, 0.88) 0%, rgba(24, 26, 30, 0.92) 100%) !important;
            color: #f6f4f1 !important;
        }

        #products .btn,
        #products .btn-small,
        #products .back-to-products,
        #orders .btn,
        #orders .btn-small,
        #invoices .btn,
        #invoices .btn-small,
        #custom-orders .btn,
        #custom-orders .btn-small,
        #settings .btn,
        #settings .btn-small,
        #settings .shipping-remove-btn {
            border-color: rgba(255, 255, 255, 0.26) !important;
            background: linear-gradient(180deg, rgba(54, 57, 63, 0.90) 0%, rgba(34, 36, 41, 0.94) 100%) !important;
            color: #f6f4f1 !important;
        }

        #products .btn:hover,
        #products .btn-small:hover,
        #products .back-to-products:hover,
        #orders .btn:hover,
        #orders .btn-small:hover,
        #invoices .btn:hover,
        #invoices .btn-small:hover,
        #custom-orders .btn:hover,
        #custom-orders .btn-small:hover,
        #settings .btn:hover,
        #settings .btn-small:hover,
        #settings .shipping-remove-btn:hover {
            border-color: rgba(246, 229, 197, 0.84) !important;
            background: linear-gradient(180deg, rgba(206, 174, 118, 0.86) 0%, rgba(154, 128, 85, 0.90) 100%) !important;
            color: #1f1911 !important;
            box-shadow: 0 0 18px rgba(205, 171, 112, 0.26) !important;
        }

        .fx-admin-pill {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(46, 48, 54, 0.80) 0%, rgba(30, 32, 37, 0.88) 100%) !important;
            color: var(--master-text) !important;
        }

        .fx-admin-dot {
            background: linear-gradient(180deg, rgba(229, 198, 143, 1) 0%, rgba(170, 136, 83, 1) 100%) !important;
            box-shadow: 0 0 10px rgba(205, 171, 112, 0.48) !important;
        }

        /* ===== Executive Panel Navigation Upgrade ===== */
        .admin-guided-tabs .tab-btn {
            display: grid !important;
            grid-template-columns: 40px minmax(0, 1fr) auto;
            gap: 12px !important;
            align-items: center !important;
            min-height: 76px !important;
            padding: 14px !important;
            border-radius: 16px !important;
        }

        .tab-btn-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.22);
            background: linear-gradient(180deg, rgba(92, 95, 102, 0.34) 0%, rgba(49, 52, 58, 0.48) 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26);
            transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
            color: #f3efe8;
        }

        .tab-btn-icon svg {
            width: 19px;
            height: 19px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.9;
        }

        .tab-btn-copy {
            min-width: 0;
        }

        .tab-btn-title {
            letter-spacing: 0.015em !important;
        }

        .tab-btn-desc {
            margin-top: 3px !important;
            opacity: 0.92;
        }

        .tab-btn-badge {
            min-width: 42px;
            height: 30px;
            padding: 0 10px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.03em;
            border: 1px solid rgba(255, 255, 255, 0.28);
            background: linear-gradient(180deg, rgba(88, 91, 98, 0.42) 0%, rgba(50, 53, 59, 0.56) 100%);
            color: #f4f0e8;
            transition: border-color 0.22s ease, background 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
        }

        .tab-btn-badge.is-empty {
            color: rgba(235, 228, 215, 0.76);
            border-color: rgba(255, 255, 255, 0.20);
            background: linear-gradient(180deg, rgba(72, 75, 82, 0.24) 0%, rgba(44, 47, 53, 0.34) 100%);
        }

        .admin-guided-tabs .tab-btn:hover .tab-btn-icon,
        .admin-guided-tabs .tab-btn:focus-visible .tab-btn-icon {
            border-color: rgba(255, 255, 255, 0.52);
            background: linear-gradient(180deg, rgba(112, 116, 123, 0.42) 0%, rgba(64, 68, 75, 0.56) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.32),
                0 0 0 1px rgba(255, 255, 255, 0.14);
            transform: translateY(-1px);
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-icon {
            border-color: rgba(245, 230, 199, 0.78);
            background: linear-gradient(180deg, rgba(214, 184, 130, 0.90) 0%, rgba(156, 128, 84, 0.94) 100%);
            color: #1f1911;
            box-shadow:
                inset 0 1px 0 rgba(255, 250, 238, 0.42),
                0 0 0 1px rgba(221, 193, 142, 0.28);
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-badge {
            border-color: rgba(246, 229, 198, 0.88);
            background: linear-gradient(180deg, rgba(214, 184, 130, 0.88) 0%, rgba(156, 128, 84, 0.94) 100%);
            color: #1f1911;
            box-shadow: 0 0 14px rgba(205, 171, 112, 0.24);
        }

        .admin-quick-actions {
            margin-top: 10px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        .admin-quick-btn {
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 999px;
            min-height: 38px;
            padding: 0 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #f4f0e9;
            background: linear-gradient(180deg, rgba(66, 69, 76, 0.58) 0%, rgba(38, 41, 47, 0.74) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.24),
                0 10px 18px rgba(0, 0, 0, 0.34);
            transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
            cursor: pointer;
        }

        .admin-quick-btn:hover,
        .admin-quick-btn:focus-visible {
            border-color: rgba(246, 229, 197, 0.84);
            background: linear-gradient(180deg, rgba(208, 176, 120, 0.86) 0%, rgba(154, 128, 84, 0.90) 100%);
            color: #1f1911;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.28),
                0 14px 24px rgba(0, 0, 0, 0.42),
                0 0 16px rgba(205, 171, 112, 0.22);
        }

        .admin-quick-btn:active {
            transform: none !important;
        }

        @media (max-width: 1199px) {
            .admin-guided-tabs .tab-btn {
                min-height: 72px !important;
            }

            .admin-quick-actions {
                grid-template-columns: repeat(3, minmax(112px, 1fr));
            }
        }

        @media (min-width: 1200px) {
            .admin-quick-actions {
                grid-template-columns: 1fr;
                margin: 8px 0 10px;
            }

            .admin-quick-btn {
                min-height: 42px;
                justify-content: space-between;
            }
        }

        /* ===== Orders Palette Sync ===== */
        body.legacy-orders-disabled.admin-orders-view {
            background:
                radial-gradient(1180px 620px at 10% 8%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 62%),
                radial-gradient(1080px 560px at 86% 84%, rgba(202, 169, 114, 0.12) 0%, rgba(202, 169, 114, 0) 64%),
                linear-gradient(180deg, var(--master-bg-a) 0%, var(--master-bg-b) 54%, var(--master-bg-c) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view::before {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.10) 1px, transparent 1px) !important;
            background-size: 30px 30px !important;
            opacity: 0.22 !important;
        }

        body.legacy-orders-disabled.admin-orders-view::after {
            background:
                radial-gradient(820px 390px at 14% 16%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 72%),
                radial-gradient(880px 420px at 84% 80%, rgba(206, 172, 116, 0.14) 0%, rgba(206, 172, 116, 0) 74%) !important;
            opacity: 0.62 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(34, 36, 41, 0.90) 0%, rgba(24, 26, 30, 0.94) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 24px 44px rgba(0, 0, 0, 0.44),
                0 0 20px rgba(205, 171, 112, 0.14) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::before {
            opacity: 0.12 !important;
            background-size: 30px 30px !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::after {
            opacity: 0.22 !important;
            background: linear-gradient(180deg, rgba(206, 172, 116, 0) 0%, rgba(206, 172, 116, 0.22) 50%, rgba(206, 172, 116, 0) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2 {
            color: #f6f4f1 !important;
            text-shadow: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-card {
            border-color: rgba(255, 255, 255, 0.20) !important;
            background: linear-gradient(180deg, rgba(48, 51, 57, 0.86) 0%, rgba(32, 35, 40, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 12px 24px rgba(0, 0, 0, 0.38) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-card::after {
            background: linear-gradient(180deg, rgba(206, 172, 116, 0) 0%, rgba(206, 172, 116, 0.18) 46%, rgba(206, 172, 116, 0) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-label,
        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-meta {
            color: #d8d2c8 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fx-orders-value {
            color: #f6f4f1 !important;
            text-shadow: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(45, 48, 54, 0.78) 0%, rgba(30, 32, 37, 0.86) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 10px 20px rgba(0, 0, 0, 0.34) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search label {
            color: #d8d2c8 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input {
            border-color: rgba(255, 255, 255, 0.22) !important;
            background: linear-gradient(180deg, rgba(34, 36, 41, 0.90) 0%, rgba(24, 26, 30, 0.94) 100%) !important;
            color: #f6f4f1 !important;
            box-shadow: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input::placeholder {
            color: rgba(216, 210, 200, 0.72) !important;
