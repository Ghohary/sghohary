            box-shadow: none !important;
            transform: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-btn:hover {
            border-color: var(--product-line-strong) !important;
            background: linear-gradient(180deg, rgba(59, 66, 80, 0.92) 0%, rgba(39, 44, 54, 0.96) 100%) !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-btn.active {
            border-color: rgba(246, 249, 255, 0.82) !important;
            background: linear-gradient(180deg, rgba(240, 244, 252, 0.98) 0%, rgba(194, 203, 218, 0.96) 100%) !important;
            color: #161b24 !important;
        }

        @media (max-width: 1260px) {
            body.legacy-products-disabled.admin-products-view #products .product-header {
                grid-template-columns: 1fr !important;
                align-items: stretch;
            }

            body.legacy-products-disabled.admin-products-view #products .product-header-actions,
            body.legacy-products-disabled.admin-products-view #products .product-primary-actions {
                justify-content: flex-start !important;
            }

            body.legacy-products-disabled.admin-products-view #products .product-search-inline {
                width: min(100%, 520px) !important;
            }
        }

        @media (max-width: 900px) {
            body.legacy-products-disabled.admin-products-view #products .products-table thead th {
                padding: 11px 10px !important;
                font-size: 9px !important;
            }

            body.legacy-products-disabled.admin-products-view #products .products-quick-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            body.legacy-products-disabled.admin-products-view #products .products-select-wrap select {
                min-width: 152px;
            }

            body.legacy-products-disabled.admin-products-view #products .products-table tbody tr td {
                height: auto !important;
                padding: 10px !important;
                font-size: 12px !important;
            }

            body.legacy-products-disabled.admin-products-view #products .products-table tbody tr td:first-child {
                padding-left: 14px !important;
            }

            body.legacy-products-disabled.admin-products-view #products .products-table tbody tr td:last-child {
                padding-right: 14px !important;
            }

            body.legacy-products-disabled.admin-products-view #products .product-thumb-frame {
                width: 96px !important;
                height: 126px !important;
                min-height: 126px !important;
            }

            body.legacy-products-disabled.admin-products-view #products .product-name-cell {
                min-height: 126px !important;
                gap: 12px !important;
            }

            body.legacy-products-disabled.admin-products-view #products .product-detail-name {
                font-size: 14px !important;
            }
        }

        /* ===== Invoices Ultimate Refresh ===== */
        body.admin-invoices-view #invoices {
            --invoice-shell-top: rgba(36, 40, 48, 0.9);
            --invoice-shell-bottom: rgba(20, 23, 29, 0.96);
            --invoice-card-top: rgba(52, 58, 70, 0.86);
            --invoice-card-bottom: rgba(32, 36, 44, 0.94);
            --invoice-line-soft: rgba(255, 255, 255, 0.16);
            --invoice-line-strong: rgba(255, 255, 255, 0.3);
            --invoice-text-main: #f4f7fc;
            --invoice-text-soft: #b8bfcc;
            --invoice-focus-ring: rgba(236, 241, 249, 0.24);
        }

        body.admin-invoices-view #invoices.tab-content {
            margin-top: 0 !important;
            padding: clamp(22px, 3.2vw, 32px) !important;
            border-radius: 26px !important;
            border: 1px solid var(--invoice-line-soft) !important;
            background: linear-gradient(180deg, var(--invoice-shell-top) 0%, var(--invoice-shell-bottom) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 22px 44px rgba(0, 0, 0, 0.4) !important;
        }

        body.admin-invoices-view #invoices.tab-content::before,
        body.admin-invoices-view #invoices.tab-content::after {
            display: none !important;
            content: none !important;
            background: none !important;
            animation: none !important;
        }

        body.admin-invoices-view #invoices,
        body.admin-invoices-view #invoices * {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
            color: var(--invoice-text-main);
        }

        body.admin-invoices-view #invoices h2 {
            margin-bottom: 16px !important;
        }

        body.admin-invoices-view #invoices .invoice-command-surface {
            display: grid;
            gap: 12px;
            margin-bottom: 16px;
            border: 1px solid var(--invoice-line-soft);
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(44, 50, 61, 0.88) 0%, rgba(30, 34, 42, 0.94) 100%);
            padding: 14px;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 12px 24px rgba(0, 0, 0, 0.26);
        }

        body.admin-invoices-view #invoices .invoice-kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 10px;
        }

        body.admin-invoices-view #invoices .invoice-kpi {
            border: 1px solid var(--invoice-line-soft);
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(58, 64, 78, 0.88) 0%, rgba(38, 43, 53, 0.94) 100%);
            padding: 10px 12px;
            min-height: 66px;
            display: grid;
            gap: 4px;
        }

        body.admin-invoices-view #invoices .invoice-kpi span {
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--invoice-text-soft);
            font-weight: 500;
        }

        body.admin-invoices-view #invoices .invoice-kpi strong {
            font-size: 20px;
            font-weight: 500;
            line-height: 1;
            color: var(--invoice-text-main);
        }

        body.admin-invoices-view #invoices .invoice-command-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        body.admin-invoices-view #invoices .invoice-quick-filters {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        body.admin-invoices-view #invoices .invoice-quick-filter {
            min-height: 34px;
            border-radius: 999px;
            border: 1px solid var(--invoice-line-soft);
            background: linear-gradient(180deg, rgba(55, 61, 74, 0.84) 0%, rgba(36, 41, 50, 0.92) 100%);
            color: var(--invoice-text-main);
            padding: 0 14px;
            font-size: 10px;
            letter-spacing: 0.11em;
            text-transform: uppercase;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.12s linear, border-color 0.12s linear, color 0.12s linear, box-shadow 0.12s linear;
        }

        body.admin-invoices-view #invoices .invoice-quick-filter:hover,
        body.admin-invoices-view #invoices .invoice-quick-filter:focus-visible {
            border-color: var(--invoice-line-strong);
            background: linear-gradient(180deg, rgba(72, 80, 95, 0.9) 0%, rgba(50, 56, 67, 0.94) 100%);
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06);
            outline: none;
        }

        body.admin-invoices-view #invoices .invoice-quick-filter.active {
            border-color: rgba(247, 251, 255, 0.82);
            background: linear-gradient(180deg, rgba(241, 245, 252, 0.98) 0%, rgba(197, 206, 220, 0.96) 100%);
            color: #171d26;
        }

        body.admin-invoices-view #invoices .invoice-command-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        body.admin-invoices-view #invoices .invoice-command-actions .btn-small {
            min-height: 36px;
            border-radius: 999px !important;
            border: 1px solid var(--invoice-line-soft) !important;
            background: linear-gradient(180deg, rgba(55, 61, 74, 0.88) 0%, rgba(36, 41, 50, 0.92) 100%) !important;
            color: var(--invoice-text-main) !important;
            padding: 0 14px !important;
            letter-spacing: 0.1em !important;
            box-shadow: none !important;
            transform: none !important;
        }

        body.admin-invoices-view #invoices .invoice-command-actions .btn-small:hover,
        body.admin-invoices-view #invoices .invoice-command-actions .btn-small:focus-visible {
            border-color: var(--invoice-line-strong) !important;
            background: linear-gradient(180deg, rgba(76, 84, 99, 0.92) 0%, rgba(53, 60, 72, 0.96) 100%) !important;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06) !important;
            outline: none !important;
        }

        body.admin-invoices-view #invoices .invoice-results-meta {
            font-size: 11px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--invoice-text-soft);
            font-weight: 500;
        }

        body.admin-invoices-view #invoices .invoice-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
            gap: 14px;
            margin-top: 0 !important;
        }

        body.admin-invoices-view #invoices .invoice-card {
            border: 1px solid var(--invoice-line-soft) !important;
            border-radius: 18px !important;
            background: linear-gradient(180deg, var(--invoice-card-top) 0%, var(--invoice-card-bottom) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 14px 28px rgba(0, 0, 0, 0.28) !important;
            padding: clamp(16px, 2.6vw, 24px) !important;
        }

        body.admin-invoices-view #invoices .invoice-card h4 {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px !important;
            color: var(--invoice-text-main) !important;
            font-size: 14px !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase;
        }

        body.admin-invoices-view #invoices .invoice-editor-mode {
            border: 1px solid var(--invoice-line-soft);
            border-radius: 999px;
            min-height: 28px;
            padding: 4px 10px;
            font-size: 10px;
            letter-spacing: 0.1em;
            color: var(--invoice-text-soft);
            text-transform: uppercase;
            font-weight: 600;
            background: linear-gradient(180deg, rgba(66, 72, 86, 0.78) 0%, rgba(44, 49, 60, 0.86) 100%);
        }

        body.admin-invoices-view #invoices .invoice-grid label {
            margin-bottom: 8px !important;
            font-size: 11px !important;
            letter-spacing: 0.08em !important;
            color: var(--invoice-text-soft) !important;
        }

        body.admin-invoices-view #invoices .invoice-grid input,
        body.admin-invoices-view #invoices .invoice-grid select,
        body.admin-invoices-view #invoices .invoice-grid textarea,
        body.admin-invoices-view #invoices .invoice-filters input,
        body.admin-invoices-view #invoices .invoice-filters select,
        body.admin-invoices-view #invoices #invoiceItems .invoice-item input {
            border: 1px solid var(--invoice-line-soft) !important;
            border-radius: 10px !important;
            background: linear-gradient(180deg, rgba(32, 36, 44, 0.92) 0%, rgba(23, 26, 33, 0.96) 100%) !important;
            color: var(--invoice-text-main) !important;
            font-size: 13px !important;
            min-height: 42px;
            padding: 10px 12px !important;
            box-shadow: none !important;
        }

        body.admin-invoices-view #invoices .invoice-grid input:focus,
        body.admin-invoices-view #invoices .invoice-grid select:focus,
        body.admin-invoices-view #invoices .invoice-grid textarea:focus,
        body.admin-invoices-view #invoices .invoice-filters input:focus,
        body.admin-invoices-view #invoices .invoice-filters select:focus,
        body.admin-invoices-view #invoices #invoiceItems .invoice-item input:focus {
            border-color: var(--invoice-line-strong) !important;
            box-shadow: 0 0 0 3px var(--invoice-focus-ring) !important;
            outline: none !important;
        }

        body.admin-invoices-view #invoices .invoice-grid input::placeholder,
        body.admin-invoices-view #invoices .invoice-grid textarea::placeholder,
        body.admin-invoices-view #invoices .invoice-filters input::placeholder {
            color: var(--invoice-text-soft) !important;
            opacity: 0.85;
        }

        body.admin-invoices-view #invoices .invoice-item {
            display: grid !important;
            grid-template-columns: minmax(0, 1.9fr) minmax(84px, 0.55fr) minmax(120px, 0.8fr) minmax(130px, 0.9fr) auto !important;
            gap: 8px !important;
            align-items: center !important;
            border: 1px solid var(--invoice-line-soft) !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(50, 55, 67, 0.84) 0%, rgba(34, 38, 47, 0.92) 100%) !important;
            padding: 10px !important;
        }

        body.admin-invoices-view #invoices .invoice-item-line-total {
            min-height: 42px;
            border: 1px solid var(--invoice-line-soft);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            font-size: 12px;
            letter-spacing: 0.06em;
            color: var(--invoice-text-main);
            background: linear-gradient(180deg, rgba(58, 64, 77, 0.86) 0%, rgba(40, 45, 55, 0.92) 100%);
            text-transform: uppercase;
            font-weight: 600;
            white-space: nowrap;
        }

        body.admin-invoices-view #invoices .invoice-item .btn-small.invoice-item-remove {
            min-height: 42px !important;
            border-radius: 10px !important;
            border: 1px solid rgba(255, 200, 200, 0.36) !important;
            background: linear-gradient(180deg, rgba(118, 58, 58, 0.84) 0%, rgba(88, 41, 41, 0.92) 100%) !important;
            color: #ffecec !important;
            margin: 0 !important;
            box-shadow: none !important;
            transform: none !important;
        }

        body.admin-invoices-view #invoices .invoice-item .btn-small.invoice-item-remove:hover,
        body.admin-invoices-view #invoices .invoice-item .btn-small.invoice-item-remove:focus-visible {
            border-color: rgba(255, 215, 215, 0.52) !important;
            background: linear-gradient(180deg, rgba(138, 68, 68, 0.9) 0%, rgba(102, 49, 49, 0.96) 100%) !important;
        }

        body.admin-invoices-view #invoices .invoice-totals {
            border: 1px solid var(--invoice-line-soft) !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(44, 49, 60, 0.84) 0%, rgba(28, 32, 40, 0.92) 100%) !important;
            padding: 10px 12px !important;
        }

        body.admin-invoices-view #invoices .invoice-total-row {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
            font-size: 13px !important;
            color: var(--invoice-text-soft) !important;
        }

        body.admin-invoices-view #invoices .invoice-total-row:last-child {
            border-bottom: none !important;
            color: var(--invoice-text-main) !important;
        }

        body.admin-invoices-view #invoices .invoice-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 10px !important;
        }

        body.admin-invoices-view #invoices .invoice-actions .btn,
        body.admin-invoices-view #invoices .invoice-actions .btn-small {
            min-height: 40px !important;
            border-radius: 999px !important;
            border: 1px solid var(--invoice-line-soft) !important;
            background: linear-gradient(180deg, rgba(58, 64, 77, 0.9) 0%, rgba(39, 44, 54, 0.94) 100%) !important;
            color: var(--invoice-text-main) !important;
            padding: 0 14px !important;
            letter-spacing: 0.1em !important;
            box-shadow: none !important;
            transform: none !important;
            margin: 0 !important;
        }

        body.admin-invoices-view #invoices .invoice-actions .btn:hover,
        body.admin-invoices-view #invoices .invoice-actions .btn-small:hover,
        body.admin-invoices-view #invoices .invoice-actions .btn:focus-visible,
        body.admin-invoices-view #invoices .invoice-actions .btn-small:focus-visible {
            border-color: var(--invoice-line-strong) !important;
            background: linear-gradient(180deg, rgba(77, 84, 99, 0.92) 0%, rgba(54, 60, 71, 0.96) 100%) !important;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06) !important;
        }

        body.admin-invoices-view #invoices #saveInvoice {
            border-color: rgba(246, 249, 255, 0.84) !important;
            background: linear-gradient(180deg, rgba(241, 245, 252, 0.98) 0%, rgba(197, 206, 220, 0.96) 100%) !important;
            color: #151b24 !important;
        }

        body.admin-invoices-view #invoices .invoice-filters {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr) minmax(0, 1fr) minmax(0, 0.9fr);
            gap: 8px;
            margin-bottom: 12px !important;
        }

        body.admin-invoices-view #invoices .invoice-list {
            display: grid;
            gap: 10px;
            max-height: 860px;
            overflow-y: auto;
            padding-right: 4px;
        }

        body.admin-invoices-view #invoices .invoice-list-item {
            border: 1px solid var(--invoice-line-soft) !important;
            border-radius: 14px !important;
            background: linear-gradient(180deg, rgba(54, 60, 73, 0.86) 0%, rgba(35, 39, 48, 0.93) 100%) !important;
            padding: 12px !important;
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 8px 12px;
            align-items: start;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 10px 20px rgba(0, 0, 0, 0.22) !important;
            transition: border-color 0.12s linear, background-color 0.12s linear, box-shadow 0.12s linear;
        }

        body.admin-invoices-view #invoices .invoice-list-item:hover {
            border-color: var(--invoice-line-strong) !important;
            background: linear-gradient(180deg, rgba(71, 78, 94, 0.9) 0%, rgba(48, 54, 66, 0.95) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                0 12px 24px rgba(0, 0, 0, 0.24) !important;
        }

        body.admin-invoices-view #invoices .invoice-list-item:focus-visible {
            outline: 2px solid rgba(246, 250, 255, 0.78);
            outline-offset: 2px;
            border-color: rgba(246, 250, 255, 0.68) !important;
        }

        body.admin-invoices-view #invoices .invoice-list-item-main {
            min-width: 0;
            display: grid;
            gap: 6px;
            cursor: pointer;
        }

        body.admin-invoices-view #invoices .invoice-list-item-top {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        body.admin-invoices-view #invoices .invoice-list-number {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.06em;
            color: var(--invoice-text-main);
        }

        body.admin-invoices-view #invoices .invoice-status-pill {
            border-radius: 999px;
            min-height: 24px;
            padding: 4px 10px;
            border: 1px solid var(--invoice-line-soft);
            font-size: 10px;
            letter-spacing: 0.11em;
            text-transform: uppercase;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        body.admin-invoices-view #invoices .invoice-status-pill.status-paid {
            border-color: rgba(202, 236, 214, 0.62);
            background: linear-gradient(180deg, rgba(178, 220, 191, 0.9) 0%, rgba(131, 179, 147, 0.96) 100%);
            color: #16211a;
        }

        body.admin-invoices-view #invoices .invoice-status-pill.status-partially_paid {
            border-color: rgba(244, 231, 194, 0.62);
            background: linear-gradient(180deg, rgba(222, 206, 166, 0.9) 0%, rgba(178, 157, 114, 0.96) 100%);
            color: #1f1a11;
        }

        body.admin-invoices-view #invoices .invoice-status-pill.status-unpaid,
        body.admin-invoices-view #invoices .invoice-status-pill.status-overdue {
            border-color: rgba(236, 190, 190, 0.62);
            background: linear-gradient(180deg, rgba(146, 74, 74, 0.86) 0%, rgba(108, 51, 51, 0.94) 100%);
            color: #fff1f1;
        }

        body.admin-invoices-view #invoices .invoice-status-pill.status-draft {
            border-color: rgba(206, 214, 227, 0.56);
            background: linear-gradient(180deg, rgba(97, 105, 121, 0.86) 0%, rgba(71, 77, 90, 0.94) 100%);
            color: #f4f7fd;
        }

        body.admin-invoices-view #invoices .invoice-list-client,
        body.admin-invoices-view #invoices .invoice-list-meta {
            font-size: 12px;
            color: var(--invoice-text-soft);
            line-height: 1.4;
        }

        body.admin-invoices-view #invoices .invoice-list-amount {
            justify-self: end;
            text-align: right;
            display: grid;
            gap: 4px;
        }

        body.admin-invoices-view #invoices .invoice-list-total {
            font-size: 16px;
            letter-spacing: 0.04em;
            color: var(--invoice-text-main);
            font-weight: 600;
        }

        body.admin-invoices-view #invoices .invoice-list-currency {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--invoice-text-soft);
            font-weight: 600;
        }

        body.admin-invoices-view #invoices .invoice-list-actions {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
        }

        body.admin-invoices-view #invoices .invoice-list-actions .btn-small {
            min-height: 34px !important;
            border-radius: 999px !important;
            border: 1px solid var(--invoice-line-soft) !important;
            background: linear-gradient(180deg, rgba(57, 63, 76, 0.9) 0%, rgba(38, 43, 52, 0.94) 100%) !important;
            color: var(--invoice-text-main) !important;
            padding: 0 12px !important;
            letter-spacing: 0.09em !important;
            margin: 0 !important;
            box-shadow: none !important;
            transform: none !important;
        }

        body.admin-invoices-view #invoices .invoice-list-actions .btn-small:hover,
        body.admin-invoices-view #invoices .invoice-list-actions .btn-small:focus-visible {
            border-color: var(--invoice-line-strong) !important;
            background: linear-gradient(180deg, rgba(77, 84, 99, 0.92) 0%, rgba(54, 60, 71, 0.96) 100%) !important;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06) !important;
        }

        body.admin-invoices-view #invoices .invoice-list-actions .invoice-delete {
            border-color: rgba(236, 190, 190, 0.56) !important;
            background: linear-gradient(180deg, rgba(117, 58, 58, 0.84) 0%, rgba(86, 40, 40, 0.92) 100%) !important;
            color: #ffeaea !important;
        }

        body.admin-invoices-view #invoices .invoice-list-actions .invoice-delete:hover,
        body.admin-invoices-view #invoices .invoice-list-actions .invoice-delete:focus-visible {
            border-color: rgba(246, 206, 206, 0.66) !important;
            background: linear-gradient(180deg, rgba(140, 70, 70, 0.9) 0%, rgba(104, 49, 49, 0.96) 100%) !important;
        }

        body.admin-invoices-view #invoices .invoice-list-empty {
            border: 1px dashed var(--invoice-line-soft);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            color: var(--invoice-text-soft);
            font-size: 12px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        @media (max-width: 1200px) {
            body.admin-invoices-view #invoices .invoice-layout {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 980px) {
            body.admin-invoices-view #invoices .invoice-kpi-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            body.admin-invoices-view #invoices .invoice-filters {
                grid-template-columns: 1fr;
            }

            body.admin-invoices-view #invoices .invoice-item {
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            }
        }

        @media (max-width: 720px) {
            body.admin-invoices-view #invoices .invoice-list-item {
                grid-template-columns: 1fr;
            }

            body.admin-invoices-view #invoices .invoice-list-amount {
                justify-self: start;
                text-align: left;
            }

            body.admin-invoices-view #invoices .invoice-list-actions {
                justify-content: flex-start;
            }

            body.admin-invoices-view #invoices .invoice-item {
                grid-template-columns: 1fr !important;
            }

            body.admin-invoices-view #invoices .invoice-item .btn-small.invoice-item-remove {
                width: 100%;
            }
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .products-table {
            border-spacing: 0 8px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .products-table tbody tr td {
            height: 158px !important;
            padding-top: 10px !important;
            padding-bottom: 10px !important;
            font-size: 12px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .products-table tbody tr td:first-child {
            padding-left: 20px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .products-table tbody tr td:last-child {
            padding-right: 20px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .product-thumb-frame {
            width: 110px !important;
            height: 148px !important;
            min-height: 148px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .product-name-cell {
            min-height: 148px !important;
            gap: 14px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .product-detail-name {
            font-size: 15px !important;
        }

        body.legacy-products-disabled.admin-products-view #products[data-density="compact"] .products-table .action-menu-btn {
            width: 46px !important;
            height: 46px !important;
            min-width: 46px !important;
            min-height: 46px !important;
        }

        /* ===== Add Product Ultimate Refresh ===== */
        body.admin-products-view.admin-add-product-view #products {
            --add-shell-top: rgba(36, 40, 48, 0.9);
            --add-shell-bottom: rgba(19, 22, 28, 0.96);
            --add-card-top: rgba(56, 63, 76, 0.86);
            --add-card-bottom: rgba(35, 40, 49, 0.94);
            --add-input-top: rgba(28, 32, 40, 0.92);
            --add-input-bottom: rgba(19, 22, 28, 0.97);
            --add-line: rgba(255, 255, 255, 0.16);
            --add-line-strong: rgba(255, 255, 255, 0.34);
            --add-text-main: #f4f7fd;
            --add-text-soft: #b9c1cf;
            --add-focus: rgba(238, 244, 255, 0.22);
            background: transparent !important;
            color: var(--add-text-main) !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-header {
            margin-bottom: 14px !important;
            border-radius: 22px !important;
            padding: 14px 18px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, var(--add-card-top) 0%, var(--add-card-bottom) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 14px 28px rgba(0, 0, 0, 0.3) !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-header-link {
            color: var(--add-text-main) !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-header-link::before {
            background: rgba(244, 248, 255, 0.7) !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-header-subtitle {
            color: var(--add-text-soft) !important;
            letter-spacing: 0.09em !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions {
            gap: 10px !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .back-to-products,
        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit {
            min-height: 46px;
            height: 46px;
            border-radius: 999px !important;
            padding: 0 22px !important;
            font-size: 11px !important;
            letter-spacing: 0.12em !important;
            transform: none !important;
            box-shadow: none !important;
            transition: border-color 0.14s linear, background-color 0.14s linear, color 0.14s linear, box-shadow 0.14s linear !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .back-to-products::before,
        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit::before,
        body.admin-products-view.admin-add-product-view #products .size-btn::before,
        body.admin-products-view.admin-add-product-view #products .size-chip::before,
        body.admin-products-view.admin-add-product-view #products .image-preview-btn::before {
            content: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .back-to-products {
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, rgba(44, 50, 61, 0.88) 0%, rgba(28, 32, 39, 0.94) 100%) !important;
            color: var(--add-text-main) !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit {
            border: 1px solid rgba(246, 250, 255, 0.84) !important;
            background: linear-gradient(180deg, rgba(241, 245, 252, 0.98) 0%, rgba(198, 207, 221, 0.96) 100%) !important;
            color: #171c25 !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .back-to-products:hover,
        body.admin-products-view.admin-add-product-view #products .product-primary-actions .back-to-products:focus-visible {
            border-color: var(--add-line-strong) !important;
            background: linear-gradient(180deg, rgba(62, 69, 84, 0.92) 0%, rgba(40, 46, 57, 0.96) 100%) !important;
            color: #ffffff !important;
            outline: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit:hover,
        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit:focus-visible {
            border-color: rgba(251, 253, 255, 0.94) !important;
            background: linear-gradient(180deg, rgba(248, 251, 255, 1) 0%, rgba(211, 220, 232, 0.98) 100%) !important;
            color: #111722 !important;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08) !important;
            outline: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .product-primary-actions .add-product-submit:disabled {
            opacity: 0.66 !important;
            cursor: wait !important;
            border-color: rgba(235, 241, 251, 0.72) !important;
            background: linear-gradient(180deg, rgba(226, 233, 244, 0.94) 0%, rgba(179, 190, 207, 0.9) 100%) !important;
            color: #202631 !important;
            box-shadow: none !important;
        }

        body.admin-products-view.admin-add-product-view #products #productForm {
            display: grid !important;
            grid-template-columns: minmax(360px, 1fr) minmax(420px, 1.15fr);
            gap: 18px;
            align-items: start;
        }

        body.admin-products-view.admin-add-product-view #products .product-composer-toolbar {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
            gap: 12px;
            border-radius: 18px;
            border: 1px solid var(--add-line);
            background: linear-gradient(180deg, rgba(45, 51, 62, 0.88) 0%, rgba(29, 33, 40, 0.94) 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 12px 24px rgba(0, 0, 0, 0.28);
            padding: 12px 14px;
            margin-bottom: 2px;
        }

        body.admin-products-view.admin-add-product-view #products .product-readiness {
            display: grid;
            gap: 8px;
            align-content: center;
        }

        body.admin-products-view.admin-add-product-view #products .product-readiness-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        body.admin-products-view.admin-add-product-view #products .product-readiness-title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.13em;
            color: var(--add-text-soft);
            font-weight: 600;
        }

        body.admin-products-view.admin-add-product-view #products .product-readiness-value {
            font-size: 12px;
            letter-spacing: 0.06em;
            color: var(--add-text-main);
            font-weight: 600;
        }

        body.admin-products-view.admin-add-product-view #products .product-readiness-track {
            width: 100%;
            height: 8px;
            border-radius: 999px;
            border: 1px solid var(--add-line);
            background: rgba(18, 21, 26, 0.9);
            overflow: hidden;
        }

        body.admin-products-view.admin-add-product-view #products .product-readiness-track span {
            display: block;
            height: 100%;
            width: 0;
            border-radius: inherit;
            background: linear-gradient(90deg, rgba(208, 218, 235, 0.82) 0%, rgba(247, 251, 255, 0.98) 100%);
            transition: width 0.2s ease;
        }

        body.admin-products-view.admin-add-product-view #products .product-composer-chips {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        body.admin-products-view.admin-add-product-view #products .product-composer-chip {
            min-height: 40px;
            border-radius: 12px;
            border: 1px solid var(--add-line);
            background: linear-gradient(180deg, rgba(39, 44, 54, 0.88) 0%, rgba(25, 29, 36, 0.95) 100%);
            color: var(--add-text-main);
            font-size: 10px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            text-align: center;
            line-height: 1.2;
        }

        body.admin-products-view.admin-add-product-view #products #productForm > .form-section {
            margin: 0 !important;
        }

        body.admin-products-view.admin-add-product-view #products #productForm > .product-top-grid {
            grid-column: 1;
            grid-row: 2 / span 2;
            position: sticky;
            top: 16px;
            align-self: start;
        }

        body.admin-products-view.admin-add-product-view #products #productForm > .product-info-section {
            grid-column: 2;
            grid-row: 2;
        }

        body.admin-products-view.admin-add-product-view #products #productForm > .product-sizes-section {
            grid-column: 2;
            grid-row: 3;
        }

        body.admin-products-view.admin-add-product-view #products .form-section:not(.product-top-grid),
        body.admin-products-view.admin-add-product-view #products .form-section-card,
        body.admin-products-view.admin-add-product-view #products .media-block {
            border: 1px solid var(--add-line) !important;
            border-radius: 20px !important;
            background: linear-gradient(180deg, var(--add-card-top) 0%, var(--add-card-bottom) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 16px 30px rgba(0, 0, 0, 0.28) !important;
            padding: clamp(20px, 3.4vw, 30px) !important;
        }

        body.admin-products-view.admin-add-product-view #products .form-section-title,
        body.admin-products-view.admin-add-product-view #products .media-block-title {
            color: var(--add-text-soft) !important;
            font-size: 11px !important;
            letter-spacing: 0.16em !important;
            margin-bottom: 14px !important;
        }

        body.admin-products-view.admin-add-product-view #products label {
            color: var(--add-text-main) !important;
            margin-bottom: 10px !important;
            font-size: 11px !important;
            letter-spacing: 0.1em !important;
            font-weight: 500 !important;
        }

        body.admin-products-view.admin-add-product-view #products .form-group {
            margin-bottom: 20px !important;
        }

        body.admin-products-view.admin-add-product-view #products input,
        body.admin-products-view.admin-add-product-view #products select,
        body.admin-products-view.admin-add-product-view #products textarea {
            border-radius: 14px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, var(--add-input-top) 0%, var(--add-input-bottom) 100%) !important;
            color: var(--add-text-main) !important;
            font-size: 14px !important;
            font-weight: 400 !important;
            min-height: 50px !important;
            padding: 12px 14px !important;
            box-shadow: none !important;
        }

        body.admin-products-view.admin-add-product-view #products textarea {
            min-height: 142px !important;
            line-height: 1.6 !important;
        }

        body.admin-products-view.admin-add-product-view #products input::placeholder,
        body.admin-products-view.admin-add-product-view #products textarea::placeholder {
            color: var(--add-text-soft) !important;
        }

        body.admin-products-view.admin-add-product-view #products input:focus,
        body.admin-products-view.admin-add-product-view #products select:focus,
        body.admin-products-view.admin-add-product-view #products textarea:focus {
            border-color: var(--add-line-strong) !important;
            box-shadow: 0 0 0 3px var(--add-focus) !important;
            outline: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone {
            position: relative;
            width: 100% !important;
            min-height: 84px !important;
            border-radius: 16px !important;
            border: 1px dashed var(--add-line-strong) !important;
            background: linear-gradient(180deg, rgba(30, 35, 43, 0.88) 0%, rgba(20, 24, 30, 0.95) 100%) !important;
            color: var(--add-text-main) !important;
            padding: 14px 16px !important;
            transition: border-color 0.16s linear, background-color 0.16s linear, box-shadow 0.16s linear !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone:hover,
        body.admin-products-view.admin-add-product-view #products .image-dropzone.drag-over {
            border-color: rgba(244, 248, 255, 0.78) !important;
            background: linear-gradient(180deg, rgba(43, 49, 61, 0.92) 0%, rgba(28, 33, 41, 0.97) 100%) !important;
            box-shadow: 0 0 0 3px rgba(248, 251, 255, 0.08) !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone-native-input {
            position: absolute;
            left: 0;
            top: 0;
            width: 1px !important;
            height: 1px !important;
            min-width: 0 !important;
            min-height: 0 !important;
            max-width: 1px !important;
            max-height: 1px !important;
            opacity: 0 !important;
            margin: -1px;
            padding: 0 !important;
            border: 0 !important;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
            pointer-events: none;
            background: transparent !important;
            box-shadow: none !important;
            appearance: none;
            -webkit-appearance: none;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone-content {
            display: grid;
            justify-items: center;
            gap: 4px;
            text-align: center;
            width: 100%;
            position: relative;
            z-index: 1;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone-title {
            font-size: 12px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--add-text-main);
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone-link {
            min-height: 30px;
            border-radius: 999px;
            border: 1px solid var(--add-line);
            background: linear-gradient(180deg, rgba(64, 71, 85, 0.9) 0%, rgba(44, 50, 61, 0.96) 100%);
            color: var(--add-text-main);
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 12px;
            cursor: pointer;
            position: relative;
            z-index: 2;
        }

        body.admin-products-view.admin-add-product-view #products .image-dropzone-meta {
            font-size: 10px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--add-text-soft);
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-container {
            margin-top: 14px !important;
            border-radius: 18px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, rgba(29, 34, 42, 0.76) 0%, rgba(19, 22, 28, 0.9) 100%) !important;
            padding: 14px !important;
            gap: 14px !important;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)) !important;
            max-height: min(52vh, 520px);
            overflow-y: auto;
            align-content: start;
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-item {
            border: 1px solid var(--add-line) !important;
            border-radius: 20px !important;
            background: rgba(9, 11, 15, 0.96) !important;
            box-shadow: 0 10px 18px rgba(0, 0, 0, 0.26) !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-item:hover {
            border-color: var(--add-line-strong) !important;
            box-shadow: 0 14px 24px rgba(0, 0, 0, 0.3) !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-item.selected {
            border: 2px solid rgba(246, 250, 255, 0.74) !important;
            box-shadow: 0 14px 26px rgba(0, 0, 0, 0.34) !important;
            background: rgba(18, 22, 28, 0.98) !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-btn {
            transform: none !important;
            box-shadow: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-btn.remove {
            min-width: 64px !important;
            height: 32px !important;
            border-radius: 999px !important;
            border: 1px solid rgba(255, 255, 255, 0.58) !important;
            background: rgba(18, 18, 18, 0.52) !important;
            color: #ffffff !important;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.24) !important;
        }

        body.admin-products-view.admin-add-product-view #products .image-preview-btn.remove:hover {
            background: rgba(18, 18, 18, 0.68) !important;
            opacity: 1 !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-selector {
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 10px !important;
            margin-bottom: 0 !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-btn {
            min-height: 44px !important;
            border-radius: 12px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, rgba(34, 38, 46, 0.92) 0%, rgba(24, 27, 33, 0.96) 100%) !important;
            color: #edf2fb !important;
            font-size: 12px !important;
            letter-spacing: 0.08em !important;
            transform: none !important;
            box-shadow: none !important;
            transition: border-color 0.14s linear, background-color 0.14s linear, color 0.14s linear !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-btn:hover,
        body.admin-products-view.admin-add-product-view #products .size-btn:focus-visible {
            border-color: var(--add-line-strong) !important;
            background: linear-gradient(180deg, rgba(54, 60, 72, 0.94) 0%, rgba(37, 42, 51, 0.98) 100%) !important;
            color: #ffffff !important;
            outline: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-btn.active {
            border-color: rgba(248, 251, 255, 0.86) !important;
            background: linear-gradient(180deg, rgba(240, 244, 252, 0.98) 0%, rgba(197, 206, 220, 0.96) 100%) !important;
            color: #161b24 !important;
        }

        body.admin-products-view.admin-add-product-view #products .selected-sizes-display {
            display: none;
            margin-top: 12px;
            padding: 10px;
            border-radius: 14px;
            border: 1px dashed var(--add-line);
            background: linear-gradient(180deg, rgba(28, 32, 40, 0.78) 0%, rgba(20, 23, 29, 0.88) 100%);
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        body.admin-products-view.admin-add-product-view #products .size-chip {
            border: 1px solid var(--add-line);
            border-radius: 999px;
            min-height: 30px;
            padding: 0 11px;
            background: rgba(49, 55, 67, 0.88);
            color: var(--add-text-main);
            font-size: 10px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
            transition: border-color 0.14s linear, background-color 0.14s linear, color 0.14s linear;
        }

        body.admin-products-view.admin-add-product-view #products .size-chip:hover {
            border-color: var(--add-line-strong);
            background: rgba(72, 79, 94, 0.9);
            color: #ffffff;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-matrix {
            margin-top: 12px;
            border-radius: 14px;
            border: 1px solid var(--add-line);
            background: linear-gradient(180deg, rgba(31, 35, 43, 0.82) 0%, rgba(21, 24, 31, 0.92) 100%);
            padding: 12px;
            display: grid;
            gap: 10px;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
