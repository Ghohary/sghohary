            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8px 10px;
        }

        @media (max-width: 1240px) {
            body.admin-products-view.admin-add-product-view #products #productForm {
                grid-template-columns: 1fr !important;
            }

            body.admin-products-view.admin-add-product-view #products .product-composer-toolbar {
                grid-template-columns: 1fr;
            }

            body.admin-products-view.admin-add-product-view #products #productForm > .product-top-grid,
            body.admin-products-view.admin-add-product-view #products #productForm > .product-info-section,
            body.admin-products-view.admin-add-product-view #products #productForm > .product-sizes-section {
                grid-column: auto;
                grid-row: auto;
            }

            body.admin-products-view.admin-add-product-view #products #productForm > .product-top-grid {
                position: static;
            }
        }

        @media (max-width: 820px) {
            body.admin-products-view.admin-add-product-view #products .product-header {
                padding: 12px !important;
                border-radius: 16px !important;
