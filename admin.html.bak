            background: linear-gradient(180deg, rgba(120, 60, 60, 0.92) 0%, rgba(89, 42, 42, 0.97) 100%) !important;
            color: #fff2f2 !important;
        }

        body.admin-products-view.admin-add-product-view #products #productForm > .form-section {
            margin: 0 !important;
