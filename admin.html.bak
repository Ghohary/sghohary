        /* ===== Roman Futurism Override ===== */
        :root {
            --rf-ink: #1f1a14;
            --rf-muted: #6a6257;
            --rf-gold: #c7a24a;
            --rf-gold-soft: #e5d2a2;
            --rf-line: rgba(126, 102, 56, 0.24);
            --rf-line-strong: rgba(161, 125, 60, 0.56);
            --rf-white: #ffffff;
            --rf-white-soft: #fcfaf6;
        }

        body {
            background:
                radial-gradient(980px 440px at 0% -8%, rgba(226, 207, 160, 0.24) 0%, rgba(226, 207, 160, 0) 60%),
                radial-gradient(860px 360px at 100% 108%, rgba(198, 165, 98, 0.18) 0%, rgba(198, 165, 98, 0) 62%),
                linear-gradient(180deg, #fffdfa 0%, #f8f3ea 100%) !important;
            color: var(--rf-ink) !important;
        }

        body::before {
            opacity: 0.09 !important;
            background-size: 40px 40px !important;
            background-image:
                linear-gradient(rgba(143, 116, 62, 0.20) 1px, transparent 1px),
                linear-gradient(90deg, rgba(143, 116, 62, 0.18) 1px, transparent 1px) !important;
            animation: none !important;
        }

        body::after {
            background:
                radial-gradient(64% 34% at 50% -12%, rgba(223, 196, 136, 0.24) 0%, rgba(223, 196, 136, 0) 100%),
                linear-gradient(180deg, rgba(243, 226, 184, 0.24) 0%, rgba(243, 226, 184, 0) 34%) !important;
            animation: none !important;
        }

        .admin-header {
            border-bottom: 1px solid var(--rf-line) !important;
            box-shadow: 0 10px 24px rgba(90, 70, 35, 0.14) !important;
        }

        .admin-header::before {
            opacity: 0.10 !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, rgba(179, 142, 73, 0) 0%, rgba(179, 142, 73, 0.62) 50%, rgba(179, 142, 73, 0) 100%) !important;
            box-shadow: none !important;
        }

        .admin-menu-shell {
            border: 1px solid var(--rf-line) !important;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(250, 244, 233, 0.94) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.95),
                0 10px 24px rgba(90, 70, 35, 0.12) !important;
        }

        .admin-menu-shell::after {
            content: none !important;
            display: none !important;
        }

        .admin-menu-hint {
            border: 1px solid rgba(179, 142, 73, 0.36) !important;
            background: rgba(252, 246, 234, 0.94) !important;
            color: #7e6130 !important;
            text-transform: uppercase;
            letter-spacing: 0.09em;
            box-shadow: none !important;
        }

        .admin-guided-tabs .tab-btn {
            border: 1px solid var(--rf-line) !important;
            background: linear-gradient(180deg, #ffffff 0%, #f8f2e8 100%) !important;
            color: var(--rf-ink) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.96),
                0 6px 14px rgba(88, 66, 31, 0.10) !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn::before,
        .admin-guided-tabs .tab-btn::after {
            content: none !important;
            display: none !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: var(--rf-line-strong) !important;
            background: linear-gradient(180deg, #fffefb 0%, #f5ebd7 100%) !important;
            box-shadow:
                0 8px 18px rgba(88, 66, 31, 0.14),
                0 0 0 1px rgba(201, 163, 89, 0.24) !important;
            color: #221b13 !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(160, 124, 58, 0.62) !important;
            background: linear-gradient(180deg, #d4b36a 0%, #b88936 100%) !important;
            color: #1b1409 !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 245, 221, 0.74),
                0 9px 20px rgba(120, 86, 33, 0.28) !important;
        }

        .admin-guided-tabs .tab-btn.active:hover {
            background: linear-gradient(180deg, #dcbe78 0%, #c39542 100%) !important;
        }

        .tab-btn-title {
            color: inherit !important;
            font-family: 'Cormorant Garamond', serif !important;
            font-size: 15px !important;
            font-weight: 600 !important;
            letter-spacing: 0.06em !important;
            text-transform: uppercase;
            text-shadow: none !important;
        }

        .tab-btn-desc {
            color: var(--rf-muted) !important;
            font-size: 10px !important;
            letter-spacing: 0.07em !important;
            text-transform: uppercase;
