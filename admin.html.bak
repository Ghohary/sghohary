        #custom-orders .custom-order-image {
            gap: 8px;
        }

        #custom-orders #customReferenceImage {
            width: 100%;
            min-height: 44px;
            border-radius: 12px;
            border: 1px solid rgba(181, 201, 225, 0.34);
            background: rgba(10, 16, 24, 0.72);
            color: #eaf3ff;
            padding: 8px 10px;
            font-size: 13px;
            line-height: 1.35;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        #custom-orders #customReferenceImage:focus {
            outline: none;
            border-color: rgba(184, 214, 247, 0.78);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 0 0 3px rgba(158, 193, 233, 0.16);
        }

        #custom-orders #customReferenceImage::file-selector-button,
        #custom-orders #customReferenceImage::-webkit-file-upload-button {
            border: 1px solid rgba(166, 202, 241, 0.34);
            border-radius: 999px;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%);
            color: #eaf3ff;
            font-size: 10px;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            font-weight: 500;
            padding: 8px 14px;
            margin-right: 10px;
            cursor: pointer;
            transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
        }

        #custom-orders #customReferenceImage::file-selector-button:hover,
        #custom-orders #customReferenceImage::-webkit-file-upload-button:hover {
            background: linear-gradient(180deg, rgba(28, 41, 58, 0.92) 0%, rgba(15, 24, 36, 0.94) 100%);
            border-color: rgba(184, 214, 247, 0.62);
            color: #ffffff;
        }

        #custom-orders .custom-order-image img {
            border: 1px solid rgba(158, 193, 233, 0.24);
            border-radius: 14px;
            background: rgba(15, 23, 35, 0.62);
