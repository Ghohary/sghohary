            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--add-text-soft);
            font-weight: 600;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-total {
            color: var(--add-text-main);
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-head-actions {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-bulk-btn {
            min-height: 26px;
            border-radius: 999px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, rgba(56, 62, 74, 0.88) 0%, rgba(38, 43, 52, 0.94) 100%) !important;
            color: var(--add-text-main) !important;
            font-size: 9px !important;
            font-weight: 600 !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            padding: 0 10px !important;
            box-shadow: none !important;
            transform: none !important;
            transition: border-color 0.12s linear, background-color 0.12s linear, color 0.12s linear !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-bulk-btn::before {
            content: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-bulk-btn:hover,
        body.admin-products-view.admin-add-product-view #products .size-inventory-bulk-btn:focus-visible {
            border-color: var(--add-line-strong) !important;
            background: linear-gradient(180deg, rgba(73, 81, 97, 0.92) 0%, rgba(52, 58, 70, 0.96) 100%) !important;
            color: #ffffff !important;
            outline: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-grid {
            display: grid;
            gap: 8px;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-row {
            min-height: 44px;
            border-radius: 12px;
            border: 1px solid var(--add-line);
            background: linear-gradient(180deg, rgba(40, 45, 55, 0.88) 0%, rgba(27, 31, 39, 0.94) 100%);
            padding: 8px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-size {
            color: var(--add-text-main);
            font-size: 11px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 500;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-controls {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-step {
            width: 30px;
            min-width: 30px;
            height: 30px;
            border-radius: 10px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, rgba(56, 62, 74, 0.92) 0%, rgba(38, 43, 52, 0.96) 100%) !important;
            color: var(--add-text-main) !important;
            font-size: 14px !important;
            font-weight: 600 !important;
            line-height: 1 !important;
            letter-spacing: 0 !important;
            text-transform: none !important;
            padding: 0 !important;
            box-shadow: none !important;
            transform: none !important;
            transition: border-color 0.12s linear, background-color 0.12s linear, color 0.12s linear !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-step::before {
            content: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-step:hover,
        body.admin-products-view.admin-add-product-view #products .size-inventory-step:focus-visible {
            border-color: var(--add-line-strong) !important;
            background: linear-gradient(180deg, rgba(73, 81, 97, 0.94) 0%, rgba(52, 58, 70, 0.98) 100%) !important;
            color: #ffffff !important;
            outline: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-input {
            width: 84px !important;
            min-width: 84px !important;
            height: 34px !important;
            min-height: 34px !important;
            border-radius: 10px !important;
            border: 1px solid var(--add-line) !important;
            background: linear-gradient(180deg, rgba(25, 29, 36, 0.94) 0%, rgba(17, 20, 26, 0.98) 100%) !important;
            color: var(--add-text-main) !important;
            text-align: center !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            letter-spacing: 0.04em !important;
            padding: 0 8px !important;
            box-shadow: none !important;
        }

        body.admin-products-view.admin-add-product-view #products .size-inventory-empty {
            min-height: 44px;
            border-radius: 12px;
            border: 1px dashed var(--add-line);
            background: rgba(21, 24, 30, 0.62);
