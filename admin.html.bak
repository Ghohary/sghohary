        /* ===== Neo Futuristic Final Override ===== */
        :root {
            --neo-bg-0: #050a12;
            --neo-bg-1: #0b1524;
            --neo-bg-2: #13243c;
            --neo-surface: rgba(10, 18, 31, 0.90);
            --neo-surface-soft: rgba(14, 24, 40, 0.88);
            --neo-line: rgba(140, 182, 235, 0.30);
            --neo-line-strong: rgba(195, 224, 255, 0.82);
            --neo-text: #eaf3ff;
            --neo-muted: #a6bbd3;
            --neo-accent: #6cb4ff;
            --neo-accent-strong: #3f8df2;
        }

        body {
            background:
                radial-gradient(1150px 520px at -8% -12%, rgba(101, 156, 230, 0.30) 0%, rgba(101, 156, 230, 0) 64%),
                radial-gradient(950px 420px at 108% 110%, rgba(79, 126, 189, 0.30) 0%, rgba(79, 126, 189, 0) 66%),
                linear-gradient(180deg, var(--neo-bg-1) 0%, var(--neo-bg-0) 100%) !important;
            color: var(--neo-text) !important;
        }

        body::before {
            opacity: 0.22 !important;
            background-size: 26px 26px !important;
            background-image:
                linear-gradient(rgba(170, 206, 255, 0.14) 1px, transparent 1px),
                linear-gradient(90deg, rgba(170, 206, 255, 0.14) 1px, transparent 1px) !important;
        }

        body::after {
            background:
                radial-gradient(72% 38% at 50% -14%, rgba(165, 206, 255, 0.20) 0%, rgba(165, 206, 255, 0) 100%),
                linear-gradient(180deg, rgba(165, 206, 255, 0.12) 0%, rgba(165, 206, 255, 0) 36%) !important;
        }

        .admin-header {
            border-bottom: 1px solid rgba(129, 168, 224, 0.36) !important;
            box-shadow: 0 16px 34px rgba(2, 7, 14, 0.46) !important;
        }

        .admin-header::before {
            opacity: 0.22 !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, rgba(140, 187, 248, 0) 0%, rgba(140, 187, 248, 0.84) 50%, rgba(140, 187, 248, 0) 100%) !important;
        }

        .admin-menu-shell {
            border: 1px solid var(--neo-line) !important;
            background:
                linear-gradient(180deg, rgba(13, 22, 37, 0.94) 0%, rgba(8, 14, 25, 0.95) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(204, 226, 255, 0.16),
                0 16px 30px rgba(3, 9, 18, 0.42) !important;
        }

        .admin-menu-hint {
            border: 1px solid rgba(142, 187, 247, 0.42) !important;
            background: rgba(17, 30, 50, 0.82) !important;
            color: #d8ebff !important;
            letter-spacing: 0.09em !important;
        }

        .admin-guided-tabs .tab-btn {
            border: 1px solid rgba(129, 174, 236, 0.38) !important;
            background: linear-gradient(180deg, rgba(18, 31, 52, 0.92) 0%, rgba(12, 22, 38, 0.95) 100%) !important;
            color: var(--neo-text) !important;
            box-shadow:
                inset 0 1px 0 rgba(214, 234, 255, 0.14),
                0 9px 18px rgba(3, 10, 20, 0.34) !important;
            transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
        }

        .admin-guided-tabs .tab-btn::before,
        .admin-guided-tabs .tab-btn::after {
            content: none !important;
            display: none !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            border-color: var(--neo-line-strong) !important;
            background: linear-gradient(180deg, rgba(27, 45, 72, 0.95) 0%, rgba(17, 30, 50, 0.96) 100%) !important;
            color: #ffffff !important;
            box-shadow:
                0 12px 22px rgba(4, 12, 24, 0.42),
                0 0 0 1px rgba(157, 202, 255, 0.28) !important;
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            border-color: rgba(206, 230, 255, 0.92) !important;
            background: linear-gradient(180deg, var(--neo-accent) 0%, var(--neo-accent-strong) 100%) !important;
            color: #071224 !important;
            box-shadow:
                inset 0 1px 0 rgba(235, 246, 255, 0.30),
                0 12px 24px rgba(17, 53, 106, 0.40) !important;
        }

        .admin-guided-tabs .tab-btn.active:hover {
            background: linear-gradient(180deg, #7cbfff 0%, #4a98f8 100%) !important;
        }

        .tab-btn-title {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            letter-spacing: 0.06em !important;
            text-transform: uppercase;
            text-shadow: none !important;
        }

        .tab-btn-desc {
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
            font-size: 10px !important;
            letter-spacing: 0.08em !important;
            text-transform: uppercase;
            color: var(--neo-muted) !important;
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: rgba(8, 20, 39, 0.82) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders,
        body.legacy-orders-disabled.admin-orders-view #orders * {
            color: var(--neo-text);
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            border: 1px solid rgba(131, 175, 236, 0.34) !important;
            background:
                radial-gradient(850px 300px at -8% -12%, rgba(86, 137, 207, 0.24) 0%, rgba(86, 137, 207, 0) 64%),
                linear-gradient(180deg, rgba(16, 28, 47, 0.95) 0%, rgba(11, 20, 34, 0.97) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(207, 229, 255, 0.14),
                0 18px 32px rgba(4, 12, 23, 0.36) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2 {
            color: #eef6ff !important;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
            font-size: clamp(20px, 2.2vw, 28px) !important;
            font-weight: 600 !important;
            letter-spacing: 0.13em !important;
            text-transform: uppercase;
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2::before {
            background: var(--neo-accent);
            box-shadow: 0 0 10px rgba(108, 180, 255, 0.42);
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            border: 1px solid rgba(128, 175, 238, 0.36) !important;
            background: linear-gradient(180deg, rgba(17, 30, 49, 0.88) 0%, rgba(12, 22, 38, 0.92) 100%) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search label {
            color: #adc1db !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input {
            border: 1px solid rgba(118, 173, 243, 0.48) !important;
            background: rgba(8, 15, 27, 0.92) !important;
            color: #eaf3ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input:focus {
            border-color: rgba(153, 198, 255, 0.84) !important;
            box-shadow: 0 0 0 3px rgba(108, 180, 255, 0.22) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border: 1px solid rgba(128, 175, 238, 0.34) !important;
            background: linear-gradient(180deg, rgba(15, 26, 43, 0.96) 0%, rgba(10, 18, 31, 0.97) 100%) !important;
            box-shadow: 0 12px 24px rgba(4, 12, 23, 0.34) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead th {
            color: #afc3dd !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(13, 24, 40, 0.94) !important;
            outline: 1px solid rgba(118, 173, 243, 0.24) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            background: rgba(22, 38, 62, 0.96) !important;
            outline-color: rgba(156, 201, 255, 0.66) !important;
            box-shadow: 0 10px 18px rgba(8, 20, 36, 0.42) !important;
            transform: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr td {
            color: #eaf3ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link {
            color: #9ac8ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link:hover,
        body.legacy-orders-disabled.admin-orders-view #orders .order-link:focus-visible {
            color: #b8daff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .payment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text {
            border: 1px solid rgba(126, 178, 242, 0.52) !important;
            background: rgba(45, 82, 134, 0.46) !important;
            color: #ddecff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.fulfilled,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.delivered {
            border-color: rgba(98, 194, 147, 0.64) !important;
            background: rgba(29, 105, 74, 0.54) !important;
            color: #d8f8ea !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text.unfulfilled {
            border-color: rgba(230, 128, 128, 0.66) !important;
            background: rgba(131, 46, 46, 0.58) !important;
            color: #ffe1e1 !important;
        }

        /* ===== Access Control Match Override ===== */
        :root {
            --ac-bg-0: #131a25;
            --ac-bg-1: #0e141d;
            --ac-shell: #0f141d;
            --ac-panel-top: rgba(18, 27, 39, 0.88);
            --ac-panel-bottom: rgba(10, 16, 25, 0.92);
            --ac-line: rgba(158, 193, 233, 0.30);
            --ac-line-strong: rgba(184, 214, 247, 0.62);
            --ac-text: #eaf3ff;
            --ac-muted: #aebed0;
            --ac-input: rgba(10, 16, 24, 0.72);
            --ac-input-focus: rgba(12, 20, 30, 0.88);
        }

        body {
            background:
                radial-gradient(1200px 560px at 8% 8%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 60%),
                radial-gradient(900px 420px at 92% 88%, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 62%),
                linear-gradient(180deg, var(--ac-bg-0) 0%, var(--ac-bg-1) 100%) !important;
            color: var(--ac-text) !important;
        }

        body::before {
            opacity: 1 !important;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) !important;
            background-size: 36px 36px !important;
            animation: none !important;
        }

        body::after {
            background: none !important;
            animation: none !important;
        }

        .container {
            background: transparent !important;
        }

        .admin-header {
            background: linear-gradient(180deg, #131c28 0%, #0f141d 100%) !important;
            border-bottom: 1px solid var(--ac-line) !important;
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28) !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        .admin-header::before {
            opacity: 0.50 !important;
        }

        .admin-header::after {
            background: linear-gradient(90deg, #78a6ff 0%, #c3f0ff 50%, #78a6ff 100%) !important;
            opacity: 0.45;
        }

        .admin-menu-shell {
            background: linear-gradient(180deg, var(--ac-panel-top) 0%, var(--ac-panel-bottom) 100%) !important;
            border: 1px solid var(--ac-line) !important;
            border-radius: 18px;
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28) !important;
        }

        .admin-menu-shell::after {
            content: none !important;
            display: none !important;
        }

        .admin-menu-hint {
            border: 1px solid var(--ac-line) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            color: var(--ac-muted) !important;
            box-shadow: none !important;
        }

        .admin-guided-tabs .tab-btn {
            border: 1px solid var(--ac-line) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            color: var(--ac-text) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 10px 22px rgba(4, 9, 15, 0.34) !important;
            transform: none !important;
        }

        .admin-guided-tabs .tab-btn::before,
        .admin-guided-tabs .tab-btn::after {
            content: none !important;
            display: none !important;
        }

        .admin-guided-tabs .tab-btn:hover,
        .admin-guided-tabs .tab-btn:focus-visible {
            background: linear-gradient(180deg, rgba(28, 41, 58, 0.92) 0%, rgba(15, 24, 36, 0.94) 100%) !important;
            border-color: var(--ac-line-strong) !important;
            color: #ffffff !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                0 14px 26px rgba(5, 11, 18, 0.45) !important;
        }

        .admin-guided-tabs .tab-btn:active,
        .admin-guided-tabs .tab-btn.active {
            background: linear-gradient(180deg, #78a6ff 0%, #3f7de0 100%) !important;
            border-color: rgba(184, 214, 247, 0.90) !important;
            color: #0b1220 !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.24),
                0 12px 24px rgba(10, 35, 74, 0.46) !important;
        }

        .admin-guided-tabs .tab-btn.active:hover {
            background: linear-gradient(180deg, #8ab4ff 0%, #4f8ff5 100%) !important;
        }

        .tab-btn-title {
            color: inherit !important;
        }

        .tab-btn-desc {
            color: #b8c9dc !important;
        }

        .admin-guided-tabs .tab-btn.active .tab-btn-desc {
            color: #12223d !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders,
        body.legacy-orders-disabled.admin-orders-view #orders * {
            color: var(--ac-text) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content {
            border: 1px solid var(--ac-line) !important;
            background: linear-gradient(180deg, var(--ac-panel-top) 0%, var(--ac-panel-bottom) 100%) !important;
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::before {
            opacity: 0.34 !important;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) !important;
            background-size: 24px 24px !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders.tab-content::after {
            content: none !important;
            display: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2 {
            color: #f3f8ff !important;
            text-shadow: 0 2px 18px rgba(120, 166, 255, 0.18) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders h2::before {
            background: #9ec6ff !important;
            box-shadow: 0 0 10px rgba(158, 198, 255, 0.65) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search {
            border: 1px solid rgba(181, 201, 225, 0.34) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            box-shadow: none !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search label {
            color: #d8e5f7 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input {
            border: 1px solid rgba(181, 201, 225, 0.34) !important;
            background: var(--ac-input) !important;
            color: #f2f8ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-search input:focus {
            background: var(--ac-input-focus) !important;
            border-color: #9ec6ff !important;
            box-shadow: 0 0 0 4px rgba(134, 171, 219, 0.18) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border: 1px solid var(--ac-line) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 16px 30px rgba(4, 9, 15, 0.35) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block thead th {
            color: #aebed0 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr {
            background: rgba(16, 25, 38, 0.94) !important;
            outline: 1px solid rgba(158, 193, 233, 0.24) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr.order-row:hover {
            background: linear-gradient(180deg, rgba(28, 41, 58, 0.92) 0%, rgba(15, 24, 36, 0.94) 100%) !important;
            outline-color: var(--ac-line-strong) !important;
            box-shadow: 0 10px 22px rgba(5, 11, 18, 0.38) !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block tbody tr td {
            color: #eaf3ff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link {
            color: #c8def9 !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .order-link:hover,
        body.legacy-orders-disabled.admin-orders-view #orders .order-link:focus-visible {
            color: #ffffff !important;
        }

        body.legacy-orders-disabled.admin-orders-view #orders .payment-text,
        body.legacy-orders-disabled.admin-orders-view #orders .fulfillment-text {
            border: 1px solid rgba(158, 193, 233, 0.30) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            color: #eaf3ff !important;
        }

        /* Match Access-Control Style Across Invoices / Custom Orders / Products / Shipping */
        body.admin-invoices-view #invoices,
        body.admin-custom-orders-view #custom-orders,
        body.legacy-products-disabled.admin-products-view #products,
        body.admin-settings-view #settings,
        body.admin-invoices-view #invoices *,
        body.admin-custom-orders-view #custom-orders *,
        body.legacy-products-disabled.admin-products-view #products *,
        body.admin-settings-view #settings * {
            color: var(--ac-text) !important;
        }

        body.admin-invoices-view #invoices.tab-content,
        body.admin-custom-orders-view #custom-orders.tab-content,
        body.legacy-products-disabled.admin-products-view #products.tab-content,
        body.admin-settings-view #settings.tab-content {
            border: 1px solid var(--ac-line) !important;
            background: linear-gradient(180deg, var(--ac-panel-top) 0%, var(--ac-panel-bottom) 100%) !important;
            box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28) !important;
        }

        body.admin-invoices-view #invoices.tab-content::before,
        body.admin-custom-orders-view #custom-orders.tab-content::before,
        body.legacy-products-disabled.admin-products-view #products.tab-content::before,
        body.admin-settings-view #settings.tab-content::before {
            opacity: 0.34 !important;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) !important;
            background-size: 24px 24px !important;
        }

        body.admin-invoices-view #invoices.tab-content::after,
        body.admin-custom-orders-view #custom-orders.tab-content::after,
        body.legacy-products-disabled.admin-products-view #products.tab-content::after,
        body.admin-settings-view #settings.tab-content::after {
            content: none !important;
            display: none !important;
        }

        body.admin-invoices-view #invoices h2,
        body.admin-custom-orders-view #custom-orders h2,
        body.legacy-products-disabled.admin-products-view #products .product-header-link,
        body.admin-settings-view #settings .shipping-panel-title {
            color: #f3f8ff !important;
            text-shadow: 0 2px 18px rgba(120, 166, 255, 0.18) !important;
        }

        body.admin-invoices-view #invoices h2::before,
        body.admin-custom-orders-view #custom-orders h2::before {
            background: #9ec6ff !important;
            box-shadow: 0 0 10px rgba(158, 198, 255, 0.65) !important;
        }

        body.admin-invoices-view #invoices .invoice-card,
        body.admin-custom-orders-view #custom-orders .custom-order-card,
        body.legacy-products-disabled.admin-products-view #products .form-section,
        body.legacy-products-disabled.admin-products-view #products .form-section-card,
        body.legacy-products-disabled.admin-products-view #products #productListSection,
        body.legacy-products-disabled.admin-products-view #products #productDataSection form,
        body.admin-settings-view #settings .settings-card.shipping-settings,
        body.admin-settings-view #settings .shipping-group-box {
            border: 1px solid var(--ac-line) !important;
            background: linear-gradient(180deg, rgba(18, 27, 39, 0.84) 0%, rgba(10, 16, 25, 0.88) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 12px 24px rgba(4, 9, 15, 0.28) !important;
        }

        body.admin-invoices-view #invoices .invoice-item,
        body.admin-invoices-view #invoices .invoice-totals,
        body.admin-invoices-view #invoices .invoice-list-item,
        body.admin-custom-orders-view #custom-orders .custom-order-item,
        body.admin-settings-view #settings .shipping-region-row {
            border: 1px solid var(--ac-line) !important;
            background: rgba(16, 25, 38, 0.92) !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-header-subtitle,
        body.admin-invoices-view #invoices .invoice-card h4,
        body.admin-custom-orders-view #custom-orders .custom-order-card h4,
        body.admin-settings-view #settings .shipping-panel-subtitle,
        body.admin-settings-view #settings .shipping-note {
            color: #aebed0 !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-search-inline input,
        body.legacy-products-disabled.admin-products-view #products input,
        body.legacy-products-disabled.admin-products-view #products select,
        body.legacy-products-disabled.admin-products-view #products textarea,
        body.admin-invoices-view #invoices input,
        body.admin-invoices-view #invoices select,
        body.admin-invoices-view #invoices textarea,
        body.admin-custom-orders-view #custom-orders input,
        body.admin-custom-orders-view #custom-orders select,
        body.admin-custom-orders-view #custom-orders textarea,
        body.admin-settings-view #settings input,
        body.admin-settings-view #settings select,
        body.admin-settings-view #settings textarea {
            border: 1px solid rgba(181, 201, 225, 0.34) !important;
            background: var(--ac-input) !important;
            color: #f2f8ff !important;
            box-shadow: none !important;
        }

        body.legacy-products-disabled.admin-products-view #products .product-search-inline input:focus,
        body.legacy-products-disabled.admin-products-view #products input:focus,
        body.legacy-products-disabled.admin-products-view #products select:focus,
