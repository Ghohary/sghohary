        body.legacy-orders-disabled.admin-orders-view #orders .order-table-block {
            border-color: rgba(255, 255, 255, 0.20) !important;
            background: linear-gradient(180deg, rgba(45, 48, 54, 0.86) 0%, rgba(30, 33, 38, 0.92) 100%) !important;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.10),
                0 16px 28px rgba(0, 0, 0, 0.40) !important;
