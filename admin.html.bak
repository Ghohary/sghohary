                    <div class="invoice-kpi">
                        <span>Paid</span>
                        <strong id="invoiceStatPaid">0</strong>
                    </div>
                    <div class="invoice-kpi">
                        <span>Overdue</span>
                        <strong id="invoiceStatOverdue">0</strong>
                    </div>
                    <div class="invoice-kpi">
                        <span>Amount Due</span>
                        <strong id="invoiceStatDueAmount">AED 0.00</strong>
